; The Drone Configurator's contract (CDDL, RFC 8610): what the dashboard and the Pico backend say
; to each other. `pnpm generate` turns it into apps/frontend/src/generated/app.ts and
; apps/backend/generated/app.pi.
;
; The backend owns the MAVLink link (padcom/pico-mavlink): it connects, keeps the vehicle's
; parameters and telemetry, and writes parameters with read-back verification. The dashboard
; only asks and shows.
services = {
  "vehicle.connect": ["method", connect-request, connection],
  "vehicle.disconnect": ["method", null, connection],
  "vehicle.connection": ["subscription", null, connection],
  ; The request is a map (`{}` is the same as `{ method: "auto" }`): the schema tooling cannot say "a map or null", so a null
  ; payload does not pass the contract's validation. (The backend itself would take it as auto.)
  "params.list": ["method", param-list-request, param-list],
  ; Stops the download that is running (nothing happens when none is). That `params.list` then fails with the code `ABORTED`;
  ; the link and the session stay as they are.
  "params.cancel": ["method", null, null],
  ; While a download runs, at most 10 times a second (the first as soon as the total is known, the last when everything has
  ; arrived).
  "params.progress": ["event", params-progress],
  "params.write": ["method", param-write, param-write-result],
  ; The flight logs on the vehicle (the backend serves `logs.vehicle.list` and `logs.download`, `logs.cancel`, `logs.progress`;
  ; `logs.erase` is still the mock's: the backend answers it with UNSUPPORTED, and says so with `can-erase` false).
  ; `logs.vehicle.list` lists them, `logs.download` fetches the ones named, one after the other, with `logs.progress` events
  ; for each, and `logs.cancel` stops it (what was fetched is kept, and the next download of that log goes on from there).
  ; Neither downloads nor erases while the vehicle is armed (`ARMED`), is not known to be disarmed (`STATE_UNKNOWN`) or while a
  ; download runs (`BUSY`). A backend that implements this must also STOP a download that is running when the vehicle arms
  ; (the refusal at the start is not enough), and keep what was fetched. `logs.erase` erases only logs that were downloaded
  ; and checked (see `vehicle-log`); the others stay, and are counted.
  "logs.vehicle.list": ["method", null, vehicle-logs],
  "logs.download": ["method", logs-download, logs-downloaded],
  "logs.cancel": ["method", null, null],
  "logs.erase": ["method", null, logs-erased],
  "logs.progress": ["event", logs-progress],
  ; The flight logs on this computer (the checked copies `logs.download` made, in the app's data folder; no vehicle needed).
  ; `logs.local.list` lists them, with what is known of each from an earlier `logs.local.read` (no log is read by listing).
  ; `logs.local.read` reads one log through, once and in order, whatever its size (a few kilobytes of it are in memory at any
  ; time), with `logs.local.progress` events (at most 10 a second), and answers with what is in it. It fails with `ABORTED` when
  ; `logs.local.cancel` stops it, with `BUSY` when another read runs, with `NOT_FOUND` for a log that is not in the list.
  "logs.local.list": ["method", null, local-logs],
  "logs.local.read": ["method", logs-local-read, local-log-summary],
  "logs.local.modes": ["method", logs-local-read, local-log-modes],
  ; The values of fields of a log that was read (and is still the file that was read: else `NOT_READ`), thinned for a chart: the
  ; time from `fromUs` to `toUs` is cut in `buckets` equal parts and each part that has samples gives their smallest and largest
  ; value and how many there are, so that a spike of one sample is never lost. A part with no sample is not in the answer (a gap,
  ; never a zero). One read at a time (`BUSY`), cancelable with `logs.local.cancel` (`ABORTED`), with `logs.local.progress`.
  "logs.local.series": ["method", logs-local-series-ask, logs-local-series],
  ; The automatic review of a log that was read (`NOT_READ` otherwise): findings from the messages every log has, each with what it
  ; rests on. ONLY a verified log is reviewed (`NOT_VERIFIED` otherwise): nothing is concluded from bytes that are not known to be the
  ; vehicle's. One read at a time (`BUSY`), cancelable with `logs.local.cancel` (`ABORTED`), `CHANGED` if the file changed meanwhile.
  "logs.local.review": ["method", logs-local-read, logs-review],
  "logs.local.cancel": ["method", null, null],
  "logs.local.progress": ["event", logs-local-progress],
  "vehicle.reboot": ["method", null, reboot-result],
  "telemetry.stream": ["subscription", telemetry-params, telemetry],
  "vehicle.messages": ["subscription", messages-params, vehicle-message],
  "files.save": ["method", file-save, file-saved],
  "files.open": ["method", null, file-opened],
  "serial.ports": ["method", null, serial-ports],
  ; Settings that survive a restart (see `settings`). `settings.set` takes a patch and answers with the document it made.
  "settings.get": ["method", null, settings-state],
  "settings.set": ["method", settings-patch, settings-state],
  ; Sent after every `settings.set`, also to a window that did not ask for it.
  "settings.changed": ["event", settings-state],
  ; A parameter the vehicle announced on its own (changed by another ground station, or by the
  ; autopilot): the dashboard's copy follows it.
  "params.changed": ["event", param],
}

; How to reach the vehicle. "simulator" is a vehicle inside the backend, for trying the app
; without hardware or SITL; "serial" is a USB or UART port (`device`, at `baud`, default 115200).
connect-request = {
  transport: "simulator" / "udp" / "tcp" / "serial",
  ? host: tstr,
  ? port: uint .size 2,
  ? device: tstr,
  ? baud: uint .size 4,
}

; "reconnecting": the link was lost and the backend is trying to bring it back (`attempt`, and `nextRetryMs` until
; the next try); the vehicle stays shown and what was on screen is kept. The `connected` that follows has `resumed` when
; it is the same vehicle (its identity matches), so the parameters on screen are still its; without `resumed` it is a
; new connection. `errorCode` is a stable code for the reason in `error` (the text is English; the interface picks its
; own words from the code).
connection = {
  state: "disconnected" / "connecting" / "connected" / "lost" / "reconnecting",
  ? vehicle: vehicle-info,
  ? error: tstr,
  ? errorCode: tstr,
  ? attempt: uint .size 4,
  ? nextRetryMs: uint .size 4,
  ? resumed: bool,
}

vehicle-info = {
  sysid: uint .size 1,
  compid: uint .size 1,
  type: tstr,
  autopilot: tstr,
}

; A parameter as the autopilot reports it. Integers and reals stay apart: `value` is exact for
; every integer type a PARAM_VALUE can carry (up to 32 bits).
param = {
  id: tstr,
  index: uint .size 2,
  kind: "int" / "real",
  type: tstr,
  value: float,
}

; `method` is for tests and diagnostics, not a choice for the user: "auto" (the default) uses the file transfer where the vehicle has
; it and the list where it does not, "list" the list only, "ftp" the file transfer only (its failure is the error, no fallback).
param-list-request = { ? method: "auto" / "list" / "ftp" }

; `source` is how the parameters came: "ftp" (the vehicle's parameter file) or "list" (PARAM_REQUEST_LIST). `fallback` is why
; the file transfer was not used when `source` is "list": "unsupported", "timeout", "protocol", "incomplete" or "disabled"
; (the list was asked for). `elapsedMs` is how long the download took, a failed attempt of the file transfer included.
param-list = {
  params: [* param],
  count: uint .size 2,
  complete: bool,
  missing: [* uint .size 2],
  ? source: "ftp" / "list",
  ? fallback: tstr,
  ? elapsedMs: uint .size 4,
}

; How far a download is: `received` of `total` parameters, and by which way they come.
params-progress = {
  received: uint .size 2,
  total: uint .size 2,
  source: "ftp" / "list",
}

param-write = {
  id: tstr,
  kind: "int" / "real",
  type: tstr,
  value: float,
}

; `verified` is false when the autopilot reports a different value than the one written (it
; refused or rounded it).
param-write-result = {
  param: param,
  verified: bool,
}

; One log on the vehicle: its number, its size in bytes (not final for the log of a flight that has just ended: the vehicle goes on
; writing for a while), when it was last written (milliseconds since 1970; absent when the vehicle gives no time: it is the time
; of the last write, not the start of the flight), and whether (`downloaded`: a checked copy of that number and size is here; the
; number alone does not say which log it is, since the vehicle starts numbering again after a format, so this is a probable match,
; and the vehicle's CRC must be asked before anything is ever erased on the strength of it) a copy that was CHECKED is on this computer. Checked means the size is the listing's AND the
; checksum is the vehicle's: over FTP the vehicle computes it (CalcFileCRC32) and it is compared with that of the copy. The
; log protocol (LOG_DATA) has no checksum, so a log fetched that way cannot be checked: it is reported `downloaded: false`,
; and `logs.erase` never takes it. A copy of the right size with a block lost or garbled is not checked either, and a log
; that could not be checked is never erased.
;
; `downloaded` needs the vehicle's CRC of the log, which the vehicle reads from its card: the backend does not ask while the
; vehicle is armed or its state is unknown, nor after the vehicle arms, nor past a time limit for the whole list; it keeps what it
; was told for a log of that number and size for as long as the connection lasts. A log that has a copy of its number and size
; and whose CRC was not had is `unchecked: true` (and `downloaded: false`); a later list answers it.
vehicle-log = {
  id: uint .size 4,
  size: uint .size 4,
  ? time: uint .size 8,
  downloaded: bool,
  ? unchecked: bool,
}

; The logs, how they were listed ("ftp": the vehicle's files, or "mavlink": the log protocol), and whether `logs.erase` can be
; used. A directory that is not there (nothing was logged yet) is an empty list. A listing that cannot be trusted (a file name
; that is not UTF-8, a reply that makes no sense) is an error of `logs.vehicle.list`, with the reason in words, not a partial list.
vehicle-logs = { logs: [* vehicle-log], source: "ftp" / "mavlink", canErase: bool }

; The logs to download, by number, in the order they are fetched.
logs-download = { ids: [* uint .size 4] }

; The logs that are whole now (copied and checked), and whether the download stopped before it was through (cancelled, the vehicle
; armed, or a log that failed: then `error` says why, in words). What was fetched of a log that did not finish is kept, and the next
; download of that log goes on from there.
logs-downloaded = { ids: [* uint .size 4], stopped: bool, ? error: tstr }

; The logs erased (they were downloaded), and how many were kept because they are not downloaded.
logs-erased = { erased: [* uint .size 4], kept: uint .size 4 }

; How a log is doing: queued, being fetched (`received` of `total` bytes; `resumedFrom` is where it began, when it went on from
; what an earlier try had fetched), done, or failed.
logs-progress = {
  id: uint .size 4,
  state: "queued" / "downloading" / "done" / "failed",
  received: uint .size 4,
  total: uint .size 4,
  ? resumedFrom: uint .size 4,
}

; A log on this computer. `key` names it (for `logs.local.read`: the vehicle's folder and the file, which is
; `NNNNNNNN-CCCCCCCC.BIN`: the vehicle's number of the log and the CRC-32 the vehicle gave for it when it was downloaded, `crc` in
; hex). `modified` is when the FILE was last changed on this computer (milliseconds since 1970), not the date of the flight. The
; `summary` is there only when the log was read since the app started and the file is still the one that was read (same size and
; time); a file that changed is read again before anything is said of it.
local-log = {
  key: tstr,
  vehicle: tstr,
  id: uint .size 4,
  size: uint .size 8,
  modified: uint .size 8,
  crc: tstr,
  ? summary: local-log-summary,
}

; The logs, and whether there were more than the backend lists (it lists the 2000 most recently changed).
local-logs = { logs: [* local-log], truncated: bool }

logs-local-read = { key: tstr }

; How far the read has got, of how many bytes.
logs-local-progress = { key: tstr, bytes: uint .size 8, total: uint .size 8 }

; What a read found. `verified`: the CRC-32 of the file, worked out during the read, is the one in its name (the vehicle's CRC
; when it was downloaded), and the file did not change while it was read. Nothing may be concluded from a log that is not
; verified (no review). `messages` were read; `problems` counts the damage met on the way (bytes that were not part of any message,
; formats that were refused, values that meant nothing). `firstUs` and `lastUs` are the times (microseconds since the vehicle's boot)
; of the first and last message that has one; there are none in a log without any. `firmware` is the first MSG that names the
; firmware ("ArduCopter V4.7.2 (...)"), absent when there is none: the modes are numbers, and what a number means depends on it.
; `modeChanges` is how many changes of flight mode there are; they themselves are in `logs.local.modes` (a summary is small, and
; is in every entry of the list; the changes can be thousands).
local-log-summary = {
  verified: bool,
  messages: uint .size 4,
  problems: uint .size 4,
  ? firstUs: uint .size 8,
  ? lastUs: uint .size 8,
  ? firmware: tstr,
  modeChanges: uint .size 4,
}

; Which values: up to 16 series (a field of a message type, such as ATT and Roll), `buckets` from 1 to 2000, and the time (the
; microseconds since the vehicle's boot, as `firstUs` and `lastUs` of the summary) to look at: all of the log by default, else
; cut to it. Several instances of a message (IMU 0 and 1, BAT 0 and 1) are told apart by `whereField` and `whereValue`: only the
; messages whose field of that name has that value count.
series-ask = {
  message: tstr,
  field: tstr,
  ? whereField: tstr,
  ? whereValue: float,
}

logs-local-series-ask = {
  key: tstr,
  series: [+ series-ask],
  buckets: uint .size 2,
  ? fromUs: uint .size 8,
  ? toUs: uint .size 8,
}

; The time that was cut in parts (`fromUs` to `toUs`, both in the log, and the `buckets` asked), and a result for each series
; asked, in the order asked. `found`: the log has the message with that field (as a number); without it there is nothing to draw,
; and the page says "no data", not a flat line. `unit` is the unit the log names for the field, when it does, and the values are IN
; that unit: a field whose character scales it already (c C e E L) is scaled by that, and any other field by the multiplier the log
; names for it (MAG's int16 milligauss have the multiplier 0.001 and the unit Gauss), not at all when the log names none. A
; field that is an instance of the message (`I`, `Inst`, `C`) is told apart with `whereField`/`whereValue`, which go together
; (`BAD_REQUEST` otherwise) and name a number, not a text. `points` are the parts
; that have samples, `index` from 0. `invalid` counts the samples that were not numbers (NaN, infinity) and are not in the points.
series-result = {
  message: tstr,
  field: tstr,
  found: bool,
  ? unit: tstr,
  points: [* series-point],
  invalid: uint .size 4,
}

series-point = { index: uint .size 2, min: float, max: float, count: uint .size 4 }

logs-local-series = {
  fromUs: uint .size 8,
  toUs: uint .size 8,
  buckets: uint .size 2,
  series: [* series-result],
}

; One finding. `id` says what it is (`vibration.x`, `vibration.y`, `vibration.z`, `vibration.clipping`, `gps.satellites`, `gps.hdop`,
; `gps.fix`, `ekf.variance`, `errors.logged`, `battery.voltage`, `battery.current`; the page words them and the limits). `value` is
; the number it rests on, `limit` the limit it was held against (the one it crossed, else the first), `atUs` when in the log it was
; found, where there is a when. `level`: "ok", "warn" and "bad" against this app's limits; "info" for what is only told (the battery:
; whether it is a problem depends on the battery); "no-data" when the log has nothing to say (a finding is then absent of value, not a
; pass). The whole log is looked at, the time on the ground too.
review-finding = {
  id: tstr,
  level: "ok" / "warn" / "bad" / "info" / "no-data",
  ? value: float,
  ? limit: float,
  ? atUs: uint .size 8,
}

logs-review = { findings: [* review-finding] }

; The changes of flight mode of a log that was read, in the order they are in the log (at most 5000, `cut` when there were more).
; The backend keeps them for the last few logs it read (16) and the file still the one that was read; for another it fails with
; `NOT_READ` and the log is to be read again.
local-log-modes = { modes: [* mode-change], cut: bool }

mode-change = { timeUs: uint .size 8, mode: uint .size 2 }

; Reboots the flight controller (MAV_CMD_PREFLIGHT_REBOOT_SHUTDOWN, parameter 1 = 1: a restart, not a reset of the
; parameters). It is sent ONCE (no resend: a second request could reach the freshly booted vehicle) and never with
; ArduPilot's force value. The backend refuses it, with a CommunicatorError and nothing sent, when no vehicle is
; connected (`NOT_CONNECTED`), the vehicle is armed (`ARMED`), its armed state is not known because no heartbeat came
; within 3 s (`STATE_UNKNOWN`: unknown counts as armed), or a parameter is being written or downloaded (`BUSY`).
; `accepted`: the vehicle acknowledged and will reboot; the connection then goes `reconnecting` with `errorCode`
; "REBOOTING" until it is back. `refused`: it answered with a failure (`detail` says which). `unsupported`: it does not
; know the command. `no-answer`: no acknowledgement within 3 s; nothing is resent, and the command may still have arrived,
; so the vehicle may still reboot (the backend refuses a second request with `BUSY` for 10 s, and a link that then goes quiet is
; reported as `REBOOTING`). A vehicle that says IN_PROGRESS is waited for (up to 10 s) and counts as `accepted`.
reboot-result = {
  result: "accepted" / "refused" / "unsupported" / "no-answer",
  ? detail: tstr,
}

; The texts the vehicle sends (STATUSTEXT: "PreArm: ...", "Arming motors", "EKF3 IMU0 is using GPS"), long ones joined.
; A subscription first sends the last `replay` stored messages (default 100, at most 200: a subscription takes only 256
; events that are not yet delivered, so a longer replay could lose some), oldest first, then each new one as it arrives.
; The backend keeps the last 500 of the connected vehicle (any of its components), and forgets them when a different
; vehicle connects (they stay across a `resumed` reconnect). A subscriber that starts again after the backend restarted
; sees ids start over, and a `connected` that is not `resumed` is a new vehicle: it clears what it has. The texts are the vehicle's own words, in its language: show them
; as text.
messages-params = { ? replay: uint .size 2 }

; `id` goes up by one for each message for as long as the backend runs, so that the dashboard can drop one it has
; already: a subscription that starts while a message is on its way cannot show it twice or out of order. `time` is
; when the backend received the message's last chunk (milliseconds since 1970). `severity` is MAVLink's MAV_SEVERITY:
; 0 emergency, 1 alert, 2 critical, 3 error, 4 warning, 5 notice, 6 info, 7 debug. `truncated` is true when chunks of a
; long message never arrived: `text` then stops at the gap.
vehicle-message = {
  id: uint .size 4,
  time: uint .size 8,
  system: uint .size 1,
  component: uint .size 1,
  severity: uint .size 1,
  text: tstr,
  truncated: bool,
}

; How often the stream sends the latest values: `rateHz` events a second (default 5, at most 20),
; whatever rate the vehicle sends its messages at. The subscriber may pass `{}` or nothing.
telemetry-params = { ? rateHz: uint .size 1 }

; Only what the vehicle has reported: telemetry starts with its first heartbeat, and battery and
; attitude are absent until it sends them (nothing shown is made up). Besides those fields, which
; stay as they are, each MAVLink message the dashboard shows has a group of its own: the latest
; values of that message, with `ageMs`, how long ago it arrived. A group is absent until its message
; has been heard (never zero-filled), and a value the vehicle marks "unknown" is absent from it.
; Units are SI and degrees: metres, metres a second, degrees, percent, volts, amperes, and
; milliampere-hours for charge consumed (battery.consumed).
telemetry = {
  armed: bool,
  mode: tstr,
  ? batteryVoltage: float,
  ? batteryRemaining: uint .size 1,   ; percent, absent when the vehicle doesn't know
  ? roll: float,
  ? pitch: float,
  ? yaw: float,
  heartbeatAgeMs: uint .size 4,
  ? position: position-group,
  ? gps: gps-group,
  ? speed: speed-group,
  ? nav: nav-group,
  ? wind: wind-group,
  ? ekf: ekf-group,
  ? vibration: vibration-group,
  ? battery: battery-group,
  ? attitude: attitude-group,
}

; GLOBAL_POSITION_INT: the vehicle's own fused position. Altitudes: above mean sea level, and above
; home. Velocities: north, east, down. `heading` is absent when the vehicle doesn't know it. A
; GLOBAL_POSITION_INT with latitude and longitude both 0 (ArduPilot's "no position yet") makes no group.
position-group = {
  lat: float,
  lon: float,
  altitude: float,
  relativeAltitude: float,
  vx: float,
  vy: float,
  vz: float,
  ? heading: float,
  ageMs: uint .size 4,
}

; GPS_RAW_INT: `fixType` as MAVLink's GPS_FIX_TYPE (0 none, 2 2D, 3 3D, 4 DGPS, 5 RTK float, 6 RTK fixed).
gps-group = {
  fixType: uint .size 1,
  ? satellites: uint .size 1,
  ? hdop: float,
  ? vdop: float,
  ageMs: uint .size 4,
}

; VFR_HUD: `throttle` in percent, `heading` in degrees.
speed-group = {
  airspeed: float,
  groundspeed: float,
  climb: float,
  throttle: uint .size 2,
  heading: float,
  ageMs: uint .size 4,
}

; NAV_CONTROLLER_OUTPUT: distance to the next waypoint and the bearing to it.
nav-group = {
  waypointDistance: uint .size 2,
  targetBearing: float,
  altitudeError: float,
  crosstrackError: float,
  ageMs: uint .size 4,
}

; WIND (ArduPilot): the direction the wind comes from, in degrees.
wind-group = {
  direction: float,
  speed: float,
  speedZ: float,
  ageMs: uint .size 4,
}

; EKF_STATUS_REPORT: `flags` as MAVLink's EKF_STATUS_FLAGS; variances are unitless (about 0 to 1 is
; healthy, above 1 is bad).
ekf-group = {
  flags: uint .size 2,
  velocityVariance: float,
  positionHorizVariance: float,
  positionVertVariance: float,
  compassVariance: float,
  terrainAltVariance: float,
  ageMs: uint .size 4,
}

; VIBRATION: `clipping` counts the accelerometers' clipping events (three sensors).
vibration-group = {
  x: float,
  y: float,
  z: float,
  clipping: [* uint .size 4],
  ageMs: uint .size 4,
}

; SYS_STATUS and BATTERY_STATUS: `voltage` and `current` (negative current: unknown, so absent),
; `remaining` in percent, `consumed` in milliampere-hours, `cells` the cell voltages the battery
; reports. `ageMs` is the age of the latest of the two messages, so a value that came from the older
; one can be older than `ageMs` says.
battery-group = {
  ? voltage: float,
  ? current: float,
  ? remaining: uint .size 1,
  ? consumed: float,
  cells: [* float],
  ageMs: uint .size 4,
}

; ATTITUDE: degrees, and degrees a second.
attitude-group = {
  roll: float,
  pitch: float,
  yaw: float,
  rollSpeed: float,
  pitchSpeed: float,
  yawSpeed: float,
  ageMs: uint .size 4,
}

; The settings document. `language` and `theme` are what the backend knows about; everything the interface keeps for
; itself (layouts, the tab last used) is a `ui` entry: a namespaced key ("layout.flightData") and a string the interface
; validates itself, so a new layout needs no change here. A value is at most 65536 characters, a key 1 to 128 (and not
; "language" or "theme", which `remove` names), there are at most 256 entries, and all the keys and values together
; are at most 1048576 characters, so that the whole document can always be sent in one message; a `language` is 1 to
; 35 characters. `version` is the version of the file (1 so far).
settings = {
  version: uint .size 1,
  ? language: tstr,
  ? theme: theme-name,
  ui: [* ui-entry],
}

theme-name = "light" / "dark" / "system"

ui-entry = { key: tstr, value: tstr }

; The document, and how it was got. `notice` says in English what the user should know and `noticeCode` is its stable
; code: "CORRUPT" (the file is not a settings document and was set aside, the settings are the defaults), "UNREADABLE"
; (the file could not be read at all, and was set aside; if it cannot be moved either it is left where it is and the
; settings are kept in memory so that it is not overwritten), "NEWER" (the file was
; written by a newer version and was set aside), "NOT_WRITABLE" (the settings directory cannot be written to, so
; the settings are kept in memory and lost when the app closes). "CORRUPT" and "NEWER" are said until the app is
; restarted; "NOT_WRITABLE" until a save works.
settings-state = {
  settings: settings,
  ? notice: tstr,
  ? noticeCode: tstr,
}

; What to change; what is not mentioned stays. `ui` entries are set (added or replaced), and `remove` names what to
; forget: "language", "theme" or a `ui` key.
settings-patch = {
  ? language: tstr,
  ? theme: theme-name,
  ? ui: [* ui-entry],
  ? remove: [* tstr],
}

; Saving and opening snapshot files through the host's native dialogs (pages can't reach them).
file-save = { name: tstr, text: tstr }

; `path` is absent when the user cancelled.
file-saved = { ? path: tstr }

file-opened = { ? path: tstr, ? text: tstr }

; The serial ports the backend's machine has (padcom/serialport's listPorts).
serial-ports = { ports: [* serial-port] }

; `description` names a USB adapter: vendor:product and the product name.
serial-port = { path: tstr, ? description: tstr }
