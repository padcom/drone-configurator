// The parameters the Tune screen may write, and the limits of each. A write that carries `tuning` (param-write in the contract) is
// the ONE kind of write that is allowed while the vehicle is armed (the leader's decision Q7: tuning is done in flight), so this
// list is the whole of what such a write can touch: a name that is not here is refused, armed or not, and a value outside the limits
// is refused whatever the page says. The page has the same table (apps/frontend/src/lib/tune/table.ts, with a test that the two agree).
//
// WHERE THE NAMES AND LIMITS COME FROM: ArduPilot's own source, `@Param` and `@Range` of each. A value above the greatest of the `@Range` is
// refused (always), and so is a negative one (no parameter here is meant to be negative). A value below the LEAST of the `@Range` is refused
// while the vehicle is ARMED (a rate gain of 0 leaves a vehicle that cannot be flown, and nobody can take that back in the air), and disarmed
// it is only warned about by the page, and written. The names are those of ArduPilot master (libraries/AC_AttitudeControl/
// AC_AttitudeControl.cpp, AC_AttitudeControl_Multi.cpp, AC_PosControl.cpp, ArduCopter/Parameters.cpp) and of the arducopter that CI's
// SITL runs (the group names are in its binary): both have the same names. A firmware that names a parameter differently has no such
// parameter in this table, and the page then shows no slider for it. Nothing here is a wildcard.
import { CommunicatorError } from "pico-desktop/communicator"

/// One parameter of the list: its name, the least ArduPilot's own `@Range` gives it (a value below it is refused while the vehicle is ARMED), the
/// most (a value above it is refused always), and whether a change takes effect while the vehicle is armed (`armedOk`): a parameter that the
/// firmware reads only when it starts (`@RebootRequired`, or what its start-up code allocates by) is written only while DISARMED, because
/// an armed write would change nothing in flight and leave a value that is not what the vehicle runs.
export struct Tunable {
  id: string
  min: f64
  max: f64
  armedOk: bool
}

/// The list, in the order of the Tune screen's groups: rate, attitude, pilot feel, position, radio knob.
export const TUNABLE: Tunable[] = [
  Tunable { id: "ATC_RAT_RLL_P", min: 0.01, max: 0.5, armedOk: true },
  Tunable { id: "ATC_RAT_RLL_I", min: 0.01, max: 2.0, armedOk: true },
  Tunable { id: "ATC_RAT_RLL_D", min: 0.0, max: 0.05, armedOk: true },
  Tunable { id: "ATC_RAT_RLL_FF", min: 0.0, max: 0.5, armedOk: true },
  Tunable { id: "ATC_RAT_PIT_P", min: 0.01, max: 0.5, armedOk: true },
  Tunable { id: "ATC_RAT_PIT_I", min: 0.01, max: 2.0, armedOk: true },
  Tunable { id: "ATC_RAT_PIT_D", min: 0.0, max: 0.05, armedOk: true },
  Tunable { id: "ATC_RAT_PIT_FF", min: 0.0, max: 0.5, armedOk: true },
  Tunable { id: "ATC_RAT_YAW_P", min: 0.1, max: 2.5, armedOk: true },
  Tunable { id: "ATC_RAT_YAW_I", min: 0.01, max: 1.0, armedOk: true },
  Tunable { id: "ATC_RAT_YAW_D", min: 0.0, max: 0.02, armedOk: true },
  Tunable { id: "ATC_RAT_YAW_FF", min: 0.0, max: 0.5, armedOk: true },
  Tunable { id: "ATC_ANG_RLL_P", min: 3.0, max: 12.0, armedOk: true },
  Tunable { id: "ATC_ANG_PIT_P", min: 3.0, max: 12.0, armedOk: true },
  Tunable { id: "ATC_ANG_YAW_P", min: 3.0, max: 12.0, armedOk: true },
  Tunable { id: "ATC_INPUT_TC", min: 0.0, max: 1.0, armedOk: true },
  Tunable { id: "ATC_ACC_R_MAX", min: 0.0, max: 1800.0, armedOk: true },
  Tunable { id: "ATC_ACC_P_MAX", min: 0.0, max: 1800.0, armedOk: true },
  Tunable { id: "ATC_ACC_Y_MAX", min: 0.0, max: 720.0, armedOk: true },
  Tunable { id: "ATC_RATE_R_MAX", min: 0.0, max: 1080.0, armedOk: true },
  Tunable { id: "ATC_RATE_P_MAX", min: 0.0, max: 1080.0, armedOk: true },
  Tunable { id: "ATC_RATE_Y_MAX", min: 0.0, max: 1080.0, armedOk: true },
  Tunable { id: "PSC_NE_POS_P", min: 0.5, max: 4.0, armedOk: true },
  Tunable { id: "PSC_D_POS_P", min: 0.5, max: 4.0, armedOk: true },
  Tunable { id: "PSC_NE_VEL_P", min: 0.1, max: 10.0, armedOk: true },
  Tunable { id: "PSC_NE_VEL_I", min: 0.1, max: 10.0, armedOk: true },
  Tunable { id: "PSC_NE_VEL_D", min: 0.0, max: 1.0, armedOk: true },
  Tunable { id: "PSC_D_VEL_P", min: 1.0, max: 10.0, armedOk: true },
  Tunable { id: "PSC_D_ACC_P", min: 0.01, max: 0.25, armedOk: true },
  Tunable { id: "PSC_D_ACC_I", min: 0.0, max: 0.5, armedOk: true },
  Tunable { id: "TUNE", min: 0.0, max: 61.0, armedOk: true },
  // The hover throttle and AutoTune (ArduCopter's names: the motors' `MOT_` group, AP_MotorsMulticopter.cpp, and the `AUTOTUNE_`
  // group, AC_AutoTune_Multi.cpp), written in flight because AutoTune needs them there: THST_HOVER (@Range 0.125 0.6875) is
  // what a hover takes and is learned in flight, HOVER_LEARN (@Values 0 disabled, 1 learn, 2 learn and save), and AutoTune's
  // axes (@Bitmask: roll, pitch, yaw, yaw D: 0 to 15, set before AutoTune is engaged), aggressiveness (@Range 0.05 0.10), minimum
  // D (0.0001 0.005) and gain back-off (0 0.5). None is `@RebootRequired`: each is read when it is used.
  Tunable { id: "MOT_THST_HOVER", min: 0.125, max: 0.6875, armedOk: true },
  Tunable { id: "MOT_HOVER_LEARN", min: 0.0, max: 2.0, armedOk: true },
  Tunable { id: "AUTOTUNE_AXES", min: 0.0, max: 15.0, armedOk: true },
  Tunable { id: "AUTOTUNE_AGGR", min: 0.05, max: 0.1, armedOk: true },
  Tunable { id: "AUTOTUNE_MIN_D", min: 0.0001, max: 0.005, armedOk: true },
  Tunable { id: "AUTOTUNE_GMBK", min: 0.0, max: 0.5, armedOk: true },
  // The filters (the Tune screen's Filters part), from AP_InertialSensor.cpp (INS_GYRO_FILTER, @Range 0 256 Hz) and
  // libraries/Filter/HarmonicNotchFilter.cpp (the first harmonic notch, INS_HNTCH_*, of ArduPilot master, 4.8.0-dev). Taken effect live
  // (`armedOk`): the gyro filter, and the notch's centre, bandwidth and attenuation (the notch is rebuilt in flight when they change). Read
  // only at start-up, so written disarmed only: ENABLE (the notch is allocated at start only when it is enabled), MODE and OPTS (the
  // tracking sources and the number of notches are set up at start; OPTS is also `@RebootRequired`), HMNCS and REF (`@RebootRequired`).
  // The gyro filter's armed least is 10 Hz here, not the `@Range`'s 0: ArduPilot says of 0 "no filtering (not recommended!)", and a
  // cutoff of 1 to 10 Hz leaves a vehicle that cannot be flown (as a rate gain of 0 does; ArduPilot's guidance is 20 to 80 Hz). Disarmed
  // it is only warned about.
  Tunable { id: "INS_GYRO_FILTER", min: 10.0, max: 256.0, armedOk: true },
  Tunable { id: "INS_HNTCH_ENABLE", min: 0.0, max: 1.0, armedOk: false },
  Tunable { id: "INS_HNTCH_MODE", min: 0.0, max: 5.0, armedOk: false },
  Tunable { id: "INS_HNTCH_REF", min: 0.0, max: 1.0, armedOk: false },
  Tunable { id: "INS_HNTCH_FREQ", min: 10.0, max: 495.0, armedOk: true },
  Tunable { id: "INS_HNTCH_BW", min: 5.0, max: 250.0, armedOk: true },
  Tunable { id: "INS_HNTCH_ATT", min: 5.0, max: 50.0, armedOk: true },
  Tunable { id: "INS_HNTCH_HMNCS", min: 0.0, max: 65535.0, armedOk: false },
  Tunable { id: "INS_HNTCH_OPTS", min: 0.0, max: 127.0, armedOk: false },
]

/// The entry of a name, or null when it is not in the list.
function entryOf(id: string): Tunable? {
  for (const t of TUNABLE) {
    if (t.id == id) {
      return t
    }
  }
  return null
}

/// Refuses a tuning write whose name is not in the list (`NOT_TUNING`), whose value is outside its limits (`OUT_OF_LIMITS`), or that changes a
/// parameter the vehicle reads only when it starts while it is ARMED (`NEEDS_REBOOT`): negative, not a number,
/// above the most ArduPilot's table allows, and, while the vehicle is ARMED, below the least it allows (a gain of 0 in the rate loop leaves a vehicle
/// that cannot be flown, and a pilot cannot take it back from the ground: disarmed the same value is only warned about, by the page). Nothing is
/// sent to the vehicle for a refused write.
export function refuseUntunable(id: string, value: f64, armed: bool): void throws CommunicatorError {
  const t = entryOf(id)
  if (t == null) {
    throw new CommunicatorError("NOT_TUNING", `${id} is not a parameter the Tune screen may write`)
  }
  // (written so that NaN is outside)
  if (!(value >= 0.0 && value <= t!.max)) {
    throw new CommunicatorError("OUT_OF_LIMITS", `${id} is 0 to ${t!.max}, not ${value}`)
  }
  if (armed && value < t!.min) {
    throw new CommunicatorError("OUT_OF_LIMITS", `${id} may not be below ${t!.min} while the vehicle is armed, and ${value} is`)
  }
  if (armed && !t!.armedOk) {
    throw new CommunicatorError("NEEDS_REBOOT", `${id} needs a reboot to take effect: it is written while the vehicle is disarmed`)
  }
}
