// The backend: the vehicle link (padcom/pico-mavlink) behind the contract's methods and
// subscriptions. Pico has no async closures yet, so handlers are named async functions over one
// module-level `Link`.
import { Cbor, Communicator, CommunicatorError, RequestContext, Sink, Transport } from "pico-desktop/communicator"
import { delay } from "std/timers"
import {
  Attitude,
  CommandCall,
  CopterMode,
  PlaneMode,
  RoverMode,
  SubMode,
  AutopilotVersionRead,
  ByteStream,
  Heartbeat,
  HeartbeatSender,
  MavAutopilot,
  MavLinkConnection,
  MavLinkError,
  MavModeFlag,
  MavParamType,
  MavType,
  ParamEncoding,
  ParamError,
  ParamList as ParamListOp,
  ParamWrite as ParamWriteOp,
  Received,
  SimulatedAutopilot,
  SysStatus,
  TypedParamValue,
  Vehicle,
  ParamListResult,
  ParamValue,
  VehicleDiscovery,
  decodeParam,
  encodingOf,
} from "padcom/pico-mavlink"
import {
  Connection,
  ConnectionState,
  Param,
  ParamKind,
  ParamList,
  ParamWriteKind,
  ParamWriteResult,
  Telemetry,
  VehicleInfo,
  decodeConnectRequest,
  decodeParamWrite,
  encodeConnection,
  encodeParam,
  encodeParamList,
  encodeParamWriteResult,
  encodeTelemetry,
} from "./generated/app"
import { register as registerFiles } from "./files"
import { register as registerSerial } from "./serial"
import { describe, open } from "./transports"

/// For tests: the simulated vehicle of a "simulator" connection.
export function simulatorForTests(): SimulatedAutopilot? {
  link.sim
}

/// For tests: a shorter wait for the autopilot's heartbeat than 3 s.
export function setHeartbeatWait(ms: int): void {
  link.heartbeatWaitMs = ms
}

/// The flight mode's name: ArduPilot's mode tables (ardupilotmega's COPTER_MODE, PLANE_MODE,
/// ROVER_MODE, SUB_MODE), chosen by the vehicle type; `mode N` otherwise.
function modeName(autopilot: int, type: int, customMode: int): string {
  if (autopilot != MavAutopilot.ARDUPILOTMEGA) {
    return `mode ${customMode}`
  }
  const plane = type == MavType.FIXED_WING || (type >= MavType.VTOL_TAILSITTER_DUOROTOR && type <= MavType.VTOL_TILTWING)
  const rover = type == MavType.GROUND_ROVER || type == MavType.SURFACE_BOAT
  const name = if (plane) PlaneMode.nameOf(customMode)
    else if (rover) RoverMode.nameOf(customMode)
    else if (type == MavType.SUBMARINE) SubMode.nameOf(customMode)
    else CopterMode.nameOf(customMode)
  name ?? `mode ${customMode}`
}

/// The vehicle link and what it last heard.
class Link {
  public conn: MavLinkConnection? = null
  public sim: SimulatedAutopilot? = null
  public beats: HeartbeatSender? = null
  public discovery: VehicleDiscovery? = null
  public state: Connection = Connection { state: ConnectionState.Disconnected }
  /// Bumped on every connect and disconnect: a link's late news about an older link is ignored.
  public generation: int = 0
  public sysid: int = 0
  public compid: int = 0
  public autopilot: int = 0
  public encoding: ParamEncoding = ParamEncoding.CCast
  public watchers: Sink[] = []
  /// What the vehicle has reported since connecting (telemetry shows only that).
  public heardHeartbeat: bool = false
  public heardStatus: bool = false
  public heardAttitude: bool = false
  public armed: bool = false
  public mode: string = "unknown"
  public voltage: f64 = 0.0
  public remaining: int = -1
  public roll: f64 = 0.0
  public pitch: f64 = 0.0
  public yaw: f64 = 0.0
  public lastHeartbeat: int = 0
  /// How long `vehicle.connect` waits for an autopilot's heartbeat.
  public heartbeatWaitMs: int = 3000
  /// Aborted when the session ends: operations still running stop at once.
  public session: AbortController = new AbortController()
  public communicator: Communicator? = null
  /// While a list download runs, PARAM_VALUEs are its answers, not news.
  public listing: bool = false

  public update(c: Connection): void {
    state = c
    for (const w of watchers) {
      w.next(encodeConnection(c))
    }
  }

  public close(): void {
    generation += 1
    session.abort()
    session = new AbortController()
    heardHeartbeat = false
    heardStatus = false
    heardAttitude = false
    const b = beats
    if (b != null) {
      b!.stop()
    }
    const d = discovery
    if (d != null) {
      d!.stop()
    }
    const c = conn
    if (c != null) {
      c!.close()
    }
    const s = sim
    if (s != null) {
      s!.stop()
    }
    beats = null
    discovery = null
    conn = null
    sim = null
    sysid = 0
  }

  /// Telemetry from the connected vehicle.
  public seen(r: Received): void {
    if (sysid == 0 || r.packet.header.sysid != sysid || r.packet.header.compid != compid) {
      return
    }
    const m = r.message
    if (m instanceof Heartbeat) {
      armed = ((m.baseMode as int) & MavModeFlag.SAFETY_ARMED) != 0
      mode = modeName(m.autopilot as int, m.type as int, m.customMode as int)
      lastHeartbeat = Date.now() as int
      heardHeartbeat = true
    } else if (m instanceof SysStatus) {
      // UINT16_MAX: the vehicle doesn't know its voltage.
      if (m.voltageBattery as int != 65535) {
        voltage = (m.voltageBattery as f64) / 1000.0
        heardStatus = true
      }
      remaining = m.batteryRemaining as int
    } else if (m instanceof ParamValue) {
      // A parameter the vehicle announced on its own: tell the dashboard.
      const c = communicator
      if (!listing && c != null) {
        const p = toParam(m.paramId, m.paramIndex as int, decodeParam(m.paramValue, m.paramType as int, encoding))
        c!.emit("params.changed", encodeParam(p))
      }
      return
    } else if (m instanceof Attitude) {
      roll = (m.roll as f64) * 180.0 / Math.PI
      pitch = (m.pitch as f64) * 180.0 / Math.PI
      yaw = (m.yaw as f64) * 180.0 / Math.PI
      heardAttitude = true
    }
  }

  public telemetry(): Telemetry {
    const t = Telemetry { armed: armed, mode: mode, heartbeatAgeMs: ((Date.now() as int) - lastHeartbeat) as u32 }
    if (heardStatus) {
      t.batteryVoltage = Math.round(voltage * 100.0) / 100.0
      if (remaining >= 0 && remaining <= 100) {
        t.batteryRemaining = remaining as u8
      }
    }
    if (heardAttitude) {
      t.roll = Math.round(roll * 10.0) / 10.0
      t.pitch = Math.round(pitch * 10.0) / 10.0
      t.yaw = Math.round(yaw)
    }
    t
  }
}

const link = new Link()

/// The backend on `transport` (the app runs it on stdio; tests on a memory link).
export function createBackend(transport: Transport): Communicator {
  const c = new Communicator(transport)
  link.communicator = c
  // The app is closing: end the vehicle session (heartbeats, the link and its reads, operations in
  // flight), so nothing keeps this process alive past the host's grace period.
  c.onClosing = () => link.close()
  c.handle("vehicle.connect", connectVehicle)
  c.handle("vehicle.disconnect", disconnectVehicle)
  c.publish("vehicle.connection", watchConnection)
  c.handle("params.list", listParams)
  c.handle("params.write", writeParam)
  c.publish("telemetry.stream", streamTelemetry)
  registerFiles(c)
  registerSerial(c)
  c
}

/// The first autopilot (not a ground station) heard, if any.
function autopilotSeen(d: VehicleDiscovery): Vehicle? {
  for (const v of d.vehicles()) {
    if (v.type != MavType.GCS && v.autopilot != MavAutopilot.INVALID) {
      return v
    }
  }
  null
}

/// Asks the vehicle for the telemetry the dashboard shows: SYS_STATUS once a second, ATTITUDE four
/// times (ArduPilot streams them only when asked, over some links). A refusal leaves them absent.
async function requestTelemetry(conn: MavLinkConnection, sysid: int, compid: int): Promise<void> {
  const calls = new CommandCall(conn, { system: sysid, component: compid }, { timeoutMs: 500, retries: 1, signal: link.session.signal })
  try {
    await calls.setMessageInterval(SysStatus.MSG_ID, 1_000_000)
    await calls.setMessageInterval(Attitude.MSG_ID, 250_000)
  } catch (e: Error) {
    // Not every autopilot supports it; telemetry then shows what arrives anyway.
  }
}

/// Receives until the link ends; then, if it's still the current one, it's lost.
async function watchLink(conn: MavLinkConnection, generation: int): Promise<void> {
  try {
    await conn.run()
  } catch (e: Error) {
    // A failed read ends the link like a closed one.
  }
  if (link.generation == generation && link.state.state == ConnectionState.Connected) {
    link.update(Connection { state: ConnectionState.Lost, vehicle: link.state.vehicle, error: "the link closed" })
  }
}

async function connectVehicle(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const request = decodeConnectRequest(payload ?? Cbor.Null, "$")
  link.close()
  const generation = link.generation
  link.update(Connection { state: ConnectionState.Connecting })
  let stream: ByteStream? = null
  try {
    stream = await open(request, (sim: SimulatedAutopilot) => { link.sim = sim })
  } catch (e: Error) {
    link.update(Connection { state: ConnectionState.Disconnected, error: `can't open ${describe(request)}: ${e.message}` })
    return encodeConnection(link.state)
  }
  const conn = new MavLinkConnection(stream!)
  link.conn = conn
  const discovery = new VehicleDiscovery(conn)
  link.discovery = discovery
  conn.on((r: Received) => link.seen(r))
  watchLink(conn, generation)
  const beats = new HeartbeatSender(conn)
  beats.start()
  link.beats = beats
  let waited = 0
  while (waited <= link.heartbeatWaitMs) {
    if (link.generation != generation) {
      return encodeConnection(link.state)
    }
    const v = autopilotSeen(discovery)
    if (v != null) {
      const found = v!
      link.sysid = found.sysid
      link.compid = found.compid
      link.autopilot = found.autopilot
      // How integers travel in parameter floats: as the autopilot says (AUTOPILOT_VERSION), or as
      // its kind usually does (PX4 bytewise; ArduPilot and most others C-cast).
      const guess = if (found.autopilot == MavAutopilot.PX4) ParamEncoding.Bytewise else ParamEncoding.CCast
      const version = await new AutopilotVersionRead(conn, { system: found.sysid, component: found.compid }, { timeoutMs: 500, retries: 1 }).run()
      link.encoding = if (version == null) guess else encodingOf(version!.capabilities) ?? guess
      const info = VehicleInfo {
        sysid: found.sysid as u8,
        compid: found.compid as u8,
        type: MavType.nameOf(found.type) ?? `${found.type}`,
        autopilot: MavAutopilot.nameOf(found.autopilot) ?? `${found.autopilot}`,
      }
      link.update(Connection { state: ConnectionState.Connected, vehicle: info })
      requestTelemetry(conn, found.sysid, found.compid)
      return encodeConnection(link.state)
    }
    await delay(50)
    waited += 50
  }
  link.close()
  link.update(Connection { state: ConnectionState.Disconnected, error: `no heartbeat from ${describe(request)}` })
  encodeConnection(link.state)
}

async function disconnectVehicle(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  link.close()
  link.update(Connection { state: ConnectionState.Disconnected })
  encodeConnection(link.state)
}

function watchConnection(_params: Cbor?, sink: Sink): void throws Error {
  sink.next(encodeConnection(link.state))
  link.watchers.push(sink)
  sink.onClose = () => {
    link.watchers = link.watchers.filter((w: Sink) => w.id != sink.id)
  }
}

function connectedLink(): MavLinkConnection throws CommunicatorError {
  const c = link.conn
  if (c == null || link.state.state != ConnectionState.Connected) {
    throw new CommunicatorError("NOT_CONNECTED", "no vehicle is connected")
  }
  c!
}

function typeName(type: int): string {
  MavParamType.nameOf(type) ?? `${type}`
}

function typeValue(name: string): int? {
  for (let t = 1; t <= 10; t++) {
    if (MavParamType.nameOf(t) == name) {
      return t
    }
  }
  null
}

function toParam(id: string, index: int, v: TypedParamValue): Param {
  match (v) {
    Int { value, type } => Param { id: id, index: index as u16, kind: ParamKind.Int, type: typeName(type), value: value as f64 },
    Real { value, type } => Param { id: id, index: index as u16, kind: ParamKind.Real, type: typeName(type), value: (value as f32) as f64 },
  }
}

async function listParams(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const conn = connectedLink()
  let r: ParamListResult? = null
  link.listing = true
  try {
    r = await new ParamListOp(conn, { system: link.sysid, component: link.compid }, link.encoding, { signal: link.session.signal }).run()
  } catch (e: MavLinkError) {
    link.listing = false
    throw new CommunicatorError(e.code, e.message)
  }
  link.listing = false
  const list = r!
  const out = ParamList {
    params: list.params.map((p) => toParam(p.id, p.index, p.value)),
    count: list.count as u16,
    complete: list.complete,
    missing: list.missing.map((i: int) => i as u16),
  }
  encodeParamList(out)
}

async function writeParam(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const w = decodeParamWrite(payload ?? Cbor.Null, "$")
  const conn = connectedLink()
  const type = typeValue(w.type)
  if (type == null) {
    throw new CommunicatorError("INVALID_VALUE", `unknown parameter type ${w.type}`)
  }
  let value: TypedParamValue = TypedParamValue.Real(w.value, type!)
  if (w.kind == ParamWriteKind.Int) {
    if (Math.floor(w.value) != w.value || Math.abs(w.value) > 4294967295.0) {
      throw new CommunicatorError("INVALID_VALUE", `${w.id} is an integer; ${w.value} isn't`)
    }
    value = TypedParamValue.Int(w.value as int, type!)
  }
  try {
    const r = await new ParamWriteOp(conn, { system: link.sysid, component: link.compid }, link.encoding, { signal: link.session.signal }).run(w.id, value)
    encodeParamWriteResult(ParamWriteResult { param: toParam(r.param.id, r.param.index, r.param.value), verified: r.verified })
  } catch (e: MavLinkError) {
    throw new CommunicatorError(e.code, e.message)
  } catch (e: ParamError) {
    throw new CommunicatorError(e.code, e.message)
  }
}

function streamTelemetry(_params: Cbor?, sink: Sink): void throws Error {
  const timer = setInterval(() => {
    if (link.state.state == ConnectionState.Connected && link.heardHeartbeat) {
      sink.next(encodeTelemetry(link.telemetry()))
    }
  }, 1000)
  sink.onClose = () => clearInterval(timer)
}
