// The backend: the vehicle link (padcom/pico-mavlink) behind the contract's methods and
// subscriptions, one module per service over the one session (session.pi). Pico has no async
// closures yet, so handlers are named async functions.
import { Communicator, Transport } from "pico-desktop/communicator"
import { SimulatedAutopilot } from "padcom/pico-mavlink"
import { register as registerCalibration } from "./calibration"
import { register as registerConnection } from "./connection"
import { register as registerFiles } from "./files"
import { register as registerLogs } from "./logs"
import { register as registerLogHousekeeping } from "./loghousekeeping"
import { register as registerLocalImport } from "./localimport"
import { register as registerLocalLogs } from "./locallogs"
import { register as registerLocalExport } from "./localexport"
import { register as registerLocalMessages } from "./localmessages"
import { register as registerLocalReview } from "./localreview"
import { register as registerLocalSpectrum } from "./localspectrum"
import { register as registerLocalSeries } from "./localseries"
import { register as registerMessages } from "./messages"
import { register as registerMotors } from "./motors"
import { register as registerParams } from "./params"
import { register as registerReboot } from "./reboot"
import { register as registerSerial } from "./serial"
import { link } from "./session"
import { register as registerSettings } from "./settings"
import { register as registerTelemetry } from "./telemetry"
import { register as registerVehicleInfo } from "./vehicleinfo"

/// For tests: the simulated vehicle of a "simulator" connection.
export function simulatorForTests(): SimulatedAutopilot? {
  link.sim
}

/// For tests: the simulated vehicles of the connections that follow have file transfer or have not.
export function setSimulatorFtpForTests(on: bool): void {
  link.simulatorFtp = on
}

/// For tests: the simulated vehicles of the connections that follow answer AUTOPILOT_VERSION or do not.
export function setSimulatorVersionForTests(on: bool): void {
  link.simulatorVersion = on
}

/// For tests: a shorter wait for the autopilot's heartbeat than 3 s.
export function setHeartbeatWait(ms: int): void {
  link.heartbeatWaitMs = ms
}

/// The backend on `transport` (the app runs it on stdio; tests on a memory link).
export function createBackend(transport: Transport): Communicator {
  const c = new Communicator(transport)
  // The app is closing: end the vehicle session (heartbeats, the link and its reads, operations in
  // flight), so nothing keeps this process alive past the host's grace period.
  c.onClosing = () => link.close()
  registerConnection(c)
  registerParams(c)
  registerReboot(c)
  registerCalibration(c)
  registerMotors(c)
  registerLogs(c)
  registerLogHousekeeping(c)
  registerLocalLogs(c)
  registerLocalSeries(c)
  registerLocalReview(c)
  registerLocalMessages(c)
  registerLocalExport(c)
  registerLocalImport(c)
  registerLocalSpectrum(c)
  registerTelemetry(c)
  registerVehicleInfo(c)
  registerMessages(c)
  registerFiles(c)
  registerSerial(c)
  registerSettings(c)
  c
}
