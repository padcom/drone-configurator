// The rudder guard's pure functions: the tables of what is landed and what may lift the hold, and the golden vectors the page's
// `safety.ts` / `armed.ts` are held to as well (`packages/contracts/rudder-vectors.txt`).
import { describe, it, expect } from "std/test"
import { readText } from "std/fs"
import { NO_OVERRIDE } from "padcom/pico-mavlink"
import { gestureAllowed, holdYaw, isLow, landedOf, yawHeld, yawToSend } from "./rudder"

function landedIsStandbyOnAFreshHeartbeat(): void {
  expect(landedOf(3, 0)).toBe(true)
  expect(landedOf(3, 3000)).toBe(true)
  // ACTIVE (flying), CRITICAL (a failsafe), BOOT, UNINIT, EMERGENCY, an unknown value: not landed
  for (const status of [0, 1, 2, 4, 5, 6, 7, 8, 99, -1]) {
    expect(landedOf(status, 100)).toBe(false)
  }
  // a heartbeat that is stale, or never was
  expect(landedOf(3, 3001)).toBe(false)
  expect(landedOf(3, -1)).toBe(false)
}

function theGestureIsAllowedWhenDisarmedOrArmedAndLanded(): void {
  expect(gestureAllowed(false, false)).toBe(true)
  expect(gestureAllowed(false, true)).toBe(true)
  expect(gestureAllowed(true, true)).toBe(true)
  expect(gestureAllowed(true, false)).toBe(false)
  expect(gestureAllowed(null, true)).toBe(false)
  expect(gestureAllowed(null, false)).toBe(false)
}

function theHoldIsLiftedOnlyByTheOptionAndAnAllowedGesture(): void {
  expect(yawHeld(false, false, true)).toBe(true)
  expect(yawHeld(false, true, true)).toBe(true)
  expect(yawHeld(true, false, false)).toBe(false)
  expect(yawHeld(true, true, true)).toBe(false)
  expect(yawHeld(true, true, false)).toBe(true)
  expect(yawHeld(true, null, true)).toBe(true)
}

function lowIsTheBottomTenthOrTwiceTheDeadZone(): void {
  expect(isLow(1180, 1100, 1900, 0)).toBe(true)
  expect(isLow(1181, 1100, 1900, 0)).toBe(false)
  expect(isLow(1260, 1100, 1900, 80)).toBe(true)
  expect(isLow(1261, 1100, 1900, 80)).toBe(false)
  expect(isLow(NO_OVERRIDE, 1100, 1900, 0)).toBe(true)
}

function theYawIsHeldToEightTenthsOfItsHalfTravel(): void {
  expect(holdYaw(1900, 1100, 1500, 1900)).toBe(1820)
  expect(holdYaw(1100, 1100, 1500, 1900)).toBe(1180)
  expect(holdYaw(1820, 1100, 1500, 1900)).toBe(1820)
  expect(holdYaw(1700, 1100, 1500, 1900)).toBe(1700)
  expect(holdYaw(NO_OVERRIDE, 1100, 1500, 1900)).toBe(NO_OVERRIDE)
  // a trim that is not in the middle: each side has its own travel
  expect(holdYaw(1900, 1000, 1400, 1900)).toBe(1800)
  expect(holdYaw(1000, 1000, 1400, 1900)).toBe(1080)
  // without the hold, or with the throttle up, it is as it is
  expect(yawToSend(false, 1100, 1900, 1100, 1900, 0, 1100, 1500, 1900)).toBe(1900)
  expect(yawToSend(true, 1500, 1900, 1100, 1900, 0, 1100, 1500, 1900)).toBe(1900)
  expect(yawToSend(true, 1100, 1900, 1100, 1900, 0, 1100, 1500, 1900)).toBe(1820)
}

/// A pulse as the vectors write it (`own` is the radio's own).
function pulseOf(text: string): int {
  return if (text == "own") NO_OVERRIDE else parseInt(text)
}

/// The yaw a vector's inputs give, through the same functions the backend uses.
function yawOf(fields: string[]): int {
  const armed: bool? = if (fields[2] == "true") true else if (fields[2] == "false") false else null
  const hold = yawHeld(fields[1] == "on", armed, landedOf(parseInt(fields[3]), parseInt(fields[4])))
  return yawToSend(hold, pulseOf(fields[5]), parseInt(fields[6]), 1100, 1900, 0, 1100, 1500, 1900)
}

async function everyGoldenVectorGivesItsYaw(): Promise<void> throws Error {
  const text = await readText("packages/contracts/rudder-vectors.txt")
  let count = 0
  const wrong: string[] = []
  for (const line of text.split("\n")) {
    if (line.trim().length > 0 && !line.startsWith("#")) {
      const parts = line.split("|").map((p: string) => p.trim())
      const got = yawOf(parts)
      if (got != parseInt(parts[7])) {
        wrong.push(`${parts[0]}: ${got} is not ${parts[7]}`)
      }
      count += 1
    }
  }
  expect(wrong.join("; ")).toBe("")
  expect(count >= 20).toBe(true)
}

describe("the rudder guard", () => {
  it("knows landed from a fresh heartbeat that says STANDBY, and nothing else", landedIsStandbyOnAFreshHeartbeat)
  it("allows the gesture when the vehicle is disarmed, or armed and landed", theGestureIsAllowedWhenDisarmedOrArmedAndLanded)
  it("lifts the hold only for the option and an allowed gesture", theHoldIsLiftedOnlyByTheOptionAndAnAllowedGesture)
  it("calls the throttle low in the bottom tenth, or twice the dead zone", lowIsTheBottomTenthOrTwiceTheDeadZone)
  it("holds the yaw to eight tenths of its half travel", theYawIsHeldToEightTenthsOfItsHalfTravel)
  it("gives the yaw of every golden vector (the page is held to the same)", everyGoldenVectorGivesItsYaw)
})
