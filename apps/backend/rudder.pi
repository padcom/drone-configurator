// The rudder guard of the RC control, as pure functions (the page has the same ones in `lib/rc/safety.ts` and `lib/app/armed.ts`, and both
// are held to the golden vectors of `packages/contracts/rudder-vectors.txt`).
//
// The vehicle arms on a yaw held at the right end for 3 s and disarms on a yaw held at the left end for 3 s (`ARMING_RUDDER`), with
// the throttle at the bottom: so while the throttle is low the yaw is never sent beyond 0.8 of its half travel (the vehicle's gesture is
// at 0.889). The person's option "let the sticks arm and disarm" lifts that hold ONLY while the vehicle is known to be disarmed (the arm
// gesture) or known to be armed AND landed (the disarm gesture on the ground). ArduCopter lets a rudder disarm happen IN THE AIR in the
// manual-throttle modes (Stabilize, Acro, SystemID, Turtle), so "armed" alone is never a reason to lift it.
import { NO_OVERRIDE } from "padcom/pico-mavlink"

/// MAV_STATE_STANDBY: what ArduCopter's heartbeat says exactly when it has `land_complete` and no failsafe is active (`ACTIVE` in the
/// air, `CRITICAL` while a failsafe is, `BOOT` while it starts).
export const STATUS_STANDBY: int = 3

/// How old the heartbeat may be (ms) for what it says to be known.
export const HEARTBEAT_FRESH_MS: int = 3000

/// The yaw is never sent further from its middle than this part of its half range (in percent) while the throttle is low.
export const RUDDER_LIMIT_PERCENT: int = 80

/// The throttle is low within this part of its range (in percent) of the minimum, or twice its dead zone, whichever is more.
export const LOW_PERCENT: int = 10

/// Whether the vehicle is landed: its last heartbeat is fresh and says STANDBY. Anything else (a stale or no heartbeat, ACTIVE, CRITICAL,
/// BOOT, a status that is not known) is "not landed".
export function landedOf(status: int, ageMs: int): bool {
  return status == STATUS_STANDBY && ageMs >= 0 && ageMs <= HEARTBEAT_FRESH_MS
}

/// Whether the sticks may make the vehicle's arm or disarm gesture: it is known disarmed, or known armed and landed. `armed` is null when
/// it is not known (which counts as armed in the air).
export function gestureAllowed(armed: bool?, landed: bool): bool {
  if (armed == null) {
    return false
  }
  return !armed! || landed
}

/// Whether the yaw hold applies: always, unless the person's option is on AND the gesture is allowed.
export function yawHeld(option: bool, armed: bool?, landed: bool): bool {
  return !(option && gestureAllowed(armed, landed))
}

/// Whether a throttle pulse is at the low end of its range (the radio's own, `NO_OVERRIDE`, is low: a vehicle with no receiver reads it
/// as the minimum). `zone` is the throttle's dead zone (`RCn_DZ`): "low" is at least twice as wide as it, so that a stick the vehicle
/// still reads as the minimum is low.
export function isLow(pulse: int, min: int, max: int, zone: int): bool {
  if (pulse == NO_OVERRIDE) {
    return true
  }
  const plain = ((max - min) as f64) * (LOW_PERCENT as f64) / 100.0
  const twice = (2 * zone) as f64
  const reach = if (plain > twice) plain else twice
  return (pulse as f64) <= (min as f64) + reach
}

/// A yaw pulse held back from the end of its travel: itself when it is within `RUDDER_LIMIT_PERCENT` of its half range from the trim,
/// else that limit on its side. `yaw` is `NO_OVERRIDE` (the radio's own) for itself.
export function holdYaw(yaw: int, min: int, trim: int, max: int): int {
  if (yaw == NO_OVERRIDE) {
    return yaw
  }
  const half = if (yaw >= trim) max - trim else trim - min
  const reach = if (yaw >= trim) yaw - trim else trim - yaw
  const limit = (half as f64) * (RUDDER_LIMIT_PERCENT as f64) / 100.0
  if ((reach as f64) <= limit) {
    return yaw
  }
  const held = Math.round(limit) as int
  return if (yaw >= trim) trim + held else trim - held
}

/// The yaw the vehicle is sent: held back when the hold applies and the throttle is low, else as it is.
export function yawToSend(hold: bool, throttle: int, yaw: int, throttleMin: int, throttleMax: int, zone: int, yawMin: int, yawTrim: int, yawMax: int): int {
  if (!hold || !isLow(throttle, throttleMin, throttleMax, zone)) {
    return yaw
  }
  return holdYaw(yaw, yawMin, yawTrim, yawMax)
}
