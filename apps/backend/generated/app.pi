export enum ReviewFindingLevel { Ok, Warn, Bad, Info, NoData }

export function decodeReviewFindingLevel(v: Cbor, path: string): ReviewFindingLevel throws InvalidPayload {
  match (text(v, path)) {
    "ok" => ReviewFindingLevel.Ok,
    "warn" => ReviewFindingLevel.Warn,
    "bad" => ReviewFindingLevel.Bad,
    "info" => ReviewFindingLevel.Info,
    "no-data" => ReviewFindingLevel.NoData,
    _ => throw new InvalidPayload(path, "ok or warn or bad or info or no-data"),
  }
}

export function encodeReviewFindingLevel(v: ReviewFindingLevel): Cbor {
  match (v) {
    Ok => Cbor.Text("ok"),
    Warn => Cbor.Text("warn"),
    Bad => Cbor.Text("bad"),
    Info => Cbor.Text("info"),
    NoData => Cbor.Text("no-data"),
  }
}

