    percent: (uint(required(m, "percent", path), `${path}.percent`, 255) as u8),
    attempt: (uint(required(m, "attempt", path), `${path}.attempt`, 255) as u8),
    mask: decodeCalibrationCompassMaskList(required(m, "mask", path), `${path}.mask`),
    report: opt5,
