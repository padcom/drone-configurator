export struct LocalLogSpectrum {
  sensor: BatchSensor
  instance: u8
  rateHz: f64
  size: u16
  resolutionHz: f64
  unit: string
  batches: u32
  skipped: u32
  axes: SpectrumAxis[]
  columns: u16
  columnHz: f64
  samples: u16
  rowBatches: u32
  unrowed: u32
  rows: SpectrumRow[]
  silent: bool
  peak?: SpectrumPeak
}

export function decodeLocalLogSpectrum(v: Cbor, path: string): LocalLogSpectrum throws InvalidPayload {
  const m = members(v, path, ["sensor", "instance", "rateHz", "size", "resolutionHz", "unit", "batches", "skipped", "axes", "columns", "columnHz", "samples", "rowBatches", "unrowed", "rows", "silent", "peak"])
  const cbor16 = m.get("peak")
  let opt16: SpectrumPeak? = null
  if (cbor16 != null) {
    opt16 = decodeSpectrumPeak(cbor16, `${path}.peak`)
  }
  return LocalLogSpectrum {
    sensor: decodeBatchSensor(required(m, "sensor", path), `${path}.sensor`),
    instance: (uint(required(m, "instance", path), `${path}.instance`, 255) as u8),
    rateHz: float(required(m, "rateHz", path), `${path}.rateHz`),
    size: (uint(required(m, "size", path), `${path}.size`, 65535) as u16),
    resolutionHz: float(required(m, "resolutionHz", path), `${path}.resolutionHz`),
    unit: text(required(m, "unit", path), `${path}.unit`),
    batches: (uint(required(m, "batches", path), `${path}.batches`, 4294967295) as u32),
    skipped: (uint(required(m, "skipped", path), `${path}.skipped`, 4294967295) as u32),
    axes: decodeLocalLogSpectrumAxesList(required(m, "axes", path), `${path}.axes`),
    columns: (uint(required(m, "columns", path), `${path}.columns`, 65535) as u16),
    columnHz: float(required(m, "columnHz", path), `${path}.columnHz`),
    samples: (uint(required(m, "samples", path), `${path}.samples`, 65535) as u16),
    rowBatches: (uint(required(m, "rowBatches", path), `${path}.rowBatches`, 4294967295) as u32),
    unrowed: (uint(required(m, "unrowed", path), `${path}.unrowed`, 4294967295) as u32),
    rows: decodeLocalLogSpectrumRowsList(required(m, "rows", path), `${path}.rows`),
    silent: boolean(required(m, "silent", path), `${path}.silent`),
    peak: opt16,
  }
}

export function encodeLocalLogSpectrum(v: LocalLogSpectrum): Cbor {
  const m = new Map<string, Cbor>()
  m.set("sensor", encodeBatchSensor(v.sensor))
  m.set("instance", Cbor.Uint(v.instance as u64))
  m.set("rateHz", Cbor.Float(v.rateHz))
  m.set("size", Cbor.Uint(v.size as u64))
  m.set("resolutionHz", Cbor.Float(v.resolutionHz))
  m.set("unit", Cbor.Text(v.unit))
  m.set("batches", Cbor.Uint(v.batches as u64))
  m.set("skipped", Cbor.Uint(v.skipped as u64))
  m.set("axes", encodeLocalLogSpectrumAxesList(v.axes))
  m.set("columns", Cbor.Uint(v.columns as u64))
  m.set("columnHz", Cbor.Float(v.columnHz))
  m.set("samples", Cbor.Uint(v.samples as u64))
  m.set("rowBatches", Cbor.Uint(v.rowBatches as u64))
  m.set("unrowed", Cbor.Uint(v.unrowed as u64))
  m.set("rows", encodeLocalLogSpectrumRowsList(v.rows))
  m.set("silent", Cbor.Bool(v.silent))
  const opt16 = v.peak
  if (opt16 != null) {
    m.set("peak", encodeSpectrumPeak(opt16))
  }
  return Cbor.Dict(m)
}

