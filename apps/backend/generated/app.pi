function decodeSerialPortsPortsList(v: Cbor, path: string): SerialPort[] throws InvalidPayload {
  const out: SerialPort[] = []
  let i = 0
  for (const e of items(v, path)) {
    out.push(decodeSerialPort(e, `${path}[${i}]`))
    i += 1
  }
  out
}

function encodeSerialPortsPortsList(v: SerialPort[]): Cbor {
  const out: Cbor[] = []
  for (const e of v) {
    out.push(encodeSerialPort(e))
  }
  Cbor.List(out)
}

