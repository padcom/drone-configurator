function decodeRcGroupChannelsList(v: Cbor, path: string): u16[] throws InvalidPayload {
  const out: u16[] = []
  let i = 0
  for (const e of items(v, path)) {
    out.push((uint(e, `${path}[${i}]`, 65535) as u16))
    i += 1
  }
  out
}

function encodeRcGroupChannelsList(v: u16[]): Cbor {
  const out: Cbor[] = []
  for (const e of v) {
    out.push(Cbor.Uint(e as u64))
  }
  Cbor.List(out)
}

