export enum TrackEventKind { Armed, Disarmed, Text }

export function decodeTrackEventKind(v: Cbor, path: string): TrackEventKind throws InvalidPayload {
  match (text(v, path)) {
    "armed" => TrackEventKind.Armed,
    "disarmed" => TrackEventKind.Disarmed,
    "text" => TrackEventKind.Text,
    _ => throw new InvalidPayload(path, "armed or disarmed or text"),
  }
}

export function encodeTrackEventKind(v: TrackEventKind): Cbor {
  match (v) {
    Armed => Cbor.Text("armed"),
    Disarmed => Cbor.Text("disarmed"),
