  SerialPorts {
    ports: decodeSerialPortsPortsList(required(m, "ports", path), `${path}.ports`),
  }
}

export function encodeSerialPorts(v: SerialPorts): Cbor {
  const m = new Map<string, Cbor>()
  m.set("ports", encodeSerialPortsPortsList(v.ports))
  Cbor.Dict(m)
}

export struct SerialPort {
  path: string
  description?: string
}

export function decodeSerialPort(v: Cbor, path: string): SerialPort throws InvalidPayload {
  const m = members(v, path, ["path", "description"])
  const cbor1 = m.get("description")
  let opt1: string? = null
  if (cbor1 != null) {
    opt1 = text(cbor1, `${path}.description`)
  }
  SerialPort {
    path: text(required(m, "path", path), `${path}.path`),
    description: opt1,
  }
}

export function encodeSerialPort(v: SerialPort): Cbor {
  const m = new Map<string, Cbor>()
  m.set("path", Cbor.Text(v.path))
  const opt1 = v.description
  if (opt1 != null) {
    m.set("description", Cbor.Text(opt1))
  }
  Cbor.Dict(m)
}
