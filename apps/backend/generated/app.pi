  m.set("ui", encodeSettingsUiList(v.ui))
  Cbor.Dict(m)
}

export enum ThemeName { Light, Dark, System }

export function decodeThemeName(v: Cbor, path: string): ThemeName throws InvalidPayload {
  match (text(v, path)) {
    "light" => ThemeName.Light,
    "dark" => ThemeName.Dark,
    "system" => ThemeName.System,
    _ => throw new InvalidPayload(path, "light or dark or system"),
  }
}

export function encodeThemeName(v: ThemeName): Cbor {
  match (v) {
    Light => Cbor.Text("light"),
    Dark => Cbor.Text("dark"),
    System => Cbor.Text("system"),
  }
}

