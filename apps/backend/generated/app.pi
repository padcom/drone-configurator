export struct BatteryGroup {
  voltage?: f64
  current?: f64
  remaining?: u8
  consumed?: f64
  cells: f64[]
  ageMs: u32
}

export function decodeBatteryGroup(v: Cbor, path: string): BatteryGroup throws InvalidPayload {
  const m = members(v, path, ["voltage", "current", "remaining", "consumed", "cells", "ageMs"])
  const cbor0 = m.get("voltage")
  let opt0: f64? = null
  if (cbor0 != null) {
    opt0 = float(cbor0, `${path}.voltage`)
  }
  const cbor1 = m.get("current")
  let opt1: f64? = null
  if (cbor1 != null) {
    opt1 = float(cbor1, `${path}.current`)
  }
  const cbor2 = m.get("remaining")
  let opt2: u8? = null
  if (cbor2 != null) {
    opt2 = (uint(cbor2, `${path}.remaining`, 255) as u8)
  }
  const cbor3 = m.get("consumed")
  let opt3: f64? = null
  if (cbor3 != null) {
    opt3 = float(cbor3, `${path}.consumed`)
  }
  BatteryGroup {
    voltage: opt0,
    current: opt1,
    remaining: opt2,
    consumed: opt3,
    cells: decodeBatteryGroupCellsList(required(m, "cells", path), `${path}.cells`),
    ageMs: (uint(required(m, "ageMs", path), `${path}.ageMs`, 4294967295) as u32),
  }
}

export function encodeBatteryGroup(v: BatteryGroup): Cbor {
  const m = new Map<string, Cbor>()
  const opt0 = v.voltage
  if (opt0 != null) {
    m.set("voltage", Cbor.Float(opt0))
  }
  const opt1 = v.current
  if (opt1 != null) {
    m.set("current", Cbor.Float(opt1))
  }
  const opt2 = v.remaining
  if (opt2 != null) {
    m.set("remaining", Cbor.Uint(opt2 as u64))
  }
  const opt3 = v.consumed
  if (opt3 != null) {
    m.set("consumed", Cbor.Float(opt3))
  }
  m.set("cells", encodeBatteryGroupCellsList(v.cells))
  m.set("ageMs", Cbor.Uint(v.ageMs as u64))
  Cbor.Dict(m)
}

