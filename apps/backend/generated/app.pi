export struct Telemetry {
  armed: bool
  mode: string
  batteryVoltage?: f64
  batteryRemaining?: u8
  roll?: f64
  pitch?: f64
  yaw?: f64
  heartbeatAgeMs: u32
  position?: PositionGroup
  gps?: GpsGroup
  speed?: SpeedGroup
  nav?: NavGroup
  wind?: WindGroup
  ekf?: EkfGroup
  vibration?: VibrationGroup
  battery?: BatteryGroup
  attitude?: AttitudeGroup
  servo?: ServoGroup
  rc?: RcGroup
}

export function decodeTelemetry(v: Cbor, path: string): Telemetry throws InvalidPayload {
  const m = members(v, path, ["armed", "mode", "batteryVoltage", "batteryRemaining", "roll", "pitch", "yaw", "heartbeatAgeMs", "position", "gps", "speed", "nav", "wind", "ekf", "vibration", "battery", "attitude", "servo", "rc"])
  const cbor2 = m.get("batteryVoltage")
  let opt2: f64? = null
  if (cbor2 != null) {
    opt2 = float(cbor2, `${path}.batteryVoltage`)
  }
  const cbor3 = m.get("batteryRemaining")
  let opt3: u8? = null
  if (cbor3 != null) {
    opt3 = (uint(cbor3, `${path}.batteryRemaining`, 255) as u8)
  }
  const cbor4 = m.get("roll")
  let opt4: f64? = null
  if (cbor4 != null) {
    opt4 = float(cbor4, `${path}.roll`)
  }
  const cbor5 = m.get("pitch")
  let opt5: f64? = null
  if (cbor5 != null) {
    opt5 = float(cbor5, `${path}.pitch`)
  }
  const cbor6 = m.get("yaw")
  let opt6: f64? = null
  if (cbor6 != null) {
    opt6 = float(cbor6, `${path}.yaw`)
  }
  const cbor8 = m.get("position")
  let opt8: PositionGroup? = null
  if (cbor8 != null) {
    opt8 = decodePositionGroup(cbor8, `${path}.position`)
  }
  const cbor9 = m.get("gps")
  let opt9: GpsGroup? = null
  if (cbor9 != null) {
    opt9 = decodeGpsGroup(cbor9, `${path}.gps`)
  }
  const cbor10 = m.get("speed")
  let opt10: SpeedGroup? = null
  if (cbor10 != null) {
    opt10 = decodeSpeedGroup(cbor10, `${path}.speed`)
  }
  const cbor11 = m.get("nav")
  let opt11: NavGroup? = null
  if (cbor11 != null) {
    opt11 = decodeNavGroup(cbor11, `${path}.nav`)
  }
  const cbor12 = m.get("wind")
  let opt12: WindGroup? = null
  if (cbor12 != null) {
    opt12 = decodeWindGroup(cbor12, `${path}.wind`)
  }
  const cbor13 = m.get("ekf")
  let opt13: EkfGroup? = null
  if (cbor13 != null) {
    opt13 = decodeEkfGroup(cbor13, `${path}.ekf`)
  }
  const cbor14 = m.get("vibration")
  let opt14: VibrationGroup? = null
  if (cbor14 != null) {
    opt14 = decodeVibrationGroup(cbor14, `${path}.vibration`)
  }
  const cbor15 = m.get("battery")
  let opt15: BatteryGroup? = null
  if (cbor15 != null) {
    opt15 = decodeBatteryGroup(cbor15, `${path}.battery`)
  }
  const cbor16 = m.get("attitude")
  let opt16: AttitudeGroup? = null
  if (cbor16 != null) {
    opt16 = decodeAttitudeGroup(cbor16, `${path}.attitude`)
  }
  const cbor17 = m.get("servo")
  let opt17: ServoGroup? = null
  if (cbor17 != null) {
    opt17 = decodeServoGroup(cbor17, `${path}.servo`)
  }
  const cbor18 = m.get("rc")
  let opt18: RcGroup? = null
  if (cbor18 != null) {
    opt18 = decodeRcGroup(cbor18, `${path}.rc`)
  }
  Telemetry {
    armed: boolean(required(m, "armed", path), `${path}.armed`),
    mode: text(required(m, "mode", path), `${path}.mode`),
    batteryVoltage: opt2,
    batteryRemaining: opt3,
    roll: opt4,
    pitch: opt5,
    yaw: opt6,
    heartbeatAgeMs: (uint(required(m, "heartbeatAgeMs", path), `${path}.heartbeatAgeMs`, 4294967295) as u32),
    position: opt8,
    gps: opt9,
    speed: opt10,
    nav: opt11,
    wind: opt12,
    ekf: opt13,
    vibration: opt14,
    battery: opt15,
    attitude: opt16,
    servo: opt17,
    rc: opt18,
  }
}

export function encodeTelemetry(v: Telemetry): Cbor {
  const m = new Map<string, Cbor>()
  m.set("armed", Cbor.Bool(v.armed))
  m.set("mode", Cbor.Text(v.mode))
  const opt2 = v.batteryVoltage
  if (opt2 != null) {
    m.set("batteryVoltage", Cbor.Float(opt2))
  }
  const opt3 = v.batteryRemaining
  if (opt3 != null) {
    m.set("batteryRemaining", Cbor.Uint(opt3 as u64))
  }
  const opt4 = v.roll
  if (opt4 != null) {
    m.set("roll", Cbor.Float(opt4))
  }
  const opt5 = v.pitch
  if (opt5 != null) {
    m.set("pitch", Cbor.Float(opt5))
  }
  const opt6 = v.yaw
  if (opt6 != null) {
    m.set("yaw", Cbor.Float(opt6))
  }
  m.set("heartbeatAgeMs", Cbor.Uint(v.heartbeatAgeMs as u64))
  const opt8 = v.position
  if (opt8 != null) {
    m.set("position", encodePositionGroup(opt8))
  }
  const opt9 = v.gps
  if (opt9 != null) {
    m.set("gps", encodeGpsGroup(opt9))
  }
  const opt10 = v.speed
  if (opt10 != null) {
    m.set("speed", encodeSpeedGroup(opt10))
  }
  const opt11 = v.nav
  if (opt11 != null) {
    m.set("nav", encodeNavGroup(opt11))
  }
  const opt12 = v.wind
  if (opt12 != null) {
    m.set("wind", encodeWindGroup(opt12))
  }
  const opt13 = v.ekf
  if (opt13 != null) {
    m.set("ekf", encodeEkfGroup(opt13))
  }
  const opt14 = v.vibration
  if (opt14 != null) {
    m.set("vibration", encodeVibrationGroup(opt14))
  }
  const opt15 = v.battery
  if (opt15 != null) {
    m.set("battery", encodeBatteryGroup(opt15))
  }
  const opt16 = v.attitude
  if (opt16 != null) {
    m.set("attitude", encodeAttitudeGroup(opt16))
  }
  const opt17 = v.servo
  if (opt17 != null) {
    m.set("servo", encodeServoGroup(opt17))
  }
  const opt18 = v.rc
  if (opt18 != null) {
    m.set("rc", encodeRcGroup(opt18))
  }
  Cbor.Dict(m)
}

