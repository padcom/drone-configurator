export struct CalibrationCompassReport {
  ok: bool
  fitness: f64
  offsets: f64[]
  diagonals: f64[]
  offDiagonals: f64[]
  oldOrientation: u8
  newOrientation: u8
  orientationConfidence: f64
  scale: f64
  accepted: bool
}

export function decodeCalibrationCompassReport(v: Cbor, path: string): CalibrationCompassReport throws InvalidPayload {
  const m = members(v, path, ["ok", "fitness", "offsets", "diagonals", "offDiagonals", "oldOrientation", "newOrientation", "orientationConfidence", "scale", "accepted"])
  CalibrationCompassReport {
    ok: boolean(required(m, "ok", path), `${path}.ok`),
    fitness: float(required(m, "fitness", path), `${path}.fitness`),
    offsets: decodeCalibrationCompassReportOffsetsList(required(m, "offsets", path), `${path}.offsets`),
    diagonals: decodeCalibrationCompassReportDiagonalsList(required(m, "diagonals", path), `${path}.diagonals`),
    offDiagonals: decodeCalibrationCompassReportOffDiagonalsList(required(m, "offDiagonals", path), `${path}.offDiagonals`),
    oldOrientation: (uint(required(m, "oldOrientation", path), `${path}.oldOrientation`, 255) as u8),
    newOrientation: (uint(required(m, "newOrientation", path), `${path}.newOrientation`, 255) as u8),
    orientationConfidence: float(required(m, "orientationConfidence", path), `${path}.orientationConfidence`),
    scale: float(required(m, "scale", path), `${path}.scale`),
    accepted: boolean(required(m, "accepted", path), `${path}.accepted`),
  }
}

export function encodeCalibrationCompassReport(v: CalibrationCompassReport): Cbor {
  const m = new Map<string, Cbor>()
  m.set("ok", Cbor.Bool(v.ok))
  m.set("fitness", Cbor.Float(v.fitness))
  m.set("offsets", encodeCalibrationCompassReportOffsetsList(v.offsets))
  m.set("diagonals", encodeCalibrationCompassReportDiagonalsList(v.diagonals))
  m.set("offDiagonals", encodeCalibrationCompassReportOffDiagonalsList(v.offDiagonals))
  m.set("oldOrientation", Cbor.Uint(v.oldOrientation as u64))
  m.set("newOrientation", Cbor.Uint(v.newOrientation as u64))
  m.set("orientationConfidence", Cbor.Float(v.orientationConfidence))
  m.set("scale", Cbor.Float(v.scale))
  m.set("accepted", Cbor.Bool(v.accepted))
  Cbor.Dict(m)
}

export enum CalibrationResultOutcome { Success, Failed, Cancelled, Refused }

export function decodeCalibrationResultOutcome(v: Cbor, path: string): CalibrationResultOutcome throws InvalidPayload {
  match (text(v, path)) {
    "success" => CalibrationResultOutcome.Success,
    "failed" => CalibrationResultOutcome.Failed,
    "cancelled" => CalibrationResultOutcome.Cancelled,
    "refused" => CalibrationResultOutcome.Refused,
    _ => throw new InvalidPayload(path, "success or failed or cancelled or refused"),
  }
}

export function encodeCalibrationResultOutcome(v: CalibrationResultOutcome): Cbor {
  match (v) {
    Success => Cbor.Text("success"),
    Failed => Cbor.Text("failed"),
    Cancelled => Cbor.Text("cancelled"),
    Refused => Cbor.Text("refused"),
  }
}

export struct CalibrationResult {
  kind: CalibrationKind
  outcome: CalibrationResultOutcome
  code?: string
  detail?: string
  unsure?: bool
}

export function decodeCalibrationResult(v: Cbor, path: string): CalibrationResult throws InvalidPayload {
  const m = members(v, path, ["kind", "outcome", "code", "detail", "unsure"])
  const cbor2 = m.get("code")
  let opt2: string? = null
  if (cbor2 != null) {
    opt2 = text(cbor2, `${path}.code`)
  }
  const cbor3 = m.get("detail")
  let opt3: string? = null
  if (cbor3 != null) {
    opt3 = text(cbor3, `${path}.detail`)
  }
  const cbor4 = m.get("unsure")
  let opt4: bool? = null
  if (cbor4 != null) {
    opt4 = boolean(cbor4, `${path}.unsure`)
  }
  CalibrationResult {
    kind: decodeCalibrationKind(required(m, "kind", path), `${path}.kind`),
    outcome: decodeCalibrationResultOutcome(required(m, "outcome", path), `${path}.outcome`),
    code: opt2,
    detail: opt3,
    unsure: opt4,
  }
}

export function encodeCalibrationResult(v: CalibrationResult): Cbor {
  const m = new Map<string, Cbor>()
  m.set("kind", encodeCalibrationKind(v.kind))
  m.set("outcome", encodeCalibrationResultOutcome(v.outcome))
  const opt2 = v.code
  if (opt2 != null) {
    m.set("code", Cbor.Text(opt2))
  }
  const opt3 = v.detail
  if (opt3 != null) {
    m.set("detail", Cbor.Text(opt3))
  }
  const opt4 = v.unsure
  if (opt4 != null) {
    m.set("unsure", Cbor.Bool(opt4))
  }
  Cbor.Dict(m)
}

