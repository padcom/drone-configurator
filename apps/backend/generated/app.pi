}

function decodeLocalLogModesModesList(v: Cbor, path: string): ModeChange[] throws InvalidPayload {
  const out: ModeChange[] = []
  let i = 0
  for (const e of items(v, path)) {
    out.push(decodeModeChange(e, `${path}[${i}]`))
    i += 1
  }
  out
}

function encodeLocalLogModesModesList(v: ModeChange[]): Cbor {
  const out: Cbor[] = []
  for (const e of v) {
    out.push(encodeModeChange(e))
  }
  Cbor.List(out)
}

