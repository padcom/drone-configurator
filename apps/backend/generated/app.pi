  return RcGroup {
    channels: decodeRcGroupChannelsList(required(m, "channels", path), `${path}.channels`),
    rssi: opt1,
    ageMs: (uint(required(m, "ageMs", path), `${path}.ageMs`, 4294967295) as u32),
  }
}

export function encodeRcGroup(v: RcGroup): Cbor {
