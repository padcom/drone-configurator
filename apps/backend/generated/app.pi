  const opt7 = v.latencyMs
  if (opt7 != null) {
    m.set("latencyMs", Cbor.Float(opt7))
  }
  m.set("silentMs", Cbor.Uint(v.silentMs as u64))
  m.set("totalReceived", Cbor.Uint(v.totalReceived as u64))
  m.set("totalLost", Cbor.Uint(v.totalLost as u64))
  return Cbor.Dict(m)
}

export struct RecordingState {
  enabled: bool
  folder: string
  limitMb: u32
  key?: string
  path?: string
  bytes: u64
  failure?: RecordingFailure
  removed: u32
  removedBytes: u64
}

export function decodeRecordingState(v: Cbor, path: string): RecordingState throws InvalidPayload {
  const m = members(v, path, ["enabled", "folder", "limitMb", "key", "path", "bytes", "failure", "removed", "removedBytes"])
  const cbor3 = m.get("key")
  let opt3: string? = null
  if (cbor3 != null) {
    opt3 = text(cbor3, `${path}.key`)
  }
  const cbor4 = m.get("path")
  let opt4: string? = null
  if (cbor4 != null) {
    opt4 = text(cbor4, `${path}.path`)
  }
  const cbor6 = m.get("failure")
  let opt6: RecordingFailure? = null
  if (cbor6 != null) {
    opt6 = decodeRecordingFailure(cbor6, `${path}.failure`)
  }
  return RecordingState {
    enabled: boolean(required(m, "enabled", path), `${path}.enabled`),
    folder: text(required(m, "folder", path), `${path}.folder`),
    limitMb: (uint(required(m, "limitMb", path), `${path}.limitMb`, 4294967295) as u32),
    key: opt3,
    path: opt4,
    bytes: (uint(required(m, "bytes", path), `${path}.bytes`, 18446744073709551615) as u64),
    failure: opt6,
    removed: (uint(required(m, "removed", path), `${path}.removed`, 4294967295) as u32),
    removedBytes: (uint(required(m, "removedBytes", path), `${path}.removedBytes`, 18446744073709551615) as u64),
  }
}

export function encodeRecordingState(v: RecordingState): Cbor {
  const m = new Map<string, Cbor>()
  m.set("enabled", Cbor.Bool(v.enabled))
  m.set("folder", Cbor.Text(v.folder))
  m.set("limitMb", Cbor.Uint(v.limitMb as u64))
  const opt3 = v.key
  if (opt3 != null) {
    m.set("key", Cbor.Text(opt3))
  }
  const opt4 = v.path
  if (opt4 != null) {
    m.set("path", Cbor.Text(opt4))
  }
  m.set("bytes", Cbor.Uint(v.bytes as u64))
  const opt6 = v.failure
  if (opt6 != null) {
    m.set("failure", encodeRecordingFailure(opt6))
  }
  m.set("removed", Cbor.Uint(v.removed as u64))
  m.set("removedBytes", Cbor.Uint(v.removedBytes as u64))
  return Cbor.Dict(m)
}

export struct RecordingFailure {
  code: RecordingFailureCode
  message: string
}

export function decodeRecordingFailure(v: Cbor, path: string): RecordingFailure throws InvalidPayload {
  const m = members(v, path, ["code", "message"])
  return RecordingFailure {
    code: decodeRecordingFailureCode(required(m, "code", path), `${path}.code`),
    message: text(required(m, "message", path), `${path}.message`),
  }
}

export function encodeRecordingFailure(v: RecordingFailure): Cbor {
  const m = new Map<string, Cbor>()
  m.set("code", encodeRecordingFailureCode(v.code))
  m.set("message", Cbor.Text(v.message))
  return Cbor.Dict(m)
}

export enum RecordingFailureCode { DiskFull, WriteFailed, NoFolder, Limit }

export function decodeRecordingFailureCode(v: Cbor, path: string): RecordingFailureCode throws InvalidPayload {
  match (text(v, path)) {
    "disk-full" => RecordingFailureCode.DiskFull,
    "write-failed" => RecordingFailureCode.WriteFailed,
    "no-folder" => RecordingFailureCode.NoFolder,
    "limit" => RecordingFailureCode.Limit,
    _ => throw new InvalidPayload(path, "disk-full or write-failed or no-folder or limit"),
  }
}

export function encodeRecordingFailureCode(v: RecordingFailureCode): Cbor {
  match (v) {
    DiskFull => Cbor.Text("disk-full"),
    WriteFailed => Cbor.Text("write-failed"),
    NoFolder => Cbor.Text("no-folder"),
    Limit => Cbor.Text("limit"),
  }
}
