    "review" => CalibrationStateState.Review,
    "finished" => CalibrationStateState.Finished,
    _ => throw new InvalidPayload(path, "idle or starting or running or review or finished"),
  }
}

export function encodeCalibrationStateState(v: CalibrationStateState): Cbor {
  match (v) {
    Idle => Cbor.Text("idle"),
    Starting => Cbor.Text("starting"),
    Running => Cbor.Text("running"),
    Review => Cbor.Text("review"),
    Finished => Cbor.Text("finished"),
  }
}

function decodeCalibrationStateCompassesList(v: Cbor, path: string): CalibrationCompass[] throws InvalidPayload {
  const out: CalibrationCompass[] = []
  let i = 0
  for (const e of items(v, path)) {
    out.push(decodeCalibrationCompass(e, `${path}[${i}]`))
    i += 1
  }
  out
}

function decodeCalibrationStateTextsList(v: Cbor, path: string): string[] throws InvalidPayload {
  const out: string[] = []
  let i = 0
  for (const e of items(v, path)) {
    out.push(text(e, `${path}[${i}]`))
    i += 1
  }
  out
}

function encodeCalibrationStateCompassesList(v: CalibrationCompass[]): Cbor {
  const out: Cbor[] = []
  for (const e of v) {
    out.push(encodeCalibrationCompass(e))
  }
  Cbor.List(out)
}

function encodeCalibrationStateTextsList(v: string[]): Cbor {
  const out: Cbor[] = []
  for (const e of v) {
    out.push(Cbor.Text(e))
  }
  Cbor.List(out)
}

export struct CalibrationState {
  state: CalibrationStateState
  kind?: CalibrationKind
  accel?: CalibrationAccel
  compasses?: CalibrationCompass[]
  radio?: CalibrationRadio
  result?: CalibrationResult
  texts: string[]
}

export function decodeCalibrationState(v: Cbor, path: string): CalibrationState throws InvalidPayload {
  const m = members(v, path, ["state", "kind", "accel", "compasses", "radio", "result", "texts"])
  const cbor1 = m.get("kind")
  let opt1: CalibrationKind? = null
  if (cbor1 != null) {
    opt1 = decodeCalibrationKind(cbor1, `${path}.kind`)
  }
  const cbor2 = m.get("accel")
  let opt2: CalibrationAccel? = null
  if (cbor2 != null) {
    opt2 = decodeCalibrationAccel(cbor2, `${path}.accel`)
  }
  const cbor3 = m.get("compasses")
  let opt3: CalibrationCompass[]? = null
  if (cbor3 != null) {
    opt3 = decodeCalibrationStateCompassesList(cbor3, `${path}.compasses`)
  }
  const cbor4 = m.get("radio")
  let opt4: CalibrationRadio? = null
  if (cbor4 != null) {
    opt4 = decodeCalibrationRadio(cbor4, `${path}.radio`)
  }
  const cbor5 = m.get("result")
  let opt5: CalibrationResult? = null
  if (cbor5 != null) {
    opt5 = decodeCalibrationResult(cbor5, `${path}.result`)
  }
  CalibrationState {
    state: decodeCalibrationStateState(required(m, "state", path), `${path}.state`),
    kind: opt1,
    accel: opt2,
    compasses: opt3,
    radio: opt4,
    result: opt5,
    texts: decodeCalibrationStateTextsList(required(m, "texts", path), `${path}.texts`),
  }
}

export function encodeCalibrationState(v: CalibrationState): Cbor {
  const m = new Map<string, Cbor>()
  m.set("state", encodeCalibrationStateState(v.state))
  const opt1 = v.kind
  if (opt1 != null) {
    m.set("kind", encodeCalibrationKind(opt1))
  }
  const opt2 = v.accel
  if (opt2 != null) {
    m.set("accel", encodeCalibrationAccel(opt2))
  }
  const opt3 = v.compasses
  if (opt3 != null) {
    m.set("compasses", encodeCalibrationStateCompassesList(opt3))
  }
  const opt4 = v.radio
  if (opt4 != null) {
    m.set("radio", encodeCalibrationRadio(opt4))
  }
  const opt5 = v.result
  if (opt5 != null) {
    m.set("result", encodeCalibrationResult(opt5))
  }
  m.set("texts", encodeCalibrationStateTextsList(v.texts))
  Cbor.Dict(m)
}

