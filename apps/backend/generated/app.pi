    opt18 = decodeBatteryGroup(cbor18, `${path}.battery`)
  }
  const cbor19 = m.get("attitude")
  let opt19: AttitudeGroup? = null
  if (cbor19 != null) {
    opt19 = decodeAttitudeGroup(cbor19, `${path}.attitude`)
  }
  const cbor20 = m.get("servo")
  let opt20: ServoGroup? = null
  if (cbor20 != null) {
    opt20 = decodeServoGroup(cbor20, `${path}.servo`)
  }
  const cbor21 = m.get("rc")
  let opt21: RcGroup? = null
  if (cbor21 != null) {
    opt21 = decodeRcGroup(cbor21, `${path}.rc`)
  }
  return Telemetry {
    armed: boolean(required(m, "armed", path), `${path}.armed`),
    mode: text(required(m, "mode", path), `${path}.mode`),
    systemStatus: opt2,
    batteryVoltage: opt3,
    batteryRemaining: opt4,
    roll: opt5,
    pitch: opt6,
    yaw: opt7,
    heartbeatAgeMs: (uint(required(m, "heartbeatAgeMs", path), `${path}.heartbeatAgeMs`, 4294967295) as u32),
    position: opt9,
    home: opt10,
    prearm: opt11,
    gps: opt12,
    speed: opt13,
    nav: opt14,
    wind: opt15,
    ekf: opt16,
    vibration: opt17,
    battery: opt18,
    attitude: opt19,
    servo: opt20,
    rc: opt21,
  }
}

export function encodeTelemetry(v: Telemetry): Cbor {
  const m = new Map<string, Cbor>()
  m.set("armed", Cbor.Bool(v.armed))
  m.set("mode", Cbor.Text(v.mode))
  const opt2 = v.systemStatus
  if (opt2 != null) {
    m.set("systemStatus", Cbor.Uint(opt2 as u64))
  }
  const opt3 = v.batteryVoltage
  if (opt3 != null) {
    m.set("batteryVoltage", Cbor.Float(opt3))
  }
  const opt4 = v.batteryRemaining
  if (opt4 != null) {
    m.set("batteryRemaining", Cbor.Uint(opt4 as u64))
  }
  const opt5 = v.roll
  if (opt5 != null) {
    m.set("roll", Cbor.Float(opt5))
  }
  const opt6 = v.pitch
  if (opt6 != null) {
    m.set("pitch", Cbor.Float(opt6))
  }
  const opt7 = v.yaw
  if (opt7 != null) {
    m.set("yaw", Cbor.Float(opt7))
  }
  m.set("heartbeatAgeMs", Cbor.Uint(v.heartbeatAgeMs as u64))
  const opt9 = v.position
  if (opt9 != null) {
    m.set("position", encodePositionGroup(opt9))
  }
  const opt10 = v.home
  if (opt10 != null) {
    m.set("home", encodeHomeGroup(opt10))
  }
  const opt11 = v.prearm
  if (opt11 != null) {
    m.set("prearm", encodePrearmGroup(opt11))
  }
  const opt12 = v.gps
  if (opt12 != null) {
    m.set("gps", encodeGpsGroup(opt12))
  }
  const opt13 = v.speed
  if (opt13 != null) {
    m.set("speed", encodeSpeedGroup(opt13))
  }
  const opt14 = v.nav
  if (opt14 != null) {
    m.set("nav", encodeNavGroup(opt14))
  }
  const opt15 = v.wind
  if (opt15 != null) {
    m.set("wind", encodeWindGroup(opt15))
  }
  const opt16 = v.ekf
  if (opt16 != null) {
    m.set("ekf", encodeEkfGroup(opt16))
  }
  const opt17 = v.vibration
  if (opt17 != null) {
    m.set("vibration", encodeVibrationGroup(opt17))
  }
  const opt18 = v.battery
  if (opt18 != null) {
    m.set("battery", encodeBatteryGroup(opt18))
  }
  const opt19 = v.attitude
  if (opt19 != null) {
    m.set("attitude", encodeAttitudeGroup(opt19))
  }
  const opt20 = v.servo
  if (opt20 != null) {
    m.set("servo", encodeServoGroup(opt20))
  }
  const opt21 = v.rc
  if (opt21 != null) {
    m.set("rc", encodeRcGroup(opt21))
  }
  return Cbor.Dict(m)
}

