// A `.tlog` read as the log library reads a DataFlash log: `TlogDecoder` is a `DfDecoder` that is fed the bytes of a recording and
// gives `DfMessage`s, so the readers that already exist (series, review, messages, export) work on it unchanged.
//
// It gives two kinds of message, never mixed up:
//  - every MAVLink message of the recording, as it is: named as the dialect names it (`ATTITUDE`), with the dialect's field names
//    and units, a `TimeUS` first (microseconds from the first record of the recording) and the sender's `sysid`/`compid` last. These
//    are what the message browser and the CSV export show;
//  - a few messages named as the DataFlash log's, which the Flights view asks for (`ATT`, `CTUN`, `VIBE`, `BAT`, `GPS`, `XKF4`,
//    `MODE`, `MSG`), made from the MAVLink message that carries the same thing (see `DERIVED`). A value the vehicle marks "unknown"
//    (UINT16_MAX volts, a satellite count of 255, a position of INT32_MAX) is not a number: it is NaN, which every reader treats as
//    a gap. What a recording cannot say has no message: there is no `ERR`, `EV`, `FMT` or IMU batch in a tlog, so the review says
//    "no data" for them by itself.
//
// The units are the dialect's where it has them; where the MAVLink dialect has none (VIBRATION) the table `OWN_UNITS` says (the
// values ArduPilot documents), and the derived messages are in the units their DataFlash fields have (deg, m, V, A, m/s/s).
import { DfField, DfFormat, DfMessage, DfTables, MavLinkPacketField, MessageInfo, Registry, TlogReader, TlogRecord, defaultRegistry } from "padcom/pico-mavlink"
import { TlogReport } from "./generated/app"
import { LogReader } from "./logreader"

/// The MAVLink messages that make the DataFlash-named ones: [the MAVLink message, the DataFlash one].
export const DERIVED: string[][] = [
  ["ATTITUDE", "ATT"],
  ["GLOBAL_POSITION_INT", "CTUN"],
  ["VIBRATION", "VIBE"],
  ["SYS_STATUS", "BAT"],
  ["GPS_RAW_INT", "GPS"],
  ["EKF_STATUS_REPORT", "XKF4"],
  ["HEARTBEAT", "MODE"],
  ["STATUSTEXT", "MSG"],
]

/// Units for fields the dialect gives none (by message and field): ArduPilot documents VIBRATION in m/s/s.
export const OWN_UNITS: string[][] = [
  ["VIBRATION", "vibration_x", "m/s/s"],
  ["VIBRATION", "vibration_y", "m/s/s"],
  ["VIBRATION", "vibration_z", "m/s/s"],
]

/// The first type number of the derived formats (the raw ones have their message id).
const DERIVED_TYPE: int = 100000
const MAV_AUTOPILOT_INVALID: int = 8
/// The gap (microseconds) put before a stretch of the recording whose clock went back: 30 s.
const SEGMENT_GAP_US: int = 30000000
const DEG: f64 = 57.29577951308232

const SCRATCH = new ArrayBuffer(8)
const SCRATCH_BYTES = new Uint8Array(SCRATCH, 0)
const SCRATCH_F32 = new Float32Array(SCRATCH, 0)
const SCRATCH_F64 = new Float64Array(SCRATCH, 0)

/// The byte at `at` of a payload, or 0 past its end (a MAVLink 2 payload may be cut short of its message's length).
function byteAt(b: Uint8Array, at: int): int {
  if (at < b.length) b[at] as int else 0
}

/// The unsigned little-endian integer of `n` bytes at `at`.
function unsignedAt(b: Uint8Array, at: int, n: int): f64 {
  let v = 0.0
  for (let i = n - 1; i >= 0; i--) {
    v = v * 256.0 + (byteAt(b, at + i) as f64)
  }
  v
}

function signedAt(b: Uint8Array, at: int, n: int): f64 {
  const u = unsignedAt(b, at, n)
  let half = 128.0
  for (let i = 1; i < n; i++) {
    half *= 256.0
  }
  if (u >= half) u - half * 2.0 else u
}

function floatAt(b: Uint8Array, at: int, n: int): f64 {
  for (let i = 0; i < n; i++) {
    SCRATCH_BYTES.set(i, byteAt(b, at + i))
  }
  if (n == 4) SCRATCH_F32.get(0) as f64 else SCRATCH_F64.get(0)
}

/// The element type of a field ("uint16_t[]" is "uint16_t").
function elementOf(type: string): string {
  const at = type.indexOf("[")
  if (at < 0) type else type.slice(0, at)
}

/// One value of the wire type `type` at `at` (a number; a char is its code).
function valueAt(b: Uint8Array, at: int, type: string): f64 {
  const t = elementOf(type)
  if (t == "float") {
    return floatAt(b, at, 4)
  }
  if (t == "double") {
    return floatAt(b, at, 8)
  }
  const n = if (t.includes("64")) 8 else if (t.includes("32")) 4 else if (t.includes("16")) 2 else 1
  if (t.startsWith("u") || t == "char") unsignedAt(b, at, n) else signedAt(b, at, n)
}

/// The text of a `char[n]` field, up to the first NUL (invalid UTF-8 becomes U+FFFD).
function charsAt(b: Uint8Array, at: int, n: int): string {
  let end = 0
  while (end < n && byteAt(b, at + end) != 0) {
    end += 1
  }
  const bytes = new Uint8Array(end)
  for (let i = 0; i < end; i++) {
    bytes.set(i, byteAt(b, at + i))
  }
  try {
    new TextDecoder().decode(bytes)
  } catch (e: TypeError) {
    ""
  }
}

/// A value the vehicle marks "unknown" (`unknown`: UINT16_MAX, a count of 255, INT32_MAX) is not a number: NaN.
function known(v: f64, unknown: f64): f64 {
  if (v == unknown) nan() else v
}

/// Not a number: a value that is not there (every reader of the library takes it as a gap).
function nan(): f64 {
  0.0 / 0.0
}

/// A format of numbers: a `TimeUS` and then `labels`, each a number (`d`), with `units` (the same length; "" for none).
function numbersFormat(type: int, name: string, labels: string[], units: string[], ids: Map<string, int>): DfFormat {
  const fields: DfField[] = [new DfField("TimeUS", 0x51, 0)]
  for (let i = 0; i < labels.length; i++) {
    const f = new DfField(labels[i], 0x64, 8 + 8 * i)
    f.unitId = unitId(units[i], ids)
    fields.push(f)
  }
  new DfFormat(type, 3 + 8 * (labels.length + 1), name, `Q${"d".repeat(labels.length)}`, `TimeUS,${labels.join(",")}`, fields)
}

/// The id a unit label has in the tables (0 for none).
function unitId(label: string, ids: Map<string, int>): int {
  if (label == "") {
    return 0
  }
  const known = ids.get(label)
  if (known != null) {
    return known!
  }
  const id = 1 + ids.size
  ids.set(label, id)
  id
}

/// What the reader found, in the contract's shape.
export function reportOf(reader: TlogReader): TlogReport {
  const p = reader.report
  const r = TlogReport {
    records: clamp32(p.records),
    v1: clamp32(p.v1),
    v2: clamp32(p.v2),
    signed: clamp32(p.signed),
    crcFailures: clamp32(p.crcFailures),
    unknown: clamp32(p.unknown),
    jitter: clamp32(p.jitter),
    segments: clamp32(p.segments),
    bytesSkipped: p.bytesSkipped as u64,
    bytesCut: clamp32(p.bytesCut),
    cutEnd: p.cutEnd,
    dated: p.dated,
  }
  if (p.records > 0) {
    r.firstUs = p.firstUs as u64
    r.lastUs = p.lastUs as u64
  }
  r
}

function clamp32(n: int): u32 {
  (if (n > 4294967295) 4294967295 else n) as u32
}

/// A tlog as messages. Feed it with `push`, take with `next`, `finish` at the end of the file.
export class TlogDecoder implements LogReader {
  public readonly reader: TlogReader = new TlogReader()
  public readonly unitTable: DfTables = new DfTables()
  readonly registry: Registry = defaultRegistry()
  /// The raw formats by message id, the derived ones by DataFlash name.
  readonly raw: Map<int, DfFormat> = new Map<int, DfFormat>()
  readonly derived: Map<string, DfFormat> = new Map<string, DfFormat>()
  readonly unitIds: Map<string, int> = new Map<string, int>()
  readonly pending: DfMessage[] = []
  /// The time of the first record: the messages' `TimeUS` counts from it.
  origin: int = -1
  /// The stretch of the recording the last record was in, what is added to the times of the stretches that began before the end of the
  /// one before, and the latest time given.
  segment: int = 0
  shift: int = 0
  latest: int = 0
  /// The mode last given by each sender (key `sysid`), so that `MODE` is a change and not every heartbeat.
  readonly modes: Map<int, int> = new Map<int, int>()
  /// Messages of a kind the dialects don't have (cannot happen for a record the reader gave) and messages made from a record.
  public unmapped: int = 0

  /// Whether a message is one this decoder derived (named as a DataFlash message), as against a MAVLink message as it was.
  public isDerived(name: string): bool {
    for (const pair of DERIVED) {
      if (pair[1] == name) {
        return true
      }
    }
    false
  }

  public push(chunk: Uint8Array): void {
    reader.push(chunk)
  }

  public next(): DfMessage? {
    while (pending.length == 0) {
      const record = reader.next()
      if (record == null) {
        return null
      }
      convert(record!)
    }
    const first = pending[0]
    pending.splice(0, 1)
    first
  }

  public finish(): void {
    reader.finish()
  }

  /// The units are on the fields (by id); the table names them.
  public tables(): DfTables {
    if (unitTable.units.size < unitIds.size) {
      for (const [label, id] of unitIds) {
        unitTable.setUnit(id, label)
      }
    }
    unitTable
  }

  /// The bytes that were no record: what was skipped in the middle and the cut end (a cut end is not damage; the caller takes it
  /// off by `cutBytes`).
  public skippedBytes(): int {
    reader.report.bytesSkipped + reader.report.bytesCut
  }

  /// The bytes at the end of the file that are the start of a record that is not whole.
  public cutBytes(): int {
    reader.report.bytesCut
  }

  /// Frames with a wrong CRC and frames of messages that no dialect has (their CRC can't be checked).
  public problemCount(): int {
    reader.report.crcFailures + reader.report.unknown
  }

  public isTlog(): bool {
    true
  }

  public tlogReport(): TlogReport? {
    reportOf(reader)
  }

  /// Whether a message is made by this decoder (named as DataFlash names it) and not a MAVLink message as it was.
  public hides(name: string): bool {
    isDerived(name)
  }

  /// The time of a record on the axis of the views: microseconds from the first record. A new stretch of the recording (the recorder's
  /// clock went back: a restart, a second recording appended) that would begin before the end of what came before is put
  /// `SEGMENT_GAP_US` after it, so that the axis only goes forward and the stretches are told apart by a gap.
  timeOf(record: TlogRecord): int {
    let t = record.timeUs - origin + shift
    if (record.segment != segment) {
      segment = record.segment
      if (t < latest) {
        shift += latest + SEGMENT_GAP_US - t
        t = latest + SEGMENT_GAP_US
      }
    }
    if (t > latest) {
      latest = t
    }
    t
  }

  /// Makes the messages of one record.
  convert(record: TlogRecord): void {
    if (origin < 0) {
      origin = record.timeUs
    }
    const info = registry.get(record.msgid)
    if (info == null) {
      unmapped += 1
      return
    }
    const payload = record.payload()
    const t = timeOf(record) as f64
    pending.push(rawMessage(info!, record, payload, t))
    deriveFrom(info!, record, payload, t)
  }

  /// The MAVLink message as it is.
  rawMessage(info: MessageInfo, record: TlogRecord, payload: Uint8Array, t: f64): DfMessage {
    let format = raw.get(info.id)
    if (format == null) {
      format = rawFormat(info)
      raw.set(info.id, format!)
    }
    const nums: f64[] = [t]
    const texts: string[] = [""]
    const lists: f64[][] = [[]]
    for (const f of info.fields) {
      const isText = f.type == "char[]"
      const isArray = f.length > 0 && !isText
      nums.push(if (isText || isArray) 0.0 else valueAt(payload, f.offset, f.type))
      texts.push(if (isText) charsAt(payload, f.offset, f.length) else "")
      const list: f64[] = []
      if (isArray) {
        for (let i = 0; i < f.length; i++) {
          list.push(valueAt(payload, f.offset + i * f.size, f.type))
        }
      }
      lists.push(list)
    }
    nums.push(record.sysid as f64, record.compid as f64)
    texts.push("", "")
    lists.push([], [])
    new DfMessage(format!, 0, nums, texts, lists)
  }

  /// The format of a MAVLink message: `TimeUS`, its fields (numbers `d`, text `Z`, arrays `a`), `sysid`, `compid`.
  rawFormat(info: MessageInfo): DfFormat {
    const fields: DfField[] = [new DfField("TimeUS", 0x51, 0)]
    for (const f of info.fields) {
      const kind = if (f.type == "char[]") 0x5A else if (f.length > 0) 0x61 else 0x64
      const field = new DfField(f.source, kind, 8)
      field.unitId = unitId(unitOf(info, f), unitIds)
      fields.push(field)
    }
    fields.push(new DfField("sysid", 0x64, 8), new DfField("compid", 0x64, 8))
    new DfFormat(info.id, 3 + 8 * fields.length, info.name, "", "", fields)
  }

  /// The unit of a field: the dialect's, else the table of our own, else none.
  unitOf(info: MessageInfo, f: MavLinkPacketField): string {
    if (f.units != "") {
      return f.units
    }
    for (const row of OWN_UNITS) {
      if (row[0] == info.name && row[1] == f.source) {
        return row[2]
      }
    }
    ""
  }

  /// The DataFlash-named messages that this record makes (none for most).
  deriveFrom(info: MessageInfo, record: TlogRecord, payload: Uint8Array, t: f64): void {
    const name = info.name
    if (name == "ATTITUDE") {
      deriveAttitude(info, payload, t)
    } else if (name == "GLOBAL_POSITION_INT") {
      give("CTUN", ["Alt"], ["m"], t, [known(field(info, payload, "relative_alt"), 2147483647.0) / 1000.0])
    } else if (name == "VIBRATION") {
      deriveVibration(info, payload, t)
    } else if (name == "SYS_STATUS") {
      deriveBattery(info, payload, t)
    } else if (name == "GPS_RAW_INT") {
      deriveGps(info, payload, t)
    } else if (name == "EKF_STATUS_REPORT") {
      give("XKF4", ["SV", "SP", "SH", "SM"], ["", "", "", ""], t, [field(info, payload, "velocity_variance"), field(info, payload, "pos_horiz_variance"), field(info, payload, "pos_vert_variance"), field(info, payload, "compass_variance")])
    } else if (name == "HEARTBEAT") {
      deriveMode(info, record, payload, t)
    } else if (name == "STATUSTEXT") {
      deriveText(info, payload, t)
    }
  }

  /// The value of the field called `source` (the dialect's name) of a payload, NaN when the message has no such field.
  field(info: MessageInfo, payload: Uint8Array, source: string): f64 {
    for (const f of info.fields) {
      if (f.source == source) {
        return valueAt(payload, f.offset, f.type)
      }
    }
    nan()
  }

  deriveAttitude(info: MessageInfo, payload: Uint8Array, t: f64): void {
    give("ATT", ["Roll", "Pitch", "Yaw"], ["deg", "deg", "deg"], t, [
      field(info, payload, "roll") * DEG,
      field(info, payload, "pitch") * DEG,
      field(info, payload, "yaw") * DEG,
    ])
  }

  /// VIBRATION: the vibration of the first IMU with the clipping of each of the three (the message has one vector only).
  deriveVibration(info: MessageInfo, payload: Uint8Array, t: f64): void {
    for (let imu = 0; imu < 3; imu++) {
      const x = if (imu == 0) field(info, payload, "vibration_x") else nan()
      const y = if (imu == 0) field(info, payload, "vibration_y") else nan()
      const z = if (imu == 0) field(info, payload, "vibration_z") else nan()
      give("VIBE", ["IMU", "VibeX", "VibeY", "VibeZ", "Clip"], ["", "m/s/s", "m/s/s", "m/s/s", ""], t, [
        imu as f64,
        x,
        y,
        z,
        field(info, payload, `clipping_${imu}`),
      ])
    }
  }

  /// SYS_STATUS: the pack voltage and current (the first battery); UINT16_MAX volts and -1 amps mean the vehicle sent none.
  deriveBattery(info: MessageInfo, payload: Uint8Array, t: f64): void {
    const mv = known(field(info, payload, "voltage_battery"), 65535.0)
    const ca = field(info, payload, "current_battery")
    if (mv != mv) {
      return
    }
    give("BAT", ["Inst", "Volt", "Curr"], ["", "V", "A"], t, [0.0, mv / 1000.0, if (ca < 0.0) nan() else ca / 100.0])
  }

  /// GPS_RAW_INT: the receiver's fix as the DataFlash GPS message has it (degrees, metres above sea level).
  deriveGps(info: MessageInfo, payload: Uint8Array, t: f64): void {
    const sats = known(field(info, payload, "satellites_visible"), 255.0)
    const eph = known(field(info, payload, "eph"), 65535.0)
    const lat = known(field(info, payload, "lat"), 2147483647.0)
    const lng = known(field(info, payload, "lon"), 2147483647.0)
    const alt = known(field(info, payload, "alt"), 2147483647.0)
    give("GPS", ["I", "Status", "NSats", "HDop", "Lat", "Lng", "Alt"], ["", "", "", "", "deg", "deg", "m"], t, [
      0.0,
      field(info, payload, "fix_type"),
      sats,
      eph / 100.0,
      lat / 10000000.0,
      lng / 10000000.0,
      alt / 1000.0,
    ])
  }

  /// HEARTBEAT of a vehicle (the ground station's has no autopilot): a change of mode is a MODE message.
  deriveMode(info: MessageInfo, record: TlogRecord, payload: Uint8Array, t: f64): void {
    if (field(info, payload, "autopilot") == (MAV_AUTOPILOT_INVALID as f64)) {
      return
    }
    const mode = field(info, payload, "custom_mode") as int
    const before = modes.get(record.sysid)
    if (before != null && before! == mode) {
      return
    }
    modes.set(record.sysid, mode)
    give("MODE", ["Mode", "ModeNum"], ["", ""], t, [mode as f64, mode as f64])
  }

  /// STATUSTEXT: a line of the vehicle's text, as the DataFlash MSG message has it.
  deriveText(info: MessageInfo, payload: Uint8Array, t: f64): void {
    for (const f of info.fields) {
      if (f.source == "text") {
        giveText("MSG", "Message", t, charsAt(payload, f.offset, f.length))
      }
    }
  }

  /// Puts a derived message of one text on the queue.
  giveText(name: string, label: string, t: f64, text: string): void {
    let format = derived.get(name)
    if (format == null) {
      const fields: DfField[] = [new DfField("TimeUS", 0x51, 0), new DfField(label, 0x5A, 8)]
      format = new DfFormat(DERIVED_TYPE + derived.size, 3 + 8 + 64, name, "QZ", `TimeUS,${label}`, fields)
      derived.set(name, format!)
    }
    pending.push(new DfMessage(format!, 0, [t, 0.0], ["", text]))
  }

  /// Puts a derived message of numbers on the queue.
  give(name: string, labels: string[], units: string[], t: f64, values: f64[]): void {
    let format = derived.get(name)
    if (format == null) {
      format = numbersFormat(DERIVED_TYPE + derived.size, name, labels, units, unitIds)
      derived.set(name, format!)
    }
    const nums: f64[] = [t]
    const texts: string[] = [""]
    for (const v of values) {
      nums.push(v)
      texts.push("")
    }
    pending.push(new DfMessage(format!, 0, nums, texts))
  }
}
