// The params service, over an in-memory link against the simulated vehicle.
import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { Cbor } from "pico-desktop/communicator"
import { MavParamType, TypedParamValue } from "padcom/pico-mavlink"
import { setSimulatorFtpForTests, simulatorForTests } from "./app"
import {
  ConnectRequest,
  ConnectRequestTransport,
  ParamListRequest,
  ParamListRequestMethod,
  ParamListSource,
  ParamWrite,
  ParamWriteKind,
  ParamsProgressSource,
  decodeParam,
  decodeParamList,
  decodeParamsProgress,
  encodeConnectRequest,
  encodeParamListRequest,
  encodeParamWrite,
} from "./generated/app"
import { start } from "./testing"

async function refusesWithoutAVehicle(): Promise<void> throws Error {
  const f = await start()
  await f.call("vehicle.disconnect")
  const e = await f.call("params.list")
  expect(e.err?.code ?? "no error").toBe("NOT_CONNECTED")
}

async function disconnectCancels(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  // The simulator never answers a parameter it doesn't have: the write would retry for seconds.
  const w = ParamWrite { id: "NO_SUCH_PARAM", kind: ParamWriteKind.Int, type: "INT32", value: 1.0 }
  const started = Date.now() as int
  const writing = await fe.send("params.write", encodeParamWrite(w))
  await delay(50)
  await fe.call("vehicle.disconnect")
  const e = await fe.reply(writing)
  expect(`${e.err?.code ?? "no error"} ${(Date.now() as int) - started < 1000}`).toBe("ABORTED true")
}

async function announcesChanges(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  await fe.call("params.list")
  // Another ground station changes RTL_ALT: the vehicle announces it, the backend passes it on.
  simulatorForTests()!.change("RTL_ALT", TypedParamValue.Int(2500, MavParamType.INT32))
  const e = await fe.event("params.changed")
  const p = decodeParam(e.p ?? Cbor.Null, "$")
  expect(`${p.id}=${p.value} ${p.type}`).toBe("RTL_ALT=2500 INT32")
  await fe.call("vehicle.disconnect")
}

async function reportsHowTheListCame(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  // The simulated vehicle has file transfer: the parameters come by it, and progress is in parameters (not bytes).
  const e = await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))
  const list = decodeParamList(e.p ?? Cbor.Null, "$")
  expect(`${list.complete} ${list.source == ParamListSource.Ftp} ${list.fallback == null} ${list.count}`).toBe("true true true 12")
  expect(list.elapsedMs != null && list.elapsedMs! < 5000).toBe(true)
  const progress = fe.heard.filter((h) => h.n == "params.progress")
  expect(progress.length >= 1).toBe(true)
  const last = decodeParamsProgress(progress[progress.length - 1].p ?? Cbor.Null, "$")
  expect(`${last.received} ${last.total} ${last.source == ParamsProgressSource.Ftp}`).toBe("12 12 true")
  // The announcements of other ground stations are not mistaken for answers: none was made here.
  expect(fe.heard.filter((h) => h.n == "params.changed").length).toBe(0)
  await fe.call("vehicle.disconnect")
}

async function reportsTheListDownload(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const e = await fe.call("params.list", encodeParamListRequest(ParamListRequest { method: ParamListRequestMethod.List }))
  const list = decodeParamList(e.p ?? Cbor.Null, "$")
  expect(`${list.complete} ${list.source == ParamListSource.List} ${list.fallback ?? "none"}`).toBe("true true disabled")
  // Progress by the list: the first as soon as the total is known, the last when everything has arrived, in parameters.
  const progress = fe.heard.filter((h) => h.n == "params.progress")
  expect(progress.length >= 2).toBe(true)
  const first = decodeParamsProgress(progress[0].p ?? Cbor.Null, "$")
  const last = decodeParamsProgress(progress[progress.length - 1].p ?? Cbor.Null, "$")
  expect(`${first.received} ${first.total} ${first.source == ParamsProgressSource.List}`).toBe(`1 ${list.count} true`)
  expect(`${last.received} ${last.total}`).toBe(`${list.count} ${list.count}`)
  // No more than about 10 a second: the whole download is a few ms, so it is the first, the last and at most one between.
  expect(progress.length <= 4).toBe(true)
  await fe.call("vehicle.disconnect")
}

async function fallsBackAndRemembersWhatItShould(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const sim = simulatorForTests()!
  // A vehicle that says it has the file but refuses it (ENOENT): by list, "unsupported".
  sim.ftpMode = "unsupported"
  const first = decodeParamList((await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))).p ?? Cbor.Null, "$")
  expect(`${first.source == ParamListSource.List} ${first.fallback ?? "none"} ${first.complete}`).toBe("true unsupported true")
  // It is remembered for the connection: the next download does not ask the vehicle again, and says why.
  const asked = sim.ftpLog.length
  const second = decodeParamList((await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))).p ?? Cbor.Null, "$")
  expect(`${second.source == ParamListSource.List} ${second.fallback ?? "none"}`).toBe("true unsupported")
  expect(sim.ftpLog.length).toBe(asked)
  // A forced file transfer ignores what is remembered, and fails with its own error: no fallback.
  const forced = await fe.call("params.list", encodeParamListRequest(ParamListRequest { method: ParamListRequestMethod.Ftp }))
  expect(forced.err?.code ?? "no error").toBe("FTP_ERRNO")
  // A new connection forgets it, and finds the file transfer working again.
  await fe.call("vehicle.disconnect")
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const third = decodeParamList((await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))).p ?? Cbor.Null, "$")
  expect(`${third.source == ParamListSource.Ftp} ${third.fallback ?? "none"}`).toBe("true none")
  await fe.call("vehicle.disconnect")
}

async function doesNotRememberAFailureThatMayPass(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const sim = simulatorForTests()!
  // The vehicle has no session free: a reason that may pass ("timeout"), not one to give the file transfer up for.
  sim.ftpMode = "busy"
  const first = decodeParamList((await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))).p ?? Cbor.Null, "$")
  expect(`${first.source == ParamListSource.List} ${first.fallback ?? "none"}`).toBe("true timeout")
  // A timeout is skipped once (the next download goes by list at once), the one after tries again.
  const asked = sim.ftpLog.length
  const second = decodeParamList((await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))).p ?? Cbor.Null, "$")
  expect(`${second.source == ParamListSource.List} ${second.fallback ?? "none"}`).toBe("true timeout")
  expect(sim.ftpLog.length).toBe(asked)
  sim.ftpMode = "ok"
  const third = decodeParamList((await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))).p ?? Cbor.Null, "$")
  expect(`${third.source == ParamListSource.Ftp} ${third.fallback ?? "none"}`).toBe("true none")
  // An error of one read (EINVAL) is a protocol failure: not remembered at all.
  sim.ftpMode = "einval"
  const fourth = decodeParamList((await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))).p ?? Cbor.Null, "$")
  expect(`${fourth.source == ParamListSource.List} ${fourth.fallback ?? "none"}`).toBe("true protocol")
  sim.ftpMode = "ok"
  const fifth = decodeParamList((await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))).p ?? Cbor.Null, "$")
  expect(`${fifth.source == ParamListSource.Ftp}`).toBe("true")
  await fe.call("vehicle.disconnect")
}

async function usesNoFileTransferWithoutTheCapability(): Promise<void> throws Error {
  const fe = await start()
  // Without the capability bit (known from AUTOPILOT_VERSION when it connected) the list is used with no FTP packet.
  setSimulatorFtpForTests(false)
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  setSimulatorFtpForTests(true)
  const sim = simulatorForTests()!
  const list = decodeParamList((await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))).p ?? Cbor.Null, "$")
  expect(`${list.source == ParamListSource.List} ${list.fallback ?? "none"} ${list.complete}`).toBe("true unsupported true")
  expect(sim.ftpLog.length).toBe(0)
  await fe.call("vehicle.disconnect")
}

async function keepsAnnouncementsOfAnotherStationOutOfTheEventsDuringTheFile(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const sim = simulatorForTests()!
  // The replies of the file transfer are lost for a while: the download waits, and another ground station changes a value.
  sim.ftpLoss = 100
  const listing = await fe.send("params.list", encodeParamListRequest(ParamListRequest {}))
  await delay(200)
  sim.change("RTL_ALT", TypedParamValue.Int(2500, MavParamType.INT32))
  await delay(100)
  sim.ftpLoss = 0
  const list = decodeParamList((await fe.reply(listing)).p ?? Cbor.Null, "$")
  // It is not announced on its own during the download (the list that comes has it), and the list has the new value.
  expect(fe.heard.filter((h) => h.n == "params.changed").length).toBe(0)
  const rtl = list.params.filter((p) => p.id == "RTL_ALT")
  expect(rtl.length).toBe(1)
  expect(rtl[0].value).toBe(2500.0)
  await fe.call("vehicle.disconnect")
}

async function cancelsTheDownloadAndGoesOn(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  // A vehicle that says nothing: the download waits for it, and can be cancelled.
  simulatorForTests()!.down = true
  const started = Date.now() as int
  const listing = await fe.send("params.list", encodeParamListRequest(ParamListRequest {}))
  await delay(100)
  const cancel = await fe.call("params.cancel")
  expect(cancel.err == null).toBe(true)
  const e = await fe.reply(listing)
  expect(`${e.err?.code ?? "no error"} ${(Date.now() as int) - started < 900}`).toBe("ABORTED true")
  // The link and the session are as they were: the vehicle answers again, and a second download works.
  simulatorForTests()!.down = false
  const again = await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))
  expect(decodeParamList(again.p ?? Cbor.Null, "$").complete).toBe(true)
  // A cancel with no download running does nothing.
  const none = await fe.call("params.cancel")
  expect(none.err == null).toBe(true)
  await fe.call("vehicle.disconnect")
}

async function refusesASecondDownloadAndEndsWithTheSession(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  simulatorForTests()!.down = true
  const first = await fe.send("params.list", encodeParamListRequest(ParamListRequest {}))
  await delay(50)
  // One download at a time: the second is refused, and the first is not disturbed.
  const second = await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))
  expect(second.err?.code ?? "no error").toBe("BUSY")
  // The session ending (the user disconnects) stops the first, with no cancel.
  const started = Date.now() as int
  await fe.call("vehicle.disconnect")
  const e = await fe.reply(first)
  expect(`${e.err?.code ?? "no error"} ${(Date.now() as int) - started < 900}`).toBe("ABORTED true")
  // A download of the next session works, and ends with it as well (one listener on each session's signal).
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const again = await fe.call("params.list", encodeParamListRequest(ParamListRequest {}))
  expect(decodeParamList(again.p ?? Cbor.Null, "$").complete).toBe(true)
  await fe.call("vehicle.disconnect")
}

async function takesNoRequestAsAuto(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  // (A backend takes no payload as auto, though the contract's validation asks for a map.)
  const old = await fe.call("params.list")
  const list = decodeParamList(old.p ?? Cbor.Null, "$")
  expect(`${list.complete} ${list.source == ParamListSource.Ftp}`).toBe("true true")
  await fe.call("vehicle.disconnect")
}

describe("the params service", () => {
  it("downloads by file transfer, says so, and reports progress in parameters", reportsHowTheListCame)
  it("downloads by list when asked to, and reports its progress", reportsTheListDownload)
  it("falls back to the list, remembers a file the vehicle does not have, and forgets it on a new connection", fallsBackAndRemembersWhatItShould)
  it("remembers a timeout for one download only, and a protocol failure not at all", doesNotRememberAFailureThatMayPass)
  it("uses the list with no file transfer packet for a vehicle without the capability", usesNoFileTransferWithoutTheCapability)
  it("keeps what another station announces during the file transfer out of the events, and in the list", keepsAnnouncementsOfAnotherStationOutOfTheEventsDuringTheFile)
  it("cancels a download without ending the session", cancelsTheDownloadAndGoesOn)
  it("refuses a second download while one runs, and the session ending stops the first", refusesASecondDownloadAndEndsWithTheSession)
  it("takes no request as auto", takesNoRequestAsAuto)
  it("refuses parameter calls without a vehicle", refusesWithoutAVehicle)
  it("cancels a write in flight when the user disconnects", disconnectCancels)
  it("passes on a parameter the vehicle announces", announcesChanges)
})
