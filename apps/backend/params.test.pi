// The params service, over an in-memory link against the simulated vehicle.
import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { Cbor } from "pico-desktop/communicator"
import { MavParamType, ParamRequestList, ParamRequestRead, Received, TypedParamValue } from "padcom/pico-mavlink"
import { simulatorForTests } from "./app"
import {
  ConnectRequest,
  ConnectRequestTransport,
  ParamWrite,
  ParamWriteKind,
  decodeParam,
  decodeParamList,
  encodeConnectRequest,
  encodeParamWrite,
} from "./generated/app"
import { dropCachedList } from "./params"
import { link } from "./session"
import { Frontend, start } from "./testing"

async function refusesWithoutAVehicle(): Promise<void> throws Error {
  const f = await start()
  await f.call("vehicle.disconnect")
  const e = await f.call("params.list")
  expect(e.err?.code ?? "no error").toBe("NOT_CONNECTED")
}

async function disconnectCancels(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  // The simulator never answers a parameter it doesn't have: the write would retry for seconds.
  const w = ParamWrite { id: "NO_SUCH_PARAM", kind: ParamWriteKind.Int, type: "INT32", value: 1.0 }
  const started = Date.now() as int
  const writing = await fe.send("params.write", encodeParamWrite(w))
  await delay(50)
  await fe.call("vehicle.disconnect")
  const e = await fe.reply(writing)
  expect(`${e.err?.code ?? "no error"} ${(Date.now() as int) - started < 1000}`).toBe("ABORTED true")
}

async function announcesChanges(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  await fe.call("params.list")
  // Another ground station changes RTL_ALT: the vehicle announces it, the backend passes it on.
  simulatorForTests()!.change("RTL_ALT", TypedParamValue.Int(2500, MavParamType.INT32))
  const e = await fe.event("params.changed")
  const p = decodeParam(e.p ?? Cbor.Null, "$")
  expect(`${p.id}=${p.value} ${p.type}`).toBe("RTL_ALT=2500 INT32")
  await fe.call("vehicle.disconnect")
}

/// A simulated vehicle with ArduPilot's fingerprint among its parameters, counting how many times the whole list was asked
/// for.
class Counted {
  public lists: int = 0
  /// How many single parameters were asked for by name (the fingerprint, here; the list's gaps are asked by index).
  public reads: int = 0
}

async function connectWithFingerprint(counted: Counted, withHash: bool): Promise<Frontend> throws Error {
  // The cache outlives a connection (the same vehicle, reconnected, may use it): each test starts with none.
  dropCachedList()
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const sim = simulatorForTests()!
  if (withHash) {
    sim.params.push({ id: "_HASH_CHECK", value: TypedParamValue.Int(111, MavParamType.INT32) })
  }
  sim.conn.on((r: Received) => {
    if (r.message instanceof ParamRequestList) {
      counted.lists += 1
    }
    if (r.message instanceof ParamRequestRead) {
      counted.reads += 1
    }
  })
  fe
}

async function list(fe: Frontend): Promise<string> throws Error {
  const l = decodeParamList((await fe.call("params.list")).p ?? Cbor.Null, "$")
  `${l.count} ${l.complete}`
}

/// The vehicle has a fingerprint and it has not changed: the list held is given, with no download.
async function reusesAListThatIsCurrent(): Promise<void> throws Error {
  const counted = new Counted()
  const fe = await connectWithFingerprint(counted, true)
  try {
    expect(await list(fe)).toBe("13 true")
    expect(await list(fe)).toBe("13 true")
    expect(await list(fe)).toBe("13 true")
    expect(counted.lists).toBe(1)
  } finally {
    await fe.call("vehicle.disconnect")
  }
}

/// A vehicle with no fingerprint cannot prove a list is current: it is downloaded each time.
async function downloadsWithoutAFingerprint(): Promise<void> throws Error {
  const counted = new Counted()
  const fe = await connectWithFingerprint(counted, false)
  try {
    expect(await list(fe)).toBe("12 true")
    expect(await list(fe)).toBe("12 true")
    expect(await list(fe)).toBe("12 true")
    // Asked for the fingerprint once (twice: one retry), and not again for each list.
    expect(`${counted.lists} ${counted.reads}`).toBe("3 2")
  } finally {
    await fe.call("vehicle.disconnect")
  }
}

/// The fingerprint differs from the one the list was downloaded under (a parameter changed with nobody announcing it):
/// the list is downloaded again, and shows the new value.
async function downloadsWhenTheFingerprintChanged(): Promise<void> throws Error {
  const counted = new Counted()
  const fe = await connectWithFingerprint(counted, true)
  try {
    expect(await list(fe)).toBe("13 true")
    const sim = simulatorForTests()!
    sim.params[12] = { id: "_HASH_CHECK", value: TypedParamValue.Int(222, MavParamType.INT32) }
    sim.params[8] = { id: "RTL_ALT", value: TypedParamValue.Int(3000, MavParamType.INT32) }
    const again = decodeParamList((await fe.call("params.list")).p ?? Cbor.Null, "$")
    expect(`${counted.lists} ${again.params.filter((p) => p.id == "RTL_ALT")[0].value}`).toBe("2 3000")
    // And the new list is the one held now.
    expect(await list(fe)).toBe("13 true")
    expect(counted.lists).toBe(2)
  } finally {
    await fe.call("vehicle.disconnect")
  }
}

/// A write, or a parameter the vehicle announces, makes the list held untrustworthy: the next list is downloaded.
async function forgetsTheListWhenAParameterChanges(): Promise<void> throws Error {
  const counted = new Counted()
  const fe = await connectWithFingerprint(counted, true)
  try {
    await list(fe)
    const w = ParamWrite { id: "WPNAV_SPEED", kind: ParamWriteKind.Real, type: "REAL32", value: 750.0 }
    await fe.call("params.write", encodeParamWrite(w))
    await list(fe)
    expect(counted.lists).toBe(2)
    simulatorForTests()!.change("RTL_ALT", TypedParamValue.Int(2500, MavParamType.INT32))
    await fe.event("params.changed")
    await list(fe)
    expect(counted.lists).toBe(3)
  } finally {
    await fe.call("vehicle.disconnect")
  }
}

/// Another vehicle never gets a list that was downloaded from the one before, even when their fingerprints are equal.
async function neverGivesAnotherVehiclesList(): Promise<void> throws Error {
  const counted = new Counted()
  const fe = await connectWithFingerprint(counted, true)
  try {
    await list(fe)
    link.identity = "another vehicle"
    await list(fe)
    expect(counted.lists).toBe(2)
  } finally {
    await fe.call("vehicle.disconnect")
  }
}

describe("the params service", () => {
  it("reuses the list held while the vehicle's fingerprint is the same", reusesAListThatIsCurrent)
  it("downloads each time when the vehicle has no fingerprint", downloadsWithoutAFingerprint)
  it("downloads again when the fingerprint changed", downloadsWhenTheFingerprintChanged)
  it("forgets the list held when a parameter is written or announced", forgetsTheListWhenAParameterChanges)
  it("never gives the list of another vehicle", neverGivesAnotherVehiclesList)
  it("refuses parameter calls without a vehicle", refusesWithoutAVehicle)
  it("cancels a write in flight when the user disconnects", disconnectCancels)
  it("passes on a parameter the vehicle announces", announcesChanges)
})
