// The connection service: connecting to a vehicle and watching the link.
import { Cbor, Communicator, RequestContext, Sink } from "pico-desktop/communicator"
import { delay } from "std/timers"
import {
  AutopilotVersionRead,
  ByteStream,
  MavAutopilot,
  MavLinkConnection,
  MavLinkProtocolV2,
  MavLinkRouter,
  MavType,
  SimulatedAutopilot,
  Vehicle,
  VehicleDiscovery,
  defaultRegistry,
} from "padcom/pico-mavlink"
import { Connection, ConnectionState, ConnectRequestTransport, decodeConnectRequest, encodeConnection } from "./generated/app"
import { GuardedStream } from "./guarded"
import { APP_COMPID, Beats, GCS_SYSID } from "./heartbeat"
import { counted } from "./linkstats"
import { reopenable, watchSession } from "./reconnect"
import { recorded } from "./recording"
import { boardOf, capabilitiesOf, encodingFor, identityOf, infoOf, link } from "./session"
import { keysRead, readKeys, settle, signForVehicle, watchBeats } from "./signing"
import { describe, openDetecting } from "./transports"
import { DetectError, WINDOW_MS } from "./autodetect"

/// Registers the service's methods and subscription on `c`.
export function register(c: Communicator): void {
  c.handle("vehicle.connect", connectVehicle)
  c.handle("vehicle.disconnect", disconnectVehicle)
  c.publish("vehicle.connection", watchConnection)
}

/// The first autopilot (not a ground station) heard, if any.
function autopilotSeen(d: VehicleDiscovery): Vehicle? {
  for (const v of d.vehicles()) {
    if (v.type != MavType.GCS && v.autopilot != MavAutopilot.INVALID) {
      return v
    }
  }
  return null
}

/// Receives until the connection ends. The router stays open when a link drops (reconnect.pi brings it back), so this
/// ends only when the session is closed, or when reading fails for good: then, if it's still the current one, it's lost.
async function watchLink(conn: MavLinkConnection, generation: int): Promise<void> {
  try {
    await conn.run()
  } catch (e: Error) {
    // A failed read ends the link like a closed one.
  }
  if (link.generation == generation && link.state.state == ConnectionState.Connected) {
    link.update(Connection { state: ConnectionState.Lost, vehicle: link.state.vehicle, error: "the link closed" })
  }
}

async function connectVehicle(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const asked = decodeConnectRequest(payload ?? Cbor.Null, "$")
  link.close()
  const generation = link.generation
  link.update(Connection { state: ConnectionState.Connecting })
  let stream: ByteStream? = null
  // What reconnects use: for a serial request that left the port or the rate to be found, the ones that were (#27).
  let request = asked
  try {
    const onSimulator = (sim: SimulatedAutopilot) => link.adoptSimulator(sim)
    const opened = await openDetecting(asked, onSimulator, WINDOW_MS, () => link.generation == generation)
    if (opened == null || link.generation != generation) {
      opened?.stream.close()
      return encodeConnection(link.state)
    }
    request = opened!.request
    // A link that is opened again later may be closed by the session while the router holds it (see guarded.pi).
    stream = if (reopenable(request)) new GuardedStream(opened!.stream) else opened!.stream
  } catch (e: Error) {
    if (e instanceof DetectError) {
      link.update(Connection { state: ConnectionState.Disconnected, error: `${describe(asked)}: ${e.message}`, errorCode: e.code })
    } else {
      link.update(Connection { state: ConnectionState.Disconnected, error: `can't open ${describe(asked)}: ${e.message}` })
    }
    return encodeConnection(link.state)
  }
  // The link goes under a router that stays open when the link ends (`keepOpen`): the connection and the
  // operations on it outlive a dropped link, and reconnect.pi adds a new link to the router when the old one
  // comes back (#28). `close()` closes the router and with it every link.
  const registry = defaultRegistry()
  // With `forward`, what one link delivers goes on to the others: the endpoints of the forwarding (forward.pi) are links too.
  // With the vehicle's link alone there is nothing to forward to.
  const router = new MavLinkRouter({ registry, keepOpen: true, forward: true })
  router.addLink(stream!)
  // (as the vehicle's ground station: its heartbeats count for the vehicle's GCS failsafe, whatever RC control does; see heartbeat.pi)
  // (what is sent is counted for the link's quality: linkstats.pi)
  // (and recorded, both ways, from here until the session ends: recording.pi)
  const conn = new MavLinkConnection(await recorded(counted(router)), { registry, protocol: new MavLinkProtocolV2(GCS_SYSID, APP_COMPID) })
  link.conn = conn
  link.router = router
  // Every heartbeat is kept as it came: whether it is signed, and with which key, says how the link signs (signing.pi).
  watchBeats(conn)
  if (reopenable(request)) {
    link.stream = stream
  }
  link.request = request
  const discovery = new VehicleDiscovery(conn)
  link.discovery = discovery
  watchLink(conn, generation)
  const beats = new Beats(conn)
  beats.start()
  link.beats = beats
  let waited = 0
  const waitMs = if (request.transport == ConnectRequestTransport.TcpServer) link.serverWaitMs else link.heartbeatWaitMs
  while (waited <= waitMs) {
    if (link.generation != generation) {
      return encodeConnection(link.state)
    }
    const v = autopilotSeen(discovery)
    if (v != null) {
      const found = v!
      link.sysid = found.sysid
      link.compid = found.compid
      link.autopilot = found.autopilot
      link.attach(conn)
      // Signed when a key is held that its heartbeats are signed with: the version is then asked for signed.
      if (!keysRead()) {
        await readKeys()
      }
      signForVehicle(conn)
      const version = await new AutopilotVersionRead(conn, { system: found.sysid, component: found.compid }, { timeoutMs: 500, retries: 1 }).run()
      link.encoding = encodingFor(found, version)
      link.capabilities = capabilitiesOf(version)
      link.ftpMemo = ""
      link.identity = identityOf(found, version)
      link.board = boardOf(found, version)
      link.typeMayChange = false
      settle()
      link.update(Connection { state: ConnectionState.Connected, vehicle: infoOf(found) })
      watchSession(generation)
      return encodeConnection(link.state)
    }
    await delay(50)
    waited += 50
  }
  link.close()
  link.update(Connection { state: ConnectionState.Disconnected, error: `no heartbeat from ${describe(request)}` })
  encodeConnection(link.state)
}

async function disconnectVehicle(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  link.close()
  link.update(Connection { state: ConnectionState.Disconnected })
  encodeConnection(link.state)
}

function watchConnection(_params: Cbor?, sink: Sink): void throws Error {
  sink.next(encodeConnection(link.state))
  link.watchers.push(sink)
  sink.onClose = () => {
    link.watchers = link.watchers.filter((w: Sink) => w.id != sink.id)
  }
}
