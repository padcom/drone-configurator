// The connection service: connecting to a vehicle and watching the link.
import { Cbor, Communicator, RequestContext, Sink } from "pico-desktop/communicator"
import { delay } from "std/timers"
import {
  Attitude,
  AutopilotVersionRead,
  ByteStream,
  CommandCall,
  HeartbeatSender,
  MavAutopilot,
  MavLinkConnection,
  MavType,
  ParamEncoding,
  Received,
  SimulatedAutopilot,
  SysStatus,
  Vehicle,
  VehicleDiscovery,
  encodingOf,
} from "padcom/pico-mavlink"
import { Connection, ConnectionState, VehicleInfo, decodeConnectRequest, encodeConnection } from "./generated/app"
import { link } from "./session"
import { describe, open } from "./transports"

/// Registers the service's methods and subscription on `c`.
export function register(c: Communicator): void {
  c.handle("vehicle.connect", connectVehicle)
  c.handle("vehicle.disconnect", disconnectVehicle)
  c.publish("vehicle.connection", watchConnection)
}

/// The first autopilot (not a ground station) heard, if any.
function autopilotSeen(d: VehicleDiscovery): Vehicle? {
  for (const v of d.vehicles()) {
    if (v.type != MavType.GCS && v.autopilot != MavAutopilot.INVALID) {
      return v
    }
  }
  null
}

/// Asks the vehicle for the telemetry the dashboard shows: SYS_STATUS once a second, ATTITUDE four
/// times (ArduPilot streams them only when asked, over some links). A refusal leaves them absent.
async function requestTelemetry(conn: MavLinkConnection, sysid: int, compid: int): Promise<void> {
  const calls = new CommandCall(conn, { system: sysid, component: compid }, { timeoutMs: 500, retries: 1, signal: link.session.signal })
  try {
    await calls.setMessageInterval(SysStatus.MSG_ID, 1_000_000)
    await calls.setMessageInterval(Attitude.MSG_ID, 250_000)
  } catch (e: Error) {
    // Not every autopilot supports it; telemetry then shows what arrives anyway.
  }
}

/// Receives until the link ends; then, if it's still the current one, it's lost.
async function watchLink(conn: MavLinkConnection, generation: int): Promise<void> {
  try {
    await conn.run()
  } catch (e: Error) {
    // A failed read ends the link like a closed one.
  }
  if (link.generation == generation && link.state.state == ConnectionState.Connected) {
    link.update(Connection { state: ConnectionState.Lost, vehicle: link.state.vehicle, error: "the link closed" })
  }
}

async function connectVehicle(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const request = decodeConnectRequest(payload ?? Cbor.Null, "$")
  link.close()
  const generation = link.generation
  link.update(Connection { state: ConnectionState.Connecting })
  let stream: ByteStream? = null
  try {
    stream = await open(request, (sim: SimulatedAutopilot) => { link.sim = sim })
  } catch (e: Error) {
    link.update(Connection { state: ConnectionState.Disconnected, error: `can't open ${describe(request)}: ${e.message}` })
    return encodeConnection(link.state)
  }
  const conn = new MavLinkConnection(stream!)
  link.conn = conn
  const discovery = new VehicleDiscovery(conn)
  link.discovery = discovery
  conn.on((r: Received) => link.seen(r))
  watchLink(conn, generation)
  const beats = new HeartbeatSender(conn)
  beats.start()
  link.beats = beats
  let waited = 0
  while (waited <= link.heartbeatWaitMs) {
    if (link.generation != generation) {
      return encodeConnection(link.state)
    }
    const v = autopilotSeen(discovery)
    if (v != null) {
      const found = v!
      link.sysid = found.sysid
      link.compid = found.compid
      link.autopilot = found.autopilot
      // How integers travel in parameter floats: as the autopilot says (AUTOPILOT_VERSION), or as
      // its kind usually does (PX4 bytewise; ArduPilot and most others C-cast).
      const guess = if (found.autopilot == MavAutopilot.PX4) ParamEncoding.Bytewise else ParamEncoding.CCast
      const version = await new AutopilotVersionRead(conn, { system: found.sysid, component: found.compid }, { timeoutMs: 500, retries: 1 }).run()
      link.encoding = if (version == null) guess else encodingOf(version!.capabilities) ?? guess
      const info = VehicleInfo {
        sysid: found.sysid as u8,
        compid: found.compid as u8,
        type: MavType.nameOf(found.type) ?? `${found.type}`,
        autopilot: MavAutopilot.nameOf(found.autopilot) ?? `${found.autopilot}`,
      }
      link.update(Connection { state: ConnectionState.Connected, vehicle: info })
      requestTelemetry(conn, found.sysid, found.compid)
      return encodeConnection(link.state)
    }
    await delay(50)
    waited += 50
  }
  link.close()
  link.update(Connection { state: ConnectionState.Disconnected, error: `no heartbeat from ${describe(request)}` })
  encodeConnection(link.state)
}

async function disconnectVehicle(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  link.close()
  link.update(Connection { state: ConnectionState.Disconnected })
  encodeConnection(link.state)
}

function watchConnection(_params: Cbor?, sink: Sink): void throws Error {
  sink.next(encodeConnection(link.state))
  link.watchers.push(sink)
  sink.onClose = () => {
    link.watchers = link.watchers.filter((w: Sink) => w.id != sink.id)
  }
}
