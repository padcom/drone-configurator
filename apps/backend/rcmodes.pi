// What a copter's flight mode does with the pilot's throttle, for an RC control whose throttle rests in the middle (plan
// `drone-configurator-joystick-backend.md`, section 11, from ArduCopter's source). The same table as the page's `lib/rc/modes.ts`;
// both are held to `packages/contracts/mode-vectors.txt`. A mode that is not here is `THRUST`: never the safe guess.

/// The throttle is a climb rate (its middle is no climb): Alt Hold, Loiter, Circle, Sport, Autotune, PosHold, Flowhold, ZigZag.
export const CLIMB: int = 0
/// The mode commands the altitude and takes no throttle from the pilot (Auto, Guided, RTL, Land, Brake ...): a centred stick does no harm.
export const IGNORES: int = 1
/// The throttle is thrust (its middle is about hover and the vehicle does not hold its altitude), and a mode that is not known.
export const THRUST: int = 2

/// What the mode `number` (the heartbeat's `custom_mode`) does with the pilot's throttle.
export function modeClass(number: int): int {
  return match (number) {
    2 => CLIMB,
    5 => CLIMB,
    7 => CLIMB,
    13 => CLIMB,
    15 => CLIMB,
    16 => CLIMB,
    22 => CLIMB,
    24 => CLIMB,
    3 => IGNORES,
    4 => IGNORES,
    6 => IGNORES,
    9 => IGNORES,
    17 => IGNORES,
    18 => IGNORES,
    19 => IGNORES,
    20 => IGNORES,
    21 => IGNORES,
    23 => IGNORES,
    26 => IGNORES,
    27 => IGNORES,
    _ => THRUST,
  }
}

/// Whether a control with a centred throttle may START in the mode `number`: only where the throttle is a climb rate (armed or not).
/// -1, no heartbeat yet, is not a mode.
export function startsIn(number: int): bool {
  return number >= 0 && modeClass(number) == CLIMB
}

/// Whether a control with a centred throttle may go on in the mode `number`: where the throttle is a climb rate, and where the mode takes
/// none from the pilot (a failsafe RTL, a Land, a mission). Any other mode, and one that is not known, ends it.
export function continuesIn(number: int): bool {
  return number >= 0 && modeClass(number) != THRUST
}

/// Whether the vehicle's MAV_TYPE is a multicopter (quad, hexa, octo, tri, dodeca, deca): a helicopter, a plane, a rover and the like are not.
export function isMulticopter(mavType: int): bool {
  return mavType == 2 || mavType == 13 || mavType == 14 || mavType == 15 || mavType == 29 || mavType == 35
}
