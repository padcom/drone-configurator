// The logs service: the flight logs on the vehicle, listed and downloaded over MAVLink FTP (`logs.vehicle.list`, `logs.download`
// with `logs.progress`, `logs.cancel`). The logs of ArduPilot are `/logs/NNNNNNNN.BIN` (8 digits), created when the vehicle arms
// (a directory that is not there yet is an empty list). `logs.erase` is not implemented (answered with UNSUPPORTED).
//
// A log is downloaded to `<data directory>/logs/<vehicle>/NNNNNNNN.BIN`. While it comes it is `NNNNNNNN.BIN.part`: a download
// that stops (cancelled, the vehicle armed, the link lost) leaves the part, and the next one goes on from its end. Only a copy
// whose CRC-32 is the vehicle's own (CalcFileCRC32) is renamed to its real name: that file is "downloaded" (and is the only kind
// that may one day be erased on the vehicle). A log that cannot be checked (the vehicle has no CRC) stays a part.
//
// The log of a flight that has just ended is still written to for a while, so the size in the listing is not final: the download
// asks for no size, and a CRC that differs because the file grew is chased: the download goes on from what it has (up to a few
// times) until the vehicle's CRC is the one of the bytes written.
//
// Safety: nothing is downloaded while the vehicle is armed (`ARMED`) or while that is not known (`STATE_UNKNOWN`), nor while a
// parameter operation runs or another download (`BUSY`); a download that runs is STOPPED when the vehicle arms. The listing of a
// directory that cannot be trusted (a name that is not UTF-8) is an error with the reason (`LOGS_UNAVAILABLE`), never a partial list.
import { Cbor, Communicator, CommunicatorError, RequestContext } from "pico-desktop/communicator"
import {
  Crc32,
  FileSink,
  FtpClient,
  FtpEntry,
  FtpError,
  Heartbeat,
  MavLinkConnection,
  MavModeFlag,
  Received,
  Target,
  downloadFile,
} from "padcom/pico-mavlink"
import { File, mkdir, open, remove, rename, stat } from "std/fs"
import { join } from "std/path"
import {
  LogsDownloaded,
  LogsProgress,
  LogsProgressState,
  VehicleLog,
  VehicleLogs,
  VehicleLogsSource,
  decodeLogsDownload,
  encodeLogsDownloaded,
  encodeLogsProgress,
  encodeVehicleLogs,
} from "./generated/app"
import { dataDirectory } from "./settings"
import { SessionPart, armedState, connectedLink, link } from "./session"

/// Where ArduPilot keeps its logs on the vehicle.
const LOG_DIRECTORY: string = "/logs"

/// How many times a download chases a log that grows while it is fetched (each time it goes on from what it has).
const CHASES: int = 4

/// At most this often (ms) a `logs.progress` is sent for the log that is coming (the first and the last always).
const PROGRESS_EVERY_MS: int = 100

/// How long the vehicle is given to compute the CRC of a log (ms): it reads the whole file.
const CRC_WAIT_MS: int = 30000

/// Registers the service's methods on `c`, and its part of the session.
export function register(c: Communicator): void {
  running.communicator = c
  link.parts.set("logs", running)
  c.handle("logs.vehicle.list", listLogs)
  c.handle("logs.download", downloadLogs)
  c.handle("logs.cancel", cancelDownload)
  c.handle("logs.erase", eraseLogs)
}

/// The log download that runs, if any, and the vehicle's arming, which stops it.
class Running implements SessionPart {
  public communicator: Communicator? = null
  public conn: MavLinkConnection? = null
  public listener: int = 0
  /// The download that runs, so that `logs.cancel`, the vehicle arming and the session ending can stop it.
  public download: AbortController? = null
  /// Why it was stopped, when it was not by `logs.cancel`: "" or the words.
  public stoppedFor: string = ""
  /// The session signal that is followed (once for each session, not once for each download).
  public followed: AbortSignal? = null
  /// When progress was last sent (ms since 1970).
  public progressAt: int = 0

  public attach(c: MavLinkConnection): void {
    if (conn != null) {
      detach()
    }
    conn = c
    listener = c.on((r: Received) => seen(r))
  }

  public detach(): void {
    const c = conn
    if (c != null) {
      c!.off(listener)
    }
    conn = null
  }

  /// A heartbeat that says the vehicle is armed stops the download that runs: the vehicle's card and its link are for flying.
  public seen(r: Received): void {
    if (download == null || link.sysid == 0 || r.packet.header.sysid != link.sysid || r.packet.header.compid != link.compid) {
      return
    }
    const m = r.message
    if (m instanceof Heartbeat && ((m.baseMode as int) & MavModeFlag.SAFETY_ARMED) != 0) {
      stop("the vehicle armed")
    }
  }

  /// Stops the download that runs, if any, and notes why (the first reason stays).
  public stop(why: string): void {
    const d = download
    if (d != null) {
      if (stoppedFor == "") {
        stoppedFor = why
      }
      d!.abort()
    }
  }

  /// Makes the session ending stop the download that runs. One listener on a session's signal, however many downloads it has.
  public follow(signal: AbortSignal): void {
    if (followed == signal) {
      return
    }
    followed = signal
    signal.addEventListener("abort", () => stop("the session ended"))
  }
}

const running = new Running()

/// The name of the log file of number `id`: eight digits and ".BIN".
export function nameOfLog(id: int): string {
  let digits = `${id}`
  while (digits.length < 8) {
    digits = `0${digits}`
  }
  `${digits}.BIN`
}

/// The number of a log file, or -1 when the name is not that of a log: eight digits and ".BIN" (LASTLOG.TXT and the like are not).
export function numberOfLog(name: string): int {
  if (name.length != 12 || name.slice(8, 12) != ".BIN") {
    return -1
  }
  let n = 0
  for (const ch of name.slice(0, 8).split("")) {
    const digit = "0123456789".indexOf(ch)
    if (digit < 0) {
      return -1
    }
    n = n * 10 + digit
  }
  n
}

/// The vehicle as a folder name: its identity, with what a path does not allow turned into '-'.
export function folderOf(identity: string): string {
  let out = ""
  for (const ch of identity.split("")) {
    out += if ("/:\\ ".indexOf(ch) >= 0) "-" else ch
  }
  if (out == "") "vehicle" else out
}

/// The folder the logs of the connected vehicle are kept in.
async function folder(): Promise<string> throws CommunicatorError {
  try {
    const root = await dataDirectory()
    return join(root, "logs", folderOf(link.identity))
  } catch (e: Error) {
    throw new CommunicatorError("NO_STORAGE", `can't use the folder for logs: ${e.message}`)
  }
}

/// The client for the vehicle's file transfer.
function clientFor(conn: MavLinkConnection, signal: AbortSignal?): FtpClient {
  const target: Target = { system: link.sysid, component: link.compid }
  if (signal == null) {
    return new FtpClient(conn, target, { timeoutMs: 1000, retries: 3 })
  }
  new FtpClient(conn, target, { timeoutMs: 1000, retries: 3, signal: signal! })
}

/// The log files of the vehicle, in the order it lists them: `.BIN` files of eight digits. A directory that is not there is none.
/// A listing that cannot be trusted is `LOGS_UNAVAILABLE`.
async function entriesOf(client: FtpClient): Promise<FtpEntry[]> throws CommunicatorError {
  let all: FtpEntry[] = []
  try {
    all = await client.listDirectory(LOG_DIRECTORY)
  } catch (e: FtpError) {
    if (e.code == "FTP_NOT_FOUND" || (e.code == "FTP_ERRNO" && e.errno == 2)) {
      return []
    }
    if (e.code == "FTP_PROTOCOL") {
      throw new CommunicatorError("LOGS_UNAVAILABLE", `the list of logs on the vehicle can't be trusted: ${e.message}`)
    }
    throw new CommunicatorError(e.code, e.message)
  }
  const logs: FtpEntry[] = []
  for (const e of all) {
    if (!e.directory && numberOfLog(e.name) >= 0) {
      logs.push(e)
    }
  }
  logs
}

/// The size of the file at `path`, or -1 when there is none.
async function sizeOf(path: string): Promise<int> {
  try {
    const info = await stat(path)
    if (info.isFile) info.size else -1
  } catch (e: Error) {
    -1
  }
}

/// A log of the vehicle as the contract has it. It is downloaded when a checked copy of the same size is here.
async function toLog(e: FtpEntry, dir: string): Promise<VehicleLog> {
  const have = await sizeOf(join(dir, e.name))
  const log = VehicleLog { id: numberOfLog(e.name) as u32, size: e.size as u32, downloaded: have == e.size }
  if (e.time != null) {
    // The vehicle gives seconds since 1970 (the time of the last write); the contract has milliseconds.
    log.time = (e.time! * 1000) as u64
  }
  log
}

async function listLogs(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const conn = connectedLink()
  if (running.download != null || link.listing) {
    throw new CommunicatorError("BUSY", "a download is running")
  }
  const dir = await folder()
  const entries = await entriesOf(clientFor(conn, link.session.signal))
  const logs: VehicleLog[] = []
  for (const e of entries) {
    logs.push(await toLog(e, dir))
  }
  encodeVehicleLogs(VehicleLogs { logs: logs, source: VehicleLogsSource.Ftp, canErase: false })
}

/// Why a log may not be downloaded now, as an error, or nothing: armed or not known to be disarmed, another download, a parameter
/// operation.
function refuse(): void throws CommunicatorError {
  const armed = armedState()
  if (armed == null) {
    throw new CommunicatorError("STATE_UNKNOWN", "the vehicle's state is unknown (no heartbeat for 3 s)")
  }
  if (armed!) {
    throw new CommunicatorError("ARMED", "the vehicle is armed")
  }
  if (running.download != null || link.listing || link.writes > 0) {
    throw new CommunicatorError("BUSY", "a download or a parameter operation is running")
  }
}

/// Tells the interface how a log is doing.
function say(id: int, state: LogsProgressState, received: int, total: int, resumedFrom: int): void {
  const c = running.communicator
  if (c == null) {
    return
  }
  const p = LogsProgress { id: id as u32, state: state, received: received as u32, total: total as u32 }
  if (resumedFrom > 0) {
    p.resumedFrom = resumedFrom as u32
  }
  c!.emit("logs.progress", encodeLogsProgress(p))
}

/// The part of a log being fetched: the file is written in order, and its CRC kept as it goes.
class PartFile implements FileSink {
  public readonly file: File
  public readonly crc: Crc32
  /// How many bytes the part holds.
  public total: int

  constructor(file: File, crc: Crc32, total: int) {
    this.file = file
    this.crc = crc
    this.total = total
  }

  public async write(bytes: Uint8Array): Promise<void> throws Error {
    await file.write(bytes)
    crc.update(bytes)
    total += bytes.length
  }
}

/// The CRC-32 of the bytes of a file, read a piece at a time.
async function crcOfFile(path: string): Promise<Crc32> throws Error {
  const crc = new Crc32()
  const f = await open(path)
  try {
    while (true) {
      const piece = await f.read(1048576)
      if (piece == null) {
        break
      }
      crc.update(piece!)
    }
  } catch (e: Error) {
    await f.close()
    throw e
  }
  await f.close()
  crc
}

/// How a log came: `done`, `stopped` (cancelled, the vehicle armed, the session ended: what came is kept), or `failed` with the
/// words for why.
class Outcome {
  public state: string = "done"
  public why: string = ""
}

function failed(why: string): Outcome {
  const o = new Outcome()
  o.state = "failed"
  o.why = why
  o
}

/// Downloads the log `id`, whose listing says `listed` bytes, to its folder: the part goes on from where it is, the file is renamed
/// to its real name when the vehicle's CRC is the one of the bytes. Told progress as `logs.progress`.
async function fetch(client: FtpClient, id: int, listed: int, dir: string): Promise<Outcome> {
  const name = nameOfLog(id)
  const whole = join(dir, name)
  const part = `${whole}.part`
  try {
    await mkdir(dir, true)
    const done = await sizeOf(whole)
    if (done == listed) {
      say(id, LogsProgressState.Done, done, done, 0)
      return new Outcome()
    }
    let held = await sizeOf(part)
    // A part longer than the log (the vehicle's log of that number is another one now) is no part of it.
    if (held > listed && listed > 0) {
      await remove(part)
      held = -1
    }
    const crc = if (held > 0) await crcOfFile(part) else new Crc32()
    const file = await open(part, false, true, true, true)
    const sink = new PartFile(file, crc, if (held > 0) held else 0)
    const outcome = await chase(client, id, listed, sink, if (held > 0) held else 0)
    await file.close()
    if (outcome.state == "done") {
      await rename(part, whole)
    } else if (outcome.state == "failed" && outcome.why.startsWith("the copy does not match")) {
      // Bytes that do not match the vehicle's file and did not grow with it are of no use to a resume.
      await remove(part)
    }
    return outcome
  } catch (e: Error) {
    return failed(`log ${id}: ${e.message}`)
  }
}

/// The downloads of one log: the first, and the ones that follow a CRC that differs because the file grew.
async function chase(client: FtpClient, id: int, listed: int, sink: PartFile, startedAt: int): Promise<Outcome> throws Error {
  const remote = `${LOG_DIRECTORY}/${nameOfLog(id)}`
  let last = ""
  for (let attempt = 0; attempt < CHASES; attempt++) {
    try {
      const got = await downloadFile(
        client, remote, sink, sink.total, sink.crc.crc, -1,
        (bytes: int, estimate: int) => progressed(id, bytes, estimate, listed, startedAt),
        250, 0, 2000000000, true, CRC_WAIT_MS,
      )
      if (!got.verified) {
        return failed(`log ${id} could not be checked by the vehicle (${got.crcError}); it is kept as a part`)
      }
      say(id, LogsProgressState.Done, got.size, got.size, startedAt)
      return new Outcome()
    } catch (e: FtpError) {
      if (e.code == "FTP_ABORTED") {
        return stopped()
      }
      if (e.code != "FTP_CRC") {
        return failed(`log ${id}: ${e.message}`)
      }
      last = e.message
    }
  }
  failed(`the copy does not match the vehicle's file after ${CHASES} tries (${last})`)
}

function stopped(): Outcome {
  const o = new Outcome()
  o.state = "stopped"
  o
}

/// Progress of the log that comes, at most every `PROGRESS_EVERY_MS`; the total is the larger of the listing's size and what has come.
function progressed(id: int, bytes: int, estimate: int, listed: int, resumedFrom: int): void {
  const now = Date.now() as int
  const total = if (bytes > listed) bytes else if (estimate > listed) estimate else listed
  if (running.progressAt != 0 && bytes < total && now - running.progressAt < PROGRESS_EVERY_MS) {
    return
  }
  running.progressAt = now
  say(id, LogsProgressState.Downloading, bytes, total, resumedFrom)
}

async function downloadLogs(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const asked = decodeLogsDownload(payload ?? Cbor.Null, "$")
  const conn = connectedLink()
  refuse()
  const dir = await folder()
  const own = new AbortController()
  running.follow(link.session.signal)
  running.download = own
  running.stoppedFor = ""
  running.progressAt = 0
  link.logging = true
  const finished: u32[] = []
  let error = ""
  let stoppedEarly = false
  try {
    const client = clientFor(conn, own.signal)
    const listing = await entriesOf(client)
    const wanted: u32[] = []
    for (const id of asked.ids) {
      if (!wanted.includes(id)) {
        wanted.push(id)
      }
    }
    for (const id of wanted) {
      const entry = listing.find((e: FtpEntry) => numberOfLog(e.name) == (id as int))
      say(id as int, LogsProgressState.Queued, 0, if (entry == null) 0 else entry!.size, 0)
    }
    for (const id of wanted) {
      if (own.signal.aborted) {
        stoppedEarly = true
        break
      }
      const entry = listing.find((e: FtpEntry) => numberOfLog(e.name) == (id as int))
      if (entry == null) {
        say(id as int, LogsProgressState.Failed, 0, 0, 0)
        error = `log ${id} is not on the vehicle`
        stoppedEarly = true
        break
      }
      const outcome = await fetch(client, id as int, entry!.size, dir)
      if (outcome.state == "done") {
        finished.push(id)
      } else {
        stoppedEarly = true
        if (outcome.state == "failed") {
          say(id as int, LogsProgressState.Failed, 0, entry!.size, 0)
          error = outcome.why
        }
        break
      }
    }
  } finally {
    link.logging = false
    running.download = null
  }
  const why = running.stoppedFor
  running.stoppedFor = ""
  const result = LogsDownloaded { ids: finished, stopped: stoppedEarly }
  if (error != "") {
    result.error = error
  } else if (why != "") {
    result.error = `the download was stopped: ${why}`
  }
  encodeLogsDownloaded(result)
}

/// Stops the download that runs, if any: what came is kept.
async function cancelDownload(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  running.stop("")
  null
}

/// Erasing logs on the vehicle needs a file removal that the file transfer here does not have yet.
async function eraseLogs(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  throw new CommunicatorError("UNSUPPORTED", "erasing the logs on the vehicle is not available yet")
}
