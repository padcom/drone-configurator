// Our heartbeat, as a ground station. pico-mavlink's HeartbeatSender sends without waiting for the result, so a send that
// fails (a router whose links are all down, which is what the session is between two tries to bring a link back) is an
// error nobody catches, and ends the process. This one waits for it and goes on: a heartbeat that did not leave is
// simply the next one.
import { MavLinkConnection, Heartbeat, MavAutopilot, MavState, MavType } from "padcom/pico-mavlink"

/// The system id the app speaks with: ArduPilot's `MAV_GCS_SYSID` (255 by default). The vehicle takes overrides from it, and it is the
/// only id whose traffic the vehicle's GCS failsafe (`FS_GCS_ENABLE`, `FS_GCS_TIMEOUT`) counts as "the ground station is there": its
/// HEARTBEAT, and also an RC_CHANNELS_OVERRIDE or a MANUAL_CONTROL. A heartbeat from another id (the library's default is 254) is not
/// seen by it, so that once the RC sender had spoken as 255 and stopped, the vehicle failsafed 5 s later with a healthy link, and refused
/// to arm ("PreArm: GCS failsafe on") until a 255 message came again. Every connection of the app speaks as this id.
export const GCS_SYSID: int = 255

/// The component id of the app's main connection (the heartbeats, the requests). Not the autopilot's (1), and not the RC sender's
/// (190, Mission Planner's), so that two connections of one system id do not look like one sender to a router (it drops a frame that has
/// the same system, component, sequence number and message as one it has just passed).
export const APP_COMPID: int = 191

export class Beats {
  readonly conn: MavLinkConnection
  readonly intervalMs: int
  timer: int = -1

  constructor(conn: MavLinkConnection, intervalMs: int = 1000) {
    this.conn = conn
    this.intervalMs = intervalMs
  }

  /// One HEARTBEAT now, then every interval.
  public start(): void {
    beat()
    timer = setInterval(() => beat(), intervalMs)
  }

  public stop(): void {
    clearInterval(timer)
    timer = -1
  }

  async beat(): Promise<void> {
    const h = new Heartbeat()
    h.type = MavType.GCS as u8
    h.autopilot = MavAutopilot.INVALID as u8
    h.systemStatus = MavState.ACTIVE as u8
    h.mavlinkVersion = 3
    try {
      await conn.send(h)
    } catch (e: Error) {
      // No link took it (all are down): the next heartbeat goes when there is one.
    }
  }
}
