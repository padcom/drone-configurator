// The files of the Plan page: QGroundControl's `.plan` (JSON) and Mission Planner's `.waypoints` (text), read and written as plain data. Pure
// functions over text: no files, no link; the page's file dialogs hand the text over and take the text that is written.
//
// CLEAN ROOM. Only the two formats as they are published and the MAVLink protocol are used: the `.plan` document's members (`fileType`,
// `mission.items[]` with `SimpleItem` and `ComplexItem`, `plannedHomePosition`, `cruiseSpeed`, `geoFence`, `rallyPoints`) and the `.waypoints`
// line (`QGC WPL 110`, then `seq current frame command p1 p2 p3 p4 x y z autocontinue`, separated by tabs, the first line after the header being
// home). Nothing is copied from either program's source or text.
//
// A FILE IS DATA. It is never executed, its path is not here (the host's dialog gives text), and everything is bounded BEFORE it is looked at:
//  - at most `MAX_FILE_BYTES` of text (`TOO_BIG`), `MAX_ITEMS` mission items, `MAX_ZONES` fence zones with `MAX_VERTICES` vertices in all and
//    `MAX_RALLY` rally points (`TOO_MANY`);
//  - every number is checked: a command is 0 to 65535, a frame 0 to 255, a latitude and longitude of a place are on the globe, the altitude and
//    the parameters are numbers, and a NaN is taken only where ArduPilot takes it (param4, the yaw, of a waypoint, loiter unlimited, land,
//    takeoff and VTOL takeoff; params 2 to 4 of an arc; 3 and 4 of VTOL land: `nanAllowed`, the rule of pico-mavlink's mission client); anything
//    else is `BAD_ITEM` with the item's place (`.plan`: its index; `.waypoints`: the line).
//  - the `.plan`'s COMPLEX ITEMS (a survey, a corridor scan, a structure scan: QGC expands them when it flies) are NOT expanded here: a file that
//    has any is refused (`COMPLEX_ITEMS`, with how many), unless the caller says to skip them; they are then counted in `skipped`, never silently
//    dropped. A mission item of a command the page does not know is kept as it is (`known` false: shown read-only, written unchanged).
//  - `current` of a `.waypoints` line is 0 or 1 (ArduPilot takes 2 and 3 for orders to a flying vehicle, so they are `BAD_LINE`).
// What is written is read back as the same plan (`planfiles.test.pi`): the numbers are written in full, a NaN as `null` (`.plan`, as QGC does) or
// `NaN` (`.waypoints`).

/// Whether a number is a number (not NaN, not infinite).
function isFinite(x: f64): bool {
  return (x - x) == 0.0
}

/// The longest file taken (bytes of text), and the most of each part of a plan.
export const MAX_FILE_BYTES: int = 1000000
export const MAX_ITEMS: int = 2000
export const MAX_ZONES: int = 200
export const MAX_VERTICES: int = 2000
export const MAX_RALLY: int = 200
/// The fewest vertices of a fence polygon (two points are a line, which fences nothing).
export const MIN_VERTICES: int = 3

/// MAV_CMDs the page knows how to edit (the others are kept, read-only).
const KNOWN: int[] = [16, 17, 18, 19, 20, 21, 22, 112, 177, 178, 179, 181, 183, 201, 203, 206]

/// MAV_AUTOPILOT_ARDUPILOTMEGA and MAV_TYPE_QUADROTOR, which a written `.plan` says.
const FIRMWARE_ARDUPILOT: int = 3
const VEHICLE_QUADROTOR: int = 2

/// Why a file was not taken. `code`: `TOO_BIG`, `TOO_MANY`, `NOT_JSON`, `NOT_A_PLAN`, `COMPLEX_ITEMS`, `BAD_ITEM`, `NOT_WAYPOINTS`, `BAD_LINE`.
/// `at` is where: the index of the item in a `.plan` (-1: not one), the line (from 1) in a `.waypoints` (0: not one).
export class PlanFileError extends Error {
  public readonly code: string
  public readonly at: int

  constructor(code: string, message: string, at: int = -1) {
    super(message)
    this.code = code
    this.at = at
  }
}

/// A place: degrees and metres (the frame of its altitude is the item's).
export struct PlanPoint {
  lat: f64
  lon: f64
  alt: f64
}

/// One item of a mission, as the file has it. `p1` to `p4` are the command's parameters, NaN where a file says none.
export class PlanItem {
  public command: int
  public frame: int
  public p1: f64 = 0.0
  public p2: f64 = 0.0
  public p3: f64 = 0.0
  public p4: f64 = 0.0
  public lat: f64 = 0.0
  public lon: f64 = 0.0
  public alt: f64 = 0.0
  public autocontinue: bool = true
  /// Whether the page knows the command (an item it does not is read-only and written unchanged).
  public known: bool = true

  constructor(command: int, frame: int) {
    this.command = command
    this.frame = frame
    this.known = isKnownCommand(command)
  }
}

/// A fence zone: a polygon (`points`, `inclusion` or not) or a circle (the centre in `points[0]`, `radius` in metres).
export class FenceZone {
  public circle: bool = false
  public inclusion: bool = true
  public radius: f64 = 0.0
  public points: PlanPoint[] = []
}

/// What a file holds. `home` is where the plan says home is (null: it says nothing); `cruiseSpeed` NaN when it says none; `skipped` how many
/// complex items were left out (only when asked to).
export class Plan {
  public home: PlanPoint? = null
  public cruiseSpeed: f64 = 0.0 / 0.0
  public items: PlanItem[] = []
  public fence: FenceZone[] = []
  public rally: PlanPoint[] = []
  public skipped: int = 0
}

/// Whether the page knows how to edit `command`.
export function isKnownCommand(command: int): bool {
  return KNOWN.includes(command)
}

/// The parameters of `command` that ArduPilot lets be NaN, as bits (bit 0 is param1 ... bit 3 is param4): param4 (the yaw, "no change") of
/// NAV_WAYPOINT (16), NAV_LOITER_UNLIM (17), NAV_LAND (21), NAV_TAKEOFF (22) and NAV_VTOL_TAKEOFF (84); params 2 to 4 of NAV_ARC_WAYPOINT
/// (36); params 3 and 4 of NAV_VTOL_LAND (85). The same rule as pico-mavlink's mission client (AP_Mission::sanity_check_params).
export function nanAllowed(command: int): int {
  if (command == 16 || command == 17 || command == 21 || command == 22 || command == 84) {
    return 8
  }
  if (command == 36) {
    return 14
  }
  if (command == 85) {
    return 12
  }
  return 0
}

/// Whether the x and y of `frame` are a latitude and a longitude (the global frames: 0, 3, 5, 6, 10 and 11).
export function isGlobalFrame(frame: int): bool {
  return frame == 0 || frame == 3 || frame == 5 || frame == 6 || frame == 10 || frame == 11
}

/// Whether `v` is a number or a NaN that is allowed (`allowed`: bit `bit` of `nanAllowed`).
function numberOk(v: f64, allowed: int, bit: int): bool {
  if (v != v) {
    return (allowed & (1 << bit)) != 0
  }
  return isFinite(v)
}

/// The problem with an item, or "" when it is right: a command or a frame out of range, a parameter or an altitude that is not a number (a
/// NaN only where the vehicle takes one), a place off the globe in a global frame.
export function problemOf(item: PlanItem): string {
  if (item.command < 0 || item.command > 65535) {
    return `command ${item.command} is not 0 to 65535`
  }
  if (item.frame < 0 || item.frame > 255) {
    return `frame ${item.frame} is not 0 to 255`
  }
  const allowed = nanAllowed(item.command)
  if (!numberOk(item.p1, allowed, 0) || !numberOk(item.p2, allowed, 1) || !numberOk(item.p3, allowed, 2) || !numberOk(item.p4, allowed, 3)) {
    return "a parameter is not a number the vehicle takes"
  }
  if (!isFinite(item.lat) || !isFinite(item.lon) || !isFinite(item.alt)) {
    return "the place or the altitude is not a number"
  }
  if (isGlobalFrame(item.frame) && (item.lat < -90.0 || item.lat > 90.0 || item.lon < -180.0 || item.lon > 180.0)) {
    return "the place is off the globe"
  }
  return ""
}

/// The problem with a point, or "": a latitude and longitude on the globe, and a finite altitude.
function pointProblem(lat: f64, lon: f64, alt: f64): string {
  if (!isFinite(lat) || !isFinite(lon) || !isFinite(alt) || lat < -90.0 || lat > 90.0 || lon < -180.0 || lon > 180.0) {
    return "the place is off the globe or not a number"
  }
  return ""
}

/// Whether `text` is longer than `MAX_FILE_BYTES` BYTES (a string's length counts code points, which are 1 to 4 bytes): the code points are
/// counted first (more of them than the most bytes is too big at once), the bytes only for a text that could still fit.
function tooBig(text: string): bool {
  if (text.length > MAX_FILE_BYTES) {
    return true
  }
  let bytes = 0
  for (let i = 0; i < text.length; i++) {
    const code = text[i] as int
    bytes += if (code < 0x80) 1 else if (code < 0x800) 2 else if (code < 0x10000) 3 else 4
    if (bytes > MAX_FILE_BYTES) {
      return true
    }
  }
  return false
}

/// MAV_CMD_DO_JUMP: param1 is the item to go on from (its seq in a mission; in a `.plan` its `doJumpId`).
const DO_JUMP: int = 177

/// Whether a home is "none": a vehicle (and the app's own telemetry) takes 0, 0 for a home that is not known.
function noHome(lat: f64, lon: f64): bool {
  return lat == 0.0 && lon == 0.0
}

/// The problem with the plan's jumps, or "": the target of a DO_JUMP is a whole number from 1 to the number of items (ArduPilot refuses a jump
/// to 0 or beyond the end). The index of the item with the problem is `at`.
function jumpProblem(items: PlanItem[]): PlanFileError? {
  for (let i = 0; i < items.length; i++) {
    if (items[i].command == DO_JUMP) {
      const target = items[i].p1
      if (!isFinite(target) || target != Math.floor(target) || target < 1.0 || target > items.length as f64) {
        return new PlanFileError("BAD_JUMP", `item ${i + 1}: a jump to ${target}, which is no item of the mission (1 to ${items.length})`, i)
      }
    }
  }
  return null
}

// ---------------------------------------------------------------------------------------------------------------------------------------------
// QGroundControl's .plan
// ---------------------------------------------------------------------------------------------------------------------------------------------

/// The shape of a `.plan` that is read: what is not here is let go (JSON.parse skips what a type does not name), what is here may be missing.
class QgcItem {
  public type: string = ""
  public command: int? = null
  public frame: int? = null
  public params: f64?[]? = null
  public autoContinue: bool? = null
  public doJumpId: int? = null
  public complexItemType: string? = null
}

class QgcMission {
  public items: QgcItem[]? = null
  public plannedHomePosition: f64[]? = null
  public cruiseSpeed: f64? = null
}

class QgcCircleBody {
  public center: f64[]? = null
  public radius: f64? = null
}

class QgcCircle {
  public circle: QgcCircleBody? = null
  public inclusion: bool? = null
}

class QgcPolygon {
  public polygon: f64[][]? = null
  public inclusion: bool? = null
}

class QgcFence {
  public circles: QgcCircle[]? = null
  public polygons: QgcPolygon[]? = null
}

class QgcRally {
  public points: f64[][]? = null
}

class QgcPlan {
  public fileType: string? = null
  public mission: QgcMission? = null
  public geoFence: QgcFence? = null
  public rallyPoints: QgcRally? = null
}

/// A `.plan`'s text as a plan. A complex item makes it `COMPLEX_ITEMS` unless `skipComplex` (then they are counted in `skipped`).
export function parseQgcPlan(text: string, skipComplex: bool): Plan throws PlanFileError {
  if (tooBig(text)) {
    throw new PlanFileError("TOO_BIG", `the file is longer than ${MAX_FILE_BYTES} bytes`)
  }
  let doc: QgcPlan = new QgcPlan()
  try {
    doc = JSON.parse<QgcPlan>(text)
  } catch (e: Error) {
    throw new PlanFileError("NOT_JSON", `not a .plan file: ${e.message}`)
  }
  const kind = doc.fileType
  if (kind == null || kind! != "Plan") {
    throw new PlanFileError("NOT_A_PLAN", "the file says it is not a Plan (fileType)")
  }
  const plan = new Plan()
  const mission = doc.mission
  if (mission != null) {
    readMission(mission!, plan, skipComplex)
  }
  const fence = doc.geoFence
  if (fence != null) {
    readFence(fence!, plan)
  }
  const rally = doc.rallyPoints
  if (rally != null) {
    readRally(rally!, plan)
  }
  return plan
}

function pointOf(numbers: f64[], what: string, at: int): PlanPoint throws PlanFileError {
  if (numbers.length < 2) {
    throw new PlanFileError("BAD_ITEM", `${what} has fewer than two numbers`, at)
  }
  const alt = if (numbers.length > 2) numbers[2] else 0.0
  const why = pointProblem(numbers[0], numbers[1], alt)
  if (why != "") {
    throw new PlanFileError("BAD_ITEM", `${what}: ${why}`, at)
  }
  const p: PlanPoint = { lat: numbers[0], lon: numbers[1], alt: alt }
  return p
}

function readMission(mission: QgcMission, plan: Plan, skipComplex: bool): void throws PlanFileError {
  const speed = mission.cruiseSpeed
  if (speed != null) {
    if (!isFinite(speed!) || speed! <= 0.0) {
      throw new PlanFileError("BAD_ITEM", `the cruise speed ${speed!} is not more than 0`)
    }
    plan.cruiseSpeed = speed!
  }
  const home = mission.plannedHomePosition
  if (home != null) {
    const place = pointOf(home!, "the planned home position", -1)
    // (0, 0 is what a plan says when it has no home: not a home on the equator at the meridian)
    plan.home = if (noHome(place.lat, place.lon)) null else place
  }
  const items = mission.items ?? []
  if (items.length > MAX_ITEMS) {
    throw new PlanFileError("TOO_MANY", `${items.length} mission items are more than ${MAX_ITEMS}`)
  }
  // The `doJumpId` of each item that is kept and its seq (its place, from 1): a DO_JUMP's param1 names an id, and the plan holds the seq.
  const seqOfId = new Map<int, int>()
  // The jumps that were kept: their place in the plan and in the file.
  const jumpsKept: int[] = []
  const jumpsInFile: int[] = []
  let complex = 0
  for (let i = 0; i < items.length; i++) {
    if (items[i].type == "SimpleItem") {
      const item = simpleItem(items[i], i)
      plan.items.push(item)
      const id = items[i].doJumpId
      if (id != null) {
        if (seqOfId.has(id!)) {
          throw new PlanFileError("BAD_ITEM", `item ${i}: the doJumpId ${id!} is the one of another item`, i)
        }
        seqOfId.set(id!, plan.items.length)
      }
      if (item.command == DO_JUMP) {
        jumpsKept.push(plan.items.length - 1)
        jumpsInFile.push(i)
      }
    } else if (items[i].type == "ComplexItem") {
      complex += 1
    } else {
      throw new PlanFileError("BAD_ITEM", `item ${i} is a "${items[i].type}", not a SimpleItem or a ComplexItem`, i)
    }
  }
  if (complex > 0) {
    if (!skipComplex) {
      throw new PlanFileError("COMPLEX_ITEMS", `${complex} complex items (a survey, a corridor or a structure scan) are not supported: skip them or fly them in QGroundControl`)
    }
    plan.skipped = complex
  }
  // A jump's param1 is the `doJumpId` of its target in a `.plan`: it becomes the target's seq. An id that names no item that was kept (one
  // that is not there, or that was a skipped complex item) is `BAD_JUMP`.
  for (let n = 0; n < jumpsKept.length; n++) {
    const item = plan.items[jumpsKept[n]]
    const id = item.p1
    const known = isFinite(id) && id == Math.floor(id) && id >= -2147483648.0 && id <= 2147483647.0
    const seq = if (known) seqOfId.get(id as int) else null
    if (seq == null) {
      throw new PlanFileError("BAD_JUMP", `item ${jumpsInFile[n]}: a jump to the doJumpId ${id}, which is the id of no item that was kept`, jumpsInFile[n])
    }
    item.p1 = seq! as f64
  }
}

function simpleItem(q: QgcItem, at: int): PlanItem throws PlanFileError {
  const command = q.command
  const frame = q.frame
  const params = q.params
  if (command == null || frame == null || params == null || params!.length != 7) {
    throw new PlanFileError("BAD_ITEM", `item ${at} has no command, frame and seven params`, at)
  }
  const item = new PlanItem(command!, frame!)
  const p = params!
  item.p1 = numberOrNaN(p[0])
  item.p2 = numberOrNaN(p[1])
  item.p3 = numberOrNaN(p[2])
  item.p4 = numberOrNaN(p[3])
  // (params 5 to 7 are the place: a null there is not read as a 0, which would be a place; the file is refused, saying so)
  if (p[4] == null || p[5] == null || p[6] == null) {
    throw new PlanFileError("BAD_ITEM", `item ${at}: params 5 to 7 (the place and the altitude) must be numbers, not null`, at)
  }
  item.lat = numberOrNaN(p[4])
  item.lon = numberOrNaN(p[5])
  item.alt = numberOrNaN(p[6])
  const keep = q.autoContinue
  item.autocontinue = if (keep == null) true else keep!
  const why = problemOf(item)
  if (why != "") {
    throw new PlanFileError("BAD_ITEM", `item ${at}: ${why}`, at)
  }
  return item
}

/// A param as the file has it: a number, or null for a NaN.
function numberOrNaN(v: f64?): f64 {
  if (v == null) {
    return 0.0 / 0.0
  }
  return v!
}

function readFence(fence: QgcFence, plan: Plan): void throws PlanFileError {
  const circles = fence.circles ?? []
  const polygons = fence.polygons ?? []
  if (circles.length + polygons.length > MAX_ZONES) {
    throw new PlanFileError("TOO_MANY", `${circles.length + polygons.length} fence zones are more than ${MAX_ZONES}`)
  }
  let vertices = 0
  for (let i = 0; i < polygons.length; i++) {
    const poly = polygons[i].polygon
    if (poly == null || poly!.length < MIN_VERTICES) {
      throw new PlanFileError("BAD_ITEM", `fence polygon ${i} has fewer than ${MIN_VERTICES} vertices`, i)
    }
    vertices += poly!.length
    if (vertices > MAX_VERTICES) {
      throw new PlanFileError("TOO_MANY", `more than ${MAX_VERTICES} fence vertices`)
    }
    const zone = new FenceZone()
    const inc = polygons[i].inclusion
    zone.inclusion = if (inc == null) true else inc!
    for (const v of poly!) {
      zone.points.push(pointOf(v, `fence polygon ${i}`, i))
    }
    plan.fence.push(zone)
  }
  for (let i = 0; i < circles.length; i++) {
    const body = circles[i].circle
    if (body == null || body!.center == null || body!.radius == null) {
      throw new PlanFileError("BAD_ITEM", `fence circle ${i} has no centre and radius`, i)
    }
    const radius = body!.radius!
    if (!isFinite(radius) || radius <= 0.0) {
      throw new PlanFileError("BAD_ITEM", `fence circle ${i}: the radius is not more than 0`, i)
    }
    const zone = new FenceZone()
    zone.circle = true
    const inc = circles[i].inclusion
    zone.inclusion = if (inc == null) true else inc!
    zone.radius = radius
    zone.points.push(pointOf(body!.center!, `fence circle ${i}`, i))
    plan.fence.push(zone)
  }
}

function readRally(rally: QgcRally, plan: Plan): void throws PlanFileError {
  const points = rally.points ?? []
  if (points.length > MAX_RALLY) {
    throw new PlanFileError("TOO_MANY", `${points.length} rally points are more than ${MAX_RALLY}`)
  }
  for (let i = 0; i < points.length; i++) {
    plan.rally.push(pointOf(points[i], `rally point ${i}`, i))
  }
}

/// A number as JSON: in full, and `null` for a NaN (as QGroundControl writes it).
function jsonNumber(v: f64): string {
  if (v != v) {
    return "null"
  }
  return `${v}`
}

function jsonPoint(p: PlanPoint, withAltitude: bool): string {
  return if (withAltitude) `[${jsonNumber(p.lat)}, ${jsonNumber(p.lon)}, ${jsonNumber(p.alt)}]` else `[${jsonNumber(p.lat)}, ${jsonNumber(p.lon)}]`
}

/// Refuses what the readers refuse (a plan that is written is a plan that is read back): an item that is wrong (`problemOf`), a jump to no
/// item, too many items, zones, vertices or rally points, a polygon of fewer than three vertices, a circle of no radius, a place off the
/// globe, a cruise speed that is not more than 0 (a NaN is none). `PlanFileError` with the item's place in `at`.
export function checkPlan(plan: Plan): void throws PlanFileError {
  if (plan.items.length > MAX_ITEMS) {
    throw new PlanFileError("TOO_MANY", `${plan.items.length} mission items are more than ${MAX_ITEMS}`)
  }
  for (let i = 0; i < plan.items.length; i++) {
    const why = problemOf(plan.items[i])
    if (why != "") {
      throw new PlanFileError("BAD_ITEM", `item ${i}: ${why}`, i)
    }
  }
  const bad = jumpProblem(plan.items)
  if (bad != null) {
    throw bad!
  }
  if (plan.cruiseSpeed == plan.cruiseSpeed && !(isFinite(plan.cruiseSpeed) && plan.cruiseSpeed > 0.0)) {
    throw new PlanFileError("BAD_ITEM", `the cruise speed ${plan.cruiseSpeed} is not more than 0`)
  }
  const home = plan.home
  if (home != null && pointProblem(home!.lat, home!.lon, home!.alt) != "") {
    throw new PlanFileError("BAD_ITEM", "the home is off the globe or not a number")
  }
  if (plan.fence.length > MAX_ZONES) {
    throw new PlanFileError("TOO_MANY", `${plan.fence.length} fence zones are more than ${MAX_ZONES}`)
  }
  let vertices = 0
  for (let i = 0; i < plan.fence.length; i++) {
    const z = plan.fence[i]
    vertices += z.points.length
    if (vertices > MAX_VERTICES) {
      throw new PlanFileError("TOO_MANY", `more than ${MAX_VERTICES} fence vertices`)
    }
    if (z.circle && (z.points.length != 1 || !(isFinite(z.radius) && z.radius > 0.0))) {
      throw new PlanFileError("BAD_ITEM", `fence zone ${i}: a circle has one centre and a radius of more than 0`, i)
    }
    if (!z.circle && z.points.length < MIN_VERTICES) {
      throw new PlanFileError("BAD_ITEM", `fence zone ${i}: a polygon has fewer than ${MIN_VERTICES} vertices`, i)
    }
    for (const p of z.points) {
      if (pointProblem(p.lat, p.lon, p.alt) != "") {
        throw new PlanFileError("BAD_ITEM", `fence zone ${i}: a place is off the globe or not a number`, i)
      }
    }
  }
  if (plan.rally.length > MAX_RALLY) {
    throw new PlanFileError("TOO_MANY", `${plan.rally.length} rally points are more than ${MAX_RALLY}`)
  }
  for (let i = 0; i < plan.rally.length; i++) {
    if (pointProblem(plan.rally[i].lat, plan.rally[i].lon, plan.rally[i].alt) != "") {
      throw new PlanFileError("BAD_ITEM", `rally point ${i} is off the globe or not a number`, i)
    }
  }
}

/// The text of a `.plan` for `plan`: SimpleItems, the planned home position, the fence's polygons and circles and the rally points. A plan
/// that `checkPlan` refuses is refused. A plan with no home is written with 0, 0, 0 (read back as no home); with no cruise speed, with 15 m/s.
/// A DO_JUMP's param1 is the seq of its target (the place of the item, from 1), which is also the `doJumpId` that is written for it.
export function writeQgcPlan(plan: Plan): string throws PlanFileError {
  checkPlan(plan)
  const items: string[] = []
  for (let i = 0; i < plan.items.length; i++) {
    const it = plan.items[i]
    const params = [it.p1, it.p2, it.p3, it.p4, it.lat, it.lon, it.alt].map((v: f64) => jsonNumber(v)).join(", ")
    items.push(`        {\n          "type": "SimpleItem",\n          "command": ${it.command},\n          "frame": ${it.frame},\n          "autoContinue": ${it.autocontinue},\n          "doJumpId": ${i + 1},\n          "params": [${params}]\n        }`)
  }
  const polygons: string[] = []
  const circles: string[] = []
  for (const z of plan.fence) {
    if (z.circle) {
      circles.push(`      { "circle": { "center": ${jsonPoint(z.points[0], false)}, "radius": ${jsonNumber(z.radius)} }, "inclusion": ${z.inclusion}, "version": 1 }`)
    } else {
      polygons.push(`      { "inclusion": ${z.inclusion}, "polygon": [${z.points.map((p: PlanPoint) => jsonPoint(p, false)).join(", ")}], "version": 1 }`)
    }
  }
  const rally = plan.rally.map((p: PlanPoint) => jsonPoint(p, true))
  const home = plan.home
  const homeText = if (home == null) "[0, 0, 0]" else jsonPoint(home!, true)
  const lines = [
    "{",
    `  "fileType": "Plan",`,
    `  "groundStation": "drone-configurator",`,
    `  "version": 1,`,
    `  "mission": {`,
    `    "cruiseSpeed": ${jsonNumber(if (plan.cruiseSpeed == plan.cruiseSpeed) plan.cruiseSpeed else 15.0)},`,
    `    "firmwareType": ${FIRMWARE_ARDUPILOT},`,
    `    "vehicleType": ${VEHICLE_QUADROTOR},`,
    `    "plannedHomePosition": ${homeText},`,
    `    "items": [`,
    items.join(",\n"),
    "    ],",
    `    "version": 2`,
    "  },",
    `  "geoFence": {`,
    `    "circles": [`,
    circles.join(",\n"),
    "    ],",
    `    "polygons": [`,
    polygons.join(",\n"),
    "    ],",
    `    "version": 2`,
    "  },",
    `  "rallyPoints": { "points": [${rally.join(", ")}], "version": 2 }`,
    "}",
  ]
  return lines.join("\n") + "\n"
}

// ---------------------------------------------------------------------------------------------------------------------------------------------
// Mission Planner's .waypoints
// ---------------------------------------------------------------------------------------------------------------------------------------------

/// The header of the format: its first line.
const WAYPOINTS_HEADER: string = "QGC WPL 110"

/// A number of a `.waypoints` line, or a NaN (`allowNaN`) when the field says so; `BAD_LINE` for anything else (a number is JSON's: no sign
/// before it, no `.5`, no `1.`, no hexadecimal).
function lineNumber(token: string, line: int, allowNaN: bool): f64 throws PlanFileError {
  if (allowNaN && token.toLowerCase() == "nan") {
    return 0.0 / 0.0
  }
  try {
    const v = JSON.parse<f64>(token)
    if (isFinite(v)) {
      return v
    }
  } catch (e: Error) {
  }
  throw new PlanFileError("BAD_LINE", `line ${line}: "${token}" is not a number`, line)
}

function lineInt(token: string, line: int, what: string, low: int, high: int): int throws PlanFileError {
  const v = lineNumber(token, line, false)
  if (v != Math.floor(v) || v < low as f64 || v > high as f64) {
    throw new PlanFileError("BAD_LINE", `line ${line}: ${what} ${token} is not a whole number from ${low} to ${high}`, line)
  }
  return v as int
}

/// A `.waypoints` text as a plan: line 1 `QGC WPL 110`, line 2 home, then the items, in order from seq 1. Fields are separated by tabs or
/// spaces. The plan has no fence and no rally points (the format has none).
export function parseWaypoints(text: string): Plan throws PlanFileError {
  if (tooBig(text)) {
    throw new PlanFileError("TOO_BIG", `the file is longer than ${MAX_FILE_BYTES} bytes`)
  }
  const lines = text.split("\n")
  if (lines.length == 0 || lines[0].trim() != WAYPOINTS_HEADER) {
    throw new PlanFileError("NOT_WAYPOINTS", `the first line is not "${WAYPOINTS_HEADER}"`, 1)
  }
  if (lines.length > MAX_ITEMS + 100) {
    throw new PlanFileError("TOO_MANY", `${lines.length} lines are more than ${MAX_ITEMS} items and home`)
  }
  const plan = new Plan()
  let seq = 0
  for (let n = 1; n < lines.length; n++) {
    const line = lines[n].trim()
    if (line == "") {
      continue
    }
    // (n + 1 is the line a person counts: the header is line 1)
    const item = lineItem(line, seq, n + 1)
    if (seq == 0) {
      // (0, 0 is what a file says when it has no home)
      if (!noHome(item.lat, item.lon)) {
        plan.home = { lat: item.lat, lon: item.lon, alt: item.alt }
      }
    } else {
      plan.items.push(item)
    }
    seq += 1
    if (seq > MAX_ITEMS + 1) {
      throw new PlanFileError("TOO_MANY", `more than ${MAX_ITEMS} items and home`)
    }
  }
  // (a jump's param1 is the seq of its target: 1 to the number of items)
  const bad = jumpProblem(plan.items)
  if (bad != null) {
    throw bad!
  }
  return plan
}

function lineItem(line: string, seq: int, lineNo: int): PlanItem throws PlanFileError {
  const fields = line.split(/\s+/)
  if (fields.length != 12) {
    throw new PlanFileError("BAD_LINE", `line ${lineNo}: ${fields.length} fields, not 12`, lineNo)
  }
  if (lineInt(fields[0], lineNo, "seq", 0, MAX_ITEMS + 1) != seq) {
    throw new PlanFileError("BAD_LINE", `line ${lineNo}: seq ${fields[0]} is not ${seq}`, lineNo)
  }
  const current = lineInt(fields[1], lineNo, "current", 0, 255)
  if (current > 1) {
    throw new PlanFileError("BAD_LINE", `line ${lineNo}: current ${current} is not 0 or 1 (2 and 3 are orders to a flying vehicle)`, lineNo)
  }
  const item = new PlanItem(lineInt(fields[3], lineNo, "command", 0, 65535), lineInt(fields[2], lineNo, "frame", 0, 255))
  const allowed = nanAllowed(item.command)
  item.p1 = lineNumber(fields[4], lineNo, (allowed & 1) != 0)
  item.p2 = lineNumber(fields[5], lineNo, (allowed & 2) != 0)
  item.p3 = lineNumber(fields[6], lineNo, (allowed & 4) != 0)
  item.p4 = lineNumber(fields[7], lineNo, (allowed & 8) != 0)
  item.lat = lineNumber(fields[8], lineNo, false)
  item.lon = lineNumber(fields[9], lineNo, false)
  item.alt = lineNumber(fields[10], lineNo, false)
  item.autocontinue = lineInt(fields[11], lineNo, "autocontinue", 0, 1) == 1
  const why = problemOf(item)
  if (why != "") {
    throw new PlanFileError("BAD_LINE", `line ${lineNo}: ${why}`, lineNo)
  }
  return item
}

/// A number of a `.waypoints` line, in full; `NaN` for a NaN.
function lineText(v: f64): string {
  if (v != v) {
    return "NaN"
  }
  return `${v}`
}

/// The text of a `.waypoints` for `plan`: home first (the plan's, or 0, 0, 0), then the items. The fence and rally points are not in the format.
export function writeWaypoints(plan: Plan): string throws PlanFileError {
  checkPlan(plan)
  const lines: string[] = [WAYPOINTS_HEADER]
  const home = plan.home
  let h: PlanPoint = { lat: 0.0, lon: 0.0, alt: 0.0 }
  if (home != null) {
    h = home!
  }
  lines.push(`0\t1\t0\t16\t0\t0\t0\t0\t${lineText(h.lat)}\t${lineText(h.lon)}\t${lineText(h.alt)}\t1`)
  for (let i = 0; i < plan.items.length; i++) {
    const it = plan.items[i]
    const fields = [`${i + 1}`, "0", `${it.frame}`, `${it.command}`, lineText(it.p1), lineText(it.p2), lineText(it.p3), lineText(it.p4), lineText(it.lat), lineText(it.lon), lineText(it.alt), if (it.autocontinue) "1" else "0"]
    lines.push(fields.join("\t"))
  }
  return lines.join("\n") + "\n"
}
