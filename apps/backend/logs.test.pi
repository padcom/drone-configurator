// The logs service (`logs.*`), over an in-memory link against the simulated vehicle, whose file system holds the logs. The folder
// for downloaded logs is a directory made for each test.
import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { exists, readBytes, readDir, remove, writeBytes, mkdir } from "std/fs"
import { join } from "std/path"
import { pid } from "std/process"
import { Cbor, Envelope } from "pico-desktop/communicator"
import { LogInfo, crc32Of } from "padcom/pico-mavlink"
import { simulatorForTests } from "./app"
import {
  ConnectRequest,
  ConnectRequestTransport,
  LogsDownload,
  LogsDownloaded,
  LogsErased,
  LogsProgressState,
  VehicleLogs,
  VehicleLogsSource,
  decodeLogsDownloaded,
  decodeLogsErased,
  decodeLogsProgress,
  decodeVehicleLogs,
  encodeConnectRequest,
  encodeLogsDownload,
} from "./generated/app"
import { copyName, copyNumbers, folderName, folderOf, forgetNoFtp, ftpUnusable, hex8, limitCrcQuestions, nameOfLog, numberOfLog, uncheckedName, uncheckedNumbers } from "./logs"
import { changedSince } from "./logsfallback"
import { link } from "./session"
import { useDirectoryForTests } from "./settings"
import { Frontend, start } from "./testing"

const FIRST: string = "/logs/00000001.BIN"
const SECOND: string = "/logs/00000002.BIN"

/// `n` bytes that look like data and are the same on every run.
function content(n: int, seed: int): Uint8Array {
  const out = new Uint8Array(n)
  let x = seed
  for (let i = 0; i < n; i++) {
    x = (x * 1103515245 + 12345) & 0x7FFFFFFF
    out.set(i, (x >> 16) & 0xFF)
  }
  out
}

function same(a: Uint8Array, b: Uint8Array): bool {
  if (a.length != b.length) {
    return false
  }
  for (let i = 0; i < a.length; i++) {
    if (a[i] != b[i]) {
      return false
    }
  }
  true
}

/// What a test has: the frontend, the folder the app's files go to, and the folder of the vehicle's downloaded logs.
class Rig {
  public readonly f: Frontend
  public readonly root: string
  /// The timer that keeps the simulated vehicle disarmed (it arms itself at its 3rd tick): it sets the tick back.
  public hold: int = -1

  constructor(f: Frontend, root: string) {
    this.f = f
    this.root = root
  }

  /// Lets the simulated vehicle go on: its next tick arms it.
  public letItArm(): void {
    clearInterval(hold)
    simulatorForTests()!.ticks = 2
  }

  /// Where the downloaded logs of the connected vehicle are.
  public folder(): string {
    join(root, "logs", folderName())
  }
}

/// A connected simulator with a log in the vehicle's file system, kept disarmed (the simulator arms itself after 3 ticks).
async function connected(): Promise<Rig> throws Error {
  const root = `/tmp/drone-configurator-logs-${pid}-${Date.now()}`
  await mkdir(root, true)
  useDirectoryForTests(root)
  const f = await start()
  await f.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const sim = simulatorForTests()!
  sim.ticks = 0
  const r = new Rig(f, root)
  r.hold = setInterval(() => { sim.ticks = 0 }, 100)
  await afterBeat()
  sim.fsFiles.set(FIRST, content(100000, 1))
  r
}

/// Waits for the next heartbeat of the vehicle: the armed state is only known after one.
async function afterBeat(): Promise<void> throws Error {
  const before = link.heartbeatAt
  let waited = 0
  while (link.heartbeatAt == before && waited < 4000) {
    await delay(20)
    waited += 20
  }
}

/// The names of the checked copies in the vehicle's folder (not the parts).
async function copyNames(r: Rig): Promise<string[]> throws Error {
  const out: string[] = []
  if (!(await exists(r.folder()))) {
    return out
  }
  for await (const e of readDir(r.folder())) {
    if (e.isFile && e.name.slice(e.name.length - 4, e.name.length) == ".BIN") {
      out.push(e.name)
    }
  }
  out
}

/// Where the checked copy of log `id` with these bytes is (or would be).
function copyPath(r: Rig, id: int, bytes: Uint8Array): string {
  join(r.folder(), copyName(id, crc32Of(bytes)))
}

async function finish(r: Rig): Promise<void> throws Error {
  clearInterval(r.hold)
  await r.f.call("vehicle.disconnect")
  await remove(r.root, true)
}

async function list(r: Rig): Promise<VehicleLogs> throws Error {
  const e = await r.f.call("logs.vehicle.list")
  decodeVehicleLogs(e.p ?? Cbor.Null, "$")
}

/// The error code of a call, or "".
function codeOf(e: Envelope): string {
  if (e.err != null) e.err!.code else ""
}

async function download(r: Rig, ids: u32[]): Promise<LogsDownloaded> throws Error {
  const e = await r.f.call("logs.download", encodeLogsDownload(LogsDownload { ids: ids }))
  decodeLogsDownloaded(e.p ?? Cbor.Null, "$")
}

/// The progress events heard so far for log `id`, as "state received/total" lines.
function progressOf(r: Rig, id: int): string[] {
  const out: string[] = []
  for (const h of r.f.heard) {
    if (h.n == "logs.progress") {
      const p = decodeLogsProgress(h.p ?? Cbor.Null, "$")
      if (p.id as int == id) {
        out.push(`${stateName(p.state)} ${p.received}/${p.total}${if (p.resumedFrom != null) ` from ${p.resumedFrom!}` else ""}`)
      }
    }
  }
  out
}

function stateName(s: LogsProgressState): string {
  match (s) {
    Queued => "queued",
    Downloading => "downloading",
    Done => "done",
    Failed => "failed",
  }
}

function namesTheLogFiles(): void {
  expect(nameOfLog(1)).toBe("00000001.BIN")
  expect(nameOfLog(12345678)).toBe("12345678.BIN")
  expect(numberOfLog("00000042.BIN")).toBe(42)
  expect(numberOfLog("LASTLOG.TXT")).toBe(-1)
  expect(numberOfLog("0000001.BIN")).toBe(-1)
  expect(numberOfLog("00000001.BIN.part")).toBe(-1)
  expect(numberOfLog("0000000a.BIN")).toBe(-1)
  expect(folderOf("1/1/2/3/uid:ab:cd")).toBe("1-1-2-3-uid-ab-cd")
  expect(folderOf("")).toBe("vehicle")
}

async function listsNothingBeforeTheFirstArm(): Promise<void> throws Error {
  const r = await connected()
  simulatorForTests()!.fsFiles.clear()
  const logs = await list(r)
  expect(logs.logs.length).toBe(0)
  expect(logs.canErase).toBe(false)
  await finish(r)
}

async function listsTheLogsAndNothingElse(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  sim.fsFiles.set(SECOND, content(500, 2))
  sim.fsFiles.set("/logs/LASTLOG.TXT", content(3, 3))
  sim.fsFiles.set("/logs/00000003.BIN.part", content(3, 4))
  sim.fsTimes.set(FIRST, 1783000000)
  const logs = await list(r)
  expect(logs.logs.map((l) => `${l.id}:${l.size}:${l.downloaded}`).join(",")).toBe("1:100000:false,2:500:false")
  // The time is the vehicle's seconds, given in milliseconds; a log it gives no time for has none.
  expect(logs.logs[0].time!).toBe(1783000000000 as u64)
  expect(logs.logs[1].time == null).toBe(true)
  await finish(r)
}

async function saysWhyAListThatCannotBeTrustedIsNone(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  // A name with a tab in it, in a listing without times, reads as a size and a time: the listing is refused, not partly shown.
  sim.ftpMode = "oldlist"
  sim.fsFiles.set("/logs/a\t5", content(10, 5))
  const e = await r.f.call("logs.vehicle.list")
  expect(codeOf(e)).toBe("LOGS_UNAVAILABLE")
  expect(e.err!.message.includes("can't be trusted")).toBe(true)
  await finish(r)
}

async function downloadsALogAndChecksIt(): Promise<void> throws Error {
  const r = await connected()
  const done = await download(r, [1])
  expect(done.ids.join(",")).toBe("1")
  expect(done.stopped).toBe(false)
  expect(done.error == null).toBe(true)
  const file = copyPath(r, 1, content(100000, 1))
  expect(same(await readBytes(file), content(100000, 1))).toBe(true)
  expect(await exists(join(r.folder(), "00000001.BIN.part"))).toBe(false)
  const lines = progressOf(r, 1)
  expect(lines[0]).toBe("queued 0/100000")
  expect(lines[lines.length - 1]).toBe("done 100000/100000")
  expect((await list(r)).logs[0].downloaded).toBe(true)
  // A log asked for again is whole already: nothing is fetched.
  const again = await download(r, [1])
  expect(again.ids.join(",")).toBe("1")
  await finish(r)
}

async function goesOnFromAPart(): Promise<void> throws Error {
  const r = await connected()
  await mkdir(r.folder(), true)
  const whole = content(100000, 1)
  await writeBytes(join(r.folder(), "00000001.BIN.part"), whole.slice(0, 33333))
  const done = await download(r, [1])
  expect(done.ids.join(",")).toBe("1")
  expect(same(await readBytes(copyPath(r, 1, whole)), whole)).toBe(true)
  const lines = progressOf(r, 1)
  expect(lines[lines.length - 1]).toBe("done 100000/100000 from 33333")
  expect(lines.filter((l) => l.startsWith("downloading")).length > 0 || lines.length >= 2).toBe(true)
  await finish(r)
}

async function goesOnFromAPartOfMoreThanAMegabyte(): Promise<void> throws Error {
  // The CRC of the part is read in pieces of a megabyte: a part of 2.5 MB takes three.
  const r = await connected()
  simulatorForTests()!.fsFiles.set(FIRST, content(3_200_000, 1))
  await mkdir(r.folder(), true)
  const whole = content(3_200_000, 1)
  await writeBytes(join(r.folder(), "00000001.BIN.part"), whole.slice(0, 2_500_000))
  const done = await download(r, [1])
  expect(done.ids.join(",")).toBe("1")
  expect(same(await readBytes(copyPath(r, 1, whole)), whole)).toBe(true)
  await finish(r)
}

async function refusesWhileArmedOrNotKnownOrBusy(): Promise<void> throws Error {
  const r = await connected()
  link.armed = true
  expect(codeOf(await r.f.call("logs.download", encodeLogsDownload(LogsDownload { ids: [1] })))).toBe("ARMED")
  link.armed = false
  link.heartbeatAt = (Date.now() as int) - 10000
  expect(codeOf(await r.f.call("logs.download", encodeLogsDownload(LogsDownload { ids: [1] })))).toBe("STATE_UNKNOWN")
  await afterBeat()
  link.armed = false
  link.listing = true
  expect(codeOf(await r.f.call("logs.download", encodeLogsDownload(LogsDownload { ids: [1] })))).toBe("BUSY")
  link.listing = false
  // Nothing was sent to the vehicle's file system, nothing written.
  expect(simulatorForTests()!.ftpLog.filter((line) => line.startsWith("4 ")).length).toBe(0)
  expect(await exists(r.folder())).toBe(false)
  await finish(r)
}

async function stopsWhenTheVehicleArms(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  sim.fsFiles.set(FIRST, content(400000, 1))
  // Bursts of 100 packets: the download takes a while.
  sim.ftpStallAfter = 100
  const asked = await r.f.send("logs.download", encodeLogsDownload(LogsDownload { ids: [1] }))
  await r.f.event("logs.progress")
  await r.f.event("logs.progress")
  // The next tick of the simulator arms it: its heartbeat says so.
  r.letItArm()
  const e = await r.f.reply(asked)
  const done = decodeLogsDownloaded(e.p ?? Cbor.Null, "$")
  expect(done.stopped).toBe(true)
  expect(done.ids.length).toBe(0)
  expect(done.error!.includes("armed")).toBe(true)
  // What came is kept as a part; the log is not a downloaded one.
  expect((await copyNames(r)).length).toBe(0)
  expect(await exists(join(r.folder(), "00000001.BIN.part"))).toBe(true)
  expect(link.logging).toBe(false)
  await finish(r)
}

async function cancelKeepsThePartAndTheNextOneGoesOn(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  sim.fsFiles.set(FIRST, content(400000, 1))
  sim.ftpStallAfter = 100
  const asked = await r.f.send("logs.download", encodeLogsDownload(LogsDownload { ids: [1] }))
  await r.f.event("logs.progress")
  await r.f.event("logs.progress")
  await r.f.call("logs.cancel")
  const done = decodeLogsDownloaded((await r.f.reply(asked)).p ?? Cbor.Null, "$")
  expect(done.stopped).toBe(true)
  expect(done.error == null).toBe(true)
  const part = join(r.folder(), "00000001.BIN.part")
  const held = (await readBytes(part)).length
  expect(held > 0 && held < 400000).toBe(true)
  sim.ftpStallAfter = 0
  const again = await download(r, [1])
  expect(again.ids.join(",")).toBe("1")
  expect(same(await readBytes(copyPath(r, 1, content(400000, 1))), content(400000, 1))).toBe(true)
  const lines = progressOf(r, 1)
  expect(lines[lines.length - 1].includes(`from ${held}`)).toBe(true)
  await finish(r)
}

async function chasesALogThatGrowsWhileItComes(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  const longer = content(130000, 1)
  sim.fsFiles.set(FIRST, content(100000, 1))
  sim.ftpStallAfter = 100
  const asked = await r.f.send("logs.download", encodeLogsDownload(LogsDownload { ids: [1] }))
  await r.f.event("logs.progress")
  await r.f.event("logs.progress")
  // The vehicle goes on writing the log: it is longer from now on (the open file the download has is the old one).
  sim.fsFiles.set(FIRST, longer)
  sim.ftpStallAfter = 0
  const done = decodeLogsDownloaded((await r.f.reply(asked)).p ?? Cbor.Null, "$")
  expect(done.ids.join(",")).toBe("1")
  expect(same(await readBytes(copyPath(r, 1, longer)), longer)).toBe(true)
  await finish(r)
}

async function failsAWrongCrcAndDropsTheBadPart(): Promise<void> throws Error {
  const r = await connected()
  simulatorForTests()!.ftpMode = "badcrc"
  const done = await download(r, [1])
  expect(done.ids.length).toBe(0)
  expect(done.stopped).toBe(true)
  expect(done.error!.includes("does not match")).toBe(true)
  expect((await copyNames(r)).length).toBe(0)
  expect(await exists(join(r.folder(), "00000001.BIN.part"))).toBe(false)
  expect(progressOf(r, 1)[progressOf(r, 1).length - 1].startsWith("failed")).toBe(true)
  await finish(r)
}

async function keepsAPartThatTheVehicleCannotCheck(): Promise<void> throws Error {
  const r = await connected()
  simulatorForTests()!.ftpMode = "nocrc"
  const done = await download(r, [1])
  expect(done.ids.length).toBe(0)
  expect(done.error!.includes("could not be checked")).toBe(true)
  expect((await copyNames(r)).length).toBe(0)
  expect(same(await readBytes(join(r.folder(), "00000001.BIN.part")), content(100000, 1))).toBe(true)
  expect((await list(r)).logs[0].downloaded).toBe(false)
  await finish(r)
}

async function stopsAtALogThatIsNotThere(): Promise<void> throws Error {
  const r = await connected()
  const done = await download(r, [1, 7])
  expect(done.ids.join(",")).toBe("1")
  expect(done.stopped).toBe(true)
  expect(done.error!.includes("not on the vehicle")).toBe(true)
  await finish(r)
}

async function holdsOffARebootAndAParameterDownloadWhileItRuns(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  sim.fsFiles.set(FIRST, content(300000, 1))
  sim.ftpStallAfter = 100
  const asked = await r.f.send("logs.download", encodeLogsDownload(LogsDownload { ids: [1] }))
  await r.f.event("logs.progress")
  await r.f.event("logs.progress")
  expect(codeOf(await r.f.call("vehicle.reboot"))).toBe("BUSY")
  expect(codeOf(await r.f.call("params.list"))).toBe("BUSY")
  expect(codeOf(await r.f.call("logs.vehicle.list"))).toBe("BUSY")
  expect(codeOf(await r.f.call("logs.download", encodeLogsDownload(LogsDownload { ids: [1] })))).toBe("BUSY")
  await r.f.call("logs.cancel")
  await r.f.reply(asked)
  await finish(r)
}

async function neverReplacesACopyAndKnowsOneByItsCrc(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  await download(r, [1])
  const first = content(100000, 1)
  // The vehicle's log 1 is another one now (a new card, the numbering started again), of the same size.
  const other = content(100000, 9)
  sim.fsFiles.set(FIRST, other)
  const names = await copyNames(r)
  expect(names.join(",")).toBe(copyName(1, crc32Of(first)))
  // The copy has that number and size, but not the CRC the vehicle has for its log: the list does not call it downloaded.
  expect((await list(r)).logs[0].downloaded).toBe(false)
  const done = await download(r, [1])
  expect(done.ids.join(",")).toBe("1")
  expect((await copyNames(r)).length).toBe(2)
  expect(same(await readBytes(copyPath(r, 1, first)), first)).toBe(true)
  expect(same(await readBytes(copyPath(r, 1, other)), other)).toBe(true)
  // The same log asked for again is the copy that is here: nothing new.
  await download(r, [1])
  expect((await copyNames(r)).length).toBe(2)
  // And both are downloaded now, as far as the list can tell: the vehicle's log is the second copy.
  expect((await list(r)).logs[0].downloaded).toBe(true)
  await finish(r)
}

async function doesNotTrustACopyByItsNameAlone(): Promise<void> throws Error {
  const r = await connected()
  const whole = content(100000, 1)
  await download(r, [1])
  const copy = copyPath(r, 1, whole)
  // The copy was damaged since (same name, same size, other bytes): the list still takes it for the log (the vehicle's CRC is the
  // name's), but a download reads the file, finds it wrong, and fetches the log again in its place.
  await writeBytes(copy, content(100000, 7))
  const done = await download(r, [1])
  expect(done.ids.join(",")).toBe("1")
  expect(same(await readBytes(copy), whole)).toBe(true)
  expect((await copyNames(r)).length).toBe(1)
  await finish(r)
}

async function givesAVehicleWithNoUniqueIdAFolderOfItsConnection(): Promise<void> throws Error {
  const r = await connected()
  const before = folderName()
  expect(before.startsWith(folderOf(link.identity))).toBe(true)
  expect(folderName()).toBe(before)
  await r.f.call("vehicle.disconnect")
  await delay(5)
  await r.f.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  expect(folderName() == before).toBe(false)
  await finish(r)
}

async function refusesTwoDownloadsAtTheSameTime(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  sim.fsFiles.set(FIRST, content(300000, 1))
  sim.ftpStallAfter = 100
  const ask = encodeLogsDownload(LogsDownload { ids: [1] })
  // Both are sent before either is answered.
  const one = await r.f.send("logs.download", ask)
  const two = await r.f.send("logs.download", ask)
  expect(codeOf(await r.f.reply(two))).toBe("BUSY")
  expect(link.logging).toBe(true)
  await r.f.event("logs.progress")
  await r.f.call("logs.cancel")
  expect(decodeLogsDownloaded((await r.f.reply(one)).p ?? Cbor.Null, "$").stopped).toBe(true)
  expect(link.logging).toBe(false)
  await finish(r)
}

function namesACopyByItsLogAndCrc(): void {
  expect(hex8(0)).toBe("00000000")
  expect(hex8(0xCBF43926)).toBe("cbf43926")
  expect(copyName(42, 0x0000ABCD)).toBe("00000042-0000abcd.BIN")
  expect(copyNumbers("00000042-0000abcd.BIN").join(",")).toBe(`42,${0xABCD}`)
  expect(copyNumbers("00000042.BIN")[0]).toBe(-1)
  expect(copyNumbers("00000042-0000abcg.BIN")[0]).toBe(-1)
  expect(copyNumbers("00000042-0000ABCD.BIN")[0]).toBe(-1)
}

async function holdsEverythingElseOffWhileTheListIsRead(): Promise<void> throws Error {
  const r = await connected()
  // The vehicle says nothing: the listing (which begins with a reset of the sessions) is under way for seconds.
  simulatorForTests()!.ftpMode = "silent"
  const listing = await r.f.send("logs.vehicle.list")
  await delay(150)
  expect(link.logging).toBe(true)
  expect(codeOf(await r.f.call("params.list"))).toBe("BUSY")
  expect(codeOf(await r.f.call("vehicle.reboot"))).toBe("BUSY")
  expect(codeOf(await r.f.call("logs.download", encodeLogsDownload(LogsDownload { ids: [1] })))).toBe("BUSY")
  expect(codeOf(await r.f.call("logs.vehicle.list"))).toBe("BUSY")
  // The session ending stops the listing; nothing stays set.
  await r.f.call("vehicle.disconnect")
  await r.f.reply(listing)
  expect(link.logging).toBe(false)
  await finish(r)
}

async function stopsACancelDuringTheListing(): Promise<void> throws Error {
  const r = await connected()
  // The vehicle says nothing: the download is still reading the list when the cancel comes.
  simulatorForTests()!.ftpMode = "silent"
  const asked = await r.f.send("logs.download", encodeLogsDownload(LogsDownload { ids: [1] }))
  await delay(150)
  expect(link.logging).toBe(true)
  await r.f.call("logs.cancel")
  // A download that was stopped, not an error: nothing came, nothing is kept, nothing stays set.
  const reply = await r.f.reply(asked)
  const done = decodeLogsDownloaded(reply.p ?? Cbor.Null, "$")
  expect(done.ids.length).toBe(0)
  expect(done.stopped).toBe(true)
  expect(link.logging).toBe(false)
  await finish(r)
}

/// How many CalcFileCRC32 (opcode 14) the vehicle has been asked.
function crcAsks(): int {
  simulatorForTests()!.ftpLog.filter((line) => line.startsWith("14 ")).length
}

/// Two logs on the vehicle, both downloaded (so that each has a copy of its number and size), and the questions about CRCs counted
/// from here.
async function twoCopies(r: Rig): Promise<int> throws Error {
  simulatorForTests()!.fsFiles.set("/logs/00000002.BIN", content(5000, 2))
  await download(r, [1, 2])
  crcAsks()
}

/// A third log on the vehicle with a copy, which the vehicle has not been asked about on this connection yet (the first two were,
/// by a list in good order).
async function oneNotAskedYet(r: Rig): Promise<void> throws Error {
  await twoCopies(r)
  expect((await list(r)).logs.map((l) => l.downloaded).join(",")).toBe("true,true")
  simulatorForTests()!.fsFiles.set("/logs/00000003.BIN", content(3000, 3))
  await download(r, [3])
}

async function doesNotAskTheVehicleForCrcsWhileArmed(): Promise<void> throws Error {
  const r = await connected()
  const before = await twoCopies(r)
  link.armed = true
  const logs = (await list(r)).logs
  // The copies are there, but the card is not read while the vehicle is armed: not known, not "downloaded", and not asked.
  expect(logs.map((l) => `${l.id}:${l.downloaded}:${l.unchecked ?? false}`).join(",")).toBe("1:false:true,2:false:true")
  expect(crcAsks()).toBe(before)
  // The same when the state is not known.
  link.armed = false
  link.heartbeatAt = (Date.now() as int) - 10000
  expect((await list(r)).logs.map((l) => l.unchecked ?? false).join(",")).toBe("true,true")
  expect(crcAsks()).toBe(before)
  // Disarmed again: asked, and known.
  await afterBeat()
  link.armed = false
  expect((await list(r)).logs.map((l) => `${l.downloaded}:${l.unchecked ?? false}`).join(",")).toBe("true:false,true:false")
  await finish(r)
}

async function doesNotAskAgainForALogThatIsTheSame(): Promise<void> throws Error {
  const r = await connected()
  const before = await twoCopies(r)
  expect((await list(r)).logs.map((l) => l.downloaded).join(",")).toBe("true,true")
  const asked = crcAsks()
  expect(asked).toBe(before + 2)
  // The vehicle's log 1 is another one of the same size now; what the vehicle said of that number and size is not asked again
  // on this connection, so the second list costs the card nothing.
  simulatorForTests()!.fsFiles.set(FIRST, content(100000, 9))
  expect((await list(r)).logs.map((l) => l.downloaded).join(",")).toBe("true,true")
  expect(crcAsks()).toBe(asked)
  // A log that grew has no copy of its size any more: nothing to ask about.
  simulatorForTests()!.fsFiles.set(FIRST, content(100001, 9))
  expect((await list(r)).logs.map((l) => l.downloaded).join(",")).toBe("false,true")
  expect(crcAsks()).toBe(asked)
  await finish(r)
}

async function stopsAskingWhenTheTimeIsUp(): Promise<void> throws Error {
  const r = await connected()
  await oneNotAskedYet(r)
  // No time left for the questions: what the vehicle said before on this connection is still known, the rest is not asked.
  limitCrcQuestions(0)
  const before = crcAsks()
  const logs = (await list(r)).logs
  limitCrcQuestions(20000)
  expect(logs.map((l) => `${l.downloaded}:${l.unchecked ?? false}`).join(",")).toBe("true:false,true:false,false:true")
  expect(crcAsks()).toBe(before)
  await finish(r)
}

async function stopsTheListOnCancel(): Promise<void> throws Error {
  const r = await connected()
  // The vehicle says nothing: the list is waiting for it (the same wait as for a CRC that the vehicle reads from its card).
  simulatorForTests()!.ftpMode = "silent"
  const asked = await r.f.send("logs.vehicle.list")
  await delay(150)
  expect(link.logging).toBe(true)
  const started = Date.now() as int
  await r.f.call("logs.cancel")
  expect(codeOf(await r.f.reply(asked))).toBe("STOPPED")
  expect((Date.now() as int) - started < 5000).toBe(true)
  expect(link.logging).toBe(false)
  await finish(r)
}

async function stopsTheListWhenTheVehicleArms(): Promise<void> throws Error {
  const r = await connected()
  simulatorForTests()!.ftpMode = "silent"
  const asked = await r.f.send("logs.vehicle.list")
  await delay(150)
  expect(link.logging).toBe(true)
  const started = Date.now() as int
  // The vehicle's next heartbeat says it is armed: its card is for flying, the list ends.
  r.letItArm()
  expect(codeOf(await r.f.reply(asked))).toBe("STOPPED")
  expect((Date.now() as int) - started < 5000).toBe(true)
  expect(link.logging).toBe(false)
  await finish(r)
}

async function erase(r: Rig): Promise<LogsErased> throws Error {
  const e = await r.f.call("logs.erase")
  decodeLogsErased(e.p ?? Cbor.Null, "$")
}

/// The vehicle has no file transfer: it answers nothing to it (a read that waits for it takes seconds).
function withoutFileTransfer(): void {
  simulatorForTests()!.ftpMode = "silent"
}

function namesAProtocolCopy(): void {
  expect(uncheckedName(1, 0xABCDEF01)).toBe("00000001-abcdef01.unchecked.BIN")
  expect(uncheckedNumbers("00000007-0000002a.unchecked.BIN").join(",")).toBe("7,42")
  // A checked copy's name is not one with no checksum, and the reverse: the one list never takes the other.
  expect(uncheckedNumbers("00000007-0000002a.BIN")[0]).toBe(-1)
  expect(copyNumbers("00000007-0000002a.unchecked.BIN")[0]).toBe(-1)
  expect(uncheckedNumbers("00000007-0000002a.unchecked.BIN.part")[0]).toBe(-1)
  expect(ftpUnusable("FTP_TIMEOUT")).toBe(true)
  expect(ftpUnusable("FTP_UNKNOWN_COMMAND")).toBe(true)
  expect(ftpUnusable("FTP_PROTOCOL")).toBe(false)
  expect(ftpUnusable("FTP_ABORTED")).toBe(false)
}

async function listsOverTheLogProtocolWhenThereIsNoFileTransfer(): Promise<void> throws Error {
  const r = await connected()
  withoutFileTransfer()
  const logs = await list(r)

  expect(logs.source).toBe(VehicleLogsSource.Mavlink)
  expect(logs.canErase).toBe(false)
  expect(logs.logs.length).toBe(1)
  expect(logs.logs[0].id as int).toBe(1)
  expect(logs.logs[0].size as int).toBe(100000)
  expect(logs.logs[0].downloaded).toBe(false)
  expect(logs.logs[0].noChecksum == null).toBe(true)
  await finish(r)
}

async function downloadsOverTheLogProtocolAndNeverChecksTheCopy(): Promise<void> throws Error {
  const r = await connected()
  withoutFileTransfer()
  const whole = content(100000, 1)
  const done = await download(r, [1])

  expect(done.ids.join(",")).toBe("1")
  expect(done.stopped).toBe(false)
  expect(done.error == null).toBe(true)
  // The copy is kept under a name that says nothing was checked, and the bytes are the vehicle's.
  expect(same(await readBytes(join(r.folder(), uncheckedName(1, crc32Of(whole)))), whole)).toBe(true)
  expect(await exists(join(r.folder(), "00000001.BIN.part"))).toBe(false)
  expect(await exists(copyPath(r, 1, whole))).toBe(false)
  const lines = progressOf(r, 1)
  expect(lines[0]).toBe("queued 0/100000")
  expect(lines[lines.length - 1]).toBe("done 100000/100000")
  // Listed again: a copy is here, with no checksum; it is not "downloaded".
  const logs = await list(r)
  expect(logs.logs[0].downloaded).toBe(false)
  expect(logs.logs[0].noChecksum!).toBe(true)
  // And asked for again, nothing is fetched.
  const sent = simulatorForTests()!.logs.sentData
  expect((await download(r, [1])).ids.join(",")).toBe("1")
  expect(simulatorForTests()!.logs.sentData).toBe(sent)
  await finish(r)
}

async function goesOnFromAPartOverTheLogProtocol(): Promise<void> throws Error {
  const r = await connected()
  withoutFileTransfer()
  const whole = content(100000, 1)
  await mkdir(r.folder(), true)
  await writeBytes(join(r.folder(), "00000001.BIN.part"), whole.slice(0, 33300))
  const done = await download(r, [1])

  expect(done.ids.join(",")).toBe("1")
  expect(same(await readBytes(join(r.folder(), uncheckedName(1, crc32Of(whole)))), whole)).toBe(true)
  const lines = progressOf(r, 1)
  expect(lines[lines.length - 1]).toBe("done 100000/100000 from 33300")
  // Only what was missing was asked for: 33300 bytes are 370 packets of 90.
  expect(simulatorForTests()!.logs.sentData < 760).toBe(true)
  await finish(r)
}

async function stopsAProtocolDownloadWhenTheVehicleArms(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  withoutFileTransfer()
  sim.fsFiles.set(FIRST, content(400000, 1))
  // A few packets at a time, slowly: the download takes a while.
  sim.logs.perPump = 5
  sim.logs.pumpMs = 10
  const asked = await r.f.send("logs.download", encodeLogsDownload(LogsDownload { ids: [1] }))
  await r.f.event("logs.progress")
  await r.f.event("logs.progress")
  r.letItArm()
  const done = decodeLogsDownloaded((await r.f.reply(asked)).p ?? Cbor.Null, "$")

  expect(done.stopped).toBe(true)
  expect(done.ids.length).toBe(0)
  // What came is kept as a part; nothing is called a copy.
  expect(await exists(join(r.folder(), "00000001.BIN.part"))).toBe(true)
  expect(link.logging).toBe(false)
  await finish(r)
}

async function erasesEveryLogWhenEachHasACheckedCopy(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  sim.fsFiles.set(SECOND, content(5000, 2))
  expect((await download(r, [1, 2])).ids.join(",")).toBe("1,2")
  const gone = await erase(r)

  expect(gone.erased.length).toBe(2)
  expect(gone.erased[0] as int).toBe(1)
  expect(gone.erased[1] as int).toBe(2)
  expect(gone.kept as int).toBe(0)
  expect(sim.logs.paths().length).toBe(0)
  expect(sim.logs.log.includes("erase")).toBe(true)
  // The copies here are not touched.
  expect(await exists(copyPath(r, 1, content(100000, 1)))).toBe(true)
  expect(await exists(copyPath(r, 2, content(5000, 2)))).toBe(true)
  expect(link.logging).toBe(false)
  expect(link.listing).toBe(false)
  await finish(r)
}

async function erasesNothingWhileALogHasNoCheckedCopy(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  sim.fsFiles.set(SECOND, content(5000, 2))
  await download(r, [1])

  expect(codeOf(await r.f.call("logs.erase"))).toBe("NOT_DOWNLOADED")
  expect(sim.logs.paths().length).toBe(2)
  expect(sim.logs.log.includes("erase")).toBe(false)
  await finish(r)
}

async function doesNotTakeACopyWithNoChecksumForAChecked(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  withoutFileTransfer()
  await download(r, [1])
  // File transfer is back (and tried again): the copy that came without a checksum still does not count.
  sim.ftpMode = "ok"
  forgetNoFtp()

  expect(codeOf(await r.f.call("logs.erase"))).toBe("NOT_DOWNLOADED")
  expect(sim.logs.paths().length).toBe(1)
  await finish(r)
}

async function doesNotEraseWhatTheCopyDoesNotMatch(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  await download(r, [1])
  // The copy is damaged after it was checked: the name is only a claim, the file is read again.
  const file = copyPath(r, 1, content(100000, 1))
  const bytes = await readBytes(file)
  bytes.set(500, (bytes[500] as int + 1) & 0xFF)
  await writeBytes(file, bytes)

  expect(codeOf(await r.f.call("logs.erase"))).toBe("NOT_DOWNLOADED")
  expect(sim.logs.paths().length).toBe(1)
  await finish(r)
}

async function doesNotEraseWithNoFileTransferToCheckAgainst(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  withoutFileTransfer()

  expect(codeOf(await r.f.call("logs.erase"))).toBe("NOT_VERIFIABLE")
  expect(sim.logs.paths().length).toBe(1)
  // It is known now: the next call does not wait for the file transfer to answer.
  const began = Date.now() as int
  expect(codeOf(await r.f.call("logs.erase"))).toBe("NOT_VERIFIABLE")
  expect((Date.now() as int) - began < 2000).toBe(true)
  await finish(r)
}

async function erasesNothingOnAVehicleWithNoLogs(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  sim.fsFiles.delete(FIRST)
  const gone = await erase(r)

  expect(gone.erased.length).toBe(0)
  expect(sim.logs.log.includes("erase")).toBe(false)
  await finish(r)
}

async function refusesToEraseWhileArmedOrNotKnownOrBusy(): Promise<void> throws Error {
  const r = await connected()
  const sim = simulatorForTests()!
  await download(r, [1])
  link.armed = true
  expect(codeOf(await r.f.call("logs.erase"))).toBe("ARMED")
  link.armed = false
  link.heartbeatAt = (Date.now() as int) - 10000
  expect(codeOf(await r.f.call("logs.erase"))).toBe("STATE_UNKNOWN")
  await afterBeat()
  link.armed = false
  link.listing = true
  expect(codeOf(await r.f.call("logs.erase"))).toBe("BUSY")
  link.listing = false
  expect(sim.logs.paths().length).toBe(1)
  expect(sim.logs.log.includes("erase")).toBe(false)
  await finish(r)
}

function vetoesAnEraseOfLogsThatAreNotTheOnesThatWereChecked(): void {
  const checked: int[] = [100000, 5000]
  expect(changedSince(checked, [new LogInfo(1, 100000, 0), new LogInfo(2, 5000, 0)])).toBe(false)
  // Smaller or the same is nothing that was not read; larger is a log that was written to since; another count is another vehicle's logs.
  expect(changedSince(checked, [new LogInfo(1, 99000, 0), new LogInfo(2, 5000, 0)])).toBe(false)
  expect(changedSince(checked, [new LogInfo(1, 100000, 0), new LogInfo(2, 5090, 0)])).toBe(true)
  expect(changedSince(checked, [new LogInfo(1, 100000, 0)])).toBe(true)
  expect(changedSince(checked, [new LogInfo(1, 100000, 0), new LogInfo(2, 5000, 0), new LogInfo(3, 1, 0)])).toBe(true)
  // The protocol numbers the logs from 1 whatever the files are called: ids are not compared.
  expect(changedSince(checked, [new LogInfo(7, 100000, 0), new LogInfo(9, 5000, 0)])).toBe(false)
}

async function refusesWithoutAVehicle(): Promise<void> throws Error {
  const f = await start()
  expect(codeOf(await f.call("logs.vehicle.list"))).toBe("NOT_CONNECTED")
  expect(codeOf(await f.call("logs.download", encodeLogsDownload(LogsDownload { ids: [1] })))).toBe("NOT_CONNECTED")
}

describe("the logs service", () => {
  it("names log files and finds their numbers", namesTheLogFiles)
  it("refuses without a connected vehicle", refusesWithoutAVehicle)
  it("lists nothing when the vehicle has no log directory yet (nothing was logged)", listsNothingBeforeTheFirstArm)
  it("lists only the log files, with the time in milliseconds when the vehicle gives one", listsTheLogsAndNothingElse)
  it("answers a listing that cannot be trusted with LOGS_UNAVAILABLE and the reason", saysWhyAListThatCannotBeTrustedIsNone)
  it("downloads a log into the data folder, checked by the vehicle's CRC, with progress", downloadsALogAndChecksIt)
  it("goes on from a part that is there, and says where it began", goesOnFromAPart)
  it("goes on from a part of more than a megabyte", goesOnFromAPartOfMoreThanAMegabyte)
  it("refuses while armed, while that is not known, and while busy, touching nothing", refusesWhileArmedOrNotKnownOrBusy)
  it("stops a download when the vehicle arms, keeping the part", stopsWhenTheVehicleArms)
  it("keeps the part on cancel, and the next download goes on from it", cancelKeepsThePartAndTheNextOneGoesOn)
  it("chases a log that grows while it is fetched until the vehicle's CRC is the copy's", chasesALogThatGrowsWhileItComes)
  it("fails a copy that does not match the vehicle's CRC and drops it", failsAWrongCrcAndDropsTheBadPart)
  it("keeps a part that the vehicle cannot check, and does not call it downloaded", keepsAPartThatTheVehicleCannotCheck)
  it("stops at a log that is not on the vehicle", stopsAtALogThatIsNotThere)
  it("holds off a reboot, a parameter download and a second download while one runs", holdsOffARebootAndAParameterDownloadWhileItRuns)
  it("names a copy by its log and CRC", namesACopyByItsLogAndCrc)
  it("never replaces a copy: a log with the same number and another CRC gets a name of its own", neverReplacesACopyAndKnowsOneByItsCrc)
  it("does not trust a copy by its name alone: a damaged one is fetched again", doesNotTrustACopyByItsNameAlone)
  it("gives a vehicle with no unique id a folder for each connection", givesAVehicleWithNoUniqueIdAFolderOfItsConnection)
  it("refuses a second download that comes before the first has begun", refusesTwoDownloadsAtTheSameTime)
  it("holds off a parameter download, a reboot, a download and another listing while the list is read", holdsEverythingElseOffWhileTheListIsRead)
  it("ends a download as stopped, not failed, when the cancel comes while the list is read", stopsACancelDuringTheListing)
  it("does not ask the vehicle for CRCs while it is armed or its state is not known", doesNotAskTheVehicleForCrcsWhileArmed)
  it("does not ask again for a log of the same number and size on the same connection", doesNotAskAgainForALogThatIsTheSame)
  it("stops asking for CRCs when the time for the whole list is up", stopsAskingWhenTheTimeIsUp)
  it("stops the list on logs.cancel", stopsTheListOnCancel)
  it("stops the list when the vehicle arms", stopsTheListWhenTheVehicleArms)
  it("names a copy that has no checksum, apart from a checked copy", namesAProtocolCopy)
  it("lists over the log protocol when the vehicle has no file transfer", listsOverTheLogProtocolWhenThereIsNoFileTransfer)
  it("downloads over the log protocol, and never calls the copy checked", downloadsOverTheLogProtocolAndNeverChecksTheCopy)
  it("goes on from a part over the log protocol, asking only for what is missing", goesOnFromAPartOverTheLogProtocol)
  it("stops a download over the log protocol when the vehicle arms, keeping the part", stopsAProtocolDownloadWhenTheVehicleArms)
  it("erases every log, when each has a copy that the vehicle's CRC confirms", erasesEveryLogWhenEachHasACheckedCopy)
  it("erases nothing while a log on the vehicle has no checked copy", erasesNothingWhileALogHasNoCheckedCopy)
  it("does not take a copy with no checksum for a checked one", doesNotTakeACopyWithNoChecksumForAChecked)
  it("reads the copy again, and erases nothing when it is not the one that was checked", doesNotEraseWhatTheCopyDoesNotMatch)
  it("erases nothing when there is no file transfer to check the copies against", doesNotEraseWithNoFileTransferToCheckAgainst)
  it("sends no erase to a vehicle with no logs", erasesNothingOnAVehicleWithNoLogs)
  it("refuses to erase while armed, while that is not known, and while busy", refusesToEraseWhileArmedOrNotKnownOrBusy)
  it("vetoes the erase when the vehicle's logs are not the ones that were checked", vetoesAnEraseOfLogsThatAreNotTheOnesThatWereChecked)
})
