// The link's quality (#29): loss counted from sequence numbers (with the wrap from 255 to 0, duplicates, and senders apart), the rates
// over the window, and, against the simulated vehicle over an in-memory link, the `link.stats` stream with its TIMESYNC round trip.
import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { Cbor } from "pico-desktop/communicator"
import { Received, TimeSync } from "padcom/pico-mavlink"
import { simulatorForTests } from "./app"
import { ConnectRequest, ConnectRequestTransport, LinkStats, decodeLinkStats, encodeConnectRequest } from "./generated/app"
import { LinkMeter, gapOf } from "./linkstats"
import { Frontend, start } from "./testing"

async function gapsAcrossTheWrap(): Promise<void> {
  expect(`${gapOf(10, 11)} ${gapOf(10, 13)} ${gapOf(255, 0)} ${gapOf(254, 1)} ${gapOf(10, 10)} ${gapOf(0, 255)}`).toBe("0 2 0 2 0 254")
}

async function countsLossPerSender(): Promise<void> {
  const m = new LinkMeter()
  m.reset(1000)
  // sender A: 250..255, 0..4 with 253 and 2 missing (2 lost, across the wrap); sender B: 7, 8, 8 (a duplicate), 9 (none lost)
  for (const seq of [250, 251, 252, 254, 255, 0, 1, 3, 4]) {
    m.take(256 + 1, seq, 20, 1100)
  }
  for (const seq of [7, 8, 8, 9]) {
    m.take(2 * 256 + 1, seq, 20, 1200)
  }
  const s = m.stats(1500)
  expect(`${s.received} ${s.lost} ${s.totalReceived} ${s.totalLost}`).toBe("13 2 13 2")
}

async function aLossyLinkShowsItsRate(): Promise<void> {
  const m = new LinkMeter()
  m.reset(0)
  // 50 packets a second for 5 s, every fourth one dropped on the way (25 % lost), and 10 frames a second sent, 30 bytes each; at
  // 5000 ms the first second has left the window (four full seconds and the one that has just begun)
  let seq = 0
  for (let i = 0; i < 250; i++) {
    const at = i * 20
    if (i % 4 != 3) {
      m.take(256 + 1, seq, 40, at)
    }
    seq = (seq + 1) % 256
    if (i % 5 == 0) {
      m.sent(30, at)
    }
  }
  const s = m.stats(5000)
  const loss = Math.round((s.lost as f64) * 100.0 / ((s.lost + s.received) as f64))
  expect(`${s.windowMs} ${loss} ${s.rxRate} ${s.txRate} ${s.txBytes}`).toBe("4000 25 37.5 10 300")
  expect(s.latencyMs == null).toBe(true)
}

async function theWindowSlides(): Promise<void> {
  const m = new LinkMeter()
  m.reset(0)
  m.take(257, 0, 10, 100)
  m.take(257, 5, 10, 200)
  m.roundTrip(40.0, 300)
  m.roundTrip(60.0, 400)
  const early = m.stats(500)
  expect(`${early.lost} ${early.latencyMs ?? -1.0} ${early.silentMs}`).toBe("4 50 300")
  // ten seconds later the loss and the round trips have left the window; the totals stay, and the link has been silent since
  m.take(257, 6, 10, 10200)
  const late = m.stats(10500)
  expect(`${late.lost} ${late.received} ${late.latencyMs == null} ${late.totalLost} ${late.silentMs}`).toBe("0 1 true 4 300")
}

/// The next `link.stats` that says something was received.
async function nextStats(f: Frontend): Promise<LinkStats> throws Error {
  for (let i = 0; i < 10; i++) {
    const s = decodeLinkStats((await f.event("link.stats")).p ?? Cbor.Null, "$")
    if (s.received > (0 as u32)) {
      return s
    }
  }
  throw new Error("no link.stats with packets")
}

/// The simulated vehicle answers TIMESYNC as the specification says (the simulator itself does not yet): `tc1` its time, `ts1`
/// mirrored, the target the one who asked.
function answerTimeSync(r: Received): void {
  const m = r.message
  const sim = simulatorForTests()
  if (m instanceof TimeSync && m.tc1 == (0 as i64) && sim != null) {
    const out = new TimeSync()
    out.tc1 = 1 as i64
    out.ts1 = m.ts1
    out.targetSystem = r.packet.header.sysid as u8
    out.targetComponent = r.packet.header.compid as u8
    sim!.conn.send(out)
  }
}

async function streamsTheSimulatorsLink(): Promise<void> throws Error {
  const f = await start()
  await f.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const sim = simulatorForTests()!
  const listener = sim.conn.on((r: Received) => answerTimeSync(r))
  const s = await f.subscribe("link.stats")
  try {
    await delay(1500)
    const stats = await nextStats(f)
    // an in-memory link loses nothing; heartbeats and requests went out; the TIMESYNCs came back
    expect(`${stats.lost} ${stats.totalLost}`).toBe("0 0")
    expect(stats.rxRate > 0.0 && stats.txRate > 0.0 && stats.rxBytes > stats.rxRate && stats.txBytes > stats.txRate).toBe(true)
    expect(stats.silentMs < (1500 as u32)).toBe(true)
    const latency = stats.latencyMs ?? -1.0
    expect(latency >= 0.0 && latency < 500.0).toBe(true)
  } finally {
    sim.conn.off(listener)
    await f.unsubscribe(s)
    await f.call("vehicle.disconnect")
  }
}

describe("the link's quality", () => {
  it("counts the packets missing between sequence numbers, across the wrap", gapsAcrossTheWrap)
  it("counts loss per sender, and a duplicate as no loss", countsLossPerSender)
  it("shows the rate of a lossy link", aLossyLinkShowsItsRate)
  it("keeps the last seconds only, and the totals", theWindowSlides)
  it("streams the simulator's link, with the TIMESYNC round trip", streamsTheSimulatorsLink)
})
