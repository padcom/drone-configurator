// The backend over an in-memory link, against the simulated vehicle. (Over a serial port:
// app.serial.test.pi.)
import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { Cbor } from "pico-desktop/communicator"
import { MavParamType, TypedParamValue } from "padcom/pico-mavlink"
import { setHeartbeatWait, simulatorForTests } from "./app"
import { start } from "./test-frontend"
import {
  ConnectRequest,
  ConnectRequestTransport,
  ConnectionState,
  ParamWrite,
  ParamWriteKind,
  decodeConnection,
  decodeParam,
  decodeParamList,
  decodeParamWriteResult,
  encodeConnectRequest,
  encodeParamWrite,
} from "./generated/app"

async function connectsListsAndWrites(): Promise<void> throws Error {
  const f = await start()
  const c = decodeConnection((await f.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))).p ?? Cbor.Null, "$")
  expect(c.state == ConnectionState.Connected).toBe(true)
  const v = c.vehicle!
  expect(`${v.sysid}/${v.compid} ${v.type} ${v.autopilot}`).toBe("1/1 QUADROTOR ARDUPILOTMEGA")
  const list = decodeParamList((await f.call("params.list")).p ?? Cbor.Null, "$")
  expect(`${list.count} ${list.complete} ${list.params[1].id}=${list.params[1].value} ${list.params[1].type}`).toBe("12 true BATT_CAPACITY=5200 INT32")
  const w = ParamWrite { id: "WPNAV_SPEED", kind: ParamWriteKind.Real, type: "REAL32", value: 750.0 }
  const r = decodeParamWriteResult((await f.call("params.write", encodeParamWrite(w))).p ?? Cbor.Null, "$")
  expect(`${r.param.id}=${r.param.value} ${r.verified}`).toBe("WPNAV_SPEED=750 true")
  await f.call("vehicle.disconnect")
}

async function refusesWithoutAVehicle(): Promise<void> throws Error {
  const f = await start()
  await f.call("vehicle.disconnect")
  const e = await f.call("params.list")
  expect(e.err?.code ?? "no error").toBe("NOT_CONNECTED")
}

async function noHeartbeat(): Promise<void> throws Error {
  setHeartbeatWait(200)
  const f = await start()
  // A UDP port nobody sends to.
  const c = decodeConnection((await f.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Udp, port: 14999 }))).p ?? Cbor.Null, "$")
  setHeartbeatWait(3000)
  expect(`${c.state == ConnectionState.Disconnected} ${c.error ?? ""}`).toBe("true no heartbeat from udp 127.0.0.1:14999")
}

async function disconnectCancels(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  // The simulator never answers a parameter it doesn't have: the write would retry for seconds.
  const w = ParamWrite { id: "NO_SUCH_PARAM", kind: ParamWriteKind.Int, type: "INT32", value: 1.0 }
  const started = Date.now() as int
  const writing = await fe.send("params.write", encodeParamWrite(w))
  await delay(50)
  await fe.call("vehicle.disconnect")
  const e = await fe.reply(writing)
  expect(`${e.err?.code ?? "no error"} ${(Date.now() as int) - started < 1000}`).toBe("ABORTED true")
}

async function announcesChanges(): Promise<void> throws Error {
  const fe = await start()
  await fe.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  await fe.call("params.list")
  // Another ground station changes RTL_ALT: the vehicle announces it, the backend passes it on.
  simulatorForTests()!.change("RTL_ALT", TypedParamValue.Int(2500, MavParamType.INT32))
  const e = await fe.event("params.changed")
  const p = decodeParam(e.p ?? Cbor.Null, "$")
  expect(`${p.id}=${p.value} ${p.type}`).toBe("RTL_ALT=2500 INT32")
  await fe.call("vehicle.disconnect")
}

describe("the backend", () => {
  it("cancels a write in flight when the user disconnects", disconnectCancels)
  it("passes on a parameter the vehicle announces", announcesChanges)
  it("connects to the simulator, lists parameters and writes one with read-back", connectsListsAndWrites)
  it("refuses parameter calls without a vehicle", refusesWithoutAVehicle)
  it("reports a link with no heartbeat", noHeartbeat)
})
