// The only place that knows how a vehicle is reached: the simulator, UDP (listening, or sending to a vehicle that listens),
// TCP (connecting, or listening for the vehicle to connect) and a serial port, each as pico-mavlink's byte stream.
import { CommunicatorError } from "pico-desktop/communicator"
import { SerialPort as SerialDevice, listPorts, openPort } from "padcom/serialport"
import { Conn, Listener, bind, connect, listen } from "std/net"
import {
  ByteStream,
  MavParamType,
  MemoryStream,
  SimParam,
  SimulatedAutopilot,
  TcpStream,
  TypedParamValue,
  UdpStream,
  defaultSimParams,
} from "padcom/pico-mavlink"
import { ConnectRequest, ConnectRequestTransport } from "./generated/app"
import { BAUD_RATES, choosePort, detectBaud } from "./autodetect"
import { localFor } from "./discovery"

/// A serial port as pico-mavlink's byte stream: the same three methods (each library declares its
/// own interface, so the application adapts one to the other).
class SerialStream implements ByteStream {
  readonly port: SerialDevice

  constructor(port: SerialDevice) {
    this.port = port
  }

  public read(): Promise<Uint8Array?, Error> {
    port.read()
  }

  public write(bytes: Uint8Array): Promise<void, Error> {
    port.write(bytes)
  }

  public close(): void {
    port.close()
  }
}

/// A TCP port the backend listens on, as one byte stream (#197): the vehicle, or a forwarder, connects in. One connection at a
/// time: when it ends, the next one is taken, and the stream goes on (a vehicle that reboots connects again), so the link only
/// ends when the stream is closed. Until somebody has connected, what is written is dropped (as on a UDP port nobody sent to).
export class TcpServerStream implements ByteStream {
  readonly listener: Listener
  conn: Conn? = null
  closed: bool = false

  constructor(listener: Listener) {
    this.listener = listener
  }

  /// The next bytes from the connection, taking one first when there is none.
  public async read(): Promise<Uint8Array?> throws Error {
    while (!closed) {
      if (conn == null) {
        conn = await listener.accept()
        if (conn == null) {
          return null
        }
      }
      const chunk = await readOrEnd(conn!)
      if (chunk != null) {
        return chunk
      }
      // That one went: the next is taken.
      conn!.close()
      conn = null
    }
    return null
  }

  public async write(bytes: Uint8Array): Promise<void> throws Error {
    const c = conn
    if (c != null) {
      try {
        await c!.write(bytes)
        return
      } catch (e: Error) {
        // The peer went: its reads end it.
      }
    }
  }

  public close(): void {
    closed = true
    listener.close()
    conn?.close()
  }
}

/// The next bytes of a connection, or null when it ended or failed (a peer that resets it is as gone as one that closes it).
async function readOrEnd(c: Conn): Promise<Uint8Array?> {
  try {
    return await c.read()
  } catch (e: Error) {
    return null
  }
}

/// What a connection request asks for, in words for the user.
export function describe(r: ConnectRequest): string {
  match (r.transport) {
    Simulator => "the simulator",
    Udp => `udp ${r.host ?? "127.0.0.1"}:${r.port ?? 14550}`,
    UdpClient => `udp to ${r.host ?? "127.0.0.1"}:${r.port ?? 14550}`,
    Tcp => `tcp ${r.host ?? "127.0.0.1"}:${r.port ?? 5760}`,
    TcpServer => `tcp server ${r.host ?? "127.0.0.1"}:${r.port ?? 5760}`,
    Serial => `serial ${r.device ?? "(the likely autopilot)"} ${if (r.baud != null) `at ${r.baud!}` else "(trying the common rates)"}`,
  }
}

/// The simulated vehicle's parameters: pico-mavlink's Copter-like set, a few of them away from the firmware's default (which
/// the parameter file gives when it is asked for the defaults), as a vehicle that was set up has them: "modified from default".
/// The frontend's mock has the same (DEFAULTS in fixtures.ts).
export function simulatorParams(): SimParam[] {
  const out: SimParam[] = []
  for (const p of defaultSimParams()) {
    const firmware = firmwareDefaultOf(p.id)
    if (firmware != null) {
      out.push({ id: p.id, value: p.value, firmwareDefault: firmware! })
    } else {
      out.push(p)
    }
  }
  return out
}

/// The firmware's default of a simulated parameter that the simulated vehicle has away from it, or null.
function firmwareDefaultOf(id: string): TypedParamValue? {
  if (id == "BATT_CAPACITY") {
    return TypedParamValue.Int(3300, MavParamType.INT32)
  }
  if (id == "FENCE_RADIUS") {
    return TypedParamValue.Real(300.0, MavParamType.REAL32)
  }
  if (id == "WPNAV_SPEED") {
    return TypedParamValue.Real(500.0, MavParamType.REAL32)
  }
  return null
}

/// Opens the link a request asks for. For the simulator, `onSimulator` is given the simulated vehicle
/// (before the stream is returned), so its owner can stop it with the link.
export async function open(r: ConnectRequest, onSimulator: (sim: SimulatedAutopilot) => void): Promise<ByteStream> throws Error {
  match (r.transport) {
    Simulator => {
      const ends = MemoryStream.pair()
      const sim = new SimulatedAutopilot(ends[1], simulatorParams())
      // Set up before it starts: its first heartbeat is already as it should be (signed, when it holds a key).
      onSimulator(sim)
      sim.start(1000)
      const s: ByteStream = ends[0]
      s
    },
    Udp => {
      // SITL and MAVESP8266 send to this port; replies go back to whoever sent.
      const socket = await bind((r.port ?? 14550) as int, r.host ?? "127.0.0.1")
      const s: ByteStream = new UdpStream(socket)
      s
    },
    UdpClient => {
      // A port of our own; what is sent (the heartbeats first) goes to the vehicle, which answers that port.
      const host = r.host ?? "127.0.0.1"
      const socket = await bind(0, localFor(host))
      const s: ByteStream = new UdpStream(socket, (r.port ?? 14550) as int, host)
      s
    },
    Tcp => {
      const c = await connect((r.port ?? 5760) as int, r.host ?? "127.0.0.1")
      const s: ByteStream = new TcpStream(c)
      s
    },
    TcpServer => {
      const s: ByteStream = new TcpServerStream(await listen((r.port ?? 5760) as int, r.host ?? "127.0.0.1"))
      s
    },
    Serial => {
      const device = r.device
      if (device == null) {
        throw new CommunicatorError("INVALID_VALUE", "a serial connection needs a device")
      }
      const s: ByteStream = new SerialStream(openPort(device!, { baudRate: (r.baud ?? 115200) as int }))
      s
    },
  }
}

/// A link that was opened, and the request that opens it again: for a serial request that left the device or the rate to
/// be found, the device and the rate that were found (a reconnect opens them as they are, without detecting again).
export struct Opened {
  stream: ByteStream
  request: ConnectRequest
}

/// A serial port at a rate, as a byte stream.
function serialAt(device: string, baud: int): ByteStream throws Error {
  const s: ByteStream = new SerialStream(openPort(device, { baudRate: baud }))
  return s
}

/// Opens the link a connection request asks for, finding what a serial request leaves out (autodetect.pi): the device,
/// the port most likely to be the autopilot; the rate, the first common rate that brings MAVLink (each listened to for
/// `windowMs`). Null when `stillWanted` says the detection is no longer wanted.
export async function openDetecting(
  r: ConnectRequest,
  onSimulator: (sim: SimulatedAutopilot) => void,
  windowMs: int,
  stillWanted: () => bool,
): Promise<Opened?> throws Error {
  if (r.transport != ConnectRequestTransport.Serial || (r.device != null && r.baud != null)) {
    return Opened { stream: await open(r, onSimulator), request: r }
  }
  const device = r.device ?? choosePort(await listPorts()).path
  if (r.baud != null) {
    return Opened { stream: serialAt(device, r.baud! as int), request: ConnectRequest { transport: r.transport, device: device, baud: r.baud } }
  }
  const found = await detectBaud(async (baud: int): Promise<ByteStream> throws Error => serialAt(device, baud), BAUD_RATES, windowMs, stillWanted)
  if (found == null) {
    return null
  }
  const request = ConnectRequest { transport: r.transport, device: device, baud: found!.baud as u32 }
  return Opened { stream: found!.stream, request: request }
}
