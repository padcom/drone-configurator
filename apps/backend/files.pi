// The files service: saving and opening a parameter snapshot where the user chooses.
import { Cbor, Communicator, CommunicatorError, Host, OpenFile, RequestContext, SaveFile } from "pico-desktop/communicator"
import { FileInfo, exists, readText, stat, writeText } from "std/fs"
import { env } from "std/process"
import { FileContents, FileOpened, FileSaved, decodeFileRead, decodeFileSave, encodeFileContents, encodeFileOpened, encodeFileSaved } from "./generated/app"

/// The host's native services (file dialogs).
class Dialogs {
  public host: Host? = null
}

const dialogs = new Dialogs()

/// Registers the service's methods on `c`.
export function register(c: Communicator): void {
  dialogs.host = new Host(c)
  c.handle("files.save", saveFile)
  c.handle("files.open", openFile)
  c.handle("files.read", readFile)
}

function host(): Host {
  const h = dialogs.host
  if (h == null) {
    panic("drone-configurator: createBackend wasn't called")
  }
  h!
}

/// How the backend learns which file the user means.
export interface FileChooser {
  /// Where to save `name` (the dialog is titled `title`); null if the user cancelled.
  forSaving(title: string, name: string): Promise<string?, Error>
  /// The file to open; null if the user cancelled.
  forOpening(): Promise<string?, Error>
  /// The recording (`.tlog`) to import; null if the user cancelled.
  forImporting(): Promise<string?, Error>
}

/// The host's native dialogs.
class DialogFileChooser implements FileChooser {
  public async forSaving(title: string, name: string): Promise<string?> throws Error {
    await host().saveFile(SaveFile { title: title, defaultPath: name })
  }

  public async forOpening(): Promise<string?> throws Error {
    const paths = await host().openFile(OpenFile { title: "Load parameters", filters: [".json"] })
    if (paths.length == 0) null else paths[0]
  }

  public async forImporting(): Promise<string?> throws Error {
    const paths = await host().openFile(OpenFile { title: "Open a log file", filters: [".tlog"] })
    if (paths.length == 0) null else paths[0]
  }
}

/// A directory instead of dialogs, which a test can't click: `name` is saved there, and
/// `open.json` is what's opened.
class DirectoryFileChooser implements FileChooser {
  readonly dir: string

  constructor(dir: string) {
    this.dir = dir
  }

  public async forSaving(_title: string, name: string): Promise<string?> throws Error {
    `${dir}/${name}`
  }

  public async forOpening(): Promise<string?> throws Error {
    `${dir}/open.json`
  }

  /// `import.tlog` in the folder, or null (a cancelled dialog) when there is none.
  public async forImporting(): Promise<string?> throws Error {
    const path = `${dir}/import.tlog`
    if (await exists(path)) path else null
  }
}

export function fileChooser(): FileChooser {
  const dir = env.get("DRONE_CONFIGURATOR_TEST_FILES")
  if (dir != null) {
    return new DirectoryFileChooser(dir!)
  }
  new DialogFileChooser()
}

/// Saves a snapshot where the user chooses.
async function saveFile(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const f = decodeFileSave(payload ?? Cbor.Null, "$")
  const path = await fileChooser().forSaving("Save the parameters", f.name)
  if (path == null) {
    return encodeFileSaved(FileSaved {})
  }
  await writeText(path!, f.text)
  encodeFileSaved(FileSaved { path: path })
}

/// Reads a snapshot the user chooses.
async function openFile(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const path = await fileChooser().forOpening()
  if (path == null) {
    return encodeFileOpened(FileOpened {})
  }
  const text = await readText(path!)
  encodeFileOpened(FileOpened { path: path!, text: text })
}

/// The most `files.read` gives: a metadata file is a few MB at the most.
const MAX_READ_BYTES: int = 16777216

/// Whether `path` is absolute: from the root of a POSIX file system, a drive (`C:\` or `C:/`) or a network share (`\\`).
function isAbsolute(path: string): bool {
  if (path.startsWith("/") || path.startsWith("\\\\")) {
    return true
  }
  const drive = path.split(":")[0]
  drive.length == 1 && (path.startsWith(`${drive}:/`) || path.startsWith(`${drive}:\\`))
}

/// Whether some part of `path` is `..` (either separator).
function climbs(path: string): bool {
  for (const part of path.split("/")) {
    for (const piece of part.split("\\")) {
      if (piece == "..") {
        return true
      }
    }
  }
  false
}

/// Refuses a path `files.read` does not read, by what is written in it: not absolute, a `..` in it, or not named `.json`.
function refuseByName(path: string): void throws CommunicatorError {
  if (!isAbsolute(path)) {
    throw new CommunicatorError("INVALID_PATH", "not an absolute path (a file is read only from a full path)")
  }
  if (climbs(path)) {
    throw new CommunicatorError("INVALID_PATH", "it has a \"..\" in it (a path is read as written, not climbed)")
  }
  if (!path.toLowerCase().endsWith(".json")) {
    throw new CommunicatorError("NOT_JSON", "not a .json file (only a .json file is read)")
  }
}

/// What is at `path` once links are followed: refused when it is not there, cannot be looked at, or is not a regular file.
async function regularFile(path: string): Promise<FileInfo> throws CommunicatorError {
  let info: FileInfo
  try {
    info = await stat(path)
  } catch (e: IoError) {
    if (e.kind == "NotFound") {
      throw new CommunicatorError("NOT_FOUND", "no such file")
    }
    throw new CommunicatorError("UNREADABLE", `it cannot be looked at (${e.kind})`)
  }
  if (!info.isFile) {
    throw new CommunicatorError("NOT_A_FILE", "not a regular file")
  }
  info
}

/// Reads the JSON file at a path the user wrote (the metadata file the settings keep), under the rules in the contract. The
/// errors give the rule and never the file's contents (the caller knows the path it asked for).
async function readFile(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const path = decodeFileRead(payload ?? Cbor.Null, "$").path
  refuseByName(path)
  const info = await regularFile(path)
  if (info.size > MAX_READ_BYTES) {
    throw new CommunicatorError("TOO_LARGE", "over 16 MiB")
  }
  let text = ""
  try {
    text = await readText(path)
  } catch (e: IoError) {
    throw new CommunicatorError("UNREADABLE", `it cannot be read (${e.kind})`)
  }
  encodeFileContents(FileContents { text: text })
}
