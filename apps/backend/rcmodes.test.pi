// What each copter mode does with the pilot's throttle: `rcmodes.pi` held to the golden vectors the page's `lib/rc/modes.ts` is held to as
// well (`packages/contracts/mode-vectors.txt`), so that the two tables cannot differ.
import { describe, it, expect } from "std/test"
import { exists, readText } from "std/fs"
import { CLIMB, IGNORES, THRUST, continuesIn, isMulticopter, modeClass, startsIn } from "./rcmodes"

/// The vectors' path from where the tests run: the repository's root (a developer) or apps/backend (CI). It must be found: nothing is skipped.
async function vectorsPath(): Promise<string> throws Error {
  const name = "packages/contracts/mode-vectors.txt"
  for (const base of [".", "../.."]) {
    if (await exists(`${base}/${name}`)) {
      return `${base}/${name}`
    }
  }
  panic(`the mode vectors are not at ./${name} or ../../${name}: the tests must run from the repository's root or from apps/backend`)
}

function classOf(word: string): int {
  return match (word) {
    "climb" => CLIMB,
    "ignores" => IGNORES,
    _ => THRUST,
  }
}

async function everyModeOfTheVectorsHasItsClass(): Promise<void> throws Error {
  const text = await readText(await vectorsPath())
  const wrong: string[] = []
  const seen: int[] = []
  for (const line of text.split("\n")) {
    if (line.trim().length > 0 && !line.startsWith("#")) {
      const parts = line.split("|").map((p: string) => p.trim())
      const number = parseInt(parts[0])
      seen.push(number)
      if (modeClass(number) != classOf(parts[2])) {
        wrong.push(`${parts[1]} (${number}): ${modeClass(number)} is not ${parts[2]}`)
      }
    }
  }
  expect(wrong.join("; ")).toBe("")
  expect(seen.length).toBe(26)
}

async function aModeThatIsNotInTheVectorsIsThrust(): Promise<void> throws Error {
  const text = await readText(await vectorsPath())
  let known = 0
  for (let number = -2; number < 40; number++) {
    if (text.includes(`\n${number}|`)) {
      known += 1
    } else {
      expect(modeClass(number)).toBe(THRUST)
    }
  }
  expect(known).toBe(26)
}

function aControlStartsOnlyWhereTheThrottleIsAClimbRate(): void {
  for (const number of [2, 5, 7, 13, 15, 16, 22, 24]) {
    expect(startsIn(number)).toBe(true)
  }
  for (const number of [-1, 0, 1, 3, 4, 6, 9, 11, 14, 17, 25, 27, 28, 99]) {
    expect(startsIn(number)).toBe(false)
  }
}

function aControlGoesOnWhereTheThrottleIsAClimbRateOrTakesNone(): void {
  for (const number of [2, 5, 7, 13, 15, 16, 22, 24, 3, 4, 6, 9, 17, 18, 19, 20, 21, 23, 26, 27]) {
    expect(continuesIn(number)).toBe(true)
  }
  for (const number of [-1, 0, 1, 11, 14, 25, 28, 29, 99]) {
    expect(continuesIn(number)).toBe(false)
  }
}

function onlyAMulticopterTakesACentredThrottle(): void {
  for (const type of [2, 13, 14, 15, 29, 35]) {
    expect(isMulticopter(type)).toBe(true)
  }
  // a plane, a helicopter, a rover, a submarine, a boat, and none heard yet
  for (const type of [1, 4, 10, 12, 11, -1, 0]) {
    expect(isMulticopter(type)).toBe(false)
  }
}

describe("the mode table of the backend", () => {
  it("gives every mode of the golden vectors the class they say", everyModeOfTheVectorsHasItsClass)
  it("takes every other mode for thrust", aModeThatIsNotInTheVectorsIsThrust)
})

describe("where a centred throttle may be", () => {
  it("starts only in a mode that reads it as a climb rate, and never with no heartbeat", aControlStartsOnlyWhereTheThrottleIsAClimbRate)
  it("goes on where the throttle is a climb rate or taken by no one", aControlGoesOnWhereTheThrottleIsAClimbRateOrTakesNone)
  it("is for a multicopter only", onlyAMulticopterTakesACentredThrottle)
})
