// The files service. The host's dialogs can't be clicked in a test, so DRONE_CONFIGURATOR_TEST_FILES
// names a directory instead: a snapshot is saved there under the name asked for, and `open.json`
// is what opening gives (files.pi, DirectoryFileChooser).
import { describe, it, expect } from "std/test"
import { chmod, mkdir, readText, remove, symlink, writeBytes, writeText } from "std/fs"
import { join } from "std/path"
import { env, pid } from "std/process"
import { Cbor } from "pico-desktop/communicator"
import { FileRead, FileSave, decodeFileContents, decodeFileOpened, decodeFileSaved, encodeFileRead, encodeFileSave } from "./generated/app"
import { start } from "./testing"

const VARIABLE = "DRONE_CONFIGURATOR_TEST_FILES"

/// Puts the variable back as it was.
function restore(was: string?): void {
  if (was == null) env.delete(VARIABLE) else env.set(VARIABLE, was!)
}

async function savesAndOpens(): Promise<void> throws Error {
  const was = env.get(VARIABLE)
  const dir = join(env.get("TMPDIR") ?? "/tmp", `dc-files-test-${pid}`)
  try {
    await mkdir(dir, true)
    env.set(VARIABLE, dir)
    const f = await start()
    const saved = decodeFileSaved((await f.call("files.save", encodeFileSave(FileSave { name: "params.json", text: "{\"a\":1}" }))).p ?? Cbor.Null, "$")
    expect(saved.path ?? "no path").toBe(`${dir}/params.json`)
    expect(await readText(`${dir}/params.json`)).toBe("{\"a\":1}")
    await writeText(`${dir}/open.json`, "{\"b\":2}")
    const opened = decodeFileOpened((await f.call("files.open")).p ?? Cbor.Null, "$")
    expect(`${opened.path ?? "no path"} ${opened.text ?? "no text"}`).toBe(`${dir}/open.json {"b":2}`)
  } finally {
    restore(was)
    await remove(dir, true)
  }
}

async function reportsAMissingFile(): Promise<void> throws Error {
  const was = env.get(VARIABLE)
  const dir = join(env.get("TMPDIR") ?? "/tmp", `dc-files-test-missing-${pid}`)
  try {
    await mkdir(dir, true)
    env.set(VARIABLE, dir)
    const f = await start()
    // No open.json there: opening fails with an error the dashboard can show, not a crash.
    const e = await f.call("files.open")
    expect(e.k).toBe("error")
    expect((e.err?.message ?? "").length > 0).toBe(true)
  } finally {
    restore(was)
    await remove(dir, true)
  }
}

/// A directory of its own for a test.
async function freshDir(name: string): Promise<string> throws Error {
  const dir = join(env.get("TMPDIR") ?? "/tmp", `dc-files-${name}-${pid}`)
  await mkdir(dir, true)
  dir
}

/// `files.read` of a path: the error code and message, or `ok: ` and the text.
async function readOf(path: string): Promise<string> throws Error {
  const f = await start()
  const e = await f.call("files.read", encodeFileRead(FileRead { path: path }))
  if (e.k == "error") {
    return `${e.err?.code ?? "?"}: ${e.err?.message ?? ""}`
  }
  `ok: ${decodeFileContents(e.p ?? Cbor.Null, "$").text}`
}

/// The code of what `readOf` said (`ok` for a file read).
async function codeOf(path: string): Promise<string> throws Error {
  (await readOf(path)).split(":")[0]
}

async function readsAJsonFileByItsPath(): Promise<void> throws Error {
  const dir = await freshDir("read")
  try {
    await writeText(`${dir}/meta.json`, "{\"a\":1}")
    expect(await readOf(`${dir}/meta.json`)).toBe("ok: {\"a\":1}")
    // a link is followed, and what it leads to is read
    await symlink(`${dir}/meta.json`, `${dir}/link.json`)
    expect(await readOf(`${dir}/link.json`)).toBe("ok: {\"a\":1}")
  } finally {
    await remove(dir, true)
  }
}

async function refusesWhatItDoesNotRead(): Promise<void> throws Error {
  const dir = await freshDir("refuse")
  try {
    await writeText(`${dir}/meta.json`, "{}")
    await writeText(`${dir}/notes.txt`, "{}")
    await mkdir(`${dir}/folder.json`, true)
    await symlink(`${dir}/folder.json`, `${dir}/dirlink.json`)
    const codes = [
      await codeOf("meta.json"),
      await codeOf("./meta.json"),
      await codeOf(`${dir}/../meta.json`),
      await codeOf(`${dir}\\..\\meta.json`),
      await codeOf(`${dir}/notes.txt`),
      await codeOf(`${dir}/absent.json`),
      await codeOf(`${dir}/folder.json`),
      await codeOf(`${dir}/dirlink.json`),
      await codeOf(""),
    ]
    expect(codes.join(" ")).toBe("INVALID_PATH INVALID_PATH INVALID_PATH INVALID_PATH NOT_JSON NOT_FOUND NOT_A_FILE NOT_A_FILE INVALID_PATH")
    // the reason names the path as written, and the rule
    expect(await readOf("meta.json")).toBe("INVALID_PATH: not an absolute path (a file is read only from a full path)")
  } finally {
    await remove(dir, true)
  }
}

async function refusesAFileOver16MiB(): Promise<void> throws Error {
  const dir = await freshDir("big")
  try {
    await writeBytes(`${dir}/big.json`, new Uint8Array(16777217))
    await writeBytes(`${dir}/edge.json`, new Uint8Array(16777216))
    expect(await codeOf(`${dir}/big.json`)).toBe("TOO_LARGE")
    // exactly the limit is read
    expect(await codeOf(`${dir}/edge.json`)).toBe("ok")
  } finally {
    await remove(dir, true)
  }
}

async function neverPutsTheContentsInAnError(): Promise<void> throws Error {
  const dir = await freshDir("closed")
  try {
    // a file that may not be read: the rule is said, and what it holds is not
    await writeText(`${dir}/closed.json`, "{\"secret\":1}")
    await chmod(`${dir}/closed.json`, 0)
    const said = await readOf(`${dir}/closed.json`)
    await chmod(`${dir}/closed.json`, 420)
    expect(said.startsWith("UNREADABLE: it cannot be read")).toBe(true)
    expect(said.includes("secret")).toBe(false)
  } finally {
    await remove(dir, true)
  }
}

describe("the files service", () => {
  it("saves a snapshot under the name asked for and opens the file the test directory holds", savesAndOpens)
  it("reports a file that isn't there as an error", reportsAMissingFile)
  it("reads a .json file by its path, a link too", readsAJsonFileByItsPath)
  it("refuses a relative path, a .., a file that is not .json, a missing one, a folder and a link to one", refusesWhatItDoesNotRead)
  it("refuses a file over 16 MiB and reads one of exactly that", refusesAFileOver16MiB)
  it("does not say what a file it cannot read holds", neverPutsTheContentsInAnError)
})
