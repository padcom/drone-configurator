// The simulated vehicle behind a real TCP port, for the end-to-end suite (apps/frontend/e2e): the
// same MAVLink over the same socket path as ArduPilot SITL's port 5760, without SITL. It prints
// `listening <port>`, then serves one vehicle per connection until it's killed. It prints
// `param-set` for each PARAM_SET it receives, and `interval <id> <us>` for each SET_MESSAGE_INTERVAL. Any input on stdin makes the current vehicle go
// silent, so a write stays in flight. With the environment variable VEHICLE_LOGS=1 it holds three flight logs (valid DataFlash
// logs of different lengths, in `/logs`, which file transfer and the MAVLink log protocol serve) and stays DISARMED (the
// simulator arms itself after three ticks; a logs download is refused while armed), so that logs can be listed, downloaded and
// erased through the window. With VEHICLE_SETUP=1 it has the parameters the Setup pages read (a Copter with its frame, flight modes
// and failsafes set, and a compass that was never calibrated) and stays disarmed too, so that they can be written. Its
// calibrations (the accelerometer's six positions, the level, the compass of two compasses) are quick, and it says "AHRS: EKF3
// active" a second and a half after the link is made, as a vehicle that is up does (the app waits for it before it calibrates).
// With VEHICLE_50HZ=1 it sends its position, its radio's channels and its outputs 50 times a second, as a vehicle asked for fast
// telemetry does, and stays disarmed (idle on the ground): the app must coalesce that for its page (#26).
// The transports of #197: with VEHICLE_UDP=1 it listens on a UDP port instead (`listening <port>`) and answers whoever sent to it
// last, as a vehicle or a router that listens does (the app's "udp-client"); with VEHICLE_CONNECT_TO=<port> it connects to that
// TCP port on 127.0.0.1 (the app's "tcp-server"), trying every 100 ms, says `connected to <port>` the first time, and connects
// again whenever the connection ends.
// Its serial ports are loopback plugs (SERIAL_CONTROL: what is written comes back); it prints `serial-take <device>` when SERIAL_CONTROL
// takes a port and `serial-release <device>` when it hands one back (the serial bridge, #198).
import { Datagram, UdpSocket, bind, connect, listen } from "std/net"
import { env, stdin, stdout } from "std/process"
import { delay } from "std/timers"
import {
  ByteStream,
  CommandLong,
  MavCmd,
  MavParamType,
  ParamSet,
  Received,
  SimParam,
  SerialControl,
  SerialControlFlag,
  SETUP_SIGNING_ID,
  SigningKey,
  SimulatedAutopilot,
  StatusText,
  TcpStream,
  TypedParamValue,
  defaultSimParams,
  signingTimestamp,
  simulatedLog,
} from "padcom/pico-mavlink"

let muted = false

/// The signing key the last vehicle held when its connection ended: the next one starts with it, as a vehicle keeps its key in its
/// storage (each connection is a new simulated vehicle). It is never printed: what is printed is whether there is one.
class KeptKey {
  public key: SigningKey? = null
}

const keptKey = new KeptKey()

/// Keeps the key `sim` holds for the next connection.
function keepKey(sim: SimulatedAutopilot?): void {
  if (sim == null) {
    return
  }
  const policy = sim!.conn.signing
  keptKey.key = if (policy == null) null else policy!.signingKey
}

/// A stream that says when its far end has gone, and writes nothing after that (a write to a connection the peer has closed is a panic
/// of the runtime, and a simulator that sends at 25 Hz meets that in the moment between the peer's close and its own stop).
class EndWatchingStream implements ByteStream {
  readonly inner: ByteStream
  readonly onEnd: () => void
  public gone: bool = false

  constructor(inner: ByteStream, onEnd: () => void) {
    this.inner = inner
    this.onEnd = onEnd
  }

  /// A read that fails (the peer reset the connection: a ground station that disconnects while the vehicle is sending) is the
  /// end of the connection, as a close is: thrown on, it would end the whole program, and the next connection would be refused.
  public async read(): Promise<Uint8Array?> throws Error {
    let chunk: Uint8Array? = null
    try {
      chunk = await inner.read()
    } catch (e: Error) {
      ended()
      return null
    }
    if (chunk == null) {
      ended()
    }
    return chunk
  }

  ended(): void {
    if (gone) {
      return
    }
    gone = true
    const notify = onEnd
    notify()
  }

  /// A write that fails (the peer reset the connection) ends it too, and is not thrown on (the simulator's timers would end
  /// the program with it).
  public async write(bytes: Uint8Array): Promise<void> throws Error {
    if (!muted && !gone) {
      try {
        await inner.write(bytes)
      } catch (e: Error) {
        ended()
      }
    }
  }

  public close(): void {
    inner.close()
  }
}

/// A UDP port as a byte stream that answers whoever sent to it last (std/net's UdpStream keeps the first sender), as MAVProxy's
/// `udpin` does: a ground station that connects again from another port is answered there.
class FollowingUdpStream implements ByteStream {
  readonly socket: UdpSocket
  peer: Datagram? = null

  constructor(socket: UdpSocket) {
    this.socket = socket
  }

  public async read(): Promise<Uint8Array?> throws Error {
    const d = await socket.receive()
    if (d == null) {
      return null
    }
    peer = d
    return d!.data
  }

  public async write(bytes: Uint8Array): Promise<void> throws Error {
    const to = peer
    if (to != null) {
      await socket.send(bytes, to!.addr.port, to!.addr.hostname)
    }
  }

  public close(): void {
    socket.close()
  }
}

/// Serves one vehicle over `inner` until it ends; the stream says when it has (`gone`).
function serve(inner: ByteStream): EndWatchingStream {
  let sim: SimulatedAutopilot? = null
  const stream = new EndWatchingStream(inner, () => {
    keepKey(sim)
    sim?.stop()
  })
  muted = false
  held.clear()
  const setup = env.get("VEHICLE_SETUP") == "1"
  sim = new SimulatedAutopilot(stream, if (setup) setupParams() else defaultSimParams())
  // MAVLink signing (#33): the key of the last connection, and `signing on` or `signing off` to say which (never the key).
  const key = keptKey.key
  if (key != null) {
    sim!.signing.setKey(key!, signingTimestamp(Date.now() as int))
  }
  stdout.writeText(if (key != null) "signing on\n" else "signing off\n")
  sim!.conn.on((r: Received) => {
    const m = r.message
    if (m instanceof SerialControl) {
      heldSerial(m)
    }
    if (r.packet.header.msgid == SETUP_SIGNING_ID) {
      stdout.writeText("setup-signing\n")
    } else if (m instanceof ParamSet) {
      stdout.writeText("param-set\n")
    } else if (m instanceof CommandLong && m.command as int == MavCmd.DO_MOTOR_TEST) {
      // a test of a motor begins with a timeout above 0, and ends with one of 0
      stdout.writeText(if ((m._param4 as f64) > 0.0) "motor-start\n" else "motor-stop\n")
    } else if (m instanceof CommandLong && m.command as int == MavCmd.SET_MESSAGE_INTERVAL) {
      // `interval <message id> <microseconds>`: 0 gives the message back to the vehicle's own rate, -1 switches it off
      stdout.writeText(`interval ${m._param1 as int} ${m._param2 as int}\n`)
    }
  })
  sim!.start(250)
  // A check that fails: an arm is refused with "PreArm: <text>" (a test of the review before arming, and of a refused arm).
  const prearm = env.get("VEHICLE_PREARM")
  if (prearm != null && prearm! != "") {
    sim!.control.prearm = prearm!
  }
  if (env.get("VEHICLE_LOGS") == "1") {
    withLogs(sim!)
  }
  if (env.get("VEHICLE_50HZ") == "1") {
    stayDisarmed(sim!)
    sendsAt50Hz(sim!, stream)
  }
  if (setup) {
    stayDisarmed(sim!)
    calibratesQuickly(sim!)
    movesTheSticks(sim!)
    showsTheOutputs(sim!)
    // The roll rate has a script (a square wave of 1 rad/s every 2 s, and a second-order response to it: 16 % overshoot): the Tune
    // screen's response chart has a step to measure. ATTITUDE_TARGET comes only when it is asked for with SET_MESSAGE_INTERVAL.
    sim!.rateScript = true
  }
  return stream
}

/// The ports SERIAL_CONTROL holds, as this program has seen the requests.
const held: Map<int, bool> = new Map<int, bool>()

/// Says when SERIAL_CONTROL takes a port, and when it hands it back.
function heldSerial(m: SerialControl): void {
  const flags = m.flags as int
  const device = m.device as int
  if ((flags & SerialControlFlag.REPLY) != 0) {
    return
  }
  const was = held.get(device) ?? false
  const takes = (flags & SerialControlFlag.EXCLUSIVE) != 0
  held.set(device, takes)
  if (takes && !was) {
    stdout.writeText(`serial-take ${device}\n`)
  } else if (!takes && was) {
    stdout.writeText(`serial-release ${device}\n`)
  }
}

/// A vehicle whose calibrations take a moment (the real ones take seconds to minutes), and that says it is up.
function calibratesQuickly(sim: SimulatedAutopilot): void {
  sim.calibration.takesMs = 200
  sim.calibration.repeatMs = 300
  sim.compass.progressMs = 100
  sim.compass.stepPct = 25
  setTimeout(() => {
    const up = new StatusText()
    up.text = "AHRS: EKF3 active"
    sim.conn.send(up)
  }, 1500)
}

/// The parameters of a Copter that was set up as far as the Setup pages can see, except its compass (its offsets are zero), so that
/// the home has a next step; and the usual ones the simulator has.
function setupParams(): SimParam[] {
  const out = defaultSimParams()
  const whole = ["FRAME_CLASS", "FRAME_TYPE", "FLTMODE1", "FLTMODE2", "FLTMODE3", "FLTMODE4", "FLTMODE5", "FLTMODE6", "FLTMODE_CH",
    "FS_GCS_ENABLE", "FS_EKF_ACTION", "BATT_MONITOR", "BATT_FS_LOW_ACT", "BATT_FS_CRT_ACT", "AHRS_ORIENTATION",
    "SERIAL0_PROTOCOL", "SERIAL0_BAUD", "SERIAL1_PROTOCOL", "SERIAL1_BAUD", "SERIAL2_PROTOCOL", "SERIAL2_BAUD"]
  const wholeValues = [1, 1, 0, 5, 6, 3, 9, 16, 5, 0, 1, 4, 2, 1, 0, 2, 115, 2, 57, 5, 115]
  for (let i = 0; i < whole.length; i++) {
    out.push(SimParam { id: whole[i], value: TypedParamValue.Int(wholeValues[i], MavParamType.INT8) })
  }
  // The compasses' order (device ids: an I2C compass and an SPI one, and an empty place) and whether a calibration may turn one.
  out.push(SimParam { id: "COMPASS_PRIO1_ID", value: TypedParamValue.Int(466441, MavParamType.INT32) })
  out.push(SimParam { id: "COMPASS_PRIO2_ID", value: TypedParamValue.Int(466697, MavParamType.INT32) })
  out.push(SimParam { id: "COMPASS_PRIO3_ID", value: TypedParamValue.Int(0, MavParamType.INT32) })
  out.push(SimParam { id: "COMPASS_AUTO_ROT", value: TypedParamValue.Int(2, MavParamType.INT8) })
  const reals = ["INS_ACCOFFS_X", "INS_ACCOFFS_Y", "INS_ACCOFFS_Z", "INS_ACCSCAL_X", "INS_ACCSCAL_Y", "INS_ACCSCAL_Z",
    "COMPASS_OFS_X", "COMPASS_OFS_Y", "COMPASS_OFS_Z", "BATT_CRT_VOLT", "BATT_VOLT_MULT", "BATT_AMP_PERVLT"]
  const realValues = [0.12, -0.03, 0.2, 1.001, 0.999, 1.0, 0.0, 0.0, 0.0, 10.0, 10.1, 17.0]
  for (let i = 0; i < reals.length; i++) {
    out.push(SimParam { id: reals[i], value: TypedParamValue.Real(realValues[i], MavParamType.REAL32) })
  }
  // Device ids are 24 bits: a 32-bit parameter (an I2C compass, an SPI accelerometer and gyro, an SPI barometer).
  const devices = ["COMPASS_DEV_ID", "INS_ACC_ID", "INS_GYR_ID", "BARO1_DEVID"]
  const deviceValues = [466441, 590082, 590338, 721666]
  for (let i = 0; i < devices.length; i++) {
    out.push(SimParam { id: devices[i], value: TypedParamValue.Int(deviceValues[i], MavParamType.INT32) })
  }
  for (const n of [1, 2, 3, 4]) {
    out.push(SimParam { id: `RC${n}_MIN`, value: TypedParamValue.Int(1008, MavParamType.INT16) })
    out.push(SimParam { id: `RC${n}_MAX`, value: TypedParamValue.Int(1992, MavParamType.INT16) })
    out.push(SimParam { id: `RC${n}_TRIM`, value: TypedParamValue.Int(1496, MavParamType.INT16) })
  }
  for (const n of [5, 6, 7, 8]) {
    out.push(SimParam { id: `RC${n}_OPTION`, value: TypedParamValue.Int(if (n == 7) 4 else 0, MavParamType.INT16) })
  }
  // The motors: the ESC protocol and the spin thresholds.
  out.push(SimParam { id: "MOT_PWM_TYPE", value: TypedParamValue.Int(0, MavParamType.INT8) })
  const spins = ["MOT_SPIN_ARM", "MOT_SPIN_MIN", "MOT_SPIN_MAX"]
  const spinValues = [0.1, 0.15, 0.95]
  for (let i = 0; i < spins.length; i++) {
    out.push(SimParam { id: spins[i], value: TypedParamValue.Real(spinValues[i], MavParamType.REAL32) })
  }
  // The Setup page "Initial tune": the parameters it suggests for, with values that are none of its suggestions, and without
  // ATC_RAT_YAW_FLTE (a vehicle that does not have it: the page says so).
  const initialIds = ["INS_ACCEL_FILTER", "INS_GYRO_FILTER", "ATC_ACC_P_MAX", "ATC_ACC_R_MAX", "ATC_ACC_Y_MAX", "ATC_RAT_RLL_FLTD",
    "ATC_RAT_RLL_FLTT", "ATC_RAT_PIT_FLTD", "ATC_RAT_PIT_FLTT", "ATC_RAT_YAW_FLTT", "MOT_THST_EXPO", "MOT_BAT_VOLT_MAX", "MOT_BAT_VOLT_MIN"]
  const initialValues = [20.0, 20.0, 900.0, 900.0, 180.0, 10.0, 10.0, 10.0, 10.0, 10.0, 0.5, 0.0, 0.0]
  for (let i = 0; i < initialIds.length; i++) {
    out.push(SimParam { id: initialIds[i], value: TypedParamValue.Real(initialValues[i], MavParamType.REAL32) })
  }
  // The Tune screen's rate loop and attitude (a quad's usual values).
  const tuneNames = ["ATC_RAT_RLL_P", "ATC_RAT_RLL_I", "ATC_RAT_RLL_D", "ATC_RAT_RLL_FF", "ATC_RAT_PIT_P", "ATC_RAT_PIT_I", "ATC_RAT_PIT_D",
    "ATC_RAT_PIT_FF", "ATC_RAT_YAW_P", "ATC_RAT_YAW_I", "ATC_RAT_YAW_D", "ATC_RAT_YAW_FF", "ATC_ANG_RLL_P", "ATC_ANG_PIT_P", "ATC_ANG_YAW_P",
    "ATC_INPUT_TC"]
  const tuneValues = [0.135, 0.135, 0.0036, 0.0, 0.135, 0.135, 0.0036, 0.0, 0.18, 0.018, 0.0, 0.0, 4.5, 4.5, 4.5, 0.15]
  for (let i = 0; i < tuneNames.length; i++) {
    out.push(SimParam { id: tuneNames[i], value: TypedParamValue.Real(tuneValues[i], MavParamType.REAL32) })
  }
  return out
}

/// The outputs of a quad at rest: SERVO_OUTPUT_RAW of the four motors, two times a second.
function showsTheOutputs(sim: SimulatedAutopilot): void {
  sim.servoStream = true
}

/// A radio whose sticks keep moving: roll and pitch sweep their whole range, the yaw stick sends a pulse that is not a reading every
/// few steps (the app must not take it for one), and the throttle and the switches stay where they are. 8 channels, 10 times a second.
function movesTheSticks(sim: SimulatedAutopilot): void {
  const sweep = [1100, 1500, 1900, 1500]
  let step = 0
  sim.rc = [1500, 1500, 1000, 1500, 1000, 1000, 1500, 1000]
  sim.rcStream = true
  setInterval(() => {
    step += 1
    sim.rc[0] = sweep[step % 4]
    sim.rc[1] = sweep[(step + 2) % 4]
    sim.rc[3] = if (step % 7 == 3) 9000 else 1500
  }, 100)
}

/// GLOBAL_POSITION_INT, RC_CHANNELS and SERVO_OUTPUT_RAW 50 times a second, on top of what the vehicle sends at its tick, until the
/// app has gone. A timer of 20 ms runs late and would give fewer: every 10 ms it sends the ones that are due by the clock.
function sendsAt50Hz(sim: SimulatedAutopilot, stream: EndWatchingStream): void {
  const started = Date.now() as int
  let sent = 0
  setInterval(() => {
    const due = ((Date.now() as int) - started) / 20
    while (sent < due && !stream.gone && !muted) {
      sim.sendPosition()
      sim.sendRc()
      sim.sendServo()
      sent += 1
    }
  }, 10)
}

/// A vehicle that never arms: its tick is set back before it counts 3 (a Setup write is refused while armed).
function stayDisarmed(sim: SimulatedAutopilot): void {
  setInterval(() => {
    sim.ticks = 0
  }, 100)
}

/// Three logs, oldest first (their times are a day apart), and a vehicle that never arms: its tick is set back before it counts 3.
function withLogs(sim: SimulatedAutopilot): void {
  sim.addLog(1, simulatedLog(9000, 1), 1783000000)
  sim.addLog(2, simulatedLog(2500, 2), 1783086400)
  sim.addLog(3, simulatedLog(16000, 3), 1783172800)
  setInterval(() => {
    sim.ticks = 0
  }, 100)
}

async function muteOnInput(): Promise<void> throws Error {
  for await (const _chunk of stdin) {
    muted = true
  }
}

/// Connects to the app's TCP port, again whenever the connection ends (#197).
async function connectTo(port: int): Promise<void> throws Error {
  let announced = false
  while (true) {
    let stream: EndWatchingStream? = null
    try {
      stream = serve(new TcpStream(await connect(port)))
    } catch (e: Error) {
      await delay(100)
      continue
    }
    if (!announced) {
      announced = true
      await stdout.writeText(`connected to ${port}\n`)
    }
    while (!stream!.gone) {
      await delay(100)
    }
  }
}

muteOnInput()
const connectPort = env.get("VEHICLE_CONNECT_TO")
if (connectPort != null) {
  await connectTo(parseInt(connectPort!))
} else if (env.get("VEHICLE_UDP") == "1") {
  const socket = await bind(0)
  await stdout.writeText(`listening ${socket.addr.port}\n`)
  const _udp = serve(new FollowingUdpStream(socket))
} else {
  const server = await listen()
  // Not println: it stays in a buffer when stdout is a pipe, and the test is waiting to read this.
  await stdout.writeText(`listening ${server.addr.port}\n`)
  for await (const conn of server) {
    const _tcp = serve(new TcpStream(conn))
  }
}
