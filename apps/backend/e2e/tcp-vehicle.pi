// The simulated vehicle behind a real TCP port, for the end-to-end suite (apps/frontend/e2e): the
// same MAVLink over the same socket path as ArduPilot SITL's port 5760, without SITL. It prints
// `listening <port>`, then serves one vehicle per connection until it's killed. It prints
// `param-set` for each PARAM_SET it receives. Any input on stdin makes the current vehicle go
// silent, so a write stays in flight. With the environment variable VEHICLE_LOGS=1 it holds three flight logs (valid DataFlash
// logs of different lengths, in `/logs`, which file transfer and the MAVLink log protocol serve) and stays DISARMED (the
// simulator arms itself after three ticks; a logs download is refused while armed), so that logs can be listed, downloaded and
// erased through the window. With VEHICLE_SETUP=1 it has the parameters the Setup pages read (a Copter with its frame, flight modes
// and failsafes set, and a compass that was never calibrated) and stays disarmed too, so that they can be written. Its
// calibrations (the accelerometer's six positions, the level, the compass of two compasses) are quick, and it says "AHRS: EKF3
// active" a second and a half after the link is made, as a vehicle that is up does (the app waits for it before it calibrates).
import { Conn, listen } from "std/net"
import { env, stdin, stdout } from "std/process"
import {
  ByteStream,
  CommandLong,
  MavCmd,
  MavParamType,
  ParamSet,
  Received,
  SimParam,
  SimulatedAutopilot,
  StatusText,
  TcpStream,
  TypedParamValue,
  defaultSimParams,
  simulatedLog,
} from "padcom/pico-mavlink"

let muted = false

/// A stream that says when its far end has gone.
class EndWatchingStream implements ByteStream {
  readonly inner: ByteStream
  readonly onEnd: () => void

  constructor(inner: ByteStream, onEnd: () => void) {
    this.inner = inner
    this.onEnd = onEnd
  }

  public async read(): Promise<Uint8Array?> throws Error {
    let chunk: Uint8Array? = null
    try {
      chunk = await inner.read()
    } catch (e: Error) {
      ended()
      throw e
    }
    if (chunk == null) {
      ended()
    }
    chunk
  }

  ended(): void {
    const notify = onEnd
    notify()
  }

  public async write(bytes: Uint8Array): Promise<void> throws Error {
    if (!muted) {
      await inner.write(bytes)
    }
  }

  public close(): void {
    inner.close()
  }
}

function serve(conn: Conn): void {
  let sim: SimulatedAutopilot? = null
  const stream = new EndWatchingStream(new TcpStream(conn), () => sim?.stop())
  muted = false
  const setup = env.get("VEHICLE_SETUP") == "1"
  sim = new SimulatedAutopilot(stream, if (setup) setupParams() else defaultSimParams())
  sim!.conn.on((r: Received) => {
    const m = r.message
    if (m instanceof ParamSet) {
      stdout.writeText("param-set\n")
    } else if (m instanceof CommandLong && m.command as int == MavCmd.DO_MOTOR_TEST) {
      // a test of a motor begins with a timeout above 0, and ends with one of 0
      stdout.writeText(if ((m._param4 as f64) > 0.0) "motor-start\n" else "motor-stop\n")
    }
  })
  sim!.start(250)
  if (env.get("VEHICLE_LOGS") == "1") {
    withLogs(sim!)
  }
  if (setup) {
    stayDisarmed(sim!)
    calibratesQuickly(sim!)
    movesTheSticks(sim!)
    showsTheOutputs(sim!)
  }
}

/// A vehicle whose calibrations take a moment (the real ones take seconds to minutes), and that says it is up.
function calibratesQuickly(sim: SimulatedAutopilot): void {
  sim.calibration.takesMs = 200
  sim.calibration.repeatMs = 300
  sim.compass.progressMs = 100
  sim.compass.stepPct = 25
  setTimeout(() => {
    const up = new StatusText()
    up.text = "AHRS: EKF3 active"
    sim.conn.send(up)
  }, 1500)
}

/// The parameters of a Copter that was set up as far as the Setup pages can see, except its compass (its offsets are zero), so that
/// the home has a next step; and the usual ones the simulator has.
function setupParams(): SimParam[] {
  const out = defaultSimParams()
  const whole = ["FRAME_CLASS", "FRAME_TYPE", "FLTMODE1", "FLTMODE2", "FLTMODE3", "FLTMODE4", "FLTMODE5", "FLTMODE6", "FLTMODE_CH",
    "FS_GCS_ENABLE", "FS_EKF_ACTION", "BATT_MONITOR", "BATT_FS_LOW_ACT", "BATT_FS_CRT_ACT", "AHRS_ORIENTATION",
    "SERIAL0_PROTOCOL", "SERIAL0_BAUD", "SERIAL1_PROTOCOL", "SERIAL1_BAUD", "SERIAL2_PROTOCOL", "SERIAL2_BAUD"]
  const wholeValues = [1, 1, 0, 5, 6, 3, 9, 16, 5, 0, 1, 4, 2, 1, 0, 2, 115, 2, 57, 5, 115]
  for (let i = 0; i < whole.length; i++) {
    out.push(SimParam { id: whole[i], value: TypedParamValue.Int(wholeValues[i], MavParamType.INT8) })
  }
  // The compasses' order (device ids: an I2C compass and an SPI one, and an empty place) and whether a calibration may turn one.
  out.push(SimParam { id: "COMPASS_PRIO1_ID", value: TypedParamValue.Int(466441, MavParamType.INT32) })
  out.push(SimParam { id: "COMPASS_PRIO2_ID", value: TypedParamValue.Int(466697, MavParamType.INT32) })
  out.push(SimParam { id: "COMPASS_PRIO3_ID", value: TypedParamValue.Int(0, MavParamType.INT32) })
  out.push(SimParam { id: "COMPASS_AUTO_ROT", value: TypedParamValue.Int(2, MavParamType.INT8) })
  const reals = ["INS_ACCOFFS_X", "INS_ACCOFFS_Y", "INS_ACCOFFS_Z", "INS_ACCSCAL_X", "INS_ACCSCAL_Y", "INS_ACCSCAL_Z",
    "COMPASS_OFS_X", "COMPASS_OFS_Y", "COMPASS_OFS_Z", "BATT_CRT_VOLT", "BATT_VOLT_MULT", "BATT_AMP_PERVLT"]
  const realValues = [0.12, -0.03, 0.2, 1.001, 0.999, 1.0, 0.0, 0.0, 0.0, 10.0, 10.1, 17.0]
  for (let i = 0; i < reals.length; i++) {
    out.push(SimParam { id: reals[i], value: TypedParamValue.Real(realValues[i], MavParamType.REAL32) })
  }
  // Device ids are 24 bits: a 32-bit parameter (an I2C compass, an SPI accelerometer and gyro, an SPI barometer).
  const devices = ["COMPASS_DEV_ID", "INS_ACC_ID", "INS_GYR_ID", "BARO1_DEVID"]
  const deviceValues = [466441, 590082, 590338, 721666]
  for (let i = 0; i < devices.length; i++) {
    out.push(SimParam { id: devices[i], value: TypedParamValue.Int(deviceValues[i], MavParamType.INT32) })
  }
  for (const n of [1, 2, 3, 4]) {
    out.push(SimParam { id: `RC${n}_MIN`, value: TypedParamValue.Int(1008, MavParamType.INT16) })
    out.push(SimParam { id: `RC${n}_MAX`, value: TypedParamValue.Int(1992, MavParamType.INT16) })
    out.push(SimParam { id: `RC${n}_TRIM`, value: TypedParamValue.Int(1496, MavParamType.INT16) })
  }
  for (const n of [5, 6, 7, 8]) {
    out.push(SimParam { id: `RC${n}_OPTION`, value: TypedParamValue.Int(if (n == 7) 4 else 0, MavParamType.INT16) })
  }
  // The motors: the ESC protocol and the spin thresholds.
  out.push(SimParam { id: "MOT_PWM_TYPE", value: TypedParamValue.Int(0, MavParamType.INT8) })
  const spins = ["MOT_SPIN_ARM", "MOT_SPIN_MIN", "MOT_SPIN_MAX"]
  const spinValues = [0.1, 0.15, 0.95]
  for (let i = 0; i < spins.length; i++) {
    out.push(SimParam { id: spins[i], value: TypedParamValue.Real(spinValues[i], MavParamType.REAL32) })
  }
  // The Tune screen's rate loop and attitude (a quad's usual values).
  const tuneNames = ["ATC_RAT_RLL_P", "ATC_RAT_RLL_I", "ATC_RAT_RLL_D", "ATC_RAT_RLL_FF", "ATC_RAT_PIT_P", "ATC_RAT_PIT_I", "ATC_RAT_PIT_D",
    "ATC_RAT_PIT_FF", "ATC_RAT_YAW_P", "ATC_RAT_YAW_I", "ATC_RAT_YAW_D", "ATC_RAT_YAW_FF", "ATC_ANG_RLL_P", "ATC_ANG_PIT_P", "ATC_ANG_YAW_P",
    "ATC_INPUT_TC"]
  const tuneValues = [0.135, 0.135, 0.0036, 0.0, 0.135, 0.135, 0.0036, 0.0, 0.18, 0.018, 0.0, 0.0, 4.5, 4.5, 4.5, 0.15]
  for (let i = 0; i < tuneNames.length; i++) {
    out.push(SimParam { id: tuneNames[i], value: TypedParamValue.Real(tuneValues[i], MavParamType.REAL32) })
  }
  out
}

/// The outputs of a quad at rest: SERVO_OUTPUT_RAW of the four motors, two times a second.
function showsTheOutputs(sim: SimulatedAutopilot): void {
  sim.servoStream = true
}

/// A radio whose sticks keep moving: roll and pitch sweep their whole range, the yaw stick sends a pulse that is not a reading every
/// few steps (the app must not take it for one), and the throttle and the switches stay where they are. 8 channels, 10 times a second.
function movesTheSticks(sim: SimulatedAutopilot): void {
  const sweep = [1100, 1500, 1900, 1500]
  let step = 0
  sim.rc = [1500, 1500, 1000, 1500, 1000, 1000, 1500, 1000]
  sim.rcStream = true
  setInterval(() => {
    step += 1
    sim.rc[0] = sweep[step % 4]
    sim.rc[1] = sweep[(step + 2) % 4]
    sim.rc[3] = if (step % 7 == 3) 9000 else 1500
  }, 100)
}

/// A vehicle that never arms: its tick is set back before it counts 3 (a Setup write is refused while armed).
function stayDisarmed(sim: SimulatedAutopilot): void {
  setInterval(() => {
    sim.ticks = 0
  }, 100)
}

/// Three logs, oldest first (their times are a day apart), and a vehicle that never arms: its tick is set back before it counts 3.
function withLogs(sim: SimulatedAutopilot): void {
  sim.addLog(1, simulatedLog(9000, 1), 1783000000)
  sim.addLog(2, simulatedLog(2500, 2), 1783086400)
  sim.addLog(3, simulatedLog(16000, 3), 1783172800)
  setInterval(() => {
    sim.ticks = 0
  }, 100)
}

async function muteOnInput(): Promise<void> throws Error {
  for await (const _chunk of stdin) {
    muted = true
  }
}

muteOnInput()
const server = await listen()
// Not println: it stays in a buffer when stdout is a pipe, and the test is waiting to read this.
await stdout.writeText(`listening ${server.addr.port}\n`)
for await (const conn of server) {
  serve(conn)
}
