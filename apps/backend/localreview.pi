// The automatic review of a log on this computer (`logs.local.review`): a handful of findings from the messages every ArduPilot log
// has, each with the number it rests on and the limit it was held against, so that the page can say both. Only a VERIFIED log is
// reviewed (its CRC is the one the vehicle gave when it was downloaded): nothing is concluded from bytes that are not known to be
// the vehicle's. A thing the log has no data for is `no-data`, never a pass.
//
// What is looked at, from the fields of Copter-4.7.2's own log:
//   vibration.x/y/z   VIBE VibeX, VibeY, VibeZ (m/s/s): the largest, over all IMUs.
//   vibration.clipping VIBE Clip (a running count for each IMU): the most clips any IMU counted during the log.
//   gps.satellites    GPS NSats: the fewest, while the GPS had a 3D fix (Status 3 or more).
//   gps.hdop          GPS HDop: the largest, while it had a 3D fix.
//   gps.fix           GPS Status: how many of the samples had no 3D fix.
//   ekf.variance      XKF4 SV, SP, SH, SM (the variance ratios of the EKF; 1 is where the EKF calls itself unhealthy): the largest,
//                     not counting the first 10 s of the log (the filter converges then).
//   errors.logged     ERR: how many errors were logged that were not a clearing (ECode 0).
//   battery.voltage   BAT Volt: the lowest, and battery.current BAT Curr: the highest. These are `info`: whether they are a problem
//                     depends on the battery, which the log does not say here (the pack voltage: the cells are not known).
// The whole log is looked at. With ArduPilot's defaults a log begins at the arm, so that is the flight; a log that holds time on
// the ground (LOG_DISARMED) has it in these numbers too. The limits are guidelines, this app's, written in the findings, not facts.
import { Cbor, Communicator, CommunicatorError, RequestContext } from "pico-desktop/communicator"
import { DfMessage, DfTables } from "padcom/pico-mavlink"
import {
  LogsReview,
  ReviewFinding,
  ReviewFindingLevel,
  decodeLogsLocalRead,
  encodeLogsReview,
} from "./generated/app"
import { factorOf } from "./localseries"
import { LogReader } from "./logreader"
import { Taker, claimRead, knownSummary, locate, releaseRead, streamLog } from "./locallogs"

/// Vibration (m/s/s): above `VIBE_WARN` it may hurt, above `VIBE_BAD` it does.
const VIBE_WARN: f64 = 30.0
const VIBE_BAD: f64 = 60.0
/// Satellites: fewer than `SATS_BAD` is bad, fewer than `SATS_OK` is a warning.
const SATS_OK: f64 = 12.0
const SATS_BAD: f64 = 6.0
/// HDOP: above `HDOP_OK` is a warning, above `HDOP_BAD` is bad.
const HDOP_OK: f64 = 1.5
const HDOP_BAD: f64 = 2.5
/// EKF variance ratio: from `EKF_WARN` a warning (ArduCopter's default failsafe threshold), from `EKF_BAD` it is unhealthy.
const EKF_WARN: f64 = 0.8
const EKF_BAD: f64 = 1.0
/// The EKF's variance is high for a moment after the log begins (the filter is converging): the first 10 s are not looked at.
const EKF_SETTLE_US: int = 10000000
/// The most IMUs told apart for the clip counts.
const MAX_IMUS: int = 8

export function register(c: Communicator): void {
  c.handle("logs.local.review", reviewLocal)
}

/// The largest or the smallest of some values, and when it was.
class Extreme {
  public readonly wantMax: bool
  public value: f64 = 0.0
  public at: int = -1
  public seen: int = 0

  constructor(wantMax: bool) {
    this.wantMax = wantMax
  }

  /// The value of field `name` of the message, if it has one.
  public offerField(m: DfMessage, name: string): void {
    const v = m.num(name)
    if (v != null) {
      offer(v!, m.timeUs())
    }
  }

  public offer(v: f64, t: int): void {
    if (v != v || v > 1.0e300 || v < -1.0e300) {
      return
    }
    if (seen == 0 || (if (wantMax) v > value else v < value)) {
      value = v
      at = t
    }
    seen += 1
  }
}

/// A running count (clips of one IMU): where it began, and its last value.
class Running {
  public first: f64 = 0.0
  public last: f64 = 0.0
  public seen: int = 0

  public offer(v: f64): void {
    if (v != v || v > 1.0e300 || v < 0.0) {
      return
    }
    if (seen == 0) {
      first = v
    }
    last = v
    seen += 1
  }
}

/// What is gathered of a log for the review.
class Gathered implements Taker {
  public readonly vibeX: Extreme = new Extreme(true)
  public readonly vibeY: Extreme = new Extreme(true)
  public readonly vibeZ: Extreme = new Extreme(true)
  public readonly clips: Running[] = []
  public readonly sats: Extreme = new Extreme(false)
  public readonly hdop: Extreme = new Extreme(true)
  public gpsSamples: int = 0
  public noFix: int = 0
  public readonly variance: Extreme = new Extreme(true)
  public errors: int = 0
  /// Whether the log defines the format of ERR (an FMT for it): an ArduPilot log does, at its start, for every message it can have.
  public definesErr: bool = false
  public readonly volts: Extreme = new Extreme(false)
  /// The lowest cell voltage of a battery that reports its cells (BCL: V1..V12; 0 is a cell that is not there).
  public readonly cells: Extreme = new Extreme(false)
  /// The units and multipliers the log names (a DataFlash BCL has its cells in millivolts with the multiplier 0.001).
  readonly reader: LogReader
  /// The VIBE samples of IMU 0 (the ones the review rests on): how many, and the first and last time (microseconds).
  public vibeSamples: int = 0
  public vibeFirst: int = -1
  public vibeLast: int = -1
  public readonly amps: Extreme = new Extreme(true)
  /// The time of the first message that has one (microseconds), -1 before.
  public start: int = -1

  constructor(reader: LogReader) {
    this.reader = reader
    for (let i = 0; i < MAX_IMUS; i++) {
      this.clips.push(new Running())
    }
  }

  public take(m: DfMessage): void {
    const name = m.format.name
    if (start < 0) {
      start = m.timeUs()
    }
    if (name == "VIBE") {
      takeVibe(m)
    } else if (name == "GPS") {
      takeGps(m)
    } else if (name == "XKF4") {
      takeEkf(m)
    } else if (name == "FMT") {
      definesErr = definesErr || (m.text("Name") ?? "") == "ERR"
    } else if (name == "ERR") {
      if ((m.num("ECode") ?? 0.0) != 0.0) {
        errors += 1
      }
    } else if (name == "BAT") {
      volts.offerField(m, "Volt")
      amps.offerField(m, "Curr")
    } else if (name == "BCL") {
      takeCells(m)
    }
  }

  /// The cells of one BCL message: each that is there (above 0) may be the lowest.
  takeCells(m: DfMessage): void {
    const tables: DfTables = reader.tables()
    for (let i = 1; i <= 12; i++) {
      const at = m.format.indexOf(`V${i}`)
      if (at < 0) {
        continue
      }
      // In volts: the log's multiplier takes a count of millivolts there, as the series and the export do.
      const v = m.nums[at] * factorOf(m.format.fields[at], tables)
      if (v > 0.0) {
        cells.offer(v, m.timeUs())
      }
    }
  }

  takeVibe(m: DfMessage): void {
    vibeX.offerField(m, "VibeX")
    vibeY.offerField(m, "VibeY")
    vibeZ.offerField(m, "VibeZ")
    const imu = m.num("IMU") ?? 0.0
    const t = m.timeUs()
    const x = m.num("VibeX")
    if (imu == 0.0 && x != null && x! == x! && t >= 0) {
      vibeSamples += 1
      if (vibeFirst < 0) {
        vibeFirst = t
      }
      vibeLast = t
    }
    const clip = m.num("Clip")
    if (clip != null && imu >= 0.0 && imu < (MAX_IMUS as f64)) {
      clips[imu as int].offer(clip!)
    }
  }

  /// A GPS sample counts for the satellites and the HDOP only with a 3D fix; without one it is counted as having none.
  takeGps(m: DfMessage): void {
    const status = m.num("Status")
    if (status == null) {
      return
    }
    gpsSamples += 1
    if (status! < 3.0) {
      noFix += 1
      return
    }
    sats.offerField(m, "NSats")
    hdop.offerField(m, "HDop")
  }

  /// The EKF's variance ratios, but not those of the first seconds of the log, while the filter settles.
  takeEkf(m: DfMessage): void {
    const t = m.timeUs()
    if (t < 0 || start < 0 || t - start < EKF_SETTLE_US) {
      return
    }
    variance.offerField(m, "SV")
    variance.offerField(m, "SP")
    variance.offerField(m, "SH")
    variance.offerField(m, "SM")
  }
}

/// Puts the rate of the VIBE samples (per second, from the first to the last) on the vibration findings that rest on them.
function sayRate(findings: ReviewFinding[], g: Gathered): void {
  if (g.vibeSamples < 2 || g.vibeLast <= g.vibeFirst) {
    return
  }
  const rate = ((g.vibeSamples - 1) as f64) / ((g.vibeLast - g.vibeFirst) as f64 / 1000000.0)
  for (let i = 0; i < findings.length; i++) {
    const f = findings[i]
    if (f.id.startsWith("vibration.") && f.level != ReviewFindingLevel.NoData && f.id != "vibration.clipping") {
      findings[i].rateHz = rate
    }
  }
}

/// A finding with no data behind it.
function noData(id: string): ReviewFinding {
  ReviewFinding { id: id, level: ReviewFindingLevel.NoData }
}

/// A finding: what was found, the limit it was held to, when it was found, and how it fared.
function finding(id: string, level: ReviewFindingLevel, value: f64, limit: f64, at: int): ReviewFinding {
  const f = ReviewFinding { id: id, level: level, value: value, limit: limit }
  if (at >= 0) {
    f.atUs = at as u64
  }
  f
}

/// Says how many samples a finding rests on.
function counted(f: ReviewFinding, samples: int): ReviewFinding {
  f.samples = (if (samples > 4294967295) 4294967295 else samples) as u32
  f
}

/// How a value fares against a warning limit and a bad one, for things that are worse the larger they are.
export function levelAbove(v: f64, warn: f64, bad: f64): ReviewFindingLevel {
  if (v > bad) ReviewFindingLevel.Bad else if (v > warn) ReviewFindingLevel.Warn else ReviewFindingLevel.Ok
}

/// The same, for things that are worse the smaller they are.
export function levelBelow(v: f64, ok: f64, bad: f64): ReviewFindingLevel {
  if (v < bad) ReviewFindingLevel.Bad else if (v < ok) ReviewFindingLevel.Warn else ReviewFindingLevel.Ok
}

/// The limit a finding was held to: the one that was crossed, else the first.
function limitOf(level: ReviewFindingLevel, warn: f64, bad: f64): f64 {
  if (level == ReviewFindingLevel.Bad) bad else warn
}

function vibration(id: string, e: Extreme): ReviewFinding {
  if (e.seen == 0) {
    return noData(id)
  }
  const level = levelAbove(e.value, VIBE_WARN, VIBE_BAD)
  counted(finding(id, level, e.value, limitOf(level, VIBE_WARN, VIBE_BAD), e.at), e.seen)
}

function clipping(g: Gathered): ReviewFinding {
  let most = 0.0
  let any = false
  for (const r of g.clips) {
    if (r.seen > 0) {
      any = true
      most = if (r.last - r.first > most) r.last - r.first else most
    }
  }
  if (!any) {
    return noData("vibration.clipping")
  }
  finding("vibration.clipping", if (most > 0.0) ReviewFindingLevel.Warn else ReviewFindingLevel.Ok, most, 0.0, -1)
}

function satellites(g: Gathered): ReviewFinding {
  if (g.sats.seen == 0) {
    return noData("gps.satellites")
  }
  const level = levelBelow(g.sats.value, SATS_OK, SATS_BAD)
  counted(finding("gps.satellites", level, g.sats.value, if (level == ReviewFindingLevel.Bad) SATS_BAD else SATS_OK, g.sats.at), g.sats.seen)
}

function hdop(g: Gathered): ReviewFinding {
  if (g.hdop.seen == 0) {
    return noData("gps.hdop")
  }
  const level = levelAbove(g.hdop.value, HDOP_OK, HDOP_BAD)
  counted(finding("gps.hdop", level, g.hdop.value, limitOf(level, HDOP_OK, HDOP_BAD), g.hdop.at), g.hdop.seen)
}

/// How many GPS samples had no 3D fix; the limit is none.
function fix(g: Gathered): ReviewFinding {
  if (g.gpsSamples == 0) {
    return noData("gps.fix")
  }
  counted(finding("gps.fix", if (g.noFix > 0) ReviewFindingLevel.Warn else ReviewFindingLevel.Ok, g.noFix as f64, 0.0, -1), g.gpsSamples)
}

function ekf(g: Gathered): ReviewFinding {
  if (g.variance.seen == 0) {
    return noData("ekf.variance")
  }
  const level = levelAbove(g.variance.value, EKF_WARN, EKF_BAD)
  counted(finding("ekf.variance", level, g.variance.value, limitOf(level, EKF_WARN, EKF_BAD), g.variance.at), g.variance.seen)
}

function errors(g: Gathered): ReviewFinding {
  if (!g.definesErr) {
    // A log that does not even define ERR (cut, foreign, not from ArduPilot) cannot be said to have no errors.
    return noData("errors.logged")
  }
  // An ArduPilot log defines every message at its start and logs an ERR only when something happened: with the format and no
  // ERR (or only the ones that say an error is over, code 0) it has no errors, which is a finding, not a gap.
  finding("errors.logged", if (g.errors > 0) ReviewFindingLevel.Warn else ReviewFindingLevel.Ok, g.errors as f64, 0.0, -1)
}

function battery(id: string, e: Extreme): ReviewFinding {
  if (e.seen == 0) {
    return noData(id)
  }
  counted(finding(id, ReviewFindingLevel.Info, e.value, 0.0, e.at), e.seen)
}

async function reviewLocal(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const asked = decodeLogsLocalRead(payload ?? Cbor.Null, "$")
  const own = claimRead()
  try {
    return await review(asked.key, own)
  } finally {
    releaseRead()
  }
}

async function review(key: string, own: AbortController): Promise<Cbor?> throws Error {
  const file = await locate(key)
  const known = knownSummary(key, file.facts)
  if (known == null) {
    throw new CommunicatorError("NOT_READ", "the log has not been read (lately), or it changed since: read it again")
  }
  if (!known!.verified) {
    throw new CommunicatorError("NOT_VERIFIED", "the log is not verified (its CRC is not the one the vehicle gave): no review")
  }
  const reader = file.newReader()
  const g = new Gathered(reader)
  const done = await streamLog(key, file, own, g, null, reader)
  if (!done.unchanged) {
    throw new CommunicatorError("CHANGED", "the log changed while it was read: read it again")
  }
  const findings: ReviewFinding[] = [
    vibration("vibration.x", g.vibeX),
    vibration("vibration.y", g.vibeY),
    vibration("vibration.z", g.vibeZ),
    clipping(g),
    satellites(g),
    hdop(g),
    fix(g),
    ekf(g),
    errors(g),
    battery("battery.voltage", g.volts),
    battery("battery.current", g.amps),
  ]
  // A battery that reports its cells has the lowest cell voltage as a finding of its own (no row for one that does not).
  if (g.cells.seen > 0) {
    findings.push(battery("battery.cell", g.cells))
  }
  // A recording's samples are the ground station's: the rate they came at is said, a spike between two is not seen.
  if (done.reader.isTlog()) {
    sayRate(findings, g)
  }
  encodeLogsReview(LogsReview { findings: findings })
}
