// The calibration service (`calibration.*`), over an in-memory link against the simulated vehicle of pico-mavlink: its accelerometer and
// compass calibrations (SimulatedAutopilot.calibration and .compass). Each exit path of a calibration has a test of its own, and so has each
// refusal.
import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { Cbor, Envelope } from "pico-desktop/communicator"
import { CommandLong, MavCmd, Received, SimulatedAutopilot, StatusText } from "padcom/pico-mavlink"
import { simulatorForTests } from "./app"
import { waits } from "./calibration"
import {
  CalibrationKind,
  CalibrationResultOutcome,
  CalibrationState,
  CalibrationStateState,
  ConnectRequest,
  ConnectRequestTransport,
  LogsDownload,
  ParamWrite,
  ParamWriteKind,
  decodeCalibrationResult,
  decodeCalibrationState,
  encodeCalibrationAccept,
  encodeCalibrationConfirm,
  encodeCalibrationStart,
  encodeConnectRequest,
  encodeLogsDownload,
  encodeParamWrite,
  CalibrationAccept,
  CalibrationConfirm,
  CalibrationStart,
} from "./generated/app"
import { link } from "./session"
import { Frontend, start } from "./testing"

/// A connected simulator, quick to calibrate and disarmed, that has said it is up; and the interval that keeps it disarmed.
class Rig {
  public readonly f: Frontend
  public readonly sim: SimulatedAutopilot
  public readonly hold: int

  constructor(f: Frontend, sim: SimulatedAutopilot, hold: int) {
    this.f = f
    this.sim = sim
    this.hold = hold
  }

  /// Ends the connection (its timers would keep the test process alive).
  public async close(): Promise<void> throws Error {
    clearInterval(hold)
    await f.call("vehicle.disconnect")
  }
}

/// Waits for the next heartbeat of the vehicle: the armed state is only known after one.
async function afterBeat(): Promise<void> throws Error {
  const before = link.heartbeatAt
  let waited = 0
  while (link.heartbeatAt == before && waited < 4000) {
    await delay(20)
    waited += 20
  }
}

/// The vehicle says it is up, as ArduPilot does (the text is what `waitUntilUp` looks for).
function saysUp(sim: SimulatedAutopilot): void {
  const t = new StatusText()
  t.text = "AHRS: EKF3 active"
  sim.conn.send(t)
}

async function connected(): Promise<Rig> throws Error {
  waits.upMs = 800
  waits.acceptMs = 3000
  waits.accelSilenceMs = 3000
  waits.compassSilenceMs = 3000
  waits.ackMs = 1000
  const f = await start()
  await f.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const sim = simulatorForTests()!
  sim.calibration.takesMs = 0
  sim.calibration.repeatMs = 20
  sim.compass.progressMs = 10
  sim.compass.stepPct = 25
  // The simulator arms itself after three ticks: a calibration is for a vehicle on the ground.
  const hold = setInterval(() => {
    sim.ticks = if (sim.ticks > 1) 1 else sim.ticks
  }, 50)
  await afterBeat()
  saysUp(sim)
  new Rig(f, sim, hold)
}

async function startOf(f: Frontend, kind: CalibrationKind): Promise<Envelope> throws Error {
  await f.call("calibration.start", encodeCalibrationStart(CalibrationStart { kind: kind }))
}

async function state(f: Frontend): Promise<CalibrationState> throws Error {
  decodeCalibrationState((await f.call("calibration.status")).p ?? Cbor.Null, "$")
}

/// Waits until the state says what `done` wants (the calibration runs in the background), or fails after a few seconds.
async function until(f: Frontend, what: string, done: (s: CalibrationState) => bool): Promise<CalibrationState> throws Error {
  let s = await state(f)
  let waited = 0
  while (!done(s) && waited < 6000) {
    await delay(25)
    waited += 25
    s = await state(f)
  }
  expect(done(s)).toBe(true)
  if (!done(s)) {
    throw new Error(`the state never was: ${what}`)
  }
  s
}

function isFinished(s: CalibrationState): bool {
  s.state == CalibrationStateState.Finished
}

function outcomeOf(s: CalibrationState): string {
  const r = s.result
  if (r == null) {
    return "none"
  }
  match (r!.outcome) {
    Success => "success",
    Failed => "failed",
    Cancelled => "cancelled",
    Refused => "refused",
  }
}

function codeOf(s: CalibrationState): string {
  const r = s.result
  if (r == null || r!.code == null) "" else r!.code!
}

/// The error code of a reply, or "ok".
function errorOf(e: Envelope): string {
  if (e.err != null) e.err!.code else "ok"
}

/// The position the vehicle asks for, once it does (the page's confirmation is only taken for that).
async function asksFor(f: Frontend, position: int): Promise<void> throws Error {
  await until(f, `a request for position ${position}`, (s: CalibrationState) => s.accel != null && s.accel!.position as int == position)
}

async function confirms(f: Frontend, position: int): Promise<string> throws Error {
  errorOf(await f.call("calibration.confirm", encodeCalibrationConfirm(CalibrationConfirm { position: position as u8 })))
}

/// The six positions, one after the other, each said to be placed when the vehicle asks for it.
async function walkTheSixPositions(f: Frontend): Promise<void> throws Error {
  for (const p of [1, 2, 3, 4, 5, 6]) {
    await asksFor(f, p)
    expect(await confirms(f, p)).toBe("ok")
  }
}

async function fullAccelerometerEndsWithTheVehiclesOwnSuccess(): Promise<void> throws Error {
  const r = await connected()
  const first = await startOf(r.f, CalibrationKind.Accel)
  expect(errorOf(first)).toBe("ok")
  await walkTheSixPositions(r.f)
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("success")
  expect(r.sim.calibration.confirmed.join(",")).toBe("1,2,3,4,5,6")
  expect(done.accel!.placed.length).toBe(6)
  expect(done.accel!.position as int).toBe(0)
  expect(done.texts.indexOf("Calibration successful") >= 0).toBe(true)
  // the first prompt and the vehicle's own words are in the state
  expect(done.texts.indexOf("Place vehicle level and press any key.") >= 0).toBe(true)
}

async function aFailureIsShownAsAFailure(): Promise<void> throws Error {
  const r = await connected()
  r.sim.calibration.failAt = 3
  await startOf(r.f, CalibrationKind.Accel)
  for (const p of [1, 2, 3]) {
    await asksFor(r.f, p)
    expect(await confirms(r.f, p)).toBe("ok")
  }
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("failed")
  expect(codeOf(done)).toBe("FAILED")
  expect(done.result!.detail!).toBe("Calibration FAILED")
  expect(done.texts.indexOf("Calibration FAILED") >= 0).toBe(true)
}

async function theLevelIsOneCommand(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Level)
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("success")
  expect(r.sim.calibration.levelRuns).toBe(1)
  expect(r.sim.calibration.accelRuns).toBe(0)
}

async function aPositionThatIsNotAskedForIsRefused(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Accel)
  await asksFor(r.f, 1)
  expect(await confirms(r.f, 4)).toBe("NOT_ASKED")
  expect(await confirms(r.f, 1)).toBe("ok")
  await until(r.f, "the next position", (s: CalibrationState) => s.accel != null && s.accel!.position as int == 2)
  // nothing runs after the end
  await r.f.call("calibration.cancel")
  expect(await confirms(r.f, 2)).toBe("NOT_RUNNING")
  await r.close()
}

async function refusesWhenNoVehicleIsConnected(): Promise<void> throws Error {
  const f = await start()
  link.close()
  expect(errorOf(await startOf(f, CalibrationKind.Accel))).toBe("NOT_CONNECTED")
}

async function refusesWhenTheVehicleIsArmed(): Promise<void> throws Error {
  const r = await connected()
  clearInterval(r.hold)
  r.sim.ticks = 5
  await delay(1500)   // a heartbeat that says armed
  const refused = errorOf(await startOf(r.f, CalibrationKind.Accel))
  const level = errorOf(await startOf(r.f, CalibrationKind.Compass))
  expect(refused).toBe("ARMED")
  expect(level).toBe("ARMED")
  expect(r.sim.calibration.preflightCommands).toBe(0)
  expect(r.sim.compass.starts).toBe(0)
  await r.close()
}

async function refusesWhenTheArmedStateIsNotKnown(): Promise<void> throws Error {
  const r = await connected()
  link.heartbeatAt = 0
  expect(errorOf(await startOf(r.f, CalibrationKind.Level))).toBe("STATE_UNKNOWN")
  expect(r.sim.calibration.preflightCommands).toBe(0)
  await r.close()
}

async function onlyOneCalibrationRunsAtATime(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Accel)
  await asksFor(r.f, 1)
  expect(errorOf(await startOf(r.f, CalibrationKind.Compass))).toBe("BUSY")
  expect(errorOf(await startOf(r.f, CalibrationKind.Level))).toBe("BUSY")
  expect(r.sim.compass.starts).toBe(0)
  await r.f.call("calibration.cancel")
  await r.close()
}

/// What a call is answered while a compass waits for the user's decision: the code of its error.
async function whileCompassWaits(r: Rig, name: string, payload: Cbor?): Promise<string> throws Error {
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "review", (s: CalibrationState) => s.state == CalibrationStateState.Review)
  const code = errorOf(await r.f.call(name, payload))
  await r.f.call("calibration.cancel")
  await r.close()
  code
}

async function aParameterDownloadIsRefusedWhileItRuns(): Promise<void> throws Error {
  const r = await connected()
  expect(await whileCompassWaits(r, "params.list", null)).toBe("BUSY")
}

async function aParameterWriteIsRefusedWhileItRuns(): Promise<void> throws Error {
  const r = await connected()
  const write = ParamWrite { id: "COMPASS_OFS_X", kind: ParamWriteKind.Real, type: "REAL32", value: 1.5 }
  expect(await whileCompassWaits(r, "params.write", encodeParamWrite(write))).toBe("BUSY")
  // nothing reached the vehicle
  expect(r.sim.params.filter((p) => p.id == "COMPASS_OFS_X").length).toBe(0)
}

async function aGuardedParameterWriteIsRefusedWhileItRuns(): Promise<void> throws Error {
  const r = await connected()
  const write = ParamWrite { id: "COMPASS_PRIO1_ID", kind: ParamWriteKind.Int, type: "INT32", value: 466441.0, guarded: true }
  expect(await whileCompassWaits(r, "params.write", encodeParamWrite(write))).toBe("BUSY")
}

async function theLogsAreRefusedWhileItRuns(): Promise<void> throws Error {
  const r = await connected()
  expect(await whileCompassWaits(r, "logs.vehicle.list", null)).toBe("BUSY")
  const again = await connected()
  expect(await whileCompassWaits(again, "logs.download", encodeLogsDownload(LogsDownload { ids: [1 as u32] }))).toBe("BUSY")
  const last = await connected()
  expect(await whileCompassWaits(last, "logs.erase", null)).toBe("BUSY")
}

async function aRebootIsRefusedWhileItRuns(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Accel)
  await asksFor(r.f, 1)
  expect(errorOf(await r.f.call("vehicle.reboot"))).toBe("BUSY")
  await r.f.call("calibration.cancel")
  await r.close()
}

async function sendsNothingToAVehicleThatIsNotUp(): Promise<void> throws Error {
  waits.upMs = 300
  const f = await start()
  await f.call("vehicle.connect", encodeConnectRequest(ConnectRequest { transport: ConnectRequestTransport.Simulator }))
  const sim = simulatorForTests()!
  const hold = setInterval(() => {
    sim.ticks = if (sim.ticks > 1) 1 else sim.ticks
  }, 50)
  await afterBeat()
  expect(errorOf(await startOf(f, CalibrationKind.Accel))).toBe("ok")
  const done = await until(f, "finished", isFinished)
  clearInterval(hold)
  await f.call("vehicle.disconnect")
  expect(outcomeOf(done)).toBe("failed")
  expect(codeOf(done)).toBe("NOT_UP")
  // never a command to the vehicle that has just booted
  expect(sim.calibration.preflightCommands).toBe(0)
}

async function cancelEndsTheAccelerometerCalibration(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Accel)
  await asksFor(r.f, 1)
  const after = decodeCalibrationState((await r.f.call("calibration.cancel")).p ?? Cbor.Null, "$")
  expect(isFinished(after)).toBe(true)
  expect(outcomeOf(after)).toBe("cancelled")
  expect(codeOf(after)).toBe("CANCELLED")
  expect(r.sim.calibration.confirmed.length).toBe(0)
  // another one may begin at once
  expect(errorOf(await startOf(r.f, CalibrationKind.Level))).toBe("ok")
  await until(r.f, "finished", isFinished)
  await r.close()
}

async function theLinkBeingLostEndsIt(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Accel)
  await asksFor(r.f, 1)
  link.abortOperations()
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("cancelled")
  expect(codeOf(done)).toBe("LINK_LOST")
}

async function theSessionEndingEndsIt(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Accel)
  await asksFor(r.f, 1)
  link.close()
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("cancelled")
  expect(codeOf(done)).toBe("LINK_LOST")
}

async function theVehicleArmingEndsIt(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Accel)
  await asksFor(r.f, 1)
  clearInterval(r.hold)
  r.sim.ticks = 5   // the next heartbeat says armed
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("cancelled")
  expect(codeOf(done)).toBe("ARMED")
}

async function compassGoesToTheReportsAndWaitsForTheUser(): Promise<void> throws Error {
  const r = await connected()
  expect(errorOf(await startOf(r.f, CalibrationKind.Compass))).toBe("ok")
  const review = await until(r.f, "review", (s: CalibrationState) => s.state == CalibrationStateState.Review)
  expect(review.compasses!.length).toBe(2)
  const first = review.compasses![0]
  expect(first.status).toBe("SUCCESS")
  expect(first.report!.ok).toBe(true)
  expect(first.report!.fitness).toBe(12.5)
  expect(first.report!.accepted).toBe(false)
  expect(first.mask.length).toBe(10)
  // nothing was kept, and nothing is while the user does not say so
  await delay(150)
  expect(r.sim.compass.accepts).toBe(0)
  expect(r.sim.compass.saved(0) || r.sim.compass.saved(1)).toBe(false)
  expect(r.sim.compass.lastAutosave).toBe(false)
  expect((await state(r.f)).state == CalibrationStateState.Review).toBe(true)
  await r.f.call("calibration.cancel")
  await r.close()
}

async function compassAskedForItsMessages(): Promise<void> throws Error {
  const r = await connected()
  const asked: int[] = []
  r.sim.conn.on((m: Received) => {
    const c = m.message
    if (c instanceof CommandLong && c.command as int == MavCmd.SET_MESSAGE_INTERVAL) {
      asked.push(c._param1 as int)
    }
  })
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "review", (s: CalibrationState) => s.state == CalibrationStateState.Review)
  await r.f.call("calibration.cancel")
  await r.close()
  expect(asked.indexOf(191) >= 0).toBe(true)
  expect(asked.indexOf(192) >= 0).toBe(true)
}

async function compassIsKeptOnlyWhenAccepted(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "review", (s: CalibrationState) => s.state == CalibrationStateState.Review)
  const accepted = await r.f.call("calibration.accept", encodeCalibrationAccept(CalibrationAccept {}))
  expect(errorOf(accepted)).toBe("ok")
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("success")
  expect(r.sim.compass.accepts).toBe(1)
  expect(r.sim.compass.saved(0) && r.sim.compass.saved(1)).toBe(true)
  // the vehicle was told to stop calibrating at the end (the guard), after the accept
  expect(r.sim.compass.cancels).toBe(1)
}

async function compassAcceptsOnlyTheCompassesNamed(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "review", (s: CalibrationState) => s.state == CalibrationStateState.Review)
  await r.f.call("calibration.accept", encodeCalibrationAccept(CalibrationAccept { compasses: 2 as u8 }))
  await until(r.f, "finished", isFinished)
  await r.close()
  expect(r.sim.compass.saved(0)).toBe(false)
  expect(r.sim.compass.saved(1)).toBe(true)
}

async function anAcceptThatIsNotAnsweredSaysTheVehicleMayHaveKeptIt(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "review", (s: CalibrationState) => s.state == CalibrationStateState.Review)
  r.sim.compass.swallowAcks = 1   // the vehicle keeps the results, and its answer is lost
  const accepted = await r.f.call("calibration.accept", encodeCalibrationAccept(CalibrationAccept {}))
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(errorOf(accepted)).toBe("NOT_ACCEPTED")
  expect(outcomeOf(done)).toBe("failed")
  expect(codeOf(done)).toBe("TIMEOUT")
  expect(done.result!.unsure!).toBe(true)
  expect(done.result!.detail!.indexOf("may have kept the results") >= 0).toBe(true)
  // the vehicle did keep them: the page must not say nothing was kept
  expect(r.sim.compass.saved(0) && r.sim.compass.saved(1)).toBe(true)
}

async function compassCancelledFromTheReviewKeepsNothing(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "review", (s: CalibrationState) => s.state == CalibrationStateState.Review)
  const after = decodeCalibrationState((await r.f.call("calibration.cancel")).p ?? Cbor.Null, "$")
  await r.close()
  expect(outcomeOf(after)).toBe("cancelled")
  expect(r.sim.compass.accepts).toBe(0)
  expect(r.sim.compass.cancels).toBe(1)
  expect(r.sim.compass.saved(0) || r.sim.compass.saved(1)).toBe(false)
}

async function compassCancelledWhileItRunsIsToldToTheVehicle(): Promise<void> throws Error {
  const r = await connected()
  r.sim.compass.stepPct = 5   // slow: it is still running when it is cancelled
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "running", (s: CalibrationState) => s.compasses != null && s.compasses!.length > 0)
  const after = decodeCalibrationState((await r.f.call("calibration.cancel")).p ?? Cbor.Null, "$")
  await r.close()
  expect(outcomeOf(after)).toBe("cancelled")
  expect(r.sim.compass.cancels).toBe(1)
  expect(r.sim.compass.statusOf(0)).toBe(0)
  expect(after.result!.unsure == null).toBe(true)
}

async function compassCancelledByTheLinkIsToldToTheVehicle(): Promise<void> throws Error {
  const r = await connected()
  r.sim.compass.stepPct = 5
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "running", (s: CalibrationState) => s.compasses != null && s.compasses!.length > 0)
  link.abortOperations()
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("cancelled")
  expect(codeOf(done)).toBe("LINK_LOST")
  expect(r.sim.compass.cancels >= 1).toBe(true)
}

async function aLinkThatIsGoneSaysTheVehicleMayStillCalibrate(): Promise<void> throws Error {
  const r = await connected()
  r.sim.compass.stepPct = 5
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "running", (s: CalibrationState) => s.compasses != null && s.compasses!.length > 0)
  r.sim.down = true   // the vehicle hears nothing from now on
  link.abortOperations()
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("cancelled")
  expect(done.result!.unsure!).toBe(true)
}

async function compassIsCancelledWhenTheVehicleArms(): Promise<void> throws Error {
  const r = await connected()
  r.sim.compass.stepPct = 5
  await startOf(r.f, CalibrationKind.Compass)
  await until(r.f, "running", (s: CalibrationState) => s.compasses != null && s.compasses!.length > 0)
  clearInterval(r.hold)
  r.sim.ticks = 5
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("cancelled")
  expect(codeOf(done)).toBe("ARMED")
}

async function compassFailureCannotBeAccepted(): Promise<void> throws Error {
  const r = await connected()
  r.sim.compass.failWith = 7   // FAILED_RADIUS
  await startOf(r.f, CalibrationKind.Compass)
  const review = await until(r.f, "review", (s: CalibrationState) => s.state == CalibrationStateState.Review)
  expect(review.compasses![0].status).toBe("FAILED_RADIUS")
  expect(review.compasses![0].report!.ok).toBe(false)
  expect(errorOf(await r.f.call("calibration.accept", encodeCalibrationAccept(CalibrationAccept {})))).toBe("NOT_ACCEPTED")
  expect(r.sim.compass.accepts).toBe(0)
  // still waiting: the user cancels
  const after = decodeCalibrationState((await r.f.call("calibration.cancel")).p ?? Cbor.Null, "$")
  await r.close()
  expect(outcomeOf(after)).toBe("cancelled")
}

async function theVehicleRefusingTheStartIsTold(): Promise<void> throws Error {
  const r = await connected()
  r.sim.compass.refuse = true
  await startOf(r.f, CalibrationKind.Compass)
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("refused")
  expect(codeOf(done)).toBe("REFUSED")
  expect(done.texts.indexOf("Compass calibration failed to start") >= 0).toBe(true)
}

async function acceptNeedsAFinishedRun(): Promise<void> throws Error {
  const r = await connected()
  expect(errorOf(await r.f.call("calibration.accept", encodeCalibrationAccept(CalibrationAccept {})))).toBe("NOT_RUNNING")
  await r.close()
}

/// A connected simulator whose radio is sending RC_CHANNELS, all sticks centred.
async function radioRig(): Promise<Rig> throws Error {
  const r = await connected()
  waits.radioSilenceMs = 5000
  r.sim.rc =[1500, 1500, 1000, 1500, 1000, 1000, 1000, 1000]
  r.sim.rcStream = true
  r
}

/// Starts a radio calibration, and has the vehicle say it is up just after (the calibration waits for that: a vehicle is up by its words or
/// after 10 s, and a test must not depend on which came first). The error code of the answer, or "ok".
async function startRadio(r: Rig): Promise<string> throws Error {
  const answer = errorOf(await startOf(r.f, CalibrationKind.Radio))
  saysUp(r.sim)
  answer
}

/// Starts a radio calibration and waits until it has taken readings in.
async function radioRunning(r: Rig): Promise<void> throws Error {
  expect(await startRadio(r)).toBe("ok")
  await until(r.f, "readings", (s: CalibrationState) => s.radio != null && s.radio!.readings as int > 0)
}

/// Whether the least pulse of channel 1 the state has is `pulse`.
function minOneIs(s: CalibrationState, pulse: int): bool {
  s.radio != null && s.radio!.mins.length > 0 && s.radio!.mins[0] as int == pulse
}

async function radioCapturesTheRangeAndEndsWhenTheUserSaysSo(): Promise<void> throws Error {
  const r = await radioRig()
  await radioRunning(r)
  // the vehicle has the flag for the time of the calibration
  expect(r.sim.calibration.rcCalibrating).toBe(true)
  expect(link.calibrating).toBe(true)
  r.sim.rc[0] = 1100
  await until(r.f, "the least", (s: CalibrationState) => minOneIs(s, 1100))
  r.sim.rc[0] = 1900
  await until(r.f, "the greatest", (s: CalibrationState) => s.radio != null && s.radio!.maxs[0] as int == 1900)
  // a glitch is counted and is not a reading (it never becomes the greatest or the least)
  r.sim.rc[0] = 9000
  await until(r.f, "the glitch", (s: CalibrationState) => s.radio != null && s.radio!.glitches as int > 0)
  r.sim.rc[0] = 1500
  await until(r.f, "centred", (s: CalibrationState) => s.radio != null && s.radio!.last[0] as int == 1500)
  const done = decodeCalibrationState((await r.f.call("calibration.finish")).p ?? Cbor.Null, "$")
  expect(outcomeOf(done)).toBe("success")
  expect(done.radio!.mins[0] as int).toBe(1100)
  expect(done.radio!.maxs[0] as int).toBe(1900)
  expect(done.radio!.last[0] as int).toBe(1500)
  expect(done.radio!.mins.length).toBe(8)
  // the flag is cleared when it ends, and the next calibration may begin
  expect(r.sim.calibration.rcCalibrating).toBe(false)
  expect(link.calibrating).toBe(false)
  expect(done.result!.unsure == null).toBe(true)
  await r.close()
}

async function radioFinishNeedsARunWithReadings(): Promise<void> throws Error {
  const r = await connected()
  // no channels are sent: nothing was captured, and the user cannot finish on nothing
  r.sim.rcStream = false
  waits.radioSilenceMs = 10000
  expect(await startRadio(r)).toBe("ok")
  await until(r.f, "running", (s: CalibrationState) => s.state == CalibrationStateState.Running)
  expect(errorOf(await r.f.call("calibration.finish"))).toBe("NO_READINGS")
  await r.f.call("calibration.cancel")
  expect(errorOf(await r.f.call("calibration.finish"))).toBe("NOT_RUNNING")
  // and a calibration of another kind is not finished by it
  expect(errorOf(await startOf(r.f, CalibrationKind.Level))).toBe("ok")
  expect(errorOf(await r.f.call("calibration.finish"))).toBe("NOT_RUNNING")
  await until(r.f, "finished", isFinished)
  await r.close()
}

async function radioCancelKeepsNothingAndClearsTheFlag(): Promise<void> throws Error {
  const r = await radioRig()
  await radioRunning(r)
  r.sim.rc[0] = 1100
  await until(r.f, "the least", (s: CalibrationState) => minOneIs(s, 1100))
  const after = decodeCalibrationState((await r.f.call("calibration.cancel")).p ?? Cbor.Null, "$")
  expect(outcomeOf(after)).toBe("cancelled")
  expect(codeOf(after)).toBe("CANCELLED")
  expect(after.radio == null).toBe(true)
  expect(r.sim.calibration.rcCalibrating).toBe(false)
  expect(link.calibrating).toBe(false)
  expect(after.result!.unsure == null).toBe(true)
  await r.close()
}

async function radioEndsWhenTheLinkIsLost(): Promise<void> throws Error {
  const r = await radioRig()
  await radioRunning(r)
  link.abortOperations()
  const done = await until(r.f, "finished", isFinished)
  expect(outcomeOf(done)).toBe("cancelled")
  expect(codeOf(done)).toBe("LINK_LOST")
  expect(done.radio == null).toBe(true)
  expect(r.sim.calibration.rcCalibrating).toBe(false)
  expect(link.calibrating).toBe(false)
  await r.close()
}

async function radioEndsWhenTheSessionEnds(): Promise<void> throws Error {
  const r = await radioRig()
  await radioRunning(r)
  link.close()
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("cancelled")
  expect(codeOf(done)).toBe("LINK_LOST")
  expect(link.calibrating).toBe(false)
}

async function radioEndsWhenTheUserDisconnects(): Promise<void> throws Error {
  const r = await radioRig()
  await radioRunning(r)
  await r.f.call("vehicle.disconnect")
  const done = await until(r.f, "finished", isFinished)
  clearInterval(r.hold)
  expect(outcomeOf(done)).toBe("cancelled")
  expect(link.calibrating).toBe(false)
}

async function radioEndsWhenTheVehicleArmsAndSaysTheFlagMayStay(): Promise<void> throws Error {
  const r = await radioRig()
  await radioRunning(r)
  clearInterval(r.hold)
  r.sim.ticks = 5   // the next heartbeat says armed
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("cancelled")
  expect(codeOf(done)).toBe("ARMED")
  expect(link.calibrating).toBe(false)
  // an armed vehicle refuses the clear: the flag may still be set, and the result says so
  expect(done.result!.unsure!).toBe(true)
}

async function radioWorkDoesNotRunWhenTheVehicleRefusesTheFlag(): Promise<void> throws Error {
  const r = await radioRig()
  clearInterval(r.hold)
  // the vehicle is armed, though the last heartbeat the backend has says it is not (the next is a second away)
  r.sim.ticks = 5
  expect(await startRadio(r)).toBe("ok")
  const done = await until(r.f, "finished", isFinished)
  await r.close()
  expect(outcomeOf(done)).toBe("refused")
  expect(codeOf(done)).toBe("REFUSED")
  expect(done.radio == null).toBe(true)
  expect(link.calibrating).toBe(false)
}

async function radioGivesUpWhenNoChannelsComeAndClearsTheFlag(): Promise<void> throws Error {
  const r = await connected()
  waits.radioSilenceMs = 400
  r.sim.rcStream = false
  expect(await startRadio(r)).toBe("ok")
  const done = await until(r.f, "finished", isFinished)
  expect(outcomeOf(done)).toBe("failed")
  expect(codeOf(done)).toBe("TIMEOUT")
  expect(r.sim.calibration.rcCalibrating).toBe(false)
  expect(link.calibrating).toBe(false)
  await r.close()
}

async function theResultIsTold(): Promise<void> throws Error {
  const r = await connected()
  await startOf(r.f, CalibrationKind.Level)
  const told = decodeCalibrationResult((await r.f.event("calibration.result")).p ?? Cbor.Null, "$")
  await r.close()
  expect(told.outcome == CalibrationResultOutcome.Success).toBe(true)
  expect(told.kind == CalibrationKind.Level).toBe(true)
}

describe("the calibration service", () => {
  it("runs the six positions of the accelerometer, and ends with the vehicle's own success", fullAccelerometerEndsWithTheVehiclesOwnSuccess)
  it("shows a failure as a failure, with the vehicle's words", aFailureIsShownAsAFailure)
  it("sets the level with one command", theLevelIsOneCommand)
  it("takes a position only when the vehicle asks for it", aPositionThatIsNotAskedForIsRefused)
  it("tells the result as an event", theResultIsTold)
})

describe("what the calibration service refuses", () => {
  it("refuses when no vehicle is connected", refusesWhenNoVehicleIsConnected)
  it("refuses when the vehicle is armed, and sends nothing", refusesWhenTheVehicleIsArmed)
  it("refuses when the armed state is not known, and sends nothing", refusesWhenTheArmedStateIsNotKnown)
  it("runs one calibration at a time", onlyOneCalibrationRunsAtATime)
  it("refuses a parameter download while a calibration runs", aParameterDownloadIsRefusedWhileItRuns)
  it("refuses a parameter write while a calibration runs", aParameterWriteIsRefusedWhileItRuns)
  it("refuses a guarded Setup write while a calibration runs", aGuardedParameterWriteIsRefusedWhileItRuns)
  it("refuses the log list, a log download and an erase while a calibration runs", theLogsAreRefusedWhileItRuns)
  it("refuses a reboot while a calibration runs", aRebootIsRefusedWhileItRuns)
  it("sends nothing to a vehicle that has not said it is up", sendsNothingToAVehicleThatIsNotUp)
  it("takes an accept only when compass results wait", acceptNeedsAFinishedRun)
})

describe("the exits of an accelerometer calibration", () => {
  it("ends when the user cancels, and another may begin", cancelEndsTheAccelerometerCalibration)
  it("ends when the link is lost", theLinkBeingLostEndsIt)
  it("ends when the session ends", theSessionEndingEndsIt)
  it("ends when the vehicle arms", theVehicleArmingEndsIt)
})

describe("the radio calibration", () => {
  it("captures the range of each channel, keeps glitches out, and ends when the user says so", radioCapturesTheRangeAndEndsWhenTheUserSaysSo)
  it("is finished only while it runs and has taken readings in", radioFinishNeedsARunWithReadings)
  it("keeps nothing when the user cancels, and clears the vehicle's flag", radioCancelKeepsNothingAndClearsTheFlag)
  it("ends and clears the flag when the link is lost", radioEndsWhenTheLinkIsLost)
  it("ends when the session ends", radioEndsWhenTheSessionEnds)
  it("ends when the user disconnects", radioEndsWhenTheUserDisconnects)
  it("ends when the vehicle arms, and says the flag may stay when the vehicle refuses to clear it", radioEndsWhenTheVehicleArmsAndSaysTheFlagMayStay)
  it("does not run when the vehicle refuses to set the flag", radioWorkDoesNotRunWhenTheVehicleRefusesTheFlag)
  it("gives up when no channels come, and clears the flag", radioGivesUpWhenNoChannelsComeAndClearsTheFlag)
})

describe("the compass calibration", () => {
  it("goes to the reports and waits for the user: nothing is kept", compassGoesToTheReportsAndWaitsForTheUser)
  it("asks the vehicle for its compass messages", compassAskedForItsMessages)
  it("keeps the results only when they are accepted", compassIsKeptOnlyWhenAccepted)
  it("keeps only the compasses that were named", compassAcceptsOnlyTheCompassesNamed)
  it("keeps nothing when it is cancelled from the review, and tells the vehicle", compassCancelledFromTheReviewKeepsNothing)
  it("cancels on the vehicle when it is cancelled while it runs", compassCancelledWhileItRunsIsToldToTheVehicle)
  it("cancels on the vehicle when the link is lost", compassCancelledByTheLinkIsToldToTheVehicle)
  it("says the vehicle may still calibrate when the cancel cannot be told", aLinkThatIsGoneSaysTheVehicleMayStillCalibrate)
  it("is cancelled when the vehicle arms", compassIsCancelledWhenTheVehicleArms)
  it("says the vehicle may have kept the results when its answer to the accept is lost", anAcceptThatIsNotAnsweredSaysTheVehicleMayHaveKeptIt)
  it("cannot accept a failure", compassFailureCannotBeAccepted)
  it("says so when the vehicle refuses to start", theVehicleRefusingTheStartIsTold)
})
