// The backend over a real serial port (a pseudo-terminal stands in for the device). Linux only:
// it needs termios and pseudo-terminals, and padcom/serialport's only backend is Linux's.
import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { Cbor } from "pico-desktop/communicator"
import { Reader, Writer } from "std/process"
import * as f from "c:fcntl.h"
import * as termios from "c:termios.h"
import { ByteStream, SimulatedAutopilot } from "padcom/pico-mavlink"
import { start } from "./test-frontend"
import { ConnectRequest, ConnectRequestTransport, ConnectionState, decodeConnection, decodeParamList, encodeConnectRequest } from "./generated/app"

extern "C" {
  function posix_openpt(flags: c_int): c_int
  function grantpt(fd: c_int): c_int
  function unlockpt(fd: c_int): c_int
  function ptsname_r(fd: c_int, buf: usize, len: usize): c_int
  function tcgetattr(fd: c_int, termios: usize): c_int
  function tcsetattr(fd: c_int, when: c_int, termios: usize): c_int
  function cfmakeraw(termios: usize): void
  function dup(fd: c_int): c_int
}

function addr(b: Uint8Array): usize {
  (b.buffer.__handle + b.byteOffset) as usize
}

/// A pseudo-terminal's master end as a byte stream: the far end of a "serial cable" whose other
/// end (`path`) the backend opens as a serial port.
class PtyMaster implements ByteStream {
  public path: string = ""
  reader: Reader
  writer: Writer

  constructor() {
    const m = posix_openpt(f.O_RDWR | f.O_NOCTTY)
    grantpt(m)
    unlockpt(m)
    const name = new Uint8Array(128)
    ptsname_r(m, addr(name), 128 as usize)
    let n = 0
    while (name[n] != 0) {
      n += 1
    }
    try {
      this.path = new TextDecoder().decode(name.slice(0, n))
    } catch (e: TypeError) {
      panic("a pty name that isn't UTF-8")
    }
    const tio = new Uint8Array(256)
    tcgetattr(m, addr(tio))
    cfmakeraw(addr(tio))
    tcsetattr(m, termios.TCSANOW, addr(tio))
    this.reader = new Reader(m as int, "pty", true)
    this.writer = new Writer(dup(m) as int, "pty", true)
  }

  public read(): Promise<Uint8Array?, Error> {
    reader.read()
  }

  public async write(bytes: Uint8Array): Promise<void> throws Error {
    await writer.write(bytes)
  }

  public close(): void {
    writer.close()
    reader.close()
  }
}

async function overSerial(): Promise<void> throws Error {
  const pty = new PtyMaster()
  const sim = new SimulatedAutopilot(pty)
  sim.start(100)
  const fe = await start()
  const request = ConnectRequest { transport: ConnectRequestTransport.Serial, device: pty.path, baud: 57600 }
  const c = decodeConnection((await fe.call("vehicle.connect", encodeConnectRequest(request))).p ?? Cbor.Null, "$")
  expect(`${c.state == ConnectionState.Connected} ${c.error ?? ""}`).toBe("true ")
  const list = decodeParamList((await fe.call("params.list")).p ?? Cbor.Null, "$")
  expect(`${list.count} ${list.complete}`).toBe("12 true")
  // Unplugged: the far end of the cable goes away. The link is lost, and calls are refused.
  sim.stop()
  await delay(300)
  const e = await fe.call("params.list")
  expect(e.err?.code ?? "no error").toBe("NOT_CONNECTED")
  await fe.call("vehicle.disconnect")
}

async function badDevice(): Promise<void> throws Error {
  const fe = await start()
  const request = ConnectRequest { transport: ConnectRequestTransport.Serial, device: "/dev/no-such-tty" }
  const c = decodeConnection((await fe.call("vehicle.connect", encodeConnectRequest(request))).p ?? Cbor.Null, "$")
  expect(c.error ?? "").toBe("can't open serial /dev/no-such-tty at 115200: /dev/no-such-tty: opening it: No such file or directory")
}

describe("the backend over a serial port", () => {
  it("talks MAVLink over a serial port (a pseudo-terminal), and loses it when unplugged", overSerial)
  it("says why a serial port didn't open", badDevice)
})
