// The vehicle session: the one link to the vehicle. The services share it through the exported
// `link`, and listen to the vehicle as `SessionPart`s; this module imports none of them.
import { CommunicatorError, Sink } from "pico-desktop/communicator"
import {
  AutopilotVersion,
  ByteStream,
  MavAutopilot,
  MavLinkConnection,
  MavLinkRouter,
  MavType,
  ParamEncoding,
  SimulatedAutopilot,
  Vehicle,
  VehicleDiscovery,
  encodingOf,
} from "padcom/pico-mavlink"
import { Connection, ConnectionState, ConnectRequest, VehicleInfo, encodeConnection } from "./generated/app"
import { Beats } from "./heartbeat"

/// A service that listens to the vehicle while a session is up. `attach` is called once the
/// autopilot is identified (`link.sysid` and `link.compid` say which one to listen to), `detach`
/// when the session ends.
export interface SessionPart {
  attach(conn: MavLinkConnection): void
  detach(): void
}

/// The vehicle link.
class Link {
  public conn: MavLinkConnection? = null
  public sim: SimulatedAutopilot? = null
  /// Whether the simulated vehicle of a "simulator" connection has file transfer (a test can turn it off).
  public simulatorFtp: bool = true
  public beats: Beats? = null
  public discovery: VehicleDiscovery? = null
  public state: Connection = Connection { state: ConnectionState.Disconnected }
  /// Bumped on every connect and disconnect: a link's late news about an older link is ignored.
  public generation: int = 0
  public sysid: int = 0
  public compid: int = 0
  public autopilot: int = 0
  public encoding: ParamEncoding = ParamEncoding.CCast
  /// The low 32 bits of the autopilot's capabilities (AUTOPILOT_VERSION), or -1 when it was never read (a missed packet is not
  /// "no file transfer": the download asks for it itself then).
  public capabilities: int = -1
  /// Whether the simulated vehicle answers AUTOPILOT_VERSION (a test can turn it off).
  public simulatorVersion: bool = true
  /// Why file transfer was given up for the downloads that follow, for this vehicle on this connection: "" (not given up),
  /// "unsupported" (the vehicle has no parameter file: kept until the connection ends) or "timeout" (it did not answer: kept for
  /// the next download only, so the one after tries again). See params.pi.
  public ftpMemo: string = ""
  public watchers: Sink[] = []
  /// Whether the autopilot's last heartbeat said it is armed, and when it was received (ms since 1970; 0 = none yet).
  /// Set by telemetry.pi; `armedState()` says whether it can be trusted.
  public armed: bool = false
  public heartbeatAt: int = 0
  /// Parameter work that a reboot must not cut: writes in flight, and whether a download runs (params.pi).
  public writes: int = 0
  public listing: bool = false
  /// Whether a log download runs (logs.pi): a reboot is held off, and so is a parameter download (both use the vehicle's file
  /// transfer or would cut the download).
  public logging: bool = false
  /// Whether a calibration of the vehicle's sensors runs (calibration.pi): a reboot is refused (reboot.pi), and so are a parameter
  /// download or write (params.pi) and a log listing, download or erase (logs.pi): they would meet what the calibration keeps.
  public calibrating: bool = false
  /// Whether a motor test is under way (motors.pi: from its start until the motor is stopped): the vehicle then reports itself ARMED, a
  /// reboot is refused (reboot.pi) and so are a calibration, a parameter download or write and the log operations.
  public motorTest: bool = false
  /// When the vehicle accepted a reboot (ms since 1970; 0 = none): the link going quiet soon after is then a reboot, and
  /// says so (reconnect.pi). See `rebootExpected()`.
  public rebootAt: int = 0
  /// True when the vehicle did not answer the reboot at all (IN_PROGRESS counts as an answer: accepted): it may still reboot,
  /// so the link going quiet is taken for a reboot too, but a second request is refused only for a few seconds
  /// (`REBOOT_UNSURE_MS`).
  public rebootUnsure: bool = false
  /// The services that listen to the vehicle, by name (registering one again replaces it).
  public parts: Map<string, SessionPart> = new Map<string, SessionPart>()
  /// How long `vehicle.connect` waits for an autopilot's heartbeat.
  public heartbeatWaitMs: int = 3000
  /// Aborted when the session ends, or the link is lost: operations still running stop at once.
  public session: AbortController = new AbortController()
  /// What was asked for, kept so that a dropped link can be opened again (reconnect.pi).
  public request: ConnectRequest? = null
  /// The router under the connection: it outlives a dropped link, and a new link is added to it.
  public router: MavLinkRouter? = null
  /// The stream last given to the router that reconnect.pi may open again (TCP, serial): closed before the next try opens
  /// one, and when a try hears nothing, so that no socket or port is held without being used.
  public stream: ByteStream? = null
  /// Who the vehicle is (see `identityOf`): the one that comes back must be this one to be the same.
  public identity: string = ""
  /// The board the vehicle is (see `boardOf`), "" when it has no unique id that tells it from another.
  public board: string = ""
  /// Whether this session has changed what kind of vehicle the board is (a verified write of FRAME_CLASS and the like, see
  /// `changesVehicleType`) since it connected or was last taken up: only then may the same board come back as another type.
  /// Cleared by a taking up, by the end of the session, and by a write of such a parameter that did not succeed.
  public typeMayChange: bool = false
  /// A vehicle that has not been heard from for this long (ms) is gone, whatever the link says.
  public silenceMs: int = 5000
  /// The waits between tries to bring the link back (ms): the n-th try waits the n-th, the last one repeats.
  public retryDelaysMs: int[] = [1000, 2000, 4000, 8000, 10000]

  public update(c: Connection): void {
    state = c
    for (const w of watchers) {
      w.next(encodeConnection(c))
    }
  }

  /// The autopilot is identified: the parts start listening to it.
  public attach(c: MavLinkConnection): void {
    for (const p of parts.values()) {
      p.attach(c)
    }
  }

  /// Stops the operations that are running (a parameter download, a write: a write is reported as not
  /// confirmed and never sent again), and lets new ones start. The link and the connection stay.
  public abortOperations(): void {
    session.abort()
    session = new AbortController()
  }

  public close(): void {
    generation += 1
    abortOperations()
    request = null
    router = null
    stream = null
    identity = ""
    board = ""
    typeMayChange = false
    armed = false
    heartbeatAt = 0
    // (`writes` is not reset here: each write counts itself out when it ends, which closing the session makes happen.)
    listing = false
    capabilities = -1
    ftpMemo = ""
    rebootAt = 0
    rebootUnsure = false
    for (const p of parts.values()) {
      p.detach()
    }
    const b = beats
    if (b != null) {
      b!.stop()
    }
    const d = discovery
    if (d != null) {
      d!.stop()
    }
    const c = conn
    if (c != null) {
      c!.close()
    }
    const s = sim
    if (s != null) {
      s!.stop()
    }
    beats = null
    discovery = null
    conn = null
    sim = null
    sysid = 0
  }
}

/// The session: one per backend.
export const link = new Link()

/// How long after the vehicle accepted a reboot the session still expects it (ms): a link that goes quiet within it is
/// a vehicle that is rebooting, and a second reboot is refused (it could reach the freshly booted vehicle).
export const REBOOT_WINDOW_MS: int = 60000

/// How long a second reboot is refused after one the vehicle did not answer (ms): the command may have arrived, and the
/// vehicle may be about to reboot; after this a person may try again.
export const REBOOT_UNSURE_MS: int = 10000

/// Whether a reboot is still expected: one the vehicle accepted (until it is seen come back, or the window ends), or one it
/// did not answer (for a few seconds: the command may have arrived).
export function rebootExpected(): bool {
  const window = if (link.rebootUnsure) REBOOT_UNSURE_MS else REBOOT_WINDOW_MS
  link.rebootAt > 0 && (Date.now() as int) - link.rebootAt < window
}

/// How old the last heartbeat may be for the armed state to count as known (ms).
export const ARMED_FRESH_MS: int = 3000

/// Whether the autopilot is armed: true or false when its heartbeat is recent, null when there has been none or it is older
/// than `ARMED_FRESH_MS` (not known: the callers treat it as armed).
export function armedState(): bool? {
  if (link.heartbeatAt == 0 || (Date.now() as int) - link.heartbeatAt > ARMED_FRESH_MS) {
    return null
  }
  link.armed
}

/// How integers travel in parameter floats: as the autopilot says (AUTOPILOT_VERSION), or as its kind
/// usually does (PX4 bytewise; ArduPilot and most others C-cast).
export function encodingFor(v: Vehicle, version: AutopilotVersion?): ParamEncoding {
  const guess = if (v.autopilot == MavAutopilot.PX4) ParamEncoding.Bytewise else ParamEncoding.CCast
  if (version == null) guess else encodingOf(version!.capabilities) ?? guess
}

/// The low 32 bits of the capabilities the autopilot gave (the u64 does not fit an int: its upper bits are not asked about, and
/// must not panic the conversion), or -1 when it gave none (it was not asked, or did not answer: not "has none").
export function capabilitiesOf(version: AutopilotVersion?): int {
  if (version == null) -1 else ((version!.capabilities & (0xFFFFFFFF as u64)) as int)
}

/// The vehicle as the dashboard names it: the protocol's names for its type and autopilot.
export function infoOf(v: Vehicle): VehicleInfo {
  VehicleInfo {
    sysid: v.sysid as u8,
    compid: v.compid as u8,
    type: MavType.nameOf(v.type) ?? `${v.type}`,
    autopilot: MavAutopilot.nameOf(v.autopilot) ?? `${v.autopilot}`,
  }
}

/// Who a vehicle is. A board that says its unique id (AUTOPILOT_VERSION: a non-zero `uid`) is identified by its ids, its
/// autopilot and that id, and NOT by its type: changing FRAME_CLASS (a quad becomes a hexa) and rebooting changes the MAV_TYPE it
/// reports, and it is still the same board, with the same parameters, initial values and queued changes. A vehicle with no unique
/// id (uid 0, as the simulator and SITL report) is identified by its ids, its type and its autopilot, as before. A vehicle that
/// comes back after the link dropped is "the same" only if this is the same.
export function identityOf(v: Vehicle, version: AutopilotVersion?): string {
  const unique = uniqueIdOf(version)
  `${v.sysid}/${v.compid}/${v.type}/${v.autopilot}/${if (unique == "") "0" else `uid:${unique}`}`
}

/// Which board a vehicle is, without its type: by its ids, its autopilot and its unique id, or "" when it has no unique id that
/// tells boards apart. Two vehicles with the same board but another type are the same vehicle ONLY when this session changed
/// the type itself (`link.typeMayChange`): a unique id alone is not proof (two SITL instances on one host report the same one).
export function boardOf(v: Vehicle, version: AutopilotVersion?): string {
  const unique = uniqueIdOf(version)
  if (unique == "") "" else `${v.sysid}/${v.compid}/${v.autopilot}/uid:${unique}`
}

/// The parameters that change what kind of vehicle the autopilot says it is (its MAV_TYPE): the frame of a copter, the VTOL frame
/// of a plane. After a verified write of one of them and a reboot, the same board reports another type.
export function changesVehicleType(id: string): bool {
  id == "FRAME_CLASS" || id == "FRAME_TYPE" || id == "Q_ENABLE" || id == "Q_FRAME_CLASS"
}

/// Whether some bytes can tell one board from another: they are not missing, and not all the same (all zero is "no id", all
/// ones is what a flash that was never written reads as, and a constant is what a firmware that fills the field with a
/// placeholder sends: any of those is the same on every board, so it would make two different boards "the same vehicle").
function tellsBoardsApart(bytes: int[]): bool {
  if (bytes.length == 0) {
    return false
  }
  for (const b of bytes) {
    if (b != bytes[0]) {
      return true
    }
  }
  false
}

/// The bytes of a 64-bit unique id, least significant first.
function bytesOf(uid: u64): int[] {
  // (Shifted and masked as u64, one byte at a time: a 64-bit value with its top bit set does not fit an `int`, and converting it panics.)
  const bytes: int[] = []
  for (let i = 0; i < 8; i++) {
    bytes.push(((uid >> ((8 * i) as u64)) & (255 as u64)) as int)
  }
  bytes
}

/// The board's unique id as text, or "" when it has none that tells it from another. `uid2` (18 bytes, which supersedes `uid`)
/// is used when it can tell boards apart, else `uid`.
export function uniqueIdOf(version: AutopilotVersion?): string {
  if (version == null) {
    return ""
  }
  const long: int[] = version!.uid2.map((b: u8) => b as int)
  if (tellsBoardsApart(long)) {
    return `2.${long.join(".")}`
  }
  const short = bytesOf(version!.uid)
  if (tellsBoardsApart(short)) `1.${short.join(".")}` else ""
}

/// The connection to the vehicle, if one is up.
export function connectedLink(): MavLinkConnection throws CommunicatorError {
  const c = link.conn
  if (c == null || link.state.state != ConnectionState.Connected) {
    throw new CommunicatorError("NOT_CONNECTED", "no vehicle is connected")
  }
  c!
}
