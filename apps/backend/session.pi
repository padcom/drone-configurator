// The vehicle session: the one link to the vehicle and what it last heard. The services share it
// through the exported `link`; this module imports none of them.
import { Communicator, CommunicatorError, Sink } from "pico-desktop/communicator"
import {
  HeartbeatSender,
  MavLinkConnection,
  MavParamType,
  ParamEncoding,
  Received,
  SimulatedAutopilot,
  TypedParamValue,
  ParamValue,
  VehicleDiscovery,
  decodeParam,
} from "padcom/pico-mavlink"
import { Connection, ConnectionState, Param, ParamKind, encodeConnection, encodeParam } from "./generated/app"

function typeName(type: int): string {
  MavParamType.nameOf(type) ?? `${type}`
}

/// A parameter as the contract has it.
export function toParam(id: string, index: int, v: TypedParamValue): Param {
  match (v) {
    Int { value, type } => Param { id: id, index: index as u16, kind: ParamKind.Int, type: typeName(type), value: value as f64 },
    Real { value, type } => Param { id: id, index: index as u16, kind: ParamKind.Real, type: typeName(type), value: (value as f32) as f64 },
  }
}

/// A service that listens to the vehicle while a session is up. `attach` is called once the
/// autopilot is identified (`link.sysid` and `link.compid` say which one to listen to), `detach`
/// when the session ends.
export interface SessionPart {
  attach(conn: MavLinkConnection): void
  detach(): void
}

/// The vehicle link and what it last heard.
class Link {
  public conn: MavLinkConnection? = null
  public sim: SimulatedAutopilot? = null
  public beats: HeartbeatSender? = null
  public discovery: VehicleDiscovery? = null
  public state: Connection = Connection { state: ConnectionState.Disconnected }
  /// Bumped on every connect and disconnect: a link's late news about an older link is ignored.
  public generation: int = 0
  public sysid: int = 0
  public compid: int = 0
  public autopilot: int = 0
  public encoding: ParamEncoding = ParamEncoding.CCast
  public watchers: Sink[] = []
  /// The services that listen to the vehicle, by name (registering one again replaces it).
  public parts: Map<string, SessionPart> = new Map<string, SessionPart>()
  /// How long `vehicle.connect` waits for an autopilot's heartbeat.
  public heartbeatWaitMs: int = 3000
  /// Aborted when the session ends: operations still running stop at once.
  public session: AbortController = new AbortController()
  public communicator: Communicator? = null
  /// While a list download runs, PARAM_VALUEs are its answers, not news.
  public listing: bool = false

  public update(c: Connection): void {
    state = c
    for (const w of watchers) {
      w.next(encodeConnection(c))
    }
  }

  /// The autopilot is identified: the parts start listening to it.
  public attach(c: MavLinkConnection): void {
    for (const p of parts.values()) {
      p.attach(c)
    }
  }

  public close(): void {
    generation += 1
    session.abort()
    session = new AbortController()
    for (const p of parts.values()) {
      p.detach()
    }
    const b = beats
    if (b != null) {
      b!.stop()
    }
    const d = discovery
    if (d != null) {
      d!.stop()
    }
    const c = conn
    if (c != null) {
      c!.close()
    }
    const s = sim
    if (s != null) {
      s!.stop()
    }
    beats = null
    discovery = null
    conn = null
    sim = null
    sysid = 0
  }

  /// News from the connected vehicle that no part listens to yet.
  public seen(r: Received): void {
    if (sysid == 0 || r.packet.header.sysid != sysid || r.packet.header.compid != compid) {
      return
    }
    const m = r.message
    if (m instanceof ParamValue) {
      // A parameter the vehicle announced on its own: tell the dashboard.
      const c = communicator
      if (!listing && c != null) {
        const p = toParam(m.paramId, m.paramIndex as int, decodeParam(m.paramValue, m.paramType as int, encoding))
        c!.emit("params.changed", encodeParam(p))
      }
    }
  }
}

/// The session: one per backend.
export const link = new Link()

/// The connection to the vehicle, if one is up.
export function connectedLink(): MavLinkConnection throws CommunicatorError {
  const c = link.conn
  if (c == null || link.state.state != ConnectionState.Connected) {
    throw new CommunicatorError("NOT_CONNECTED", "no vehicle is connected")
  }
  c!
}
