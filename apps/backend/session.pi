// The vehicle session: the one link to the vehicle. The services share it through the exported
// `link`, and listen to the vehicle as `SessionPart`s; this module imports none of them.
import { CommunicatorError, Sink } from "pico-desktop/communicator"
import {
  AutopilotVersion,
  ByteStream,
  MavAutopilot,
  MavLinkConnection,
  MavLinkRouter,
  MavType,
  ParamEncoding,
  SimulatedAutopilot,
  Vehicle,
  VehicleDiscovery,
  encodingOf,
} from "padcom/pico-mavlink"
import { Connection, ConnectionState, ConnectRequest, VehicleInfo, encodeConnection } from "./generated/app"
import { Beats } from "./heartbeat"

/// A service that listens to the vehicle while a session is up. `attach` is called once the
/// autopilot is identified (`link.sysid` and `link.compid` say which one to listen to), `detach`
/// when the session ends.
export interface SessionPart {
  attach(conn: MavLinkConnection): void
  detach(): void
}

/// The vehicle link.
class Link {
  public conn: MavLinkConnection? = null
  public sim: SimulatedAutopilot? = null
  public beats: Beats? = null
  public discovery: VehicleDiscovery? = null
  public state: Connection = Connection { state: ConnectionState.Disconnected }
  /// Bumped on every connect and disconnect: a link's late news about an older link is ignored.
  public generation: int = 0
  public sysid: int = 0
  public compid: int = 0
  public autopilot: int = 0
  public encoding: ParamEncoding = ParamEncoding.CCast
  public watchers: Sink[] = []
  /// The services that listen to the vehicle, by name (registering one again replaces it).
  public parts: Map<string, SessionPart> = new Map<string, SessionPart>()
  /// How long `vehicle.connect` waits for an autopilot's heartbeat.
  public heartbeatWaitMs: int = 3000
  /// Aborted when the session ends, or the link is lost: operations still running stop at once.
  public session: AbortController = new AbortController()
  /// What was asked for, kept so that a dropped link can be opened again (reconnect.pi).
  public request: ConnectRequest? = null
  /// The router under the connection: it outlives a dropped link, and a new link is added to it.
  public router: MavLinkRouter? = null
  /// The stream last given to the router that reconnect.pi may open again (TCP, serial): closed before the next try opens
  /// one, and when a try hears nothing, so that no socket or port is held without being used.
  public stream: ByteStream? = null
  /// Who the vehicle is (see `identityOf`): the one that comes back must be this one to be the same.
  public identity: string = ""
  /// A vehicle that has not been heard from for this long (ms) is gone, whatever the link says.
  public silenceMs: int = 5000
  /// The waits between tries to bring the link back (ms): the n-th try waits the n-th, the last one repeats.
  public retryDelaysMs: int[] = [1000, 2000, 4000, 8000, 10000]

  public update(c: Connection): void {
    state = c
    for (const w of watchers) {
      w.next(encodeConnection(c))
    }
  }

  /// The autopilot is identified: the parts start listening to it.
  public attach(c: MavLinkConnection): void {
    for (const p of parts.values()) {
      p.attach(c)
    }
  }

  /// Stops the operations that are running (a parameter download, a write: a write is reported as not
  /// confirmed and never sent again), and lets new ones start. The link and the connection stay.
  public abortOperations(): void {
    session.abort()
    session = new AbortController()
  }

  public close(): void {
    generation += 1
    abortOperations()
    request = null
    router = null
    stream = null
    identity = ""
    for (const p of parts.values()) {
      p.detach()
    }
    const b = beats
    if (b != null) {
      b!.stop()
    }
    const d = discovery
    if (d != null) {
      d!.stop()
    }
    const c = conn
    if (c != null) {
      c!.close()
    }
    const s = sim
    if (s != null) {
      s!.stop()
    }
    beats = null
    discovery = null
    conn = null
    sim = null
    sysid = 0
  }
}

/// The session: one per backend.
export const link = new Link()

/// How integers travel in parameter floats: as the autopilot says (AUTOPILOT_VERSION), or as its kind
/// usually does (PX4 bytewise; ArduPilot and most others C-cast).
export function encodingFor(v: Vehicle, version: AutopilotVersion?): ParamEncoding {
  const guess = if (v.autopilot == MavAutopilot.PX4) ParamEncoding.Bytewise else ParamEncoding.CCast
  if (version == null) guess else encodingOf(version!.capabilities) ?? guess
}

/// The vehicle as the dashboard names it: the protocol's names for its type and autopilot.
export function infoOf(v: Vehicle): VehicleInfo {
  VehicleInfo {
    sysid: v.sysid as u8,
    compid: v.compid as u8,
    type: MavType.nameOf(v.type) ?? `${v.type}`,
    autopilot: MavAutopilot.nameOf(v.autopilot) ?? `${v.autopilot}`,
  }
}

/// Who a vehicle is: its ids, its kind and, when it says (AUTOPILOT_VERSION), its unique id. A vehicle that
/// comes back after the link dropped is "the same" only if this is the same; "0" for no unique id.
export function identityOf(v: Vehicle, version: AutopilotVersion?): string {
  const uid = if (version == null) "0" else `${version!.uid}`
  `${v.sysid}/${v.compid}/${v.type}/${v.autopilot}/${uid}`
}

/// The connection to the vehicle, if one is up.
export function connectedLink(): MavLinkConnection throws CommunicatorError {
  const c = link.conn
  if (c == null || link.state.state != ConnectionState.Connected) {
    throw new CommunicatorError("NOT_CONNECTED", "no vehicle is connected")
  }
  c!
}
