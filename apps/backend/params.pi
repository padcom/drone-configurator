// The params service: downloading the vehicle's parameters, writing one with a read-back, and
// telling the dashboard about a parameter the vehicle announces on its own. After a link came back to the same vehicle,
// a download can resume: it reuses what the session heard (paramcache.pi) and asks only for what it lacks (#28).
import { Cbor, Communicator, CommunicatorError, RequestContext } from "pico-desktop/communicator"
import { delay } from "std/timers"
import {
  FtpError,
  MavLinkConnection,
  MavLinkError,
  MavParamType,
  MavProtocolCapability,
  ParamDownload,
  ParamDownloadOptions,
  ParamDownloadResult,
  ParamError,
  ParamRequestRead,
  ParamWrite as ParamWriteOp,
  Received,
  Target,
  TypedParamValue,
  ParamValue,
  decodeParam,
} from "padcom/pico-mavlink"
import {
  Param,
  ParamKind,
  ParamList,
  ParamListRequestMethod,
  ParamListSource,
  ParamDefault,
  ParamDefaults,
  ParamWriteKind,
  ParamWriteResult,
  ParamsProgress,
  ParamsProgressSource,
  decodeParamListRequest,
  decodeParamWrite,
  encodeParam,
  encodeParamList,
  encodeParamDefaults,
  encodeParamsProgress,
  encodeParamWriteResult,
} from "./generated/app"
import { paramCache } from "./paramcache"
import { SessionPart, armedState, changesVehicleType, connectedLink, link, rebootExpected } from "./session"
import { refuseUntunable } from "./tuning"

/// Registers the service's methods on `c`, and its part of the session.
export function register(c: Communicator): void {
  announced.communicator = c
  link.parts.set("params", announced)
  c.handle("params.list", listParams)
  c.handle("params.cancel", cancelDownload)
  c.handle("params.write", writeParam)
  c.handle("params.defaults", listDefaults)
}

/// The most a progress count can be (the contract's `uint .size 2`).
const MAX_COUNT: int = 65535

/// The numbers of a progress event, `[received, total]` in parameters, always inside the contract's range: the file reports bytes
/// and the size the vehicle gave on opening is any four bytes (an estimate of 12 a parameter, here a garbled or hostile one
/// could be billions), the list reports parameters (and a vehicle can claim any count). Clamped before they are converted.
/// A total of 0 or less is nothing to report: `[0, 0]`.
export function progressCounts(received: int, total: int, fromFile: bool): int[] {
  const all = if (fromFile) total / BYTES_A_PARAM else total
  const done = if (fromFile) received / BYTES_A_PARAM else received
  if (all <= 0) {
    return [0, 0]
  }
  const top = if (all > MAX_COUNT) MAX_COUNT else all
  const shown = if (done < 0) 0 else if (done > top) top else done
  return [shown, top]
}

/// At most this often (ms) a `params.progress` is sent while a download runs.
const PROGRESS_EVERY_MS: int = 100

/// The vehicle's reckoning of the size of its parameter file: this many bytes a parameter (so progress by file is in parameters).
const BYTES_A_PARAM: int = 12

/// Parameters the vehicle announces on its own (`params.changed`).
class Announced implements SessionPart {
  public communicator: Communicator? = null
  public conn: MavLinkConnection? = null
  public listener: int = 0
  /// What a PARAM_VALUE of the vehicle is while a download runs: `news` (no download, or the file transfer is not under way: it
  /// is announced), `file` (the file transfer is under way: a PARAM_VALUE is news from another ground station, kept to be
  /// applied over the downloaded list), `list` (the list is being downloaded: a PARAM_VALUE is its answer).
  public mode: string = "news"
  /// Announcements that came during the file transfer, by name: applied over the list when it is in.
  public pending: Map<string, Param> = new Map<string, Param>()
  /// The download that runs, so that `params.cancel` can stop it (and nothing else: the session goes on).
  public download: AbortController? = null
  /// When progress was last sent (ms since 1970).
  public progressAt: int = 0
  /// The session signal that is followed (once for each session, not once for each download).
  public followed: AbortSignal? = null

  /// Makes the session ending stop the download that runs. One listener on a session's signal, however many downloads it has.
  public follow(signal: AbortSignal): void {
    if (followed == signal) {
      return
    }
    followed = signal
    signal.addEventListener("abort", () => stopDownload())
  }

  /// Stops the download that runs, if any.
  public stopDownload(): void {
    const d = download
    if (d != null) {
      d!.abort()
    }
  }

  /// How far the download is, in parameters: `bytes` (the file, `total` the vehicle's estimate of 12 bytes a parameter, clamped:
  /// the file can be bigger than it said) or `parameters` (the list). Sent at most `PROGRESS_EVERY_MS` apart (the first at once,
  /// the last when all have arrived). The first report of the list means the file transfer was given up.
  public progressed(received: int, total: int, unit: string): void {
    const fromFile = unit == "bytes"
    if (!fromFile && mode == "file") {
      mode = "list"
      pending.clear()
    }
    const counts = progressCounts(received, total, fromFile)
    const all = counts[1]
    const c = communicator
    const now = Date.now() as int
    if (c == null || all <= 0 || (progressAt != 0 && counts[0] < all && now - progressAt < PROGRESS_EVERY_MS)) {
      return
    }
    progressAt = now
    const source = if (fromFile) ParamsProgressSource.Ftp else ParamsProgressSource.List
    c!.emit("params.progress", encodeParamsProgress(ParamsProgress { received: counts[0] as u16, total: all as u16, source: source }))
  }

  /// Puts what other ground stations announced during the file transfer over the list that came (their values are newer).
  public applyPending(params: Param[]): void {
    for (const p of params) {
      const news = pending.get(p.id)
      if (news != null) {
        p.value = news!.value
        p.kind = news!.kind
        p.type = news!.type
      }
    }
    pending.clear()
  }

  public attach(c: MavLinkConnection): void {
    if (conn != null) {
      detach()
    }
    conn = c
    listener = c.on((r: Received) => seen(r))
  }

  public detach(): void {
    const c = conn
    if (c != null) {
      c!.off(listener)
    }
    conn = null
  }

  /// News from the connected vehicle.
  public seen(r: Received): void {
    if (link.sysid == 0 || r.packet.header.sysid != link.sysid || r.packet.header.compid != link.compid) {
      return
    }
    const m = r.message
    if (m instanceof ParamValue) {
      const p = toParam(m.paramId, m.paramIndex as int, decodeParam(m.paramValue, m.paramType as int, link.encoding))
      // Whatever it is (an answer, a read-back, news), it is what the vehicle has: kept for a resume.
      paramCache.heard(link.identity, p, m.paramCount as int)
      // A parameter the vehicle announced on its own: tell the dashboard (or, during the list download, it is an answer of it).
      if (mode == "list") {
        return
      }
      if (mode == "file") {
        pending.set(p.id, p)
        return
      }
      const c = communicator
      if (c != null) {
        c!.emit("params.changed", encodeParam(p))
      }
    }
  }
}

const announced = new Announced()

function typeName(type: int): string {
  return MavParamType.nameOf(type) ?? `${type}`
}

function typeValue(name: string): int? {
  for (let t = 1; t <= 10; t++) {
    if (MavParamType.nameOf(t) == name) {
      return t
    }
  }
  return null
}

/// A parameter as the contract has it.
function toParam(id: string, index: int, v: TypedParamValue): Param {
  match (v) {
    Int { value, type } => Param { id: id, index: index as u16, kind: ParamKind.Int, type: typeName(type), value: value as f64 },
    Real { value, type } => Param { id: id, index: index as u16, kind: ParamKind.Real, type: typeName(type), value: (value as f32) as f64 },
  }
}

/// Stops the download that is running, if any: it fails with `ABORTED`, and the link and the session stay.
async function cancelDownload(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  announced.stopDownload()
  return null
}

/// How a download is made, given what was asked for and what is known of the vehicle: the way for `ParamDownload` (`auto`, `list`
/// or `ftp`), and why the file transfer is skipped when it is. A download that is not forced skips the file transfer when it
/// failed before for a reason that will not change soon: `unsupported` (the vehicle has no such file: for as long as the
/// connection lasts) or `timeout` (it did not answer: for the next download only, so that the one after tries again).
class Plan {
  public method: string = "auto"
  public skipped: string = ""
}

function planFor(asked: ParamListRequestMethod?): Plan {
  const plan = new Plan()
  if (asked != null && asked! == ParamListRequestMethod.Ftp) {
    plan.method = "ftp"
  } else if (asked != null && asked! == ParamListRequestMethod.List) {
    plan.method = "list"
  } else if (link.ftpMemo != "") {
    plan.method = "list"
    plan.skipped = link.ftpMemo
    if (link.ftpMemo == "timeout") {
      link.ftpMemo = ""
    }
  }
  return plan
}

/// Whether the file transfer may be tried: the vehicle's capabilities say it has it, or were never read (then the download asks
/// for them itself, and a missed packet at connect is not "no file transfer").
function vehicleHasFtp(): bool {
  return link.capabilities < 0 || (link.capabilities & MavProtocolCapability.FTP) != 0
}

/// What is remembered about a failure of the file transfer: "unsupported" only when it comes from capabilities that were read
/// (a download that had to ask for them, and got no answer, knows nothing), "timeout" always, nothing else.
function worthRemembering(fallback: string): bool {
  return fallback == "timeout" || (fallback == "unsupported" && link.capabilities >= 0)
}

/// A download that is not forced remembers why the file transfer failed, if it was for a reason worth remembering.
function remember(plan: Plan, source: string, fallback: string?): void {
  if (plan.method == "auto" && source == "list" && fallback != null && worthRemembering(fallback!)) {
    link.ftpMemo = fallback!
  }
}

/// The options of a download: the capabilities only when they were read at connect (else `ParamDownload` asks).
function optionsFor(plan: Plan, signal: AbortSignal): ParamDownloadOptions {
  if (link.capabilities < 0) {
    const asking: ParamDownloadOptions = { method: plan.method, signal: signal }
    return asking
  }
  const known: ParamDownloadOptions = { method: plan.method, capabilities: link.capabilities, signal: signal }
  return known
}

/// Keeps the names of a COMPLETE list in the session: what is not in one is known not to be on the vehicle.
function keepNames(list: ParamList): void {
  if (!list.complete) {
    return
  }
  link.paramNames.clear()
  for (const p of list.params) {
    link.paramNames.set(p.id, true)
  }
  link.paramsComplete = true
}

/// The parameters as the contract has them: the way they came, why not the other way, how long it took.
function listOf(r: ParamDownloadResult, plan: Plan): ParamList {
  const source = if (r.source == "ftp") ParamListSource.Ftp else ParamListSource.List
  // A download that skipped the file transfer says why (what it remembered), not that the list was asked for.
  const why = if (plan.skipped != "") plan.skipped else r.fallback ?? ""
  return ParamList {
    params: r.params.map((p) => toParam(p.id, p.index, p.value)),
    count: r.count as u16,
    complete: r.complete,
    missing: r.missing.map((i: int) => i as u16),
    source: source,
    fallback: if (why == "") null else why,
    elapsedMs: r.elapsedMs as u32,
  }
}

/// Refuses a transfer of the parameters (the list, or the defaults) while something else talks to the vehicle at length.
function refuseWhileBusy(): void throws CommunicatorError {
  if (announced.download != null) {
    // One download at a time: a second would share its progress and take its place for `params.cancel`.
    throw new CommunicatorError("BUSY", "a parameter download is already running")
  }
  if (link.logging) {
    // The file transfer is busy with a log: two requests would take turns with the same vehicle's one.
    throw new CommunicatorError("BUSY", "a log is being downloaded")
  }
  if (link.calibrating) {
    // A calibration is the vehicle's own work on parameters (it keeps its results in them): what is read now is not what it leaves.
    throw new CommunicatorError("BUSY", "a calibration is running")
  }
  if (link.motorTest) {
    // The vehicle's link is the motor test's: its stop must not wait behind a download.
    throw new CommunicatorError("BUSY", "a motor test is running")
  }
  if (link.planning) {
    // A plan operation is a transfer of its own with the vehicle: two would meet.
    throw new CommunicatorError("BUSY", "the mission, fence or rally points are being read or written")
  }
}

async function listParams(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const request = if (payload == null) null else decodeParamListRequest(payload!, "$")
  const asked = if (request == null) null else request!.method
  const resume = request != null && (request!.resume ?? false)
  const conn = connectedLink()
  refuseWhileBusy()
  // The download has a controller of its own, so that cancelling it does not end the session; the session ending stops it.
  const own = new AbortController()
  announced.follow(link.session.signal)
  announced.download = own
  announced.progressAt = 0
  announced.pending.clear()
  link.listing = true
  let out: ParamList
  try {
    const resumed = if (resume) await resumeList(conn, own.signal) else null
    out = if (resumed != null) resumed! else await download(conn, asked, own.signal)
    keepNames(out)
  } catch (e: MavLinkError) {
    throw new CommunicatorError(e.code, e.message)
  } catch (e: FtpError) {
    // A forced file transfer that failed: its own error, no fallback.
    throw new CommunicatorError(e.code, e.message)
  } finally {
    // Whatever ends the download (an error of any kind included): a flag left set would hold off the reboot, and the
    // announcements, until the session ends.
    announced.mode = "news"
    announced.pending.clear()
    link.listing = false
    announced.download = null
  }
  encodeParamList(out)
}

/// An ordinary download: the whole list, by file transfer or by the list. What was heard before it is not fresh any more (it
/// wants the vehicle's values now), and a complete list is what the vehicle has.
async function download(conn: MavLinkConnection, asked: ParamListRequestMethod?, signal: AbortSignal): Promise<ParamList> throws Error {
  const plan = planFor(asked)
  announced.mode = if (plan.method != "list" && vehicleHasFtp()) "file" else "list"
  paramCache.begin()
  const options = optionsFor(plan, signal)
  const target: Target = { system: link.sysid, component: link.compid }
  const r = await new ParamDownload(conn, target, link.encoding, options).run((received: int, total: int, unit: string) => announced.progressed(received, total, unit))
  const out = listOf(r, plan)
  announced.applyPending(out.params)
  remember(plan, r.source, r.fallback)
  if (out.complete) {
    paramCache.took(link.identity, out.params, out.count as int)
  }
  return out
}

/// How many reads by index are asked for at once: ArduPilot keeps a short queue of them, and drops what does not fit.
const READS_AT_ONCE: int = 16

/// How long a batch of reads waits when nothing arrives (ms).
const READ_QUIET_MS: int = 500

/// How many times the parameters still missing are asked for.
const RESUME_ROUNDS: int = 3

/// How long the check of the list waits for its answer (ms), and how many times it asks.
const CHECK_WAIT_MS: int = 1000
const CHECK_TRIES: int = 3

function stopIfCancelled(signal: AbortSignal): void throws MavLinkError {
  if (signal.aborted) {
    throw new MavLinkError("ABORTED", "the parameter list: cancelled")
  }
}

/// Asks the vehicle for the parameter at `index`.
async function askIndex(conn: MavLinkConnection, index: int): Promise<void> throws Error {
  const read = new ParamRequestRead()
  read.targetSystem = link.sysid as u8
  read.targetComponent = link.compid as u8
  read.paramId = ""
  read.paramIndex = index as i16
  await conn.send(read)
}

/// Whether `r` is the vehicle's parameter at index 0.
function firstOfTheVehicle(r: Received): bool {
  const m = r.message
  if (m instanceof ParamValue) {
    return r.packet.header.sysid == link.sysid && r.packet.header.compid == link.compid && (m.paramIndex as int) == 0
  }
  return false
}

/// Whether the vehicle still has the list that was kept: its first parameter is asked for, and its count and its name must be
/// the ones kept (a firmware, or a feature enabled and a reboot, change the list). No answer is not the same list.
async function sameList(conn: MavLinkConnection, signal: AbortSignal): Promise<bool> throws Error {
  const count = paramCache.count
  const name = paramCache.nameAt(0)
  const resets = paramCache.resets
  for (let attempt = 0; attempt < CHECK_TRIES; attempt++) {
    stopIfCancelled(signal)
    const reply = conn.waitFor((r: Received) => firstOfTheVehicle(r), CHECK_WAIT_MS, signal)
    await askIndex(conn, 0)
    const r = await reply
    if (r != null) {
      const m = r!.message
      if (m instanceof ParamValue) {
        return (m.paramCount as int) == count && (name == "" || m.paramId == name) && paramCache.resets == resets
      }
    }
  }
  stopIfCancelled(signal)
  return false
}

/// Whether every index of `gaps` from `from` to `to` (excluded) is fresh.
function allIn(gaps: int[], from: int, to: int): bool {
  for (let i = from; i < to; i++) {
    if (!paramCache.fresh.has(gaps[i])) {
      return false
    }
  }
  return true
}

/// Waits until the reads of `gaps` from `from` to `to` are answered, or nothing has arrived for `READ_QUIET_MS`.
async function answered(gaps: int[], from: int, to: int, signal: AbortSignal): Promise<void> throws Error {
  const asked = Date.now() as int
  while (!allIn(gaps, from, to)) {
    stopIfCancelled(signal)
    const last = if (paramCache.heardAt > asked) paramCache.heardAt else asked
    if ((Date.now() as int) - last >= READ_QUIET_MS) {
      return
    }
    await delay(20)
  }
}

/// Asks for the parameters that are not fresh, by index, a batch at a time, a few rounds. False when the list changed under it.
async function fillGaps(conn: MavLinkConnection, signal: AbortSignal): Promise<bool> throws Error {
  const resets = paramCache.resets
  for (let round = 0; round < RESUME_ROUNDS && paramCache.missing().length > 0; round++) {
    const gaps = paramCache.missing()
    for (let at = 0; at < gaps.length; at += READS_AT_ONCE) {
      stopIfCancelled(signal)
      const to = if (at + READS_AT_ONCE < gaps.length) at + READS_AT_ONCE else gaps.length
      for (let i = at; i < to; i++) {
        await askIndex(conn, gaps[i])
      }
      await answered(gaps, at, to, signal)
      if (paramCache.resets != resets) {
        return false
      }
      announced.progressed(paramCache.freshCount(), paramCache.count, "parameters")
    }
  }
  return true
}

/// A download that resumes (the link came back to the same vehicle): what this session heard of the vehicle's list is reused,
/// and only what it lacks is asked for, by index. Null when it cannot (nothing kept for this vehicle, more than half of it
/// missing, or the vehicle's list is not the one kept): the caller then makes an ordinary download.
async function resumeList(conn: MavLinkConnection, signal: AbortSignal): Promise<ParamList?> throws Error {
  const started = Date.now() as int
  if (!paramCache.usableFor(link.identity)) {
    return null
  }
  const reused = paramCache.freshCount()
  if (paramCache.missing().length * 2 > paramCache.count) {
    return null
  }
  // The answers are the list's, not news.
  announced.mode = "list"
  if (!await sameList(conn, signal) || !await fillGaps(conn, signal)) {
    return null
  }
  const missing = paramCache.missing()
  return ParamList {
    params: paramCache.list(),
    count: paramCache.count as u16,
    complete: missing.length == 0,
    missing: missing.map((i: int) => i as u16),
    source: ParamListSource.List,
    elapsedMs: ((Date.now() as int) - started) as u32,
    reused: reused as u16,
  }
}

/// Refuses with `ARMED`, or `STATE_UNKNOWN` when the vehicle's armed state is not known (no heartbeat for 3 s: unknown counts as armed).
function refuseWhileArmed(): void throws CommunicatorError {
  const armed = armedState()
  if (armed == null) {
    throw new CommunicatorError("STATE_UNKNOWN", "the vehicle's state is unknown (no heartbeat for 3 s)")
  }
  if (armed!) {
    throw new CommunicatorError("ARMED", "the vehicle is armed")
  }
}

/// Why a tuning write may not go now: not a tuning parameter, outside its limits, the armed state not known, or work under way that
/// a write would meet (a calibration and a motor test are refused above, a reboot here). Armed itself is no reason.
function refuseTuning(id: string, value: f64): void throws CommunicatorError {
  const armed = armedState()
  if (armed == null) {
    // (the name and the value are looked at first, so that a refusal says the first thing that is wrong with the write)
    refuseUntunable(id, value, false)
    throw new CommunicatorError("STATE_UNKNOWN", "the vehicle's state is unknown (no heartbeat for 3 s)")
  }
  refuseUntunable(id, value, armed!)
  if (rebootExpected()) {
    throw new CommunicatorError("BUSY", "a reboot is under way")
  }
}

async function writeParam(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const w = decodeParamWrite(payload ?? Cbor.Null, "$")
  const conn = connectedLink()
  if (link.calibrating) {
    // A write now could be overwritten by what a calibration keeps (a compass result replaces COMPASS_OFS*), and the page's
    // comparison of the old values with the new would be false.
    throw new CommunicatorError("BUSY", "a calibration is running")
  }
  if (link.motorTest) {
    throw new CommunicatorError("BUSY", "a motor test is running")
  }
  if (link.planning) {
    throw new CommunicatorError("BUSY", "the mission, fence or rally points are being read or written")
  }
  // A write from a Setup page is refused while the vehicle is armed or not known to be disarmed: the page says so, and so does this.
  if (w.guarded != null && w.guarded!) {
    refuseWhileArmed()
  }
  // A write from the Tune screen is the one that may go while the vehicle is armed (the leader's decision Q7), and so it is held to the
  // list of tuning parameters and its limits, and looked at again here, at the moment of the write (after the page's hold).
  if (w.tuning != null && w.tuning!) {
    refuseTuning(w.id, w.value)
  }
  const type = typeValue(w.type)
  if (type == null) {
    throw new CommunicatorError("INVALID_VALUE", `unknown parameter type ${w.type}`)
  }
  let value: TypedParamValue = TypedParamValue.Real(w.value, type!)
  if (w.kind == ParamWriteKind.Int) {
    if (Math.floor(w.value) != w.value || Math.abs(w.value) > 4294967295.0) {
      throw new CommunicatorError("INVALID_VALUE", `${w.id} is an integer; ${w.value} isn't`)
    }
    value = TypedParamValue.Int(w.value as int, type!)
  }
  // A reboot is refused while a write is in flight (reboot.pi): it would cut the write.
  link.writes += 1
  const generation = link.generation
  try {
    const r = await new ParamWriteOp(conn, { system: link.sysid, component: link.compid }, link.encoding, { signal: link.session.signal }).run(w.id, value)
    noteTypeChange(w.id, r.verified, generation)
    encodeParamWriteResult(ParamWriteResult { param: toParam(r.param.id, r.param.index, r.param.value), verified: r.verified })
  } catch (e: MavLinkError) {
    noteTypeChange(w.id, false, generation)
    throw new CommunicatorError(e.code, e.message)
  } catch (e: ParamError) {
    noteTypeChange(w.id, false, generation)
    throw new CommunicatorError(e.code, e.message)
  } finally {
    link.writes -= 1
  }
}

/// A write of a parameter that changes the kind of vehicle the board reports (FRAME_CLASS ...): when the vehicle read it back,
/// the board may come back from its reboot as another type and still be the same vehicle (session.pi, `typeMayChange`); a
/// write that did not succeed takes that away. Another parameter changes nothing. A session that has ended since is not touched.
function noteTypeChange(id: string, verified: bool, generation: int): void {
  if (changesVehicleType(id) && link.generation == generation) {
    link.typeMayChange = verified
  }
}

/// The firmware's default of every parameter (#40), from the download with the defaults: the file carries a default only where it
/// differs from the value, so a parameter it carries none for is at its default. Values are as the contract has them (a REAL32 as
/// the float it is).
export function defaultsOf(r: ParamDownloadResult): ParamDefault[] {
  const given = new Map<string, f64>()
  for (const d of r.defaults) {
    given.set(d.id, toParam(d.id, d.index, d.value).value)
  }
  return r.params.map((p) => ParamDefault { id: p.id, value: given.get(p.id) ?? toParam(p.id, p.index, p.value).value })
}

/// `params.defaults`: the vehicle's packed parameter file asked for with its defaults, over MAVLink FTP only (the list protocol has
/// no defaults). One transfer at a time, as `params.list`, and `params.cancel` stops it. Nothing is written, and the parameters
/// the app holds are not touched: what the vehicle announces meanwhile is news, as always.
async function listDefaults(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const conn = connectedLink()
  refuseWhileBusy()
  if (link.capabilities >= 0 && (link.capabilities & MavProtocolCapability.FTP) == 0) {
    throw new CommunicatorError("UNSUPPORTED", "the vehicle has no MAVLink FTP, and only its parameter file carries the defaults")
  }
  const own = new AbortController()
  announced.follow(link.session.signal)
  announced.download = own
  link.listing = true
  try {
    const options: ParamDownloadOptions = { method: "ftp", withDefaults: true, signal: own.signal }
    const target: Target = { system: link.sysid, component: link.compid }
    const r = await new ParamDownload(conn, target, link.encoding, options).run()
    return encodeParamDefaults(ParamDefaults { defaults: defaultsOf(r), elapsedMs: r.elapsedMs as u32 })
  } catch (e: MavLinkError) {
    throw new CommunicatorError(e.code, e.message)
  } catch (e: FtpError) {
    throw new CommunicatorError(e.code, e.message)
  } finally {
    link.listing = false
    announced.download = null
  }
}
