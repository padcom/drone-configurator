// The params service: downloading the vehicle's parameters, writing one with a read-back, and
// telling the dashboard about a parameter the vehicle announces on its own.
import { Cbor, Communicator, CommunicatorError, RequestContext } from "pico-desktop/communicator"
import {
  FtpError,
  MavLinkConnection,
  MavLinkError,
  MavParamType,
  MavProtocolCapability,
  ParamDownload,
  ParamDownloadOptions,
  ParamDownloadResult,
  ParamError,
  ParamWrite as ParamWriteOp,
  Received,
  Target,
  TypedParamValue,
  ParamValue,
  decodeParam,
} from "padcom/pico-mavlink"
import {
  Param,
  ParamKind,
  ParamList,
  ParamListRequestMethod,
  ParamListSource,
  ParamWriteKind,
  ParamWriteResult,
  ParamsProgress,
  ParamsProgressSource,
  decodeParamListRequest,
  decodeParamWrite,
  encodeParam,
  encodeParamList,
  encodeParamsProgress,
  encodeParamWriteResult,
} from "./generated/app"
import { SessionPart, changesVehicleType, connectedLink, link } from "./session"

/// Registers the service's methods on `c`, and its part of the session.
export function register(c: Communicator): void {
  announced.communicator = c
  link.parts.set("params", announced)
  c.handle("params.list", listParams)
  c.handle("params.cancel", cancelDownload)
  c.handle("params.write", writeParam)
}

/// The most a progress count can be (the contract's `uint .size 2`).
const MAX_COUNT: int = 65535

/// The numbers of a progress event, `[received, total]` in parameters, always inside the contract's range: the file reports bytes
/// and the size the vehicle gave on opening is any four bytes (an estimate of 12 a parameter, here a garbled or hostile one
/// could be billions), the list reports parameters (and a vehicle can claim any count). Clamped before they are converted.
/// A total of 0 or less is nothing to report: `[0, 0]`.
export function progressCounts(received: int, total: int, fromFile: bool): int[] {
  const all = if (fromFile) total / BYTES_A_PARAM else total
  const done = if (fromFile) received / BYTES_A_PARAM else received
  if (all <= 0) {
    return [0, 0]
  }
  const top = if (all > MAX_COUNT) MAX_COUNT else all
  const shown = if (done < 0) 0 else if (done > top) top else done
  [shown, top]
}

/// At most this often (ms) a `params.progress` is sent while a download runs.
const PROGRESS_EVERY_MS: int = 100

/// The vehicle's reckoning of the size of its parameter file: this many bytes a parameter (so progress by file is in parameters).
const BYTES_A_PARAM: int = 12

/// Parameters the vehicle announces on its own (`params.changed`).
class Announced implements SessionPart {
  public communicator: Communicator? = null
  public conn: MavLinkConnection? = null
  public listener: int = 0
  /// What a PARAM_VALUE of the vehicle is while a download runs: `news` (no download, or the file transfer is not under way: it
  /// is announced), `file` (the file transfer is under way: a PARAM_VALUE is news from another ground station, kept to be
  /// applied over the downloaded list), `list` (the list is being downloaded: a PARAM_VALUE is its answer).
  public mode: string = "news"
  /// Announcements that came during the file transfer, by name: applied over the list when it is in.
  public pending: Map<string, Param> = new Map<string, Param>()
  /// The download that runs, so that `params.cancel` can stop it (and nothing else: the session goes on).
  public download: AbortController? = null
  /// When progress was last sent (ms since 1970).
  public progressAt: int = 0
  /// The session signal that is followed (once for each session, not once for each download).
  public followed: AbortSignal? = null

  /// Makes the session ending stop the download that runs. One listener on a session's signal, however many downloads it has.
  public follow(signal: AbortSignal): void {
    if (followed == signal) {
      return
    }
    followed = signal
    signal.addEventListener("abort", () => stopDownload())
  }

  /// Stops the download that runs, if any.
  public stopDownload(): void {
    const d = download
    if (d != null) {
      d!.abort()
    }
  }

  /// How far the download is, in parameters: `bytes` (the file, `total` the vehicle's estimate of 12 bytes a parameter, clamped:
  /// the file can be bigger than it said) or `parameters` (the list). Sent at most `PROGRESS_EVERY_MS` apart (the first at once,
  /// the last when all have arrived). The first report of the list means the file transfer was given up.
  public progressed(received: int, total: int, unit: string): void {
    const fromFile = unit == "bytes"
    if (!fromFile && mode == "file") {
      mode = "list"
      pending.clear()
    }
    const counts = progressCounts(received, total, fromFile)
    const all = counts[1]
    const c = communicator
    const now = Date.now() as int
    if (c == null || all <= 0 || (progressAt != 0 && counts[0] < all && now - progressAt < PROGRESS_EVERY_MS)) {
      return
    }
    progressAt = now
    const source = if (fromFile) ParamsProgressSource.Ftp else ParamsProgressSource.List
    c!.emit("params.progress", encodeParamsProgress(ParamsProgress { received: counts[0] as u16, total: all as u16, source: source }))
  }

  /// Puts what other ground stations announced during the file transfer over the list that came (their values are newer).
  public applyPending(params: Param[]): void {
    for (const p of params) {
      const news = pending.get(p.id)
      if (news != null) {
        p.value = news!.value
        p.kind = news!.kind
        p.type = news!.type
      }
    }
    pending.clear()
  }

  public attach(c: MavLinkConnection): void {
    if (conn != null) {
      detach()
    }
    conn = c
    listener = c.on((r: Received) => seen(r))
  }

  public detach(): void {
    const c = conn
    if (c != null) {
      c!.off(listener)
    }
    conn = null
  }

  /// News from the connected vehicle.
  public seen(r: Received): void {
    if (link.sysid == 0 || r.packet.header.sysid != link.sysid || r.packet.header.compid != link.compid) {
      return
    }
    const m = r.message
    if (m instanceof ParamValue) {
      // A parameter the vehicle announced on its own: tell the dashboard (or, during the list download, it is an answer of it).
      if (mode == "list") {
        return
      }
      const p = toParam(m.paramId, m.paramIndex as int, decodeParam(m.paramValue, m.paramType as int, link.encoding))
      if (mode == "file") {
        pending.set(p.id, p)
        return
      }
      const c = communicator
      if (c != null) {
        c!.emit("params.changed", encodeParam(p))
      }
    }
  }
}

const announced = new Announced()

function typeName(type: int): string {
  MavParamType.nameOf(type) ?? `${type}`
}

function typeValue(name: string): int? {
  for (let t = 1; t <= 10; t++) {
    if (MavParamType.nameOf(t) == name) {
      return t
    }
  }
  null
}

/// A parameter as the contract has it.
function toParam(id: string, index: int, v: TypedParamValue): Param {
  match (v) {
    Int { value, type } => Param { id: id, index: index as u16, kind: ParamKind.Int, type: typeName(type), value: value as f64 },
    Real { value, type } => Param { id: id, index: index as u16, kind: ParamKind.Real, type: typeName(type), value: (value as f32) as f64 },
  }
}

/// Stops the download that is running, if any: it fails with `ABORTED`, and the link and the session stay.
async function cancelDownload(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  announced.stopDownload()
  null
}

/// How a download is made, given what was asked for and what is known of the vehicle: the way for `ParamDownload` (`auto`, `list`
/// or `ftp`), and why the file transfer is skipped when it is. A download that is not forced skips the file transfer when it
/// failed before for a reason that will not change soon: `unsupported` (the vehicle has no such file: for as long as the
/// connection lasts) or `timeout` (it did not answer: for the next download only, so that the one after tries again).
class Plan {
  public method: string = "auto"
  public skipped: string = ""
}

function planFor(asked: ParamListRequestMethod?): Plan {
  const plan = new Plan()
  if (asked != null && asked! == ParamListRequestMethod.Ftp) {
    plan.method = "ftp"
  } else if (asked != null && asked! == ParamListRequestMethod.List) {
    plan.method = "list"
  } else if (link.ftpMemo != "") {
    plan.method = "list"
    plan.skipped = link.ftpMemo
    if (link.ftpMemo == "timeout") {
      link.ftpMemo = ""
    }
  }
  plan
}

/// Whether the file transfer may be tried: the vehicle's capabilities say it has it, or were never read (then the download asks
/// for them itself, and a missed packet at connect is not "no file transfer").
function vehicleHasFtp(): bool {
  link.capabilities < 0 || (link.capabilities & MavProtocolCapability.FTP) != 0
}

/// What is remembered about a failure of the file transfer: "unsupported" only when it comes from capabilities that were read
/// (a download that had to ask for them, and got no answer, knows nothing), "timeout" always, nothing else.
function worthRemembering(fallback: string): bool {
  fallback == "timeout" || (fallback == "unsupported" && link.capabilities >= 0)
}

/// A download that is not forced remembers why the file transfer failed, if it was for a reason worth remembering.
function remember(plan: Plan, source: string, fallback: string?): void {
  if (plan.method == "auto" && source == "list" && fallback != null && worthRemembering(fallback!)) {
    link.ftpMemo = fallback!
  }
}

/// The options of a download: the capabilities only when they were read at connect (else `ParamDownload` asks).
function optionsFor(plan: Plan, signal: AbortSignal): ParamDownloadOptions {
  if (link.capabilities < 0) {
    const asking: ParamDownloadOptions = { method: plan.method, signal: signal }
    return asking
  }
  const known: ParamDownloadOptions = { method: plan.method, capabilities: link.capabilities, signal: signal }
  known
}

/// The parameters as the contract has them: the way they came, why not the other way, how long it took.
function listOf(r: ParamDownloadResult, plan: Plan): ParamList {
  const source = if (r.source == "ftp") ParamListSource.Ftp else ParamListSource.List
  // A download that skipped the file transfer says why (what it remembered), not that the list was asked for.
  const why = if (plan.skipped != "") plan.skipped else r.fallback ?? ""
  ParamList {
    params: r.params.map((p) => toParam(p.id, p.index, p.value)),
    count: r.count as u16,
    complete: r.complete,
    missing: r.missing.map((i: int) => i as u16),
    source: source,
    fallback: if (why == "") null else why,
    elapsedMs: r.elapsedMs as u32,
  }
}

async function listParams(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const asked = if (payload == null) null else decodeParamListRequest(payload!, "$").method
  const conn = connectedLink()
  if (announced.download != null) {
    // One download at a time: a second would share its progress and take its place for `params.cancel`.
    throw new CommunicatorError("BUSY", "a parameter download is already running")
  }
  const plan = planFor(asked)
  // The download has a controller of its own, so that cancelling it does not end the session; the session ending stops it.
  const own = new AbortController()
  announced.follow(link.session.signal)
  announced.download = own
  announced.progressAt = 0
  announced.pending.clear()
  announced.mode = if (plan.method != "list" && vehicleHasFtp()) "file" else "list"
  link.listing = true
  let out: ParamList
  try {
    const options = optionsFor(plan, own.signal)
    const target: Target = { system: link.sysid, component: link.compid }
    const r = await new ParamDownload(conn, target, link.encoding, options).run((received: int, total: int, unit: string) => announced.progressed(received, total, unit))
    out = listOf(r, plan)
    announced.applyPending(out.params)
    remember(plan, r.source, r.fallback)
  } catch (e: MavLinkError) {
    throw new CommunicatorError(e.code, e.message)
  } catch (e: FtpError) {
    // A forced file transfer that failed: its own error, no fallback.
    throw new CommunicatorError(e.code, e.message)
  } finally {
    // Whatever ends the download (an error of any kind included): a flag left set would hold off the reboot, and the
    // announcements, until the session ends.
    announced.mode = "news"
    announced.pending.clear()
    link.listing = false
    announced.download = null
  }
  encodeParamList(out)
}

async function writeParam(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const w = decodeParamWrite(payload ?? Cbor.Null, "$")
  const conn = connectedLink()
  const type = typeValue(w.type)
  if (type == null) {
    throw new CommunicatorError("INVALID_VALUE", `unknown parameter type ${w.type}`)
  }
  let value: TypedParamValue = TypedParamValue.Real(w.value, type!)
  if (w.kind == ParamWriteKind.Int) {
    if (Math.floor(w.value) != w.value || Math.abs(w.value) > 4294967295.0) {
      throw new CommunicatorError("INVALID_VALUE", `${w.id} is an integer; ${w.value} isn't`)
    }
    value = TypedParamValue.Int(w.value as int, type!)
  }
  // A reboot is refused while a write is in flight (reboot.pi): it would cut the write.
  link.writes += 1
  const generation = link.generation
  try {
    const r = await new ParamWriteOp(conn, { system: link.sysid, component: link.compid }, link.encoding, { signal: link.session.signal }).run(w.id, value)
    noteTypeChange(w.id, r.verified, generation)
    encodeParamWriteResult(ParamWriteResult { param: toParam(r.param.id, r.param.index, r.param.value), verified: r.verified })
  } catch (e: MavLinkError) {
    noteTypeChange(w.id, false, generation)
    throw new CommunicatorError(e.code, e.message)
  } catch (e: ParamError) {
    noteTypeChange(w.id, false, generation)
    throw new CommunicatorError(e.code, e.message)
  } finally {
    link.writes -= 1
  }
}

/// A write of a parameter that changes the kind of vehicle the board reports (FRAME_CLASS ...): when the vehicle read it back,
/// the board may come back from its reboot as another type and still be the same vehicle (session.pi, `typeMayChange`); a
/// write that did not succeed takes that away. Another parameter changes nothing. A session that has ended since is not touched.
function noteTypeChange(id: string, verified: bool, generation: int): void {
  if (changesVehicleType(id) && link.generation == generation) {
    link.typeMayChange = verified
  }
}
