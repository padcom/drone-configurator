// The settings service: what the user chose (language, theme, the interface's own layouts) survives a restart.
//
// The document is one JSON file, `settings.json`, in the app's data directory (pico-desktop's `appDirs`), laid out for a
// person to read and to edit: the contract's `settings`, with the theme as its name. It is written to a temporary file and
// renamed over the old one, so a write that is cut short leaves the old settings whole. A file that cannot be read, that
// is not a settings document, or that a newer version wrote, is renamed aside (`settings.json.corrupt-<ms>`,
// `.unreadable-<ms>`, `.newer-<ms>`), the app starts on defaults and says so (`notice`). If the directory cannot be used
// the settings are kept in memory, and say so.
//
// A hand-edited file is read as it is: any spacing, a byte order mark, the members in any order, and a member this version
// does not know is skipped (JSON.parse does that) and gone from the file at the next save. A member it needs that is
// missing or has the wrong type, a theme that is not light, dark or system, a language or entries outside the limits a
// patch is held to, or the same key twice, makes the file corrupt.
//
// The rules of the version: `version` is a whole number (1; `1.0` or "1" make the file corrupt). A version this code does
// not know is NEWER, and its body is not looked at. **Any member added to the document needs a new version**, because a
// file that is rolled back to a version that does not know the member skips it, and the next save erases it without a
// word; a new version is what makes the older one set the file aside instead.
//
// A `settings.cbor` from the one release that wrote that format is not read: it is left in the directory as it is.
import { AppDirError, Cbor, Communicator, CommunicatorError, RequestContext, appDirs } from "pico-desktop/communicator"
import { exists, mkdir, readDir, readText, remove, rename, writeText } from "std/fs"
import { join } from "std/path"
import { pid } from "std/process"
import { delay } from "std/timers"
import {
  Settings,
  SettingsPatch,
  SettingsState,
  ThemeName,
  UiEntry,
  decodeSettingsPatch,
  encodeSettingsState,
} from "./generated/app"

/// The app's ID, as in pico-desktop.config.ts: it names the app's directory.
const APP_ID: string = "dev.pico-desktop.drone-configurator"

/// The version of the document that this code writes.
export const VERSION: int = 1

/// The settings file, in the data directory.
export const FILE: string = "settings.json"

const MAX_KEY: int = 128
const MAX_VALUE: int = 65536
const MAX_ENTRIES: int = 256
const MAX_LANGUAGE: int = 35
/// The most that all the keys and values together may hold (characters). The whole document travels in every answer and
/// every `settings.changed`, and a message may be at most 4 MiB: a document that is saved must be one that can be sent.
const MAX_TOTAL: int = 1048576

/// Why a settings file was not used: `CORRUPT` (it is not a settings document), `NEWER`, or `UNREADABLE` (the file could
/// not be read at all: permission, a lock, the disk).
export class SettingsFileError extends Error {
  public kind: string

  constructor(kind: string, message: string) {
    super(message)
    this.kind = kind
  }
}

/// A step that brings the text of a document of version `from` to the text of version `from + 1`, before it is read as a
/// `Settings`. The steps are tried in order of version; a document with no step for its version is corrupt.
export class Migration {
  public from: int
  public run: (text: string) => string

  constructor(from: int, run: (text: string) => string) {
    this.from = from
    this.run = run
  }
}

/// A `ui` entry as the file has it.
struct EntryFile {
  key: string
  value: string
}

/// The document as the file has it: the theme by its name (an enum has no JSON form), and `null` for what is not set.
struct DocFile {
  version: int
  language: string?
  theme: string?
  ui: EntryFile[]
}

/// Just the version, which is read first: a file of a newer version may be shaped in ways this one cannot read.
struct VersionOnly {
  version: int
}

/// What the service holds. Module state, like the session: there is one backend per process.
class Store {
  public loaded: bool = false
  public busy: bool = false
  /// The directory the file is in; null when the settings are kept in memory only.
  public dir: string? = null
  public doc: Settings = defaults()
  public notice: string? = null
  public noticeCode: string? = null
  public communicator: Communicator? = null
  /// For tests: use this directory instead of the app's data directory.
  public override: string? = null
  public steps: Migration[] = []
  /// For tests: a file that is not used cannot be moved aside.
  public asideFails: bool = false
}

const store = new Store()

function defaults(): Settings {
  Settings { version: VERSION as u8, ui: [] }
}

/// Registers the service's methods on `c`.
export function register(c: Communicator): void {
  store.communicator = c
  c.handle("settings.get", getSettings)
  c.handle("settings.set", setSettings)
}

/// For tests: the directory to keep the settings in (instead of the app's data directory), and the migrations to use.
export function useDirectoryForTests(dir: string, steps: Migration[] = []): void {
  store.override = dir
  store.steps = steps
  restartForTests()
}

/// For tests: the next file that is not used cannot be moved aside (until `restartForTests`).
export function failToSetAsideForTests(): void {
  store.asideFails = true
}

/// For tests: forget everything held in memory, as a restarted backend does; the file stays.
export function restartForTests(): void {
  store.asideFails = false
  store.loaded = false
  store.busy = false
  store.dir = null
  store.doc = defaults()
  store.notice = null
  store.noticeCode = null
}

/// Takes the service's turn: one load or save at a time.
async function lock(): Promise<void> throws Error {
  while (store.busy) {
    await delay(5)
  }
  store.busy = true
}

function unlock(): void {
  store.busy = false
}

function state(): SettingsState {
  SettingsState { settings: store.doc, notice: store.notice, noticeCode: store.noticeCode }
}

function say(code: string, message: string): void {
  store.noticeCode = code
  store.notice = message
}

/// The version a document's text says it is, or -1 when it is not JSON with a whole-number `version`.
function versionOf(text: string): int {
  try {
    return JSON.parse<VersionOnly>(text).version
  } catch (e: Error) {
    return -1
  }
}

/// Brings a document's text up to `VERSION` with `steps`. A document of a newer version, or of a version no step leads
/// from, is a `SettingsFileError`.
export function migrate(text: string, steps: Migration[]): string throws SettingsFileError {
  let current = text
  let version = versionOf(text)
  if (version < 0) {
    throw new SettingsFileError("CORRUPT", "the settings file has no version")
  }
  if (version > VERSION) {
    throw new SettingsFileError("NEWER", `the settings file is version ${version}, this app reads up to ${VERSION}`)
  }
  while (version < VERSION) {
    let step: Migration? = null
    for (const s of steps) {
      if (s.from == version) {
        step = s
      }
    }
    if (step == null) {
      throw new SettingsFileError("CORRUPT", `no way to read a version ${version} settings file`)
    }
    const run = step!.run
    current = run(current)
    version += 1
    if (versionOf(current) != version) {
      throw new SettingsFileError("CORRUPT", `a migration from version ${version - 1} did not leave version ${version}`)
    }
  }
  current
}

/// The theme a name in the file stands for, or null when it is not one.
function themeOf(name: string): ThemeName? {
  if (name == "light") ThemeName.Light else if (name == "dark") ThemeName.Dark else if (name == "system") ThemeName.System else null
}

/// The name of a theme in the file.
function nameOf(theme: ThemeName): string {
  if (theme == ThemeName.Light) "light" else if (theme == ThemeName.Dark) "dark" else "system"
}

/// The settings that a document in the file's shape holds.
function settingsFrom(f: DocFile): Settings throws SettingsFileError {
  const ui: UiEntry[] = []
  for (const e of f.ui) {
    ui.push(UiEntry { key: e.key, value: e.value })
  }
  const s = Settings { version: f.version as u8, language: f.language, ui: ui }
  const name = f.theme
  if (name != null) {
    const theme = themeOf(name!)
    if (theme == null) {
      throw new SettingsFileError("CORRUPT", `the settings file has a theme called '${name!}': light, dark or system are the ones there are`)
    }
    s.theme = theme
  }
  s
}

/// The text of the file for a settings document, laid out for a person to read and edit: a member to a line, an entry to
/// a line. (Written here and not by `JSON.stringify(doc, 2)`: its indenting takes seconds for a document of a few hundred
/// kilobytes, which the limits allow (pico-lang#133); only the strings go through `JSON.stringify`, which is quick.)
export function textOf(s: Settings): string {
  const parts: string[] = ["{\n  \"version\": ", `${s.version}`]
  const language = s.language
  if (language != null) {
    parts.push(`,\n  "language": ${JSON.stringify(language!)}`)
  }
  const theme = s.theme
  if (theme != null) {
    parts.push(`,\n  "theme": ${JSON.stringify(nameOf(theme!))}`)
  }
  parts.push(",\n  \"ui\": [")
  let first = true
  for (const e of s.ui) {
    parts.push(if (first) "\n    " else ",\n    ")
    parts.push(`{ "key": ${JSON.stringify(e.key)}, "value": ${JSON.stringify(e.value)} }`)
    first = false
  }
  parts.push(if (first) "]\n}\n" else "\n  ]\n}\n")
  parts.join("")
}

/// A settings document from the text of a file. A byte order mark at the start (some editors on Windows write one) is not
/// part of the text.
export function parse(text: string, steps: Migration[]): Settings throws SettingsFileError {
  const body = if (text.startsWith("\u{FEFF}")) text.slice(1) else text
  try {
    const s = settingsFrom(JSON.parse<DocFile>(migrate(body, steps)))
    check(s)
    s
  } catch (e: SettingsFileError) {
    throw e
  } catch (e: Error) {
    throw new SettingsFileError("CORRUPT", `the settings file cannot be read: ${e.message}`)
  }
}

/// How many characters the keys and values of `entries` hold together.
function sizeOf(entries: UiEntry[]): int {
  let total = 0
  for (const e of entries) {
    total += e.key.length + e.value.length
  }
  total
}

/// Whether a `ui` key is one the settings use themselves: `remove` names those, so an entry may not have them.
function reserved(key: string): bool {
  key == "language" || key == "theme"
}

/// How many characters a whole document holds that count against the total: its entries, and its language.
function sizeOfDoc(s: Settings): int {
  const language = s.language
  sizeOf(s.ui) + (if (language == null) 0 else language!.length)
}

/// Whether a document keeps to the limits: the same ones a patch is held to, since a person can edit the file. (The whole
/// document travels in every answer and event, so a file that passes must be one that can be sent.)
function check(s: Settings): void throws SettingsFileError {
  const language = s.language
  if (language != null && (language!.length == 0 || language!.length > MAX_LANGUAGE)) {
    throw new SettingsFileError("CORRUPT", `the settings file has a language of ${language!.length} characters, 1 to ${MAX_LANGUAGE} are allowed`)
  }
  if (s.ui.length > MAX_ENTRIES) {
    throw new SettingsFileError("CORRUPT", `the settings file has ${s.ui.length} entries, at most ${MAX_ENTRIES}`)
  }
  if (sizeOfDoc(s) > MAX_TOTAL) {
    throw new SettingsFileError("CORRUPT", `the settings file holds more than ${MAX_TOTAL} characters`)
  }
  const seen = new Set<string>()
  for (const e of s.ui) {
    if (e.key.length == 0 || e.key.length > MAX_KEY || e.value.length > MAX_VALUE || reserved(e.key)) {
      throw new SettingsFileError("CORRUPT", "the settings file has an entry outside the limits")
    }
    if (seen.has(e.key)) {
      throw new SettingsFileError("CORRUPT", `the settings file has the key '${e.key}' twice`)
    }
    seen.add(e.key)
  }
}

/// Where the file goes: the directory under test, or the app's data directory. Null (and a notice) when there is none.
async function locate(): Promise<string?> {
  const wanted = store.override
  try {
    if (wanted != null) {
      await mkdir(wanted!, true)
      return wanted
    }
    const dirs = await appDirs(APP_ID)
    return dirs.data
  } catch (e: AppDirError) {
    say("NOT_WRITABLE", `${e.message}. The settings are kept in memory and are lost when the app closes.`)
  } catch (e: Error) {
    say("NOT_WRITABLE", `can't use the settings directory: ${e.message}. The settings are kept in memory and are lost when the app closes.`)
  }
  null
}

/// Moves a file that was not used out of the way, under a name that says why; the file is kept, not deleted. Whether it
/// could be moved.
async function setAside(path: string, kind: string): Promise<bool> {
  if (store.asideFails) {
    return false
  }
  try {
    await rename(path, `${path}.${kind.toLowerCase()}-${Date.now() as int}`)
  } catch (e: Error) {
    return false
  }
  true
}

/// A file that cannot be used is set aside, and the settings are the defaults. If it cannot be moved either, it is left
/// where it is and the settings are kept in memory only: a save would replace it, and the user's settings with it.
async function giveUp(path: string, kind: string, why: string): Promise<void> {
  if (await setAside(path, kind)) {
    say(kind, `${why}. It was set aside as ${FILE}.${kind.toLowerCase()}-… and the settings are the defaults.`)
    return
  }
  store.dir = null
  say(kind, `${why}, and it could not be moved aside. It is left as it is, and the settings are the defaults, kept in memory so that it is not overwritten.`)
}

/// Removes the temporary files that writes cut short left beside the settings (a write that completes renames its own).
async function clearTemporaries(dir: string): Promise<void> {
  try {
    const stale: string[] = []
    for await (const entry of readDir(dir)) {
      if (entry.name.startsWith(`${FILE}.tmp-`)) {
        stale.push(join(dir, entry.name))
      }
    }
    for (const path of stale) {
      await remove(path)
    }
  } catch (e: Error) {
    // Left where they are; they do no harm.
  }
}

/// Reads the file, once. Called with the service's turn taken.
async function load(): Promise<void> {
  store.loaded = true
  store.dir = await locate()
  const dir = store.dir
  if (dir == null) {
    return
  }
  const path = join(dir!, FILE)
  await clearTemporaries(dir!)
  try {
    if (!await exists(path)) {
      return
    }
    store.doc = parse(await readText(path), store.steps)
  } catch (e: SettingsFileError) {
    await giveUp(path, e.kind, e.message)
  } catch (e: Error) {
    await giveUp(path, "UNREADABLE", `the settings file cannot be read: ${e.message}`)
  }
}

async function ready(): Promise<void> throws Error {
  await lock()
  try {
    if (!store.loaded) {
      await load()
    }
  } finally {
    unlock()
  }
}

/// Writes the document: to a temporary file first, then over the old one by a rename, so an interrupted write leaves the
/// old file whole. False (and a notice) when it cannot be written; the settings are then kept in memory.
async function save(): Promise<bool> {
  const dir = store.dir
  if (dir == null) {
    return false
  }
  const path = join(dir!, FILE)
  const temporary = `${path}.tmp-${pid}`
  try {
    await writeText(temporary, textOf(store.doc))
    await rename(temporary, path)
  } catch (e: Error) {
    try {
      await remove(temporary)
    } catch (r: Error) {
      // Nothing was written, or it is gone already.
    }
    say("NOT_WRITABLE", `the settings could not be saved: ${e.message}. They are kept in memory and are lost when the app closes.`)
    return false
  }
  if (store.noticeCode == "NOT_WRITABLE") {
    store.noticeCode = null
    store.notice = null
  }
  true
}

/// `entries` with `entry` added, or put in place of the one with its key.
function withEntry(entries: UiEntry[], entry: UiEntry): UiEntry[] {
  const out: UiEntry[] = []
  let placed = false
  for (const e of entries) {
    if (e.key == entry.key) {
      out.push(entry)
      placed = true
    } else {
      out.push(e)
    }
  }
  if (!placed) {
    out.push(entry)
  }
  out
}

/// `entries` without the one called `key`.
function withoutEntry(entries: UiEntry[], key: string): UiEntry[] {
  const out: UiEntry[] = []
  for (const e of entries) {
    if (e.key != key) {
      out.push(e)
    }
  }
  out
}

function invalid(message: string): CommunicatorError {
  new CommunicatorError("INVALID_VALUE", message)
}

/// The document with `patch` applied; an `INVALID_VALUE` error, with the document untouched, when it asks for what the
/// limits do not allow.
export function applied(doc: Settings, patch: SettingsPatch): Settings throws CommunicatorError {
  let next = doc
  const language = patch.language
  if (language != null) {
    if (language!.length == 0 || language!.length > MAX_LANGUAGE) {
      throw invalid(`a language is a tag of 1 to ${MAX_LANGUAGE} characters`)
    }
    next.language = language
  }
  if (patch.theme != null) {
    next.theme = patch.theme
  }
  const entries = patch.ui
  if (entries != null) {
    for (const e of entries!) {
      if (e.key.length == 0 || e.key.length > MAX_KEY) {
        throw invalid(`a key is 1 to ${MAX_KEY} characters`)
      }
      if (e.value.length > MAX_VALUE) {
        throw invalid(`the value of ${e.key} is longer than ${MAX_VALUE} characters`)
      }
      if (reserved(e.key)) {
        throw invalid(`${e.key} is a name the settings use themselves: choose another key`)
      }
      next.ui = withEntry(next.ui, e)
    }
  }
  const gone = patch.remove
  if (gone != null) {
    for (const name of gone!) {
      if (name == "language") {
        next.language = null
      } else if (name == "theme") {
        next.theme = null
      } else {
        next.ui = withoutEntry(next.ui, name)
      }
    }
  }
  if (next.ui.length > MAX_ENTRIES) {
    throw invalid(`there can be at most ${MAX_ENTRIES} entries`)
  }
  if (sizeOfDoc(next) > MAX_TOTAL) {
    throw invalid(`the entries can hold at most ${MAX_TOTAL} characters together`)
  }
  next
}

async function getSettings(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  await ready()
  encodeSettingsState(state())
}

async function setSettings(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const patch = decodeSettingsPatch(payload ?? Cbor.Null, "$")
  await ready()
  await lock()
  try {
    store.doc = applied(store.doc, patch)
    await save()
  } finally {
    unlock()
  }
  const out = encodeSettingsState(state())
  const c = store.communicator
  if (c != null) {
    c!.emit("settings.changed", out)
  }
  out
}
