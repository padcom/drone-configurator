// The flight logs on this computer: the checked copies that `logs.download` keeps in `<data directory>/logs/<vehicle>/` as
// `NNNNNNNN-CCCCCCCC.BIN` (the vehicle's number of the log and the CRC-32 the vehicle gave for it). `logs.local.list` lists them
// without reading them; `logs.local.read` reads one through, once and in order, with the DataFlash reader (padcom/pico-mavlink),
// and says what is in it.
//
// A log can be of any size: it is read a megabyte at a time and the reader holds a chunk and a message, never the log; what is
// kept of it is a few counters and the changes of flight mode (at most `MAX_MODES`). The read is cancelable and tells how far it
// is. While it reads it works out the file's CRC-32 too: a log is `verified` when that is the CRC in its name and the file did
// not change meanwhile. Nothing may be concluded from a log that is not verified.
//
// What a read found is kept (in memory) for as long as the file is the one that was read: the same size and the same time of the
// last change. A file that changed is read again before anything is said of it.
import { Cbor, Communicator, CommunicatorError, RequestContext } from "pico-desktop/communicator"
import { Crc32, DfDecoder, DfMessage } from "padcom/pico-mavlink"
import { File, open, readDir, stat } from "std/fs"
import { join } from "std/path"
import {
  LocalLog,
  LocalLogModes,
  LocalLogSummary,
  LocalLogs,
  LogsLocalProgress,
  ModeChange,
  decodeLogsLocalRead,
  encodeLocalLogModes,
  encodeLocalLogSummary,
  encodeLocalLogs,
  encodeLogsLocalProgress,
} from "./generated/app"
import { copyNumbers, hex8 } from "./logs"
import { dataDirectory } from "./settings"

/// How much of a log is read at a time.
const READ_CHUNK: int = 1048576

/// At most this often (ms) a `logs.local.progress` is sent (the last always).
const PROGRESS_EVERY_MS: int = 100

/// The changes of flight mode that are kept of a log; more are counted away (`modesCut`).
const MAX_MODES: int = 5000

/// The most logs `logs.local.list` gives (the most recently changed).
const MAX_LISTED: int = 2000

/// The most files looked at in the folders of the vehicles: a folder with more than this is not a folder of logs.
const MAX_LOOKED_AT: int = 100000

/// The longest firmware text that is kept.
const MAX_FIRMWARE: int = 120

export function register(c: Communicator): void {
  state.communicator = c
  c.handle("logs.local.list", listLocal)
  c.handle("logs.local.read", readLocal)
  c.handle("logs.local.modes", modesOfLocal)
  c.handle("logs.local.cancel", cancelRead)
}

/// What a read of a log found, with the file as it was then.
class Known {
  public readonly size: int
  public readonly mtime: int
  public readonly summary: LocalLogSummary

  constructor(size: int, mtime: int, summary: LocalLogSummary) {
    this.size = size
    this.mtime = mtime
    this.summary = summary
  }
}

/// The changes of flight mode a read found, with the file as it was then.
class KnownModes {
  public readonly size: int
  public readonly mtime: int
  public readonly modes: ModeChange[]
  public readonly cut: bool

  constructor(size: int, mtime: int, modes: ModeChange[], cut: bool) {
    this.size = size
    this.mtime = mtime
    this.modes = modes
    this.cut = cut
  }
}

/// How many summaries are kept (they are small), and how many logs' changes of mode (they can be thousands): the oldest go.
const MAX_KNOWN: int = 2000
const MAX_KNOWN_MODES: int = 16

class State {
  public communicator: Communicator? = null
  /// The read that runs, so that `logs.local.cancel` can stop it.
  public reading: AbortController? = null
  /// What the reads found, by the key of the log, at most `MAX_KNOWN` of them, and the modes of the last `MAX_KNOWN_MODES`.
  public readonly known: Map<string, Known> = new Map<string, Known>()
  public readonly modes: Map<string, KnownModes> = new Map<string, KnownModes>()
}

const state = new State()

/// For tests: forget what the reads found.
export function forgetLocalReads(): void {
  state.known.clear()
  state.modes.clear()
}

/// Puts `value` under `key` as the newest entry of `kept`, and drops the oldest ones past `cap`.
export function keepNewest<T>(kept: Map<string, T>, key: string, value: T, cap: int): void {
  kept.delete(key)
  kept.set(key, value)
  while (kept.size > cap) {
    for (const oldest of kept.keys()) {
      kept.delete(oldest)
      break
    }
  }
}

/// The folder all the vehicles' folders of logs are in.
async function root(): Promise<string> throws CommunicatorError {
  try {
    return join(await dataDirectory(), "logs")
  } catch (e: Error) {
    throw new CommunicatorError("NO_STORAGE", `can't use the folder for logs: ${e.message}`)
  }
}

/// The key of a log: its vehicle's folder and its file.
export function keyOf(vehicle: string, file: string): string {
  `${vehicle}/${file}`
}

/// The vehicle's folder and the file named by a key, or an empty list when it is not the key of a copy: exactly two names, neither
/// of them a way out of the folder, the second a checked copy's.
export function partsOfKey(key: string): string[] {
  const parts = key.split("/")
  if (parts.length != 2 || parts[0] == "" || parts[0].startsWith(".") || parts[0].includes("\\") || copyNumbers(parts[1])[0] < 0) {
    return []
  }
  parts
}

/// A copy found in a folder: its facts, and the cached summary when the file is still the one that was read.
export function describeCopy(vehicle: string, file: string, size: int, mtime: int): LocalLog {
  const numbers = copyNumbers(file)
  const key = keyOf(vehicle, file)
  // A time before 1970 (a file with a wrong clock) is not a time that can be told: it is 0, looked at before it is converted.
  const modified = if (mtime < 0) 0 else mtime
  const log = LocalLog { key: key, vehicle: vehicle, id: numbers[0] as u32, size: size as u64, modified: modified as u64, crc: hex8(numbers[1]) }
  const known = state.known.get(key)
  if (known != null && known!.size == size && known!.mtime == mtime) {
    log.summary = known!.summary
  }
  log
}

/// Puts `log` into `list`, which is kept in order of the most recently changed first and at most `MAX_LISTED` long.
function insertNewest(list: LocalLog[], log: LocalLog): void {
  let at = list.length
  while (at > 0 && list[at - 1].modified < log.modified) {
    at -= 1
  }
  if (at >= MAX_LISTED) {
    return
  }
  list.splice(at, 0, log)
  if (list.length > MAX_LISTED) {
    list.pop()
  }
}

async function listLocal(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const top = await root()
  const list: LocalLog[] = []
  let seen = 0
  let truncated = false
  if (await folderExists(top)) {
    for await (const vehicle of readDir(top)) {
      if (!vehicle.isDirectory || vehicle.name.startsWith(".")) {
        continue
      }
      for await (const entry of readDir(join(top, vehicle.name))) {
        if (!entry.isFile || copyNumbers(entry.name)[0] < 0) {
          continue
        }
        seen += 1
        if (seen > MAX_LOOKED_AT) {
          truncated = true
          break
        }
        const info = await stat(join(top, vehicle.name, entry.name))
        insertNewest(list, describeCopy(vehicle.name, entry.name, info.size, info.mtime))
      }
    }
  }
  encodeLocalLogs(LocalLogs { logs: list, truncated: truncated || seen > MAX_LISTED })
}

async function folderExists(path: string): Promise<bool> {
  try {
    const info = await stat(path)
    info.isDirectory
  } catch (e: Error) {
    false
  }
}

/// What is gathered of a log while it is read.
class Scan implements Taker {
  public messages: int = 0
  public problems: int = 0
  public firstUs: int = -1
  public lastUs: int = -1
  public firmware: string = ""
  public readonly modes: ModeChange[] = []
  public modesCut: bool = false

  /// Takes note of one message.
  public take(m: DfMessage): void {
    messages += 1
    const t = m.timeUs()
    if (t >= 0) {
      if (firstUs < 0) {
        firstUs = t
      }
      lastUs = t
    }
    const name = m.format.name
    if (name == "MODE") {
      takeMode(m, t)
    } else if (name == "MSG" && firmware == "") {
      const text = m.text("Message") ?? ""
      if (text.startsWith("Ardu")) {
        firmware = text.slice(0, MAX_FIRMWARE)
      }
    }
  }

  /// A MODE message: a change of flight mode, when it says which mode, and when.
  takeMode(m: DfMessage, t: int): void {
    const number = m.num("Mode")
    // A number that is not a mode (not a number, or out of range) is damage: looked at before it is converted.
    if (t < 0 || number == null || number! != number! || number! < 0.0 || number! > 65535.0) {
      problems += 1
      return
    }
    if (modes.length >= MAX_MODES) {
      modesCut = true
      return
    }
    modes.push(ModeChange { timeUs: t as u64, mode: (number! as int) as u16 })
  }
}

async function readLocal(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const asked = decodeLogsLocalRead(payload ?? Cbor.Null, "$")
  const own = claimRead()
  try {
    return await readLog(asked.key, own)
  } finally {
    releaseRead()
  }
}

/// Claims the one read there can be at a time (`BUSY` when one runs). Claimed at once, before anything is awaited, so a second
/// read that comes now is refused.
export function claimRead(): AbortController throws CommunicatorError {
  if (state.reading != null) {
    throw new CommunicatorError("BUSY", "a log is being read")
  }
  const own = new AbortController()
  state.reading = own
  own
}

export function releaseRead(): void {
  state.reading = null
}

/// What is taking the messages of a log while it is read.
export interface Taker {
  take(m: DfMessage): void
}

/// What a taker that writes somewhere does between the chunks of the log (the takers take synchronously, so what they gathered is
/// written here).
export interface Flusher {
  flush(): Promise<void, Error>
}

/// A log that was read through: the file as it was when the read began, the CRC-32 of what was read, the CRC in the file's name,
/// whether the file was the same when the read was over, and the reader (for its tables and its problems).
export class Streamed {
  public readonly size: int
  public readonly mtime: int
  public readonly crc: int
  public readonly named: int
  public readonly unchanged: bool
  public readonly decoder: DfDecoder
  /// How many bytes at the end are the start of a message that is not whole: a log is cut in the middle of one when it is copied
  /// while the vehicle writes it. That is how the file ends, not damage in it.
  public readonly tail: int

  constructor(size: int, mtime: int, crc: int, named: int, unchanged: bool, decoder: DfDecoder, tail: int) {
    this.size = size
    this.mtime = mtime
    this.crc = crc
    this.named = named
    this.unchanged = unchanged
    this.decoder = decoder
    this.tail = tail
  }
}

/// The path of the log named by `key` and the facts of its file, or `NOT_FOUND`.
export async function locate(key: string): Promise<LogFile> throws CommunicatorError {
  const parts = partsOfKey(key)
  if (parts.length == 0) {
    throw new CommunicatorError("NOT_FOUND", "there is no such log")
  }
  const path = join(await root(), parts[0], parts[1])
  const facts = await statOf(path)
  if (facts == null) {
    throw new CommunicatorError("NOT_FOUND", "there is no such log")
  }
  new LogFile(path, facts!, copyNumbers(parts[1])[1])
}

export class LogFile {
  public readonly path: string
  public readonly facts: FileFacts
  /// The CRC-32 in the file's name.
  public readonly named: int

  constructor(path: string, facts: FileFacts, named: int) {
    this.path = path
    this.facts = facts
    this.named = named
  }
}

/// Reads the log through once, in order, a chunk at a time, giving each message to `taker`, with progress, until it is done or `own`
/// is aborted (`ABORTED`). Between the chunks `flusher` writes what the taker gathered; `reader` is the decoder to use when the taker
/// needs its tables (the units and multipliers) while it takes.
export async function streamLog(key: string, file: LogFile, own: AbortController, taker: Taker, flusher: Flusher? = null, reader: DfDecoder? = null): Promise<Streamed> throws Error {
  const crc = new Crc32()
  const decoder = reader ?? new DfDecoder()
  const handle = await open(file.path)
  try {
    await readThrough(key, handle, file.facts.size, own, crc, decoder, taker, flusher)
  } catch (e: Error) {
    await handle.close()
    throw e
  }
  await handle.close()
  const before = decoder.problems.skipped
  decoder.finish()
  const tail = decoder.problems.skipped - before
  const after = await statOf(file.path)
  const same = after != null && after!.size == file.facts.size && after!.mtime == file.facts.mtime
  new Streamed(file.facts.size, file.facts.mtime, crc.crc, file.named, same, decoder, tail)
}

/// What a read found, if the file is still the one it was read from.
export function knownSummary(key: string, facts: FileFacts): LocalLogSummary? {
  const known = state.known.get(key)
  if (known != null && known!.size == facts.size && known!.mtime == facts.mtime) known!.summary else null
}

/// Reads the log named by `key` through, and keeps and gives what is in it.
async function readLog(key: string, own: AbortController): Promise<Cbor?> throws Error {
  const file = await locate(key)
  const scan = new Scan()
  const done = await streamLog(key, file, own, scan)
  const summary = summaryOf(scan, done, done.crc == done.named && done.unchanged)
  keepNewest(state.known, key, new Known(done.size, done.mtime, summary), MAX_KNOWN)
  keepNewest(state.modes, key, new KnownModes(done.size, done.mtime, scan.modes, scan.modesCut), MAX_KNOWN_MODES)
  encodeLocalLogSummary(summary)
}

/// Feeds the file to the reader and the CRC, a chunk at a time, telling how far it got.
async function readThrough(key: string, file: File, total: int, own: AbortController, crc: Crc32, decoder: DfDecoder, scan: Taker, flusher: Flusher?): Promise<void> throws Error {
  let bytes = 0
  let told = 0
  while (true) {
    if (own.signal.aborted) {
      throw new CommunicatorError("ABORTED", "the read was stopped")
    }
    const piece = await file.read(READ_CHUNK)
    if (piece == null) {
      break
    }
    bytes += piece!.length
    crc.update(piece!)
    decoder.push(piece!)
    while (true) {
      const m = decoder.next()
      if (m == null) {
        break
      }
      scan.take(m!)
    }
    if (flusher != null) {
      await flusher!.flush()
    }
    const now = Date.now() as int
    if (now - told >= PROGRESS_EVERY_MS) {
      told = now
      say(key, bytes, total)
    }
  }
  say(key, bytes, total)
}

/// Tells the interface how far a read is.
function say(key: string, bytes: int, total: int): void {
  const c = state.communicator
  if (c != null) {
    c!.emit("logs.local.progress", encodeLogsLocalProgress(LogsLocalProgress { key: key, bytes: bytes as u64, total: total as u64 }))
  }
}

/// The summary the contract has, from what was gathered.
function summaryOf(scan: Scan, done: Streamed, verified: bool): LocalLogSummary {
  const damage = done.decoder.problems.skipped - done.tail + done.decoder.problems.count + scan.problems
  const s = LocalLogSummary {
    verified: verified,
    messages: (if (scan.messages > 4294967295) 4294967295 else scan.messages) as u32,
    problems: (if (damage > 4294967295) 4294967295 else damage) as u32,
    modeChanges: scan.modes.length as u32,
  }
  if (done.tail > 0) {
    s.cutEnd = true
  }
  if (scan.firstUs >= 0) {
    s.firstUs = scan.firstUs as u64
    s.lastUs = scan.lastUs as u64
  }
  if (scan.firmware != "") {
    s.firmware = scan.firmware
  }
  s
}

/// The size and time of the last change of a file, or null when it is not there.
async function statOf(path: string): Promise<FileFacts?> {
  try {
    const info = await stat(path)
    if (info.isFile) new FileFacts(info.size, info.mtime) else null
  } catch (e: Error) {
    null
  }
}

export class FileFacts {
  public readonly size: int
  public readonly mtime: int

  constructor(size: int, mtime: int) {
    this.size = size
    this.mtime = mtime
  }
}

/// The changes of flight mode of a log that was read lately, if the file is still the one that was read.
async function modesOfLocal(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const asked = decodeLogsLocalRead(payload ?? Cbor.Null, "$")
  const parts = partsOfKey(asked.key)
  if (parts.length == 0) {
    throw new CommunicatorError("NOT_FOUND", "there is no such log")
  }
  const now = await statOf(join(await root(), parts[0], parts[1]))
  if (now == null) {
    throw new CommunicatorError("NOT_FOUND", "there is no such log")
  }
  const kept = state.modes.get(asked.key)
  if (kept == null || kept!.size != now!.size || kept!.mtime != now!.mtime) {
    throw new CommunicatorError("NOT_READ", "the log has not been read (lately), or it changed since: read it again")
  }
  encodeLocalLogModes(LocalLogModes { modes: kept!.modes, cut: kept!.cut })
}

/// Stops the read that runs, if any: it fails with ABORTED.
async function cancelRead(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const r = state.reading
  if (r != null) {
    r!.abort()
  }
  null
}
