{
  "name": "drone-configurator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pico-desktop dev",
    "ui": "pnpm --filter ./apps/frontend ui",
    "test": "pico-desktop test",
    "generate": "pico-desktop generate",
    "e2e": "pico-desktop test --e2e",
    "lint": "pico lint apps/backend && pnpm --filter ./apps/frontend lint && pnpm --filter ./apps/frontend typecheck && pnpm --filter ./apps/frontend exec tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@pico-desktop/communicator-pico": "link:../pico-desktop/packages/communicator-pico"
  },
  "devDependencies": {
    "pico-desktop": "link:../pico-desktop/tooling/cli"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.9.0"
  }
}
